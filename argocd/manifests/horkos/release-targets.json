{
  "blumeops_repo": "eblume/blumeops",
  "release_targets": {
    "eblume/horkos": {
      "service": "horkos",
      "kustomization": "argocd/manifests/horkos/kustomization.yaml",
      "branch_prefix": "horkos-release-v",
      "default_branch": "main",
      "healthz_url": "https://horkos.ops.eblu.me/healthz",
      "release_workflow": "release.yaml"
    },
    "eblume/talos": {
      "service": "talos",
      "kustomization": "argocd/manifests/talos/kustomization.yaml",
      "branch_prefix": "talos-release-v",
      "default_branch": "main",
      "healthz_url": "https://talos.ops.eblu.me/healthz",
      "release_workflow": "release.yaml"
    },
    "eblume/cv": {
      "service": "cv",
      "kustomization": null,
      "branch_prefix": "cv-release-v",
      "default_branch": "main",
      "healthz_url": null,
      "artifact": {
        "asset_template": "cv-{version}.tar.gz",
        "role_defaults": "ansible/roles/caddy/defaults/main.yml",
        "role_var": "caddy_cv_version",
        "deploy_note": "deployed by the documented manual procedure: [cv-on-indri.md](https://forge.ops.eblu.me/eblume/blumeops/src/branch/main/docs/how-to/operations/cv-on-indri.md)"
      },
      "release_workflow": "cv-release.yaml"
    }
  },
  "auto_filers": [
    {
      "path_prefix": "argocd/apps/",
      "action": "argocd-sync-apps.yaml",
      "inputs": {
        "revision": "{sha}"
      }
    }
  ],
  "container_targets": {
    "eblume/blumeops": {
      "containers_dir": "containers",
      "manifests_dir": "argocd/manifests",
      "default_branch": "main",
      "build_workflow": "build-container.yaml"
    }
  }
}
