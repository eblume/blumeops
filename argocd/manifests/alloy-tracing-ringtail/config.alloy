// Alloy tracing configuration for ringtail
// Uses Beyla eBPF to auto-instrument HTTP services and export traces to Tempo on indri

// ============== BEYLA eBPF AUTO-INSTRUMENTATION ==============
// Allowlist-driven: only containerized processes in the app namespaces
// below are instrumented, so host binaries and infrastructure namespaces
// can never be attached. The exe_path globs are evaluated on the process
// itself at attach time (kubernetes-metadata criteria only resolve
// later), so they stay as the attach-time backstop.
beyla.ebpf "http_services" {
  discovery {
    // 16 app namespaces; 1password intentionally left out.
    instrument {
      containers_only = true
      kubernetes {
        namespace = "authentik"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "birdnet-go"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "frigate"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "homepage"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "horkos"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "immich"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "kiwix"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "mealie"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "miniflux"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "navidrome"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "ntfy"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "ollama"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "paperless"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "shower"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "teslamate"
      }
    }
    instrument {
      containers_only = true
      kubernetes {
        namespace = "torrent"
      }
    }

    // Attach-time backstops: exe_path is a glob, evaluated on the process
    // itself before any pod metadata resolves.
    exclude_instrument {
      exe_path = "*tailscaled*"
    }
    exclude_instrument {
      exe_path = "*containerboot*"
    }
    exclude_instrument {
      exe_path = "*coredns*"
    }
    exclude_instrument {
      exe_path = "*/pause"
    }

    // Infrastructure namespaces/pods, defense in depth.
    exclude_instrument {
      kubernetes {
        namespace = "kube-system"
      }
    }
    exclude_instrument {
      kubernetes {
        namespace = "talos"
      }
    }
    exclude_instrument {
      kubernetes {
        namespace = "tailscale"
      }
    }
    exclude_instrument {
      kubernetes {
        pod_labels = { app = "alloy" }
      }
    }
    exclude_instrument {
      kubernetes {
        pod_labels = { app = "alloy-tracing" }
      }
    }
    exclude_instrument {
      kubernetes {
        pod_labels = { app = "kube-state-metrics" }
      }
    }
    exclude_instrument {
      kubernetes {
        pod_labels = { "app.kubernetes.io/name" = "nvidia-device-plugin" }
      }
    }
  }

  attributes {
    kubernetes {
      enable       = "true"
      cluster_name = "ringtail"
    }
  }

  traces {
    instrumentations = ["http"]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// ============== OTEL TRACE PIPELINE ==============

// Batch traces before export
otelcol.processor.batch "default" {
  output {
    traces = [otelcol.processor.attributes.add_cluster.input]
  }
}

// Add cluster label to all spans
otelcol.processor.attributes "add_cluster" {
  action {
    key   = "cluster"
    value = "ringtail"
    action = "upsert"
  }

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

// Export traces to Tempo on indri via Tailscale
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "https://tempo-otlp.tail8d86e.ts.net"

    tls {
      insecure_skip_verify = true
    }
  }
}
