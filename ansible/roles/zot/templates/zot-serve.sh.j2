#!/bin/bash
# {{ ansible_managed }}
#
# Launch wrapper for the zot LaunchAgent. Its one job is to pass zot's stderr
# through a filter that removes Trivy DB-download progress bars.
#
# zot's CVE extension (extensions.search.cve) downloads trivy-db (~90MiB) and
# trivy-java-db (~900MiB) every updateInterval, and zot hardcodes trivy's
# quiet=false (updateDBInternal in pkg/extensions/search/cve/trivy/scanner.go),
# so trivy draws a carriage-return-animated progress bar on stderr. Redirected
# to a file, the CR frames of one download pile up into a single newline-less
# line of up to several MB — which Loki rejects outright (256KB max entry
# size), failing the whole batch it rides in.
#
# The filter converts CR to LF as a byte stream (`tr -u`, unbuffered) and
# drops the bar frames with line-buffered grep. It must never wait for a
# newline: trivy's whole download is ONE newline-less CR-stream, and a
# line-oriented filter (the original awk version) buffers it indefinitely
# while zot blocks on a full stderr pipe — zot froze at "updating cve-db"
# and never bound its HTTP port (2026-08-14 outage, registry dark ~12h).
# stdout is untouched (launchd's StandardOutPath applies); launchd's
# StandardErrorPath still catches this wrapper's own errors. If the filter
# dies, zot's next stderr write takes SIGPIPE and KeepAlive restarts the
# pair.

exec "{{ zot_binary }}" serve "{{ zot_config_dir }}/config.json" \
  2> >(exec /usr/bin/tr -u '\r' '\n' \
    | /usr/bin/grep --line-buffered -vE '^$|[KMGT]iB / [0-9]' \
    >> "{{ zot_log_dir }}/mcquack.zot.err.log")
