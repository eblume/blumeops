# {{ ansible_managed }}

# Path to borg binary (LaunchAgent doesn't have homebrew in PATH)
local_path: {{ borgmatic_local_path }}

source_directories:
{% for dir in borgmatic_source_directories %}
    - {{ dir }}
{% endfor %}

source_directories_must_exist: true

{% if borgmatic_exclude_patterns %}
exclude_patterns:
{% for pattern in borgmatic_exclude_patterns %}
    - {{ pattern }}
{% endfor %}
{% endif %}

repositories:
{% for repo in borgmatic_repositories %}
    - path: {{ repo.path }}
      label: {{ repo.label }}
{% if repo.encryption is defined %}
      encryption: {{ repo.encryption }}
{% endif %}
{% if repo.append_only is defined %}
      append_only: {{ repo.append_only | lower }}
{% endif %}
{% endfor %}

# zstd for new chunks (lz4 is borg's default); the repo-wide ratio improves
# as archives churn in the never-pruned history.
compression: auto,zstd

encryption_passcommand: {{ borgmatic_encryption_passcommand }}

# Pin the archive-name format explicitly (borg's default) and scope
# any future prune to it: `talos-data-*` archives share these repos
# and must stay out of reach.
archive_name_format: 'indri-{now:%Y-%m-%dT%H:%M:%S.%f}'
match_archives: 'indri-*'

{% if borgmatic_archive_sqlite_dumps or borgmatic_archive_k8s_sqlite_dumps or borgmatic_archive_k8s_tar_dumps %}
# Pre-backup: stage the never-lose database snapshots into the dump dir
# (which is in source_directories, so the snapshots land in the archive).
# A non-zero exit from any hook aborts the whole backup, so a failed
# snapshot is never silent. Same `commands:` hook mechanics as
# operational.yaml — including the per-config `before: configuration`
# scope, so this coexists with talos-data.yaml's own hook in the one
# `--config config.yaml --config talos-data.yaml create` run.
commands:
    - before: configuration
      when: [create]
      run:
          - mkdir -p {{ borgmatic_archive_dump_dir }}
{% for db in borgmatic_archive_sqlite_dumps %}
          # VACUUM INTO (one read snapshot; writers cannot restart the copy,
          # unlike .backup) under a hard timeout, see sqlite-dump.sh.j2.
          - {{ ansible_facts.env.HOME }}/bin/borgmatic-sqlite-dump "{{ db.path }}" "{{ borgmatic_archive_dump_dir }}/{{ db.name }}.db" {{ borgmatic_sqlite_snapshot_timeout_s }}
{% endfor %}
{% for db in borgmatic_archive_k8s_sqlite_dumps %}
          - {{ ansible_facts.env.HOME }}/bin/borgmatic-k8s-sqlite-dump {{ db.target }} {{ db.name }} {{ borgmatic_archive_dump_dir }}/{{ db.name }}.db
{% endfor %}
{% for db in borgmatic_archive_k8s_tar_dumps %}
          - {{ ansible_facts.env.HOME }}/bin/borgmatic-k8s-tar-dump {{ db.target }} {{ db.name }} {{ borgmatic_archive_dump_dir }}/{{ db.name }}.tar
{% endfor %}
{% endif %}

{% if borgmatic_archive_postgresql_databases %}
# Never-lose PostgreSQL dumps (streamed via pg_dump, ~/.pgpass as always).
postgresql_databases:
{% for db in borgmatic_archive_postgresql_databases %}
    - name: {{ db.name }}
      hostname: {{ db.hostname | default('localhost') }}
      port: {{ db.port | default(5432) }}
      username: {{ db.username }}
{% if borgmatic_pg_dump_command is defined %}
      pg_dump_command: {{ borgmatic_pg_dump_command }}
{% endif %}
{% endfor %}
{% endif %}

ssh_command: ssh -o IdentitiesOnly=yes -i {{ borgmatic_borgbase_ssh_key_path }}

# Retry a failing repository action (e.g. a broken SSH pipe partway through a
# large offsite upload to BorgBase) rather than failing the whole run. borg
# checkpoints an interrupted `create`, so a retry resumes from where it dropped.
# retry_wait backs off linearly across attempts to let a transient network issue
# clear. Only the failing repository is retried; the before-backup dump hooks
# (which run once at `before: configuration`) are not re-run.
retries: {{ borgmatic_retries }}
retry_wait: {{ borgmatic_retry_wait }}

# The main config is the never-pruned archive tier (zk, Documents, forgejo,
# and the never-lose dumps heph/forgejo/horkos/paperless) — no retention
# keys and no prune action. Tier B retention lives in operational.yaml.
