#!/bin/sh
# {{ ansible_managed }}
#
# One-shot admin for the operational borg repos, run under launchd (the
# mcquack.eblume.borgmatic-ops-admin oneshot) instead of by the ansible
# provision over ssh: macOS TCC charges SMB-share content access to sshd,
# so any borg command that takes the repo lock EPERMs in an ssh session
# (eblume/blumeops#1773), while launchd-run jobs have the Network Volumes
# access the nightly backup agents already use.
#
# Idempotent no-op on a healthy repo: repo-create runs only when the
# repo's README is absent, and append_only is flipped to 0 only when it
# reads 1. repo-create would otherwise re-apply the config's append_only
# on a re-run; on borg 1.4 append-only makes `compact` a silent no-op, so
# the rotating repo must stay 0 (eblume/blumeops#1441).
#
# The mount guard mirrors the role's ssh-side assert: if /Volumes/backups
# were a leftover local directory, repo-create would quietly create the
# ops repo on indri's own disk. The archive-tier repo's README (present on
# the NAS since 2026-01) proves the mount is up; `test -e` is
# metadata-only, so it holds for a by-hand ssh run too.
set -eu

BORG="{{ borgmatic_borg_bin }}"
BORG_CONFIG="{{ borgmatic_operational_config }}"
MOUNT_MARK=/Volumes/backups/borg/README

test -e "$MOUNT_MARK" || {
  echo "ops-repo-admin: sifaka mount not up (no $MOUNT_MARK); aborting" >&2
  exit 1
}

{% for repo in borgmatic_operational_repositories %}
REPO="{{ repo.path }}"

if ! test -e "$REPO/README"; then
  echo "ops-repo-admin: creating operational repo at $REPO"
  "{{ borgmatic_bin }}" --config "$BORG_CONFIG" repo-create --repository "$REPO"
fi

if ! append_only=$($BORG config "$REPO" append_only); then
  echo "ops-repo-admin: reading append_only of $REPO failed" >&2
  exit 1
fi
if [ "$append_only" = "1" ]; then
  $BORG config "$REPO" append_only 0
  echo "ops-repo-admin: set append_only=0 on $REPO"
fi
{% endfor %}
