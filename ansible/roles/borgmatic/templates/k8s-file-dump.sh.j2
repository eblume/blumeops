#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Helper invoked by borgmatic's before_backup hook to ferry a *pre-existing*
# backup file out of a k8s pod's PVC. Unlike borgmatic-k8s-sqlite-dump (which
# runs an online dump inside the pod), this assumes the service produces its
# own consistent backup files on a schedule. The ringtail dump endpoint picks
# the lexically-greatest file matching its <glob> (fixed-width timestamps, so
# lexical order == chronological) and streams it to <dump_target>.
#
# Usage:
#   borgmatic-k8s-file-dump <target> <name> <dump_target>
#
# <target> is one of:
#   local:<context>   - unused today (kept as a documented placeholder)
#   ssh:borgmatic@ringtail - ringtail dump endpoint (forced command; only
#                       <name> travels over the wire). The endpoint is
#                       self-contained: a missing or empty export is contained
#                       (rc 0, empty stdout — the previous staged export is
#                       kept), a genuine infra error aborts the nightly.
#
# <name>        - the dump's name in the ringtail endpoint's table
# <dump_target> - file on this host to receive the newest backup
set -euo pipefail

target=${1:?missing target}
name=${2:?missing name}
dump_target=${3:?missing dump target}

mode=${target%%:*}
ref=${target#*:}

case "$mode" in
    local)
        # No consumer uses local mode today; the ringtail endpoint is the
        # only remote. The mode name stays as a documented placeholder.
        echo "borgmatic-k8s-file-dump: local mode is not wired ($name)" >&2
        exit 2
        ;;
    ssh)
        # The ringtail endpoint's key forces `sudo /etc/borgmatic/borgmatic-dump
        # <name>` (nixos/ringtail/configuration.nix), so the only dial over the
        # wire is the dump name — pod coordinates live in the ringtail table.
        # rc 0 with empty stdout means "no export yet" — keep the previous
        # staged file rather than clobbering it.
        tmp="${dump_target}.tmp.$$"
        rc=0
        # accept-new pins ringtail's host key on first contact; BatchMode
        # fails fast instead of prompting in the headless LaunchAgent run.
        ssh -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
            -i "{{ borgmatic_ringtail_ssh_key_path }}" \
            "$ref" "$name" > "$tmp" || rc=$?
        if [[ $rc -ne 0 ]]; then
            rm -f "$tmp"
            echo "borgmatic-k8s-file-dump: $name ferry failed (rc=$rc)" >&2
            exit "$rc"
        fi
        if [[ -s "$tmp" ]]; then
            mv -f "$tmp" "$dump_target"
        else
            rm -f "$tmp"
        fi
        ;;
    *)
        echo "borgmatic-k8s-file-dump: unknown target mode: $mode" >&2
        echo "  expected local:<context> or ssh:borgmatic@ringtail" >&2
        exit 1
        ;;
esac
