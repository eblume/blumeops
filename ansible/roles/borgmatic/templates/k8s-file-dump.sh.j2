#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Helper invoked by borgmatic's before_backup hook to ferry a *pre-existing*
# backup file out of a k8s pod's PVC. Unlike borgmatic-k8s-sqlite-dump (which
# runs an online dump inside the pod), this assumes the service produces its
# own consistent backup files on a schedule — used for navidrome, whose
# minimal nix image has no python3/sqlite3 to dump online but does ship
# coreutils for the in-pod ls/cat. Picks the lexically-greatest file matching
# <glob> (navidrome names backups navidrome.db.<YYYY-MM-DD-HHMMSS>, so lexical
# order == chronological, e.g. navidrome_backup_2026.06.18_14.59.15.db) and
# streams it to <dump_target>.
#
# Usage:
#   borgmatic-k8s-file-dump <target> <namespace> <selector> \
#                           <dir> <glob> <name> <dump_target> [<pvc_name>]
#
# <target> is one of:
#   local:<context>   - run local kubectl with --context=<context>
#   ssh:<user@host>   - ssh to host and run k3s kubectl there
#   pv:<user@host>    - ssh to host, read the local-path PVC's host path
#                       directly (no pod exec) — for short-lived CronJob pods
#                       that are Succeeded by ferry time. Resolves the PVC by
#                       <pvc_name> (8th arg, required for this mode). A
#                       missing or empty export is contained: the previous
#                       staged file is kept and the helper exits 0, so one
#                       dead export can't abort the whole nightly. A genuine
#                       infra error (PVC/PV unresolvable, ssh/k3s down) still
#                       exits non-zero and aborts.
#
# <namespace>   - k8s namespace of the pod (or of the PVC, in pv mode)
# <selector>    - label selector to find the pod (ignored in pv mode)
# <dir>         - directory holding the files. In local/ssh mode the pod path
#                 (e.g. /data/backup). In pv mode a subpath of the PVC root,
#                 exactly as it appears under the pod's mountPath (the PV is
#                 bound at the mountPath, so the pod's /exports/<sub> is on the
#                 host at <pv_path>/<sub> — do NOT repeat the mountPath).
# <glob>        - shell glob the backup filenames match (e.g. 'navidrome.db.*')
# <name>        - short name (diagnostics only)
# <dump_target> - file on this host to receive the newest backup
# <pvc_name>    - PVC name (pv mode only)
set -euo pipefail

target=${1:?missing target}
namespace=${2:?missing namespace}
selector=${3:?missing selector}
dir=${4:?missing dir}
glob=${5:?missing glob}
name=${6:?missing name}
dump_target=${7:?missing dump target}
pvc_name=${8:-}

mode=${target%%:*}
ref=${target#*:}

# Print the newest matching filename in $dir for the given pod, or fail if
# none match. Runs entirely in the local shell context with $kubectl bound to
# the right exec prefix.
pick_and_stream_local() {
    local kubectl=$1
    local pod
    # Only a Running pod: an Evicted/Failed pod lingers as an object and sorts
    # first by name, and `kubectl exec` into it aborts the whole backup
    # (2026-09-18/19: two nights lost to a stale talos pod).
    pod=$($kubectl get pod -l "$selector" --field-selector=status.phase=Running \
        -o jsonpath='{.items[0].metadata.name}')
    local newest=""
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        [[ "$f" == $glob ]] || continue
        [[ "$f" > "$newest" ]] && newest="$f"
    done < <($kubectl exec "$pod" -- ls -1 "$dir")
    if [[ -z "$newest" ]]; then
        echo "borgmatic-k8s-file-dump: no $glob in $dir ($name)" >&2
        exit 1
    fi
    echo "borgmatic-k8s-file-dump: $name -> $newest" >&2
    $kubectl exec "$pod" -- cat "$dir/$newest"
}

case "$mode" in
    local)
        context=$ref
        pick_and_stream_local "/opt/homebrew/bin/kubectl --context=$context -n $namespace" \
            > "$dump_target"
        ;;
    ssh)
        host=$ref
        # Force bash on the remote (login shell on ringtail is fish) and pipe
        # the script via stdin to dodge nested quoting. Diagnostics go to
        # stderr so only the backup bytes reach $dump_target.
        # /etc/rancher/k3s/k3s.yaml is 0600 root:root since ringtail became a
        # multi-user host (a world-readable kubeconfig is cluster-admin any
        # local user could grab). eblume can't read it, so reach the cluster
        # as root via passwordless sudo — root's default k3s kubeconfig is
        # that file. The file stays locked away from the restricted agent user.
        ssh "$host" bash <<EOF > "$dump_target"
set -euo pipefail
pod=\$(sudo k3s kubectl -n "$namespace" get pod -l "$selector" --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}')
newest=""
while IFS= read -r f; do
    [[ -n "\$f" ]] || continue
    [[ "\$f" == $glob ]] || continue
    [[ "\$f" > "\$newest" ]] && newest="\$f"
done < <(sudo k3s kubectl -n "$namespace" exec "\$pod" -- ls -1 "$dir")
if [[ -z "\$newest" ]]; then
    echo "borgmatic-k8s-file-dump: no $glob in $dir ($name)" >&2
    exit 1
fi
echo "borgmatic-k8s-file-dump: $name -> \$newest" >&2
sudo k3s kubectl -n "$namespace" exec "\$pod" -- cat "$dir/\$newest"
EOF
        ;;
    pv)
        # The CronJob pod is Succeeded by ferry time, so pod exec is
        # impossible; read the local-path PVC's host directory directly.
        # Resolve the PV's on-disk path via kubectl (no hard-coded
        # provisioner path). $dir is a subpath of the PVC root (the PV is
        # bound at the pod's mountPath, so the on-host path is $pv_path$dir).
        # A missing/empty export is contained below; an unresolvable PVC/PV or
        # a dead ssh/k3s is a real error and aborts.
        host=$ref
        [[ -n "$pvc_name" ]] || {
            echo "borgmatic-k8s-file-dump: pv mode needs <pvc_name> ($name)" >&2
            exit 2
        }
        tmp="${dump_target}.tmp.$$"
        rc=0
        ssh "$host" bash <<EOF > "$tmp" || rc=$?
set -euo pipefail
pv_name=\$(sudo k3s kubectl -n "$namespace" get pvc "$pvc_name" -o jsonpath='{.spec.volumeName}')
[[ -n "\$pv_name" ]] || { echo "borgmatic-k8s-file-dump: PVC $pvc_name not bound in $namespace ($name)" >&2; exit 1; }
pv_path=\$(sudo k3s kubectl get pv "\$pv_name" -o jsonpath='{.spec.local.path}')
[[ -n "\$pv_path" ]] || { echo "borgmatic-k8s-file-dump: PV \$pv_name has no local.path ($name)" >&2; exit 1; }
[[ -d "\$pv_path" ]] || { echo "borgmatic-k8s-file-dump: PV dir \$pv_path missing on host ($name)" >&2; exit 1; }
newest=""
if [[ -d "\$pv_path$dir" ]]; then
    while IFS= read -r f; do
        [[ -n "\$f" ]] || continue
        [[ "\$f" == $glob ]] || continue
        [[ "\$f" > "\$newest" ]] && newest="\$f"
    done < <(ls -1 "\$pv_path$dir")
fi
if [[ -z "\$newest" ]]; then
    echo "borgmatic-k8s-file-dump: no $glob in \$pv_path$dir yet ($name); keeping previous staged export" >&2
    exit 0
fi
src="\$pv_path$dir/\$newest"
if [[ ! -s "\$src" ]]; then
    echo "borgmatic-k8s-file-dump: newest $glob (\$newest) is empty ($name); keeping previous staged export" >&2
    exit 0
fi
echo "borgmatic-k8s-file-dump: $name -> \$newest (pv:\$pv_path)" >&2
cat "\$src"
EOF
        if [[ $rc -ne 0 ]]; then
            rm -f "$tmp"
            echo "borgmatic-k8s-file-dump: $name ferry failed (rc=$rc)" >&2
            exit "$rc"
        fi
        # rc 0 with a non-empty tmp: a fresh export — replace the staged file.
        # rc 0 with an empty tmp: no/empty export — keep the previous one.
        if [[ -s "$tmp" ]]; then
            mv -f "$tmp" "$dump_target"
        else
            rm -f "$tmp"
        fi
        ;;
    *)
        echo "borgmatic-k8s-file-dump: unknown target mode: $mode" >&2
        echo "  expected local:<context>, ssh:<user@host>, or pv:<user@host>" >&2
        exit 1
        ;;
esac
