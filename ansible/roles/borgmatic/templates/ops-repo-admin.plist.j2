<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }} -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>mcquack.eblume.borgmatic-ops-admin</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>{{ ansible_facts.env.HOME }}/bin/borgmatic-ops-repo-admin</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>{{ borgmatic_log_dir }}/mcquack.borgmatic-ops-admin.err.log</string>
	<key>StandardOutPath</key>
	<string>{{ borgmatic_log_dir }}/mcquack.borgmatic-ops-admin.out.log</string>
</dict>
</plist>
