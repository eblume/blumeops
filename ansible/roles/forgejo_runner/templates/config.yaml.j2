# {{ ansible_managed }}
# Reviewed against {{ forgejo_runner_version }} defaults.
# Ported from argocd/manifests/forgejo-runner/config.yaml (minikube),
# adapted for Docker Desktop instead of a DinD sidecar.
log:
  level: info

runner:
  capacity: {{ forgejo_runner_capacity }}
  timeout: {{ forgejo_runner_timeout }}
  shutdown_timeout: {{ forgejo_runner_timeout }}
  # Env vars injected into all job containers
  envs:
    TZ: America/Los_Angeles

container:
  # "automount": find the docker host (Docker Desktop's socket) and
  # mount it into job containers, with DOCKER_HOST set to match —
  # docker/dagger calls inside jobs hit the host daemon
  # (docker-outside-of-docker; engine containers run as siblings).
  # An explicit socket + options -v mount would duplicate what
  # automount does and fails with "Duplicate mount point".
  docker_host: automount

server:
  connections:
    forgejo:
      url: {{ forgejo_runner_forge_url }}
      uuid: {{ forgejo_runner_uuid }}
      token: {{ forgejo_runner_token }}
      labels:
{% for label in forgejo_runner_labels %}
        - {{ label }}:docker://{{ forgejo_runner_job_image }}
{% endfor %}
