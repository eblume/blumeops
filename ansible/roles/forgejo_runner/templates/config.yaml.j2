# {{ ansible_managed }}
# Reviewed against {{ forgejo_runner_version }} defaults.
#
# Host-mode jobs ([[retire-minikube]] phase 6): jobs run directly as
# erichblume with indri's mise-managed toolchain — no job container,
# no runner-job-image. Docker Desktop stays (right-sized 2cpu/4GiB)
# solely as the dagger engine host; the dagger CLI on the host finds
# its socket at the default /var/run/docker.sock.
log:
  level: info

runner:
  capacity: {{ forgejo_runner_capacity }}
  timeout: {{ forgejo_runner_timeout }}
  shutdown_timeout: {{ forgejo_runner_timeout }}
  # Env vars injected into all jobs
  envs:
    TZ: America/Los_Angeles

server:
  connections:
    forgejo:
      url: {{ forgejo_runner_forge_url }}
      uuid: {{ forgejo_runner_uuid }}
      token: {{ forgejo_runner_token }}
      labels:
{% for label in forgejo_runner_labels %}
        - {{ label }}:host
{% endfor %}
