#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx==0.28.1", "rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="[human] Assert warrant-bot still holds exactly write on blumeops and nothing more (read-only)"
#USAGE flag "--token <token>" help="Forgejo API token; the caller must be admin on eblume/blumeops (default: 1Password)"
#USAGE flag "--skip-if-no-token" help="Exit 0 instead of failing when $FORGE_REPO_WRITE_TOKEN is unset (CI bootstrap)"
"""Verify the blast radius of `warrant-bot` — the identity Warrant dispatches as.

Reads only. Changes nothing, ever. `warrant-bot-provision` is the human
ceremony that *creates* this identity and is deliberately not a workflow;
verifying it hasn't drifted since is the half that belongs in CI, and this is
that half.

What we are defending. Warrant holds a `write:repository` PAT because
`workflow_dispatch` requires write and Forgejo has no dispatch-only
permission. Write on blumeops is therefore the accepted floor, and everything
that keeps it a floor rather than a hole is *external* to Warrant:

  - write and no more — admin would let it edit protections and collaborators
  - blumeops and no other repo — the grant was never meant to generalize
  - not a site admin — which would moot every other check here
  - `main` push/merge whitelisted to eblume alone — the reason "can push
    branches" is not "can ship to production"

Each of those is a thing a human could change in the forge UI in five
seconds, from a different tab, for an unrelated reason. None of them live in
this repo, so nothing else would notice. That is exactly the shape of drift
worth a CI job.

Deliberately NOT checked: the PAT's own scopes. Reading another user's tokens
needs that user's basic auth, and stashing warrant-bot's password anywhere
this job can reach would create a worse hole than the one it audits. Scope is
pinned at mint time in `warrant-bot-provision`; rotation goes through the same
script.

Needs a token whose *user* is admin on eblume/blumeops (collaborator
permissions and branch protections are repo-admin-level reads); the token
*scopes* only need `write:repository,read:user` (the latter for the
site-admin check on /users/warrant-bot) — the CI secret is a narrowly-scoped
eblume PAT, not the admin PAT. Resolution order matches `agent-repo-access` —
see resolve_token there for why it is deliberately narrow.

Usage:
    mise run warrant-bot-drift               # exit 1 on drift
    mise run warrant-bot-drift -- --token X  # explicit credential
"""

import os
import subprocess
from typing import Annotated

import httpx
import typer
from rich.console import Console

# The public host, as warrant-bot-provision uses: it egresses directly from an
# agent pod as well as from indri, so this check is runnable wherever the token
# is. (forge.ops.eblu.me is tailnet-only and needs a SOCKS proxy from a pod.)
FORGE_URL = "https://forge.eblu.me"
BOT_USER = "warrant-bot"
OWNER, REPO = "eblume", "blumeops"
PROTECTED_BRANCH = "main"
EXPECTED_ACCESS = "write"
# Who may push to / merge into main. warrant-bot appearing here would turn its
# dispatch grant into a path to production without review.
EXPECTED_MAIN_WHITELIST = {"eblume"}
OP_TOKEN_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/forge-repo-write-token/token"

console = Console()
err = Console(stderr=True, style="bold red")


def resolve_token(explicit: str | None, skip_if_missing: bool) -> str | None:
    """Only $FORGE_REPO_WRITE_TOKEN, never $FORGEJO_TOKEN — the indri runner is
    host-mode and jobs inherit that session's environment, so a broad fallback
    silently picks up a credential the workflow never passed."""
    if explicit:
        return explicit
    if token := os.environ.get("FORGE_REPO_WRITE_TOKEN"):
        console.print("[dim]Using token from $FORGE_REPO_WRITE_TOKEN[/dim]")
        return token
    if skip_if_missing:
        return None
    console.print("[dim]Reading token from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        err.print(f"Could not read the token from 1Password: {exc}")
        err.print("Pass --token, or set FORGE_REPO_WRITE_TOKEN.")
        raise typer.Exit(1) from exc
    return result.stdout.strip()


class Report:
    """Findings, accumulated. Every check runs even after one fails — a
    partial picture of a permissions boundary invites a second surprise."""

    def __init__(self) -> None:
        self.failures: list[str] = []

    def ok(self, what: str, detail: str = "") -> None:
        console.print(f"[green]ok[/green]       {what}" + (f" [dim]({detail})[/dim]" if detail else ""))

    def fail(self, what: str, detail: str) -> None:
        console.print(f"[red]DRIFT[/red]    {what} — {detail}")
        self.failures.append(f"{what}: {detail}")

    def unknown(self, what: str, detail: str) -> None:
        """Unreadable is a failure, not a pass. A check that cannot see is
        indistinguishable from one that sees nothing wrong."""
        console.print(f"[red]UNKNOWN[/red]  {what} — {detail}")
        self.failures.append(f"{what}: could not verify ({detail})")


def paged(client: httpx.Client, path: str, **params) -> list[dict]:
    out: list[dict] = []
    page = 1
    while True:
        resp = client.get(path, params={"page": page, "limit": 50, **params})
        resp.raise_for_status()
        payload = resp.json()
        batch = payload.get("data", []) if isinstance(payload, dict) else payload
        if not batch:
            return out
        out.extend(batch)
        page += 1


def collaborator_access(client: httpx.Client, owner: str, repo: str, who: str) -> str:
    """`admin` | `write` | `read` | `none` | `unreadable`.

    Two calls, because neither endpoint answers the question alone.

    Membership comes from the collaborator *list*. The effective-permission
    endpoint cannot establish it: on a public repo it reports `read` for
    everyone on the internet, which would make a stranger indistinguishable
    from a grant.

    The level has to come from `/collaborators/{who}/permission`, because list
    entries are plain users — the API returns a `UserList` there, and `User`
    has no permissions field at all. Both endpoints are admin-only reads, so a
    token without admin gets 403 and this reports `unreadable` rather than
    guessing.
    """
    try:
        collaborators = paged(client, f"/api/v1/repos/{owner}/{repo}/collaborators")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    if not any(user["login"].lower() == who.lower() for user in collaborators):
        return "none"
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/collaborators/{who}/permission")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    # Role names, not the boolean flags of a repo `permissions` object:
    # none | read | write | admin | owner.
    match resp.json().get("permission"):
        case "owner" | "admin":
            return "admin"
        case "write" | "read" as level:
            return level
        case _:
            # Listed as a collaborator but reported as having no permission —
            # a contradiction, so claim nothing.
            return "unreadable"


def check_repo_grant(client: httpx.Client, report: Report) -> None:
    access = collaborator_access(client, OWNER, REPO, BOT_USER)
    what = f"{BOT_USER} on {OWNER}/{REPO}"
    if access == "unreadable":
        report.unknown(what, "permissions not readable — is the token admin-scoped?")
    elif access == EXPECTED_ACCESS:
        report.ok(what, EXPECTED_ACCESS)
    elif access == "none":
        # Not a security failure, but Warrant's dispatch is broken and the
        # symptom (403 at dispatch, long after approval) is far from the cause.
        report.fail(what, "no grant at all — dispatch cannot work")
    else:
        report.fail(what, f"expected {EXPECTED_ACCESS}, found {access}")


def check_no_other_repos(client: httpx.Client, report: Report) -> None:
    try:
        repos = [r for r in paged(client, "/api/v1/repos/search") if r["owner"]["login"] == OWNER]
    except httpx.HTTPStatusError as exc:
        report.unknown(f"{BOT_USER} elsewhere in {OWNER}/*", f"repo search failed: {exc}")
        return
    what = f"{BOT_USER} elsewhere in {OWNER}/*"
    strays, blind = [], []
    for repo in repos:
        if repo["name"] == REPO:
            continue
        access = collaborator_access(client, OWNER, repo["name"], BOT_USER)
        if access == "unreadable":
            blind.append(repo["name"])
        elif access != "none":
            strays.append(f"{repo['name']} ({access})")
    if strays:
        report.fail(what, f"also a collaborator on {', '.join(sorted(strays))}")
    elif blind:
        # "I checked N repos and found nothing" is only worth saying if we
        # could actually see all N.
        report.unknown(what, f"{len(blind)} repo(s) unreadable: {', '.join(sorted(blind)[:5])}…")
    else:
        report.ok(what, f"clean across {len(repos) - 1} other repos")


def check_not_site_admin(client: httpx.Client, report: Report) -> None:
    try:
        resp = client.get(f"/api/v1/users/{BOT_USER}")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        report.unknown(f"{BOT_USER} is not a site admin", f"user lookup failed: {exc}")
        return
    user = resp.json()
    if user.get("is_admin"):
        report.fail(f"{BOT_USER} is not a site admin", "IS a site admin — every other check here is moot")
    elif not user.get("is_active", True):
        report.fail(f"{BOT_USER} is not a site admin", "account is deactivated — dispatch cannot work")
    else:
        report.ok(f"{BOT_USER} is not a site admin")


def check_main_protection(client: httpx.Client, report: Report) -> None:
    what = f"{PROTECTED_BRANCH} stays whitelisted to {', '.join(sorted(EXPECTED_MAIN_WHITELIST))}"
    try:
        resp = client.get(f"/api/v1/repos/{OWNER}/{REPO}/branch_protections/{PROTECTED_BRANCH}")
        if resp.status_code == 404:
            report.fail(what, f"no branch protection on {PROTECTED_BRANCH} at all")
            return
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        report.unknown(what, f"branch protection not readable: {exc}")
        return
    rule = resp.json()
    problems = []
    if not rule.get("enable_push_whitelist"):
        problems.append("push whitelist disabled")
    if not rule.get("enable_merge_whitelist"):
        problems.append("merge whitelist disabled")
    for field in ("push_whitelist_usernames", "merge_whitelist_usernames"):
        listed = set(rule.get(field) or [])
        if extra := listed - EXPECTED_MAIN_WHITELIST:
            problems.append(f"{field} also allows {', '.join(sorted(extra))}")
    if rule.get("push_whitelist_deploy_keys"):
        problems.append("deploy keys may push")
    if problems:
        report.fail(what, "; ".join(problems))
    else:
        report.ok(what)


def main(
    token: Annotated[str | None, typer.Option("--token")] = None,
    skip_if_no_token: Annotated[bool, typer.Option("--skip-if-no-token")] = False,
) -> None:
    resolved = resolve_token(token, skip_if_no_token)
    if resolved is None:
        console.print("[yellow]SKIPPED: $FORGE_REPO_WRITE_TOKEN is unset.[/yellow]")
        return

    report = Report()
    with httpx.Client(
        base_url=FORGE_URL,
        headers={"Authorization": f"token {resolved}"},
        timeout=30.0,
    ) as client:
        check_not_site_admin(client, report)
        check_repo_grant(client, report)
        check_no_other_repos(client, report)
        check_main_protection(client, report)

    if report.failures:
        err.print(f"\n{len(report.failures)} finding(s) — warrant-bot's blast radius has drifted:")
        for finding in report.failures:
            err.print(f"  · {finding}")
        err.print(
            "\nReconcile with `mise run warrant-bot-provision --dry-run` (gilbert), or "
            "fix the branch protection in the forge UI. If a change was intended, update "
            "the expectations at the top of this script in the same PR."
        )
        raise typer.Exit(1)
    console.print(f"\n[green]{BOT_USER} is scoped as designed.[/green]")


if __name__ == "__main__":
    typer.run(main)
