#!/usr/bin/env bash
#MISE description="[human] Build indri's darwin configuration on indri (pre-apply check)"

set -euo pipefail

export MISE_TASK_OUTPUT=interleave

# The configuration must be built on indri itself: no off-box host can
# evaluate aarch64-darwin, so the check lives on indri's store - the same
# store the rebuild uses. CI runs the same build on PRs touching
# darwin/indri/; this is the human pre-apply run against the commit
# provision-indri will deploy.
# See [[provision]].
COMMIT=$(git rev-parse HEAD)

# On a branch: the branch tip must equal HEAD. Detached (the B4 rollback
# case: a merged non-tip SHA): the SHA must be an ancestor of origin/main
# - indri cannot check out what forge has not been given (same guard
# shape as provision-indri).
if [[ "$(git rev-parse --abbrev-ref HEAD)" == "HEAD" ]]; then
    if ! git fetch -q origin main; then
        echo "ERROR: cannot reach origin to verify $COMMIT is on main."
        exit 1
    fi

    if ! git merge-base --is-ancestor "$COMMIT" origin/main; then
        echo "ERROR: detached HEAD $COMMIT is not an ancestor of origin/main; indri cannot check out what it has not been given."
        exit 1
    fi
else
    if ! REMOTE_REF=$(git ls-remote origin "$(git rev-parse --abbrev-ref HEAD)" | awk 'NR==1{print $1}'); then
        echo "ERROR: cannot reach origin to verify $COMMIT is pushed."
        exit 1
    fi

    if [[ "$REMOTE_REF" != "$COMMIT" ]]; then
        echo "ERROR: Current commit $COMMIT is not pushed to forge; indri cannot check out what it has not been given."
        echo "Push your changes first: git push"
        exit 1
    fi
fi

# Tailscale SSH on indri exits 0 no matter what the remote did (upstream
# tailscale/tailscale#18256; the fix #20626 is still pending), so ssh's
# rc is meaningless and a failed build would read as success. Verify
# in-band instead: the remote prints a sentinel only after the build
# completes under set -euo pipefail.
OUT=$(mktemp)
trap 'rm -f "$OUT"' EXIT

ssh_rc=0
ssh indri "COMMIT='$COMMIT' bash -s" <<'REMOTE' 2>&1 | tee "$OUT" || ssh_rc=$?
set -euo pipefail
DEST=/tmp/blumeops-indri-flake-check
rm -rf "$DEST"
git clone --quiet https://forge.ops.eblu.me/eblume/blumeops.git "$DEST"
git -C "$DEST" checkout --quiet "$COMMIT"
cd "$DEST/darwin/indri"
nix build .#darwinConfigurations.indri.system
rm -rf "$DEST"
echo "FLAKE-CHECK-OK $COMMIT"
REMOTE

if ! grep -qxF "FLAKE-CHECK-OK $COMMIT" "$OUT"; then
    if [[ $ssh_rc -ne 0 ]]; then
        echo "indri flake check: FAILED - ssh reported rc $ssh_rc (transport failure, or a late disconnect)."
    else
        echo "indri flake check: FAILED - no success sentinel in the remote output for $COMMIT; the build did not complete."
    fi
    exit 1
fi

echo "indri flake check: OK ($COMMIT)"
