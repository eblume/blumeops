#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["rich==15.0.0", "typer==0.27.3"]
# ///
#MISE description="[human] Seed on-host secret files from the vault (ringtail, indri); --check is the vault-free drift gate"
#USAGE arg "<host>" help="ringtail or indri"
#USAGE flag "--check" help="Vault-free: verify every declared file's presence/owner/group/mode and scan the managed dirs for stray files; UNKNOWN fails; exit 1 on any drift"
#USAGE flag "--dry-run" help="Like apply, but write nothing: report would-write / unchanged / would-restart"
#USAGE flag "--only <path>" help="Restrict to the single declared entry at this on-host path (rotation of one item)"
#USAGE flag "--local" help="Check this host in place (no ssh): the weekly host systemd timer runs it as root on the box itself; requires the current hostname to be the target (--check only)"
"""Seed on-host secret files from the vault — the declared-state owner for the
per-host secrets.json manifests (nixos/ringtail/secrets.json,
darwin/indri/secrets.json). The flake invariant in each host's invariants.nix
keeps the manifest in lockstep with the nix config; this task seats the files
the config references by path.

**Human-run on gilbert, by design.** Seating a host secret is a vault read,
and the vault is the boundary this pattern guards. The apply path of the host
config — nixos-rebuild / darwin-rebuild — reads NO vault: it references secret
files by path, which is the property that lets host config merge-apply like
ArgoCD. A CI-run seeder would (a) need a vault credential in CI, which is the
exact thing this pattern removes from the apply path, (b) hand a compromised
workflow a credential that can read every host secret the manifest declares,
and (c) dissolve the human ceremony — the biometric 1Password prompt — that
makes "who ran it" a physical fact. `--check` is the part that belongs in CI:
it touches no vault and fails on anything it cannot verify. `--check --local`
runs the gate in place as root on the guarded box itself, which is what the
weekly systemd timer on ringtail (seed-secrets-check.timer) drives — the CI
runner has no ssh+sudo route back to the host, so the gate lives where it
can see.

Every remote command runs as root through `sudo -n sh -c` (ansible's
`become: true`): the managed directories are 0700 and the ssh login is a
normal user whose login shell (fish) must not parse the command.

Read-back is mandatory on every write: Tailscale SSH on indri returns exit 0
for everything (eblume/blumeops#1379), so an ssh command's status proves
nothing — only the post-write stat + sha256 round-trip does. A metadata
repair is read back the same way, and a restart is confirmed by
`systemctl is-active` output, not its exit code. A write also
creates a missing parent directory (as the entry's owner/group, 0700) and reads
that parent back, so the first seed to a fresh host needs no other actor to
create the dir; a pre-existing parent is never touched.

Stray files in the managed directories are reported, never deleted: a scratch
file is more likely than a leaked secret, and deletion stays a human act — the
same reasoning forge-reconcile gives for not deleting labels.

Generated entries mint once on first seed (32 hex chars, like ansible's
password lookup) and are never rotated: an existing generated file keeps its
content, whatever it is. Minting asks for confirmation and restarts nothing
(a generated entry may not declare `restart`): an absent file on a live host
is far more likely a lost file than a fresh one, and for the k3s token a new
value would not match the one the cluster's bootstrap data is encrypted with
(restore it from /var/lib/rancher/k3s/server/token instead).

The vault value is newline-stripped before use, matching ansible, whose
`command` stdout drops the trailing newline: with no `format` the file holds
the bare value; a `format` substitutes it, so `"TOKEN={value}"` writes
`TOKEN=<v>`, matching ansible's `content: "TOKEN={{ ... }}"` copies.
Neither carries a trailing newline.

Usage:
    mise run seed-secrets ringtail          # apply (gilbert, biometric op)
    mise run seed-secrets ringtail --check  # vault-free drift gate
    mise run seed-secrets ringtail --check --local  # host timer mode (root on the box, no ssh)
    mise run seed-secrets ringtail --dry-run
    mise run seed-secrets ringtail --only /etc/forgejo-runner/priv.env
"""

import hashlib
import json
import re
import secrets
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Annotated, Literal

import typer
from rich.console import Console
from rich.markup import escape
from rich.table import Table

REPO_ROOT = Path(__file__).resolve().parent.parent

# `uname -s` spelling; the remote probe must agree before anything runs.
HostOS = Literal["Linux", "Darwin"]

# host name -> (ssh target, manifest path relative to REPO_ROOT, host OS).
# The ssh target is the tailnet name; both hosts echo it (ansible's `hosts:`
# line). The OS drives restart-name validation and the command flavor.
HOSTS: dict[str, tuple[str, Path, HostOS]] = {
    "ringtail": ("ringtail", Path("nixos/ringtail/secrets.json"), "Linux"),
    "indri": ("indri", Path("darwin/indri/secrets.json"), "Darwin"),
}

KINDS = ("op", "generated")
EMPTY_SHA256 = hashlib.sha256(b"").hexdigest()  # the empty file
MODE_RE = re.compile(r"^0[0-7]{3}$")

console = Console()
err = Console(stderr=True, style="bold red")


class Findings:
    """Accumulates ok/fail/unknown lines; a check that cannot see is a failure."""

    def __init__(self):
        self.failures: list[str] = []

    def ok(self, what):
        console.print(f"[green]ok[/green]       {escape(what)}")

    def fail(self, what, detail):
        console.print(f"[red]failure[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: {detail}")

    def unknown(self, what, detail):
        console.print(f"[red]UNKNOWN[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: could not verify ({detail})")


LABEL_RE = re.compile(r"^[A-Za-z0-9._:-]+$")


def load_manifest(path: Path, os_name: HostOS) -> list[dict]:
    """Validate the manifest and return its entries in order; exit 1 on any
    violation. Restart names are systemd unit names (`*.service`) on linux
    and launchd labels on darwin."""
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        err.print(f"cannot read {path}: {escape(str(exc))}")
        raise typer.Exit(1) from exc
    secrets_list = data.get("secrets") if isinstance(data, dict) else None
    if not isinstance(secrets_list, list):
        err.print(f"{path}: expected a JSON object with a `secrets` list")
        raise typer.Exit(1)
    seen: set[str] = set()
    for i, e in enumerate(secrets_list):
        where = f"{path}: entry {i} ({e.get('path', '<no path>') if isinstance(e, dict) else type(e).__name__})"
        if not isinstance(e, dict):
            err.print(f"{where}: not an object")
            raise typer.Exit(1)
        secret_path = e.get("path")
        if not isinstance(secret_path, str) or not Path(secret_path).is_absolute():
            err.print(f"{where}: `path` must be an absolute string")
            raise typer.Exit(1)
        if secret_path in seen:
            err.print(f"{where}: path declared twice")
            raise typer.Exit(1)
        seen.add(secret_path)
        kind = e.get("kind")
        if kind not in KINDS:
            err.print(f"{where}: `kind` must be one of {', '.join(KINDS)}, got {kind!r}")
            raise typer.Exit(1)
        ref = e.get("ref")
        if kind == "op":
            if not isinstance(ref, str) or not ref.startswith("op://"):
                err.print(f"{where}: kind op requires a `ref` starting with op://")
                raise typer.Exit(1)
        elif ref is not None:
            err.print(f"{where}: kind generated must not carry a `ref`")
            raise typer.Exit(1)
        for field in ("owner", "group", "mode"):
            if not isinstance(e.get(field), str) or not e.get(field):
                err.print(f"{where}: `{field}` must be a non-empty string")
                raise typer.Exit(1)
        if not MODE_RE.match(e["mode"]):
            err.print(f"{where}: `mode` must match ^0[0-7]{{3}}$ (e.g. 0600), got {e['mode']!r}")
            raise typer.Exit(1)
        restart = e.get("restart", [])
        if not isinstance(restart, list) or not all(isinstance(u, str) for u in restart):
            err.print(f"{where}: `restart` must be a list of strings")
            raise typer.Exit(1)
        if kind == "generated" and restart:
            err.print(f"{where}: kind generated must not declare `restart` — a mint restarts nothing (see the docstring)")
            raise typer.Exit(1)
        if os_name == "Linux":
            bad = [u for u in restart if not u.endswith(".service")]
            if bad:
                err.print(f"{where}: linux restart entries must end in `.service`, got {', '.join(map(repr, bad))}")
                raise typer.Exit(1)
        else:
            bad = [u for u in restart if not LABEL_RE.match(u)]
            if bad:
                err.print(f"{where}: darwin restart entries must be launchd labels, got {', '.join(map(repr, bad))}")
                raise typer.Exit(1)
            if restart and e["owner"] == "root":
                err.print(f"{where}: darwin restart entries kick per-user gui domains — the entry `owner` must not be root")
                raise typer.Exit(1)
        fmt = e.get("format")
        if fmt is not None and not isinstance(fmt, str):
            err.print(f"{where}: `format` must be a string")
            raise typer.Exit(1)
        if fmt is not None and "{value}" not in fmt:
            err.print(f"{where}: `format` must contain `{{value}}` (got {fmt!r})")
            raise typer.Exit(1)
    return secrets_list


class Host:
    """One target. Every command runs as root via `sudo -n sh -c` over ssh
    (the managed dirs are 0700; the ssh login is a normal user with a fish
    login shell), or — with `--local` — as `sh -c` in place, which is how
    the root systemd timer on ringtail drives it. Before any command the
    route gate must agree on the host, and `uname -s` must match the declared
    OS, so a host is never driven with the other OS's command flavor. Output
    is parsed, never trusted via exit code: Tailscale SSH on indri returns
    exit 0 for everything (eblume/blumeops#1379), so only a parseable stdout
    proves anything."""

    def __init__(self, target: str, expected_os: HostOS, local: bool = False):
        self.target = target
        self.expected_os: HostOS = expected_os
        self.local = local
        self._os_ok: bool | None = None
        self.probe_reason: str | None = None  # why the route gate failed, for UNKNOWN

    def run(self, cmd: str, input: str | None = None) -> subprocess.CompletedProcess:
        """Run one command as root. ssh mode: `input` rides ssh stdin (never
        argv), so a secret value never appears in a process list or log;
        BatchMode keeps a missing key from hanging on a password prompt, and
        `sudo -n` fails instead of prompting. --local mode: `sh -c` in
        place, no sudo prefix — the timer already runs as root, and a check
        that cannot see is a failure anyway."""
        if self.local:
            try:
                return subprocess.run(
                    ["sh", "-c", cmd],
                    input=input,
                    stdin=subprocess.DEVNULL if input is None else None,
                    capture_output=True,
                    text=True,
                    timeout=180,
                    check=False,
                )
            except subprocess.TimeoutExpired as exc:
                return subprocess.CompletedProcess(
                    ["sh", "-c", cmd], 124, exc.stdout or "", "sh timed out",
                )
        remote = f"sudo -n sh -c {shlex.quote(cmd)}"
        try:
            return subprocess.run(
                ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", self.target, remote],
                input=input,
                stdin=subprocess.DEVNULL if input is None else None,
                capture_output=True,
                text=True,
                timeout=180,
                check=False,
            )
        except subprocess.TimeoutExpired as exc:
            return subprocess.CompletedProcess(
                ["ssh", self.target, remote], 124, exc.stdout or "", "ssh timed out",
            )

    def os(self) -> HostOS | None:
        """Route gate: None when the box cannot be positively identified, and
        `probe_reason` says why. ssh mode: `uname -s` (as root, so sudo is
        proven too) must answer the declared OS. --local mode: one `run()`
        asking for hostname, uid, uname across three lines — the current
        short hostname must be the target, uid must be 0 (root), and uname
        must match the declared OS."""
        if self._os_ok is None:
            self._os_ok, self.probe_reason = self._probe()
        return self.expected_os if self._os_ok else None

    def _probe(self) -> tuple[bool, str | None]:
        """(route-ok, reason-on-failure). One output-parse discipline for
        both modes; the ssh command is unchanged from before --local."""
        if self.local:
            proc = self.run("printf '%s\\n' \"$(hostname)\" \"$(id -u)\" \"$(uname -s)\"")
            fields = proc.stdout.splitlines()
            if len(fields) != 3:
                return False, "route probe produced no output"
            hostname, uid, uname = fields
            if hostname != self.target:
                return False, f"local check on wrong host (hostname {hostname}, expected {self.target})"
            if uid != "0":
                return False, f"local check is not root (id -u {uid})"
            if uname != self.expected_os:
                return False, f"local check on wrong OS ({uname}, expected {self.expected_os})"
            return True, None
        proc = self.run("uname -s")
        if proc.stdout.strip() != self.expected_os:
            return False, f"`sudo -n uname -s` did not answer {self.expected_os}"
        return True, None

    def stat(self, path: str) -> tuple[str, str, str] | None:
        """(owner, group, mode-as-4-octal-digits), or None when uninspectable
        or absent — absence and failure are the same red here."""
        os_name = self.os()
        if os_name is None:
            return None
        if os_name == "Linux":
            cmd = f"stat -c '%U %G %a' {shlex.quote(path)}"
        else:
            cmd = f"stat -f '%Su %Sg %Lp' {shlex.quote(path)}"
        return _parse_stat(self.run(cmd).stdout)

    def parent_state(self, path: str) -> Literal["present", "absent", "unknown"]:
        """A write target's parent dir: `present` (stat parses), `absent`
        (stat's stderr says "No such file" — the only case a write may
        create it, since install -d re-asserts mode/owner on an existing
        dir), or `unknown`. Exit codes are ignored; both answers are read
        from the tool's output."""
        os_name = self.os()
        if os_name is None:
            return "unknown"
        if os_name == "Linux":
            cmd = f"stat -c '%U %G %a' {shlex.quote(path)}"
        else:
            cmd = f"stat -f '%Su %Sg %Lp' {shlex.quote(path)}"
        proc = self.run(cmd)
        if _parse_stat(proc.stdout) is not None:
            return "present"
        if "No such file" in proc.stderr:
            return "absent"
        return "unknown"

    def probe(self, path: str) -> tuple[str, str] | None:
        """Presence probe: ("present", sha256 hex) or ("absent", ""), or None
        when the probe itself is unreliable (connection or permissions).
        Absence is read from the tool's stderr ("No such file"), not its exit
        code — the exit code lies on indri."""
        os_name = self.os()
        if os_name is None:
            return None
        if os_name == "Linux":
            cmd = f"sha256sum {shlex.quote(path)}"
        else:
            cmd = f"shasum -a 256 {shlex.quote(path)}"
        proc = self.run(cmd)
        fields = proc.stdout.split()
        if fields and re.fullmatch(r"[0-9a-f]{64}", fields[0]):
            return "present", fields[0]
        if "No such file" in proc.stderr:
            return "absent", ""
        return None

    def list_files(self, dir_path: str) -> list[str] | None:
        """Base names of the regular files in `dir_path` (dotfiles included);
        None when the directory is absent or unreadable. `ls -p` marks
        directories with a trailing `/`, which is what filters them out. The
        trailing marker line proves the listing ran (exit codes lie)."""
        if self.os() is None:
            return None
        proc = self.run(f"ls -A1p {shlex.quote(dir_path)} && echo __seed_secrets_ls_ok__")
        lines = proc.stdout.splitlines()
        if not lines or lines[-1] != "__seed_secrets_ls_ok__":
            return None
        return [line for line in lines[:-1] if line and not line.endswith("/")]

    def write(self, path: str, owner: str, group: str, mode: str, data: str) -> str | None:
        """Overwrite `path` via a temp file chown'd + chmod'd then mv'd
        remotely, so the final file appears with the right ownership/mode in
        one step. The value rides ssh stdin, never argv. A missing parent
        directory (absence proved from stat's stderr) is created inside the
        same script as the entry's owner/group, 0700, and read back
        afterwards; a pre-existing parent is never touched, and an
        uninspectable one refuses the write. The file itself is proved by read_back. Returns a
        parent-read-back failure reason (or why the write was refused),
        else None. A failed write can leave `<path>.seedtmp` behind,
        holding the value; `--check` reports it as a stray file."""
        if self.os() is None:
            return "route probe failed"
        tmp = f"{path}.seedtmp"
        parent = str(Path(path).parent)
        parent_state = "present" if parent == "/" else self.parent_state(parent)
        if parent_state == "unknown":
            # cannot prove the parent missing, and install -d re-asserts
            # mode/owner on an existing dir — refuse rather than risk it.
            return f"parent directory {parent} is uninspectable — cannot prove it missing before creating"
        cmd = (
            "umask 077 && "
            + (
                f"install -d -m 0700 -o {shlex.quote(owner)} -g {shlex.quote(group)} "
                f"{shlex.quote(parent)} && "
                if parent_state == "absent"
                else ""
            )
            + f"cat > {shlex.quote(tmp)} && "
            f"chown {shlex.quote(owner)}:{shlex.quote(group)} {shlex.quote(tmp)} && "
            f"chmod {shlex.quote(mode)} {shlex.quote(tmp)} && "
            f"mv -f {shlex.quote(tmp)} {shlex.quote(path)}"
        )
        self.run(cmd, input=data)
        if parent_state != "absent":
            return None
        # the created parent is verified the same way the file is: owner and
        # 0700 read back, a wrong-mode parent fails loudly.
        st = self.stat(parent)
        if st is None:
            return f"parent directory {parent} is not present after creation"
        o, _g, m = st
        problems = []
        if o != owner:
            problems.append(f"owner {o}")
        if m != "0700":
            problems.append(f"mode {m}")
        if problems:
            return f"parent directory {parent}: " + "; ".join(problems)
        return None

    def fix_meta(self, path: str, owner: str, group: str, mode: str) -> bool:
        """chown+chmod a file whose content already matches (metadata repair
        when apply sees drifted owner/group/mode). The caller reads back."""
        if self.os() is None:
            return False
        proc = self.run(
            f"chown {shlex.quote(owner)}:{shlex.quote(group)} {shlex.quote(path)} && "
            f"chmod {shlex.quote(mode)} {shlex.quote(path)}"
        )
        return proc.returncode == 0

    def restart(self, units: list[str], owner: str) -> str | None:
        """Restart the declared units and confirm each is active again; returns
        an error string or None. Linux: systemctl restart + is-active output.
        Darwin: the entries are launchd labels kicked in the owner's gui domain
        — the transport runs as root, so the owner must resolve to a non-root
        uid on the host, else the marker is never printed. `kickstart -k` is
        async: the state is re-read after a short retry loop, since the first
        read can be `spawn scheduled`; `running` and `spawn scheduled` are the
        accepted end states (see eblume/blumeops#1379 for why the exit code
        proves nothing)."""
        if self.os() == "Linux":
            for unit in units:
                self.run(f"systemctl restart {shlex.quote(unit)}")
                state = self.run(f"systemctl is-active {shlex.quote(unit)}").stdout.strip()
                if state != "active":
                    return f"{unit} is {state or 'in an unknown state'} after restart"
            return None
        if self.os() == "Darwin":
            for label in units:
                q = shlex.quote(label)
                cmd = (
                    f"uid=$(id -u {shlex.quote(owner)}) && "
                    f'[ "$uid" -ne 0 ] && '
                    f"{{ launchctl kickstart -k gui/$uid/{q} || "
                    f"{{ echo 'seed-secrets state: kickstart-failed'; exit 0; }}; "
                    "for _ in 1 2 3 4 5; do "
                    f'state=$(launchctl print gui/$uid/{q} 2>/dev/null '
                    "| sed -n 's/^[[:space:]]*state = //p' | head -n1); "
                    'case "$state" in ""|waiting|"spawn scheduled") sleep 1;; *) break;; esac; '
                    'done; '
                    'echo "seed-secrets state: ${state:-none}"; }'
                )
                out = self.run(cmd).stdout
                m = re.search(r"seed-secrets state: (.+)", out)
                if m is None:
                    return (
                        f"{label}: no `seed-secrets state:` marker in the output — "
                        f"{owner!r} did not resolve to a non-root user on the host"
                    )
                state = m.group(1)
                if state == "kickstart-failed":
                    return f"{label}: launchctl kickstart failed for {owner!r} — the label may not be loaded in its gui domain"
                if state == "none":
                    return (
                        f"{label}: no `state =` line in the launchctl print output after "
                        "kickstart — the label may not be loaded in the gui domain"
                    )
                if state not in ("running", "spawn scheduled"):
                    return f"{label} reports state {state} after kickstart"
            return None
        return "restart is implemented for Linux and Darwin hosts only"


def _parse_stat(stdout: str) -> tuple[str, str, str] | None:
    """(owner, group, mode as 4-octal-digits) from a stat command's stdout,
    None when it does not parse — absence and failure are the same red."""
    fields = stdout.split()
    if len(fields) != 3 or not re.fullmatch(r"[0-7]{1,4}", fields[2]):
        return None
    return fields[0], fields[1], f"{int(fields[2], 8):04o}"


def op_read(ref: str) -> str:
    """`op read` output (desired_bytes strips its trailing newline). A pod or
    CI runner has no working `op`, so failure here is the expected
    gilbert-only gate."""
    console.print(f"[dim]op read {ref}[/dim]")
    try:
        proc = subprocess.run(
            ["op", "read", ref],
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
            check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        err.print(f"op read failed: {escape(str(exc))} — this task is gilbert-only (biometric `op`)")
        raise typer.Exit(1) from exc
    if proc.returncode != 0:
        err.print(f"op read failed: {escape(proc.stderr.strip())} — this task is gilbert-only (biometric `op`)")
        raise typer.Exit(1)
    return proc.stdout


def desired_bytes(entry: dict, raw: str) -> bytes:
    """The content `entry` wants on disk.

    The value is newline-stripped either way, matching the files ansible
    wrote: its `command` module drops stdout's trailing newline, so
    `content: "{{ _agents_op_token.stdout }}"` wrote the bare value. Without
    `format` the file is that value; with `format="TOKEN={value}"` it is
    `TOKEN=<v>`. Neither carries a trailing newline.
    """
    value = raw.rstrip("\r\n")
    if "format" in entry:
        return entry["format"].format(value=value).encode()
    return value.encode()


def mint() -> str:
    """32 hex chars — what ansible's password lookup (chars=hexdigits,
    length=32) used to mint the k3s token. Minted once on first seed, never
    rotated afterwards."""
    return secrets.token_hex(16)


def read_back(host: Host, path: str, owner: str, group: str, mode: str, digest: str) -> str | None:
    """Verify owner/group/mode + content digest after a write; None when
    verified. Mandatory: Tailscale SSH on indri returns exit 0 for everything
    (eblume/blumeops#1379), so only a parsed read-back proves anything."""
    st = host.stat(path)
    if st is None:
        return "cannot stat after write"
    o, g, m = st
    problems = []
    if o != owner:
        problems.append(f"owner {o}")
    if g != group:
        problems.append(f"group {g}")
    if m != mode:
        problems.append(f"mode {m}")
    if problems:
        return "after-write stat: " + "; ".join(problems)
    p = host.probe(path)
    if p is None or p[0] != "present" or p[1] != digest:
        return "content digest does not match the written value"
    return None


def run_check(host: Host, manifest: Path, entries: list[dict]) -> None:
    findings = Findings()
    # Probe the route first: ssh, passwordless sudo, and the declared OS, read
    # from `uname -s` output (exit codes lie on indri). A check that cannot
    # reach the host is a failure even when the manifest is empty (an empty
    # manifest must not green on a dead route).
    if host.os() is None:
        label = "local route" if host.local else "ssh + sudo route"
        findings.unknown(
            f"{label} to {host.target}",
            host.probe_reason or "route probe failed",
        )
        raise typer.Exit(1)
    for entry in entries:
        path = entry["path"]
        what = f"{path} matches declared owner/group/mode"
        st = host.stat(path)
        if st is None:
            parent = str(Path(path).parent)
            if parent != "/" and host.stat(parent) is None:
                findings.unknown(
                    what,
                    f"parent directory {parent} is missing (or uninspectable) — apply creates missing parents and seats the file",
                )
            else:
                findings.unknown(what, "cannot stat (absent or uninspectable)")
            continue
        owner, group, mode = st
        problems = []
        if owner != entry["owner"]:
            problems.append(f"owner {owner} != {entry['owner']}")
        if group != entry["group"]:
            problems.append(f"group {group} != {entry['group']}")
        if mode != entry["mode"]:
            problems.append(f"mode {mode} != {entry['mode']}")
        probe = host.probe(path)
        if probe is None or probe[0] != "present":
            findings.unknown(what, "stat succeeded but the content probe did not")
            continue
        if probe[1] == EMPTY_SHA256:
            problems.append("file is empty")
        if problems:
            findings.fail(what, "; ".join(problems))
        else:
            findings.ok(what)

    # Stray-file scan: the managed directories are the unique parents of the
    # declared paths. Anything else there is reported, never deleted — a
    # scratch file is more likely than a leak, and deletion stays a human act.
    by_dir: dict[str, set[str]] = {}
    for entry in entries:
        by_dir.setdefault(str(Path(entry["path"]).parent), set()).add(Path(entry["path"]).name)
    for dir_path in sorted(by_dir):
        files = host.list_files(dir_path)
        if files is None:
            findings.unknown(f"stray-file scan of {dir_path}", "cannot list (absent or unreadable)")
            continue
        for name in sorted(set(files) - by_dir[dir_path]):
            findings.fail(
                f"stray file in {dir_path}",
                f"{name} is not declared in {manifest.name} — reported, never deleted (scratch is more likely than a leak; deletion stays a human act)",
            )

    if findings.failures:
        raise typer.Exit(1)
    console.print(f"[green]All {len(entries)} declared secret(s) verified, no stray files.[/green]")


def run_apply(host: Host, manifest: Path, entries: list[dict], dry_run: bool) -> None:
    table = Table(title=f"`seed-secrets` on {host.target} ({manifest.name})")
    table.add_column("Path")
    table.add_column("State")
    table.add_column("Units")
    changed = 0
    unchanged = 0
    failures: list[str] = []
    pending_restarts: dict[tuple[str, str], list[str]] = {}

    def unknown(path: str, why: str) -> None:
        failures.append(f"{path}: {why}")
        table.add_row(escape(path), "[red]UNKNOWN[/red]", "")
        console.print(f"[red]UNKNOWN[/red]  {escape(path)} — {escape(why)}")

    def keep_content(entry: dict, digest: str, label: str) -> None:
        """Content already right: repair drifted owner/group/mode, then read
        the repair back (exit codes prove nothing on indri)."""
        nonlocal changed, unchanged
        path = entry["path"]
        want = (entry["owner"], entry["group"], entry["mode"])
        st = host.stat(path)
        if st is None:
            unknown(path, "cannot stat")
        elif st == want:
            unchanged += 1
            table.add_row(escape(path), f"[dim]{label}[/dim]", "")
        elif dry_run:
            changed += 1
            table.add_row(escape(path), "[yellow]would fix metadata[/yellow]", "")
        else:
            host.fix_meta(path, *want)
            reason = read_back(host, path, *want, digest)
            if reason is not None:
                failures.append(f"{path}: metadata repair: {reason}")
                table.add_row(escape(path), "[red]metadata repair failed[/red]", "")
            else:
                changed += 1
                table.add_row(escape(path), "[green]metadata repaired[/green]", "")

    def seat(entry: dict, desired: bytes, verb: str) -> None:
        """Write (creating + reading back a missing parent dir), read the file back, then queue the declared units for a post-write restart (deduped per (owner, label) below)."""
        nonlocal changed
        path = entry["path"]
        digest = hashlib.sha256(desired).hexdigest()
        perr = host.write(path, entry["owner"], entry["group"], entry["mode"], desired.decode())
        if perr is not None:
            failures.append(f"{path}: parent read-back: {perr}")
            table.add_row(escape(path), "[red]parent read-back failed[/red]", "")
            console.print(f"[red]parent read-back[/red]  {escape(path)} — {escape(perr)}")
            return
        reason = read_back(host, path, entry["owner"], entry["group"], entry["mode"], digest)
        if reason is not None:
            failures.append(f"{path}: read-back: {reason}")
            table.add_row(escape(path), "[red]read-back failed[/red]", "")
            console.print(f"[red]read-back[/red]  {escape(path)} — {escape(reason)}")
            return
        units = entry.get("restart", [])
        for unit in units:
            pending_restarts.setdefault((entry["owner"], unit), []).append(path)
        changed += 1
        table.add_row(escape(path), f"[green]{verb}[/green]", escape(", ".join(units)))
        console.print(f"[green]{verb}[/green]    {escape(path)} (sha256 {escape(digest[:12])}…)")

    for entry in entries:
        path = entry["path"]
        restart_units = entry.get("restart", [])
        runner_note = "would restart " + ", ".join(restart_units) if restart_units else ""

        if entry["kind"] == "op":
            desired = desired_bytes(entry, op_read(entry["ref"]))
            state = host.probe(path)
            if state is None:
                unknown(path, "cannot probe (inspectable neither present nor absent)")
            elif state == ("present", hashlib.sha256(desired).hexdigest()):
                keep_content(entry, state[1], "unchanged")
            elif dry_run:
                changed += 1
                table.add_row(escape(path), "[yellow]would write[/yellow]", escape(runner_note))
            else:
                seat(entry, desired, "wrote")
            continue

        # generated: never rotated. Presence keeps the content (metadata
        # drift is still repaired — a chmod-wrong k3s token is the drill
        # case); absence mints only after the human confirms a fresh host.
        state = host.probe(path)
        if state is None:
            unknown(path, "cannot probe (inspectable neither present nor absent)")
        elif state[0] == "present":
            keep_content(entry, state[1], "unchanged (generated, never rotated)")
        elif dry_run:
            changed += 1
            table.add_row(escape(path), "[yellow]would mint (absent)[/yellow]", "")
        elif not typer.confirm(
            f"{path} is absent on {host.target}. Mint a NEW value? Only on a fresh host — "
            "a lost file on a live host must be restored (k3s: from /var/lib/rancher/k3s/server/token).",
            default=False,
        ):
            failures.append(f"{path}: absent, mint declined")
            table.add_row(escape(path), "[red]absent (mint declined)[/red]", "")
        else:
            seat(entry, desired_bytes(entry, mint()), "minted")

    if not dry_run:
        for (r_owner, r_label), paths in sorted(pending_restarts.items()):
            rerr = host.restart([r_label], r_owner)
            if rerr:
                failures.append(rerr)
                console.print(
                    f"[red]{escape(rerr)}[/red]  {escape(', '.join(sorted(paths)))}"
                )

    console.print(table)
    if failures:
        console.print(f"[red]{len(failures)} failure(s) — not every entry was verified.[/red]")
        raise typer.Exit(1)
    if dry_run:
        console.print(f"[green]Would seed {changed}, unchanged {unchanged}.[/green]")
    else:
        console.print(f"[green]Seeded {changed}, unchanged {unchanged}.[/green]")


def main(
    host: Annotated[str, typer.Argument(help="ringtail or indri")],
    check: Annotated[bool, typer.Option("--check", help="Vault-free verification; exit 1 on any drift")] = False,
    dry_run: Annotated[bool, typer.Option("--dry-run", help="Like apply but write nothing: report would-write / unchanged / would-restart (reads the vault)")] = False,
    only: Annotated[str | None, typer.Option("--only", help="Restrict to the single declared entry at this on-host path")] = None,
    local: Annotated[bool, typer.Option("--local", help="Check this host in place (no ssh): the weekly host systemd timer runs it as root on the box itself; requires the current hostname to be the target")] = False,
) -> None:
    try:
        target, manifest_rel, host_os = HOSTS[host]
    except KeyError:
        err.print(f"unknown host {host!r} — expected one of {', '.join(HOSTS)}")
        raise typer.Exit(1)
    if check and dry_run:
        err.print("--check and --dry-run are mutually exclusive")
        raise typer.Exit(1)
    if local and dry_run:
        err.print("--local and --dry-run are mutually exclusive")
        raise typer.Exit(1)
    if local and not check:
        err.print("--local requires --check: apply stays human-run biometric ssh from gilbert")
        raise typer.Exit(1)
    if not check and not dry_run and not sys.stdin.isatty():
        err.print("Refusing to run non-interactively: apply is human-run (biometric `op`). Use --check (vault-free) or --dry-run.")
        raise typer.Exit(1)

    manifest = REPO_ROOT / manifest_rel
    entries = load_manifest(manifest, host_os)
    if only is not None:
        matches = [e for e in entries if e["path"] == only]
        if len(matches) != 1:
            err.print(f"{only!r} is not a declared path in {manifest} — --only must name exactly one declared entry")
            raise typer.Exit(1)
        entries = matches

    host_obj = Host(target, host_os, local=local)
    if check:
        run_check(host_obj, manifest, entries)
    else:
        run_apply(host_obj, manifest, entries, dry_run)


if __name__ == "__main__":
    typer.run(main)
