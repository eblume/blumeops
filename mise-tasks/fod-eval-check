#MISE description="Run the eval-based FOD check (fod-eval-check/): instantiate every entry point of the blumeops nix trees (ringtail, darwin/indri, all containers), walk and classify every fixed-output derivation — fail-closed. --self-test runs the red/green fixture meta-tests instead"
"""The eval-based FOD check (docs/explanation/talos-v0.5/fod-eval-check.md).

Invariant: nothing downloaded executes inside a FOD. Every entry point of the
blumeops nix trees is instantiated with import-from-derivation disabled (an
IFD becomes an eval error -> red), walked with `nix derivation show -r`, and
every fixed-output/impure derivation is classified against template shapes
evaluated from the same nixpkgs source plus the hand-written catalogue.

Usage:
  mise run fod-eval-check [--repo DIR] [--flake-src REF] [--store PATH]
  mise run fod-eval-check -- --self-test

In CI the default host refs are the plain relative path refs (`./nixos/
ringtail`, `./darwin/indri`, `./containers`). In-pod the worktree is not
libgit2-readable, so pass `--flake-src git+file:///abs/path` pointing at a
git copy of the repo.
"""


import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def main() -> int:
    check = ROOT / "fod-eval-check" / "check.py"
    sys.path.insert(0, str(ROOT / "fod-eval-check"))
    import importlib

    module = importlib.import_module("check")
    return module.main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
