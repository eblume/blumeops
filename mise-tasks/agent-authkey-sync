#!/usr/bin/env bash
#MISE description="Sync the Pulumi tag:agent Tailscale auth key into 1Password (for the agent-pod ExternalSecret)"
#
# Bridges the Pulumi-minted `agent_authkey` (see pulumi/tailscale/__main__.py)
# into a blumeops-vault item that external-secrets pulls into the agent pod's
# (talos) TS_AUTHKEY Secret (the tailscale sidecar can't `op read` for itself). Run after
# `mise run tailnet-up` and on the ~90-day key rotation.
#
# Designed to be CI-portable (see heph 01KYV2MKS3…): no TTY assumption, and the
# secret goes through a stdin template, never argv (/proc/cmdline is world-
# readable on a shared runner).
set -euo pipefail

VAULT="blumeops"
ITEM="agent Tailscale Auth Key"

cd "$(dirname "$0")/../pulumi/tailscale"
KEY="$(pulumi stack output --show-secrets agent_authkey)"
[ -n "$KEY" ] || { echo "empty agent_authkey from pulumi output" >&2; exit 1; }

tmp="$(mktemp)"; trap 'rm -f "$tmp" "$tmp.err" "$tmp.new"' EXIT
if op item get "$ITEM" --vault "$VAULT" --format json > "$tmp" 2> "$tmp.err"; then
  # The probe output IS the item — no second get.
  jq --arg k "$KEY" '(.fields |= map(if .label=="authkey" then .value=$k else . end))' "$tmp" > "$tmp.new"
  op item edit "$ITEM" --vault "$VAULT" --template "$tmp.new" >/dev/null
else
  # A get failure means "missing" only when op says so. Any other error must
  # fail loudly rather than create (eblume/blumeops#963).
  if ! grep -q "isn't an item in the" "$tmp.err"; then
    cat "$tmp.err" >&2
    exit 1
  fi
  # Belt and suspenders: never create when a same-titled item already exists.
  matches=$(op item list --vault "$VAULT" --format json \
    | jq --arg t "$ITEM" '[.[] | select(.title == $t)] | length')
  case "$matches" in
    ''|*[!0-9]*)
      echo "agent-authkey-sync: no usable match count from op item list — refusing to create (eblume/blumeops#963)" >&2
      exit 1
      ;;
  esac
  if [ "$matches" -ne 0 ]; then
    echo "agent-authkey-sync: $matches item(s) titled '$ITEM' exist but get failed — refusing to create (eblume/blumeops#963)" >&2
    exit 1
  fi
  jq -n --arg t "$ITEM" --arg k "$KEY" \
    '{title:$t, category:"API_CREDENTIAL", fields:[{label:"authkey", type:"CONCEALED", value:$k}]}' > "$tmp"
  op item create --vault "$VAULT" --template "$tmp" >/dev/null
fi
echo "Synced tag:agent auth key -> op://$VAULT/$ITEM/authkey"
