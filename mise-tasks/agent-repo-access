#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx==0.28.1", "rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="[human] Reconcile the agents bot's forge collaborations, talos webhooks, and engagement labels against repos.json"
#MISE alias="ara"
#USAGE flag "--dry-run" help="Show what would change without changing it"
#USAGE flag "--check" help="Like --dry-run, but exit 1 if anything is out of sync (for CI on PRs)"
#USAGE flag "--token <token>" help="Forgejo API token; the caller must be admin on the target repos (default: 1Password)"
#USAGE flag "--skip-if-no-token" help="Exit 0 instead of failing when $FORGE_REPO_WRITE_TOKEN is unset (CI bootstrap)"
"""Reconcile which of eblume's repos the `agents` bot may touch.

`argocd/manifests/talos/repos.json` is the single source of truth: it drives
the forge collaborator grants (this script), the talos pod's clone loop
(delivered there as a kustomize-generated ConfigMap whose hashed name rolls
the pod on every policy merge), and — since the issue-driven work cycles —
the per-repo talos webhook (this script again). Before it existed those were
independent manual steps, and a missing grant was invisible — Forgejo answers
404, not 403, for a private repo the caller cannot see, so a repo the bot lacked
access to looked exactly like a typo.

The webhook half: every repo in the pool (pool != "none") gets the forge →
talos hook (the `issues` umbrella event — issue creation, assign, label,
milestone and comment deliveries — + the PR-review events), so "share a repo
with the agent" also wires up its triggers. The hook is identified by its
delivery URL; events and active-state are reconciled in place (the shared
signing secret is only needed at creation — resolved from
$TALOS_FORGE_WEBHOOK_SECRET or 1Password, so a CI apply that must CREATE a
hook fails loudly and asks for a local run from gilbert).

The label half: every pool repo also gets the `agents` engagement label
(named after the collaborator — talos' FORGE_BOT_LABEL defaults to the bot
login). It is joined by the `no-agents` suppression label: while present on
an issue, talos spawns no issue cycles on it (checked on every delivery, so
removing it re-engages). It exists because Forgejo's assignee dropdown only
offers write collaborators, so on the read-only repos (blumeops, agents,
horkos) the bot cannot be assigned from the UI — applying the label is the
way a human engages talos on an issue there. A hook without the label is a
trap: the delivery pipeline works but no click in the UI can fire it (how
horkos#4 sat inert, 2026-08-25). Labels are create-if-missing, matched by
name, and never deleted: deleting a label strips it from every issue
including closed ones (history damage), and a stray label on an off-pool
repo is inert without a hook — so this one part of the reconcile is
deliberately not authoritative.

Labels sit in Forgejo's *issue* scope category, which the narrow CI PAT
(write:repository,read:user) does not carry — it 403s even on label READS
(verified 2026-08-25). So the label half tries the primary token first (in
case the PAT is ever broadened) and falls back to $FORGE_ISSUE_TOKEN or the
blumeops-vault api-token via `op` (the same item mise-tasks/forge-api uses).
In CI neither fallback exists, so the label half is SKIPPED with a loud
yellow warning rather than failing --check forever — label drift is caught
by local runs from gilbert, like hook creation.

RECONCILE IS AUTHORITATIVE. A repo absent from repos.json (or listed with
access "none") has its `agents` collaboration REMOVED, and a talos hook on a
repo outside the pool is removed too. Run --dry-run first.

Two repos are pinned read-only by an invariant this script will not let
repos.json override — see PINNED_READ_ONLY.

The token is resolved:
  1. --token flag (explicit)
  2. $FORGE_REPO_WRITE_TOKEN (for CI) — and ONLY that variable, see resolve_token
  3. 1Password: op read (for local use on gilbert, prompts biometric)
Its *user* must hold admin on the target repos (collaborator management is
repo-admin-level; eblume owns them all), but the token *scope* only needs
`write:repository` — verified empirically 2026-08-22, retiring the older note
here that claimed such a token 403s. That is the whole point of the CI secret:
a narrowly-scoped eblume PAT (write:repository,read:user — the user half is
for warrant-bot-drift, not this script) instead of the all-scopes admin PAT. A token
that can't read collaborators on a *listed* repo is fatal rather than skipped —
see `blocked` — because every call degrades quietly under the wrong credential,
and a partial apply that reports success is worse than a clean failure.

The secret is `FORGE_…`, not `FORGEJO_…`: Forgejo reserves the `FORGEJO_`
prefix for the Actions tokens it injects itself, and rejects creation of a
secret using it with HTTP 400.

Usage:
    mise run agent-repo-access --dry-run    # preview (do this first)
    mise run agent-repo-access              # apply
    mise run agent-repo-access --check      # CI: exit 1 on drift
"""

import json
import os
import subprocess
from pathlib import Path
from typing import Annotated

import httpx
import typer
from rich.console import Console
from rich.table import Table

FORGE_URL = "https://forge.ops.eblu.me"
OP_TOKEN_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/forge-repo-write-token/token"
POLICY_PATH = Path(__file__).resolve().parent.parent / "argocd" / "manifests" / "talos" / "repos.json"

# The forge → talos webhook ([[talos]] §Programmatic API): one hook per pool
# repo, all sharing one delivery URL and one signing secret (talos verifies a
# single FORGE_WEBHOOK_SECRET). Identified by URL — never by id — so a
# hand-created hook with the right URL is adopted, not duplicated.
TALOS_HOOK_URL = "https://talos.ops.eblu.me/api/webhooks/forge"
# The `issues` umbrella covers the whole issue family: Forgejo's write parser
# gates every fine-grained issue flag on "that name OR the literal `issues`
# string" (routers/api/v1/utils/hook.go issuesHook), so one name receives
# issue creation (the auto-engage edge, eblume/blumeops#725), assign, label,
# milestone and comment deliveries; the PR-review events drive PR feedback
# runs.
#
# Two vocabularies because the GET read-back expands the flag set back into
# names (models/webhook/webhook.go EventsArray) — and `pull_request_review` is
# one flag covering the approved/rejected/review-comment trio, reported
# expanded, with `pull_request_review_comment` additionally reported off the
# pull_request_comment flag. Reconcile compares against READ, sends SEND;
# using one set for both either flaps forever or silently drops the review
# events.
TALOS_HOOK_SEND_EVENTS = frozenset(
    {
        "issues",
        "pull_request_comment",
        "pull_request_review",
    }
)
TALOS_HOOK_READ_EVENTS = frozenset(
    {
        "issues",
        "issue_assign",
        "issue_label",
        "issue_milestone",
        "issue_comment",
        "pull_request_comment",
        "pull_request_review_approved",
        "pull_request_review_rejected",
        "pull_request_review_comment",
    }
)
# Item id, not the title: `op read` cannot parse titles containing parens
# ("talos forge webhook (blumeops)").
OP_WEBHOOK_SECRET_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/unrui7ten3ntx4ka6ze2zuknhe/credential"

# The engagement label (see the label half in the module docstring). Color
# matches the hand-created original on blumeops; cosmetic, set only at
# creation.
ENGAGE_LABEL_COLOR = "7c3aed"
ENGAGE_LABEL_DESCRIPTION = "Engage the talos agent on this issue"
# The suppression label (eblume/blumeops#725): while present on an issue,
# talos spawns no issue cycles on it; checked on every delivery, so removing
# it re-engages.
NO_AGENTS_LABEL_NAME = "no-agents"
NO_AGENTS_LABEL_COLOR = "d04a47"
NO_AGENTS_LABEL_DESCRIPTION = "Suppress talos agent cycles on this issue"
# Issue-scoped fallback for the label half — the item forge-api uses.
OP_ISSUE_TOKEN_REF = "op://blumeops/w3663ffnvkewbftncqxtcpeavy/api-token"

# Repos whose read-only-on-canonical status is a security boundary, not a
# preference: the bot must not be able to push to them or run their CI.
#
# blumeops — workflow_dispatch is write-gated, so a read-only bot cannot trigger
#   blumeops CI and therefore cannot reach the deploy-credentialed Actions
#   secrets (ARGOCD_AUTH_TOKEN, FLY_DEPLOY_TOKEN, ZOT_CI_API_KEY,
#   MAIN_PUSH_TOKEN) or, on a privileged runner, the blumeops vault.
# agents  — the repo carrying the agent's own base instructions. Read-only means
#   an agent cannot rewrite what the next session is told to do without a human
#   merging the PR.
# horkos  — the approval gate itself, and its CI carries release secrets
#   (ZOT_CI_API_KEY, RELEASE_FORGE_TOKEN). release.yaml is workflow_dispatch-able
#   and runs the definition from the dispatched ref, so a write bot could dispatch
#   it from a branch with a doctored step and exfiltrate those secrets. Read-only
#   closes that path (and a compromised gate is the worst thing to hand an agent).
#
# All three work via the fork model (origin = agents/<repo>, PRs to canonical),
# so read costs them nothing. This lives in code, NOT in repos.json, on purpose:
# a one-line data edit in a routine-looking PR must not be able to flip a fence.
PINNED_READ_ONLY = frozenset({"blumeops", "agents", "horkos"})

VALID_ACCESS = frozenset({"write", "read", "none"})

console = Console()


def resolve_token(explicit: str | None, skip_if_missing: bool) -> str | None:
    """Resolve the API token, or None if --skip-if-no-token and none is set.

    Deliberately narrow: only $FORGE_REPO_WRITE_TOKEN, never $FORGEJO_TOKEN. The
    indri runner is host-mode (a LaunchAgent running as erichblume), so jobs
    INHERIT that session's environment — an earlier version of this script fell
    back to $FORGEJO_TOKEN and silently picked up a token the workflow never
    passed it. The wrong token then produced a wrong repo list, which surfaced as
    a confusing "these repos do not exist" error rather than "wrong credential".
    Accept exactly the one variable the workflow sets.
    """
    if explicit:
        return explicit
    if token := os.environ.get("FORGE_REPO_WRITE_TOKEN"):
        console.print("[dim]Using token from $FORGE_REPO_WRITE_TOKEN[/dim]")
        return token
    if skip_if_missing:
        return None
    console.print("[dim]Reading token from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(f"[red]Could not read the token from 1Password: {exc}[/red]")
        console.print("Pass --token, or set FORGE_REPO_WRITE_TOKEN.")
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def load_policy() -> tuple[str, str, dict[str, str], dict[str, str]]:
    """Return (owner, collaborator, {repo: access}, {repo: pool}) from repos.json."""
    policy = json.loads(POLICY_PATH.read_text())
    desired: dict[str, str] = {}
    pools: dict[str, str] = {}
    for entry in policy["repos"]:
        name, access = entry["name"], entry["access"]
        if access not in VALID_ACCESS:
            console.print(
                f"[red]{POLICY_PATH.name}: {name} has invalid access {access!r} "
                f"(expected one of {sorted(VALID_ACCESS)})[/red]"
            )
            raise typer.Exit(1)
        if name in PINNED_READ_ONLY and access == "write":
            # Refuse rather than silently downgrade: someone asked for a fence
            # to be flipped and should get told no, loudly.
            console.print(
                f"[red]{POLICY_PATH.name} asks for write on {name!r}, which is "
                f"pinned read-only.[/red] That grant is a security boundary — see "
                f"PINNED_READ_ONLY in {Path(__file__).name}. Refusing."
            )
            raise typer.Exit(1)
        desired[name] = access
        pools[name] = entry.get("pool", "none")
    return policy["owner"], policy["collaborator"], desired, pools


def resolve_webhook_secret() -> str:
    """The shared talos webhook signing secret, needed only to CREATE a hook.

    $TALOS_FORGE_WEBHOOK_SECRET first (nothing provisions it today — it is an
    escape hatch), then 1Password. CI carries neither, so an apply that needs
    to create a hook fails here with instructions rather than creating a hook
    that talos will reject every delivery from.
    """
    if secret := os.environ.get("TALOS_FORGE_WEBHOOK_SECRET"):
        return secret
    console.print("[dim]Reading the talos webhook secret from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_WEBHOOK_SECRET_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(
            f"[red]Could not read the webhook secret from 1Password: {exc}[/red]\n"
            "Creating a hook needs the shared signing secret. Run this from "
            "gilbert (biometric `op`), or set TALOS_FORGE_WEBHOOK_SECRET."
        )
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def talos_hooks(client: httpx.Client, owner: str, repo: str) -> list[dict] | None:
    """This repo's hooks pointing at the talos delivery URL, or None if the
    hook list is unreadable (hook management is repo-admin, like collaborators)."""
    try:
        hooks = paged(client, f"/api/v1/repos/{owner}/{repo}/hooks")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return [h for h in hooks if h.get("config", {}).get("url") == TALOS_HOOK_URL]


def resolve_issue_token() -> str | None:
    """An issue-scoped token for the label half, or None (CI: skip labels).

    $FORGE_ISSUE_TOKEN first (an escape hatch, like TALOS_FORGE_WEBHOOK_SECRET),
    then 1Password. Non-fatal on failure by design — see the module docstring.
    """
    if token := os.environ.get("FORGE_ISSUE_TOKEN"):
        return token
    console.print("[dim]Reading an issue-scoped token from 1Password for the label half…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_ISSUE_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ):
        return None
    return result.stdout.strip()


def has_engage_label(client: httpx.Client, owner: str, repo: str, name: str) -> bool | None:
    """Whether the engagement label exists on this repo, or None if the label
    list is unreadable (unlike hooks, reading labels only needs read access,
    so None here means the token cannot see the repo at all)."""
    try:
        labels = paged(client, f"/api/v1/repos/{owner}/{repo}/labels")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return any(label.get("name", "").lower() == name.lower() for label in labels)


def paged(client: httpx.Client, path: str, **params) -> list[dict]:
    out: list[dict] = []
    page = 1
    while True:
        resp = client.get(path, params={"page": page, "limit": 50, **params})
        resp.raise_for_status()
        payload = resp.json()
        # /repos/search wraps its results in {"ok":…, "data":[…]}; the plain list
        # endpoints return a bare array.
        batch = payload.get("data", []) if isinstance(payload, dict) else payload
        if not batch:
            return out
        out.extend(batch)
        page += 1


def owner_repos(client: httpx.Client, owner: str) -> list[str]:
    """Every repo owned by `owner` that this token can see, private included.

    /repos/search, NOT /users/{owner}/repos (public repos only — that bug made
    every private repo in repos.json look nonexistent) and NOT /user/repos
    (needs the `read:user` scope, which a repo-scoped PAT may not carry).
    """
    found = paged(client, "/api/v1/repos/search")
    return [r["name"] for r in found if r["owner"]["login"] == owner]


def current_access(client: httpx.Client, owner: str, repo: str, who: str) -> str:
    """The collaborator grant on `repo`, or "none".

    Membership comes from the *collaborator list* rather than the
    effective-permission endpoint: on a public repo the latter reports "read"
    for everyone, which would make a non-collaborator indistinguishable from a
    granted one and cause this script to think a grant exists where none does.

    The level then comes from `/collaborators/{who}/permission`, because list
    entries are plain users — the API returns a `UserList` there, and `User`
    carries no permissions field to read a level out of.
    """
    try:
        collaborators = paged(client, f"/api/v1/repos/{owner}/{repo}/collaborators")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    if not any(user["login"].lower() == who.lower() for user in collaborators):
        return "none"
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/collaborators/{who}/permission")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    # Role names, not the boolean flags of a repo `permissions` object:
    # none | read | write | admin | owner.
    match resp.json().get("permission"):
        case "owner" | "admin":
            return "admin"
        case "write" | "read" as level:
            return level
        case _:
            return "unreadable"


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run")] = False,
    check: Annotated[bool, typer.Option("--check")] = False,
    token: Annotated[str | None, typer.Option("--token")] = None,
    skip_if_no_token: Annotated[bool, typer.Option("--skip-if-no-token")] = False,
) -> None:
    owner, who, desired, pools = load_policy()
    preview = dry_run or check

    resolved = resolve_token(token, skip_if_no_token)
    if resolved is None:
        console.print(
            "[yellow]SKIPPED: $FORGE_REPO_WRITE_TOKEN is not set.[/yellow] Provision it with "
            "`mise run provision-indri -- --tags forgejo_actions_secrets`."
        )
        return

    client = httpx.Client(
        base_url=FORGE_URL,
        headers={"Authorization": f"token {resolved}"},
        timeout=30.0,
    )

    with client:
        # Every repo the owner has, not just the listed ones — that is what makes
        # removal possible. A repo carrying a stale `agents` grant only shows up
        # here if we go looking for it.
        try:
            all_repos = owner_repos(client, owner)
        except httpx.HTTPStatusError as exc:
            console.print(f"[red]Could not list {owner}'s repos: {exc}[/red]")
            raise typer.Exit(1) from exc

        unknown = sorted(set(desired) - set(all_repos))
        if unknown:
            console.print(
                f"[red]repos.json lists repos that do not exist under {owner!r} "
                f"(or the token cannot see them): {', '.join(unknown)}[/red]"
            )
            raise typer.Exit(1)

        table = Table(title=f"`{who}` collaborations on {owner}/*")
        table.add_column("Repo")
        table.add_column("Current")
        table.add_column("Desired")
        table.add_column("Action")

        hook_table = Table(title=f"talos webhooks + `{who}` label on {owner}/*")
        hook_table.add_column("Repo")
        hook_table.add_column("Current")
        hook_table.add_column("Desired")
        hook_table.add_column("Action")

        actions: list[tuple[str, str, str]] = []  # (repo, verb, permission)
        # (repo, verb, hook_id) — verb in create|update|remove; remove also
        # covers extra duplicates on a repo that keeps its first hook.
        hook_actions: list[tuple[str, str, int | None]] = []
        label_actions: list[tuple[str, str, str, str]] = []  # (repo, name, color, description)
        label_client: httpx.Client | None = None  # issue-scoped fallback, resolved lazily
        label_skipped = False  # no issue-capable token: warn once, check nothing
        blocked: list[str] = []
        for repo in sorted(all_repos):
            want = desired.get(repo, "none")
            have = current_access(client, owner, repo, who)
            if have == "unreadable":
                # Reading collaborators needs repo-admin permission. On a repo we were TOLD to
                # manage this is fatal: skipping would silently not apply policy
                # while still reporting success. On an unlisted repo it only means
                # we cannot audit it for a stale grant — warn and move on.
                if repo in desired:
                    blocked.append(repo)
                else:
                    console.print(f"[dim]{owner}/{repo}: not readable, not listed — ignoring[/dim]")
                continue

            if have == want:
                verb, style = "ok", "dim"
            elif want == "none":
                verb, style = "revoke", "red"
                actions.append((repo, "revoke", want))
            elif have == "none":
                verb, style = "grant", "green"
                actions.append((repo, "grant", want))
            else:
                verb, style = "update", "yellow"
                actions.append((repo, "update", want))

            if verb != "ok" or want != "none":
                table.add_row(repo, have, want, f"[{style}]{verb}[/{style}]")

            # Webhook half. Desired = one talos hook, exact event set, active,
            # on every pool repo; none anywhere else. Same admin-visibility
            # rules as collaborators, and the same fatal-if-listed logic —
            # collaborator readability was already checked above, so reaching
            # here means the hook list is readable too (both are repo-admin).
            want_hook = pools.get(repo, "none") != "none"
            hooks = talos_hooks(client, owner, repo)
            if hooks is None:
                if repo in desired:
                    blocked.append(repo)
                continue

            if not hooks:
                hook_have = "none"
                if want_hook:
                    hook_verb, hook_style = "create", "green"
                    hook_actions.append((repo, "create", None))
                else:
                    hook_verb, hook_style = "ok", "dim"
            else:
                keeper, extras = hooks[0], hooks[1:]
                in_sync = (
                    set(keeper.get("events") or []) == TALOS_HOOK_READ_EVENTS
                    and keeper.get("active")
                    and not extras
                )
                hook_have = "hook" if in_sync else "drifted"
                if not want_hook:
                    hook_verb, hook_style = "remove", "red"
                    hook_actions.extend((repo, "remove", h["id"]) for h in hooks)
                elif in_sync:
                    hook_verb, hook_style = "ok", "dim"
                else:
                    hook_verb, hook_style = "update", "yellow"
                    hook_actions.append((repo, "update", keeper["id"]))
                    hook_actions.extend((repo, "remove", h["id"]) for h in extras)

            if hook_verb != "ok" or want_hook:
                hook_table.add_row(
                    repo,
                    hook_have,
                    "hook" if want_hook else "none",
                    f"[{hook_style}]{hook_verb}[/{hook_style}]",
                )

            # Label half: pool repos get both issue-scope labels (the `agents`
            # engagement edge and the `no-agents` suppression edge); elsewhere
            # an existing one is left alone (see the module docstring for why
            # this is create-only, and why there is a fallback token).
            if want_hook and not label_skipped:
                label_specs = (
                    (who, f"#{ENGAGE_LABEL_COLOR}", ENGAGE_LABEL_DESCRIPTION),
                    (NO_AGENTS_LABEL_NAME, f"#{NO_AGENTS_LABEL_COLOR}", NO_AGENTS_LABEL_DESCRIPTION),
                )
                missing = []
                for name, color, description in label_specs:
                    labeled = has_engage_label(client, owner, repo, name)
                    if labeled is None and label_client is None:
                        issue_token = resolve_issue_token()
                        if issue_token is None:
                            label_skipped = True
                            console.print(
                                "[yellow]SKIPPED the label half: this token lacks the issue "
                                "scope and no fallback is available (set FORGE_ISSUE_TOKEN, "
                                "or run locally from gilbert for `op`). Label drift is NOT "
                                "being checked.[/yellow]"
                            )
                            break
                        label_client = httpx.Client(
                            base_url=FORGE_URL,
                            headers={"Authorization": f"token {issue_token}"},
                            timeout=30.0,
                        )
                    if labeled is None and label_client is not None:
                        labeled = has_engage_label(label_client, owner, repo, name)
                    if labeled is None:
                        blocked.append(repo)
                        break
                    if not labeled:
                        missing.append((name, color, description))
                for name, color, description in missing:
                    label_actions.append((repo, name, color, description))
                    hook_table.add_row(repo, "no label", "label", "[green]create label[/green]")

        console.print(table)
        console.print(hook_table)

        if blocked:
            console.print(
                f"\n[red]Cannot read collaborators on {len(blocked)} listed repo(s): "
                f"{', '.join(blocked)}[/red]\n"
                f"Collaborator management needs repo-admin permission — this token's user "
                f"is not an admin on them (Forgejo 404s rather than 403s when it cannot see a private "
                f"repo at all, so 'wrong token' and 'no such repo' look identical). "
                f"Refusing to apply a partial policy."
            )
            raise typer.Exit(1)

        if not actions and not hook_actions and not label_actions:
            console.print("[green]In sync.[/green]")
            return

        if preview:
            pending = len(actions) + len(hook_actions) + len(label_actions)
            console.print(f"\n[bold]{pending} change(s) pending.[/bold]")
            for repo, verb, perm in actions:
                console.print(f"  {verb} {owner}/{repo}" + (f" → {perm}" if perm != "none" else ""))
            for repo, verb, _ in hook_actions:
                console.print(f"  {verb} talos hook on {owner}/{repo}")
            for repo, name, _color, _description in label_actions:
                console.print(f"  create `{name}` label on {owner}/{repo}")
            if check:
                console.print("\n[red]Out of sync (--check).[/red]")
                raise typer.Exit(1)
            return

        for repo, verb, perm in actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{who}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {owner}/{repo} failed: {exc}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {owner}/{repo}" + (f" → {perm}" if perm != "none" else ""))

        # The signing secret is fetched once, and only if a create is pending —
        # updates and removals never touch it, so the routine CI applies
        # (events drift, repo leaves the pool) need no secret at all.
        secret = resolve_webhook_secret() if any(v == "create" for _, v, _ in hook_actions) else None
        for repo, verb, hook_id in hook_actions:
            try:
                if verb == "create":
                    client.post(
                        f"/api/v1/repos/{owner}/{repo}/hooks",
                        json={
                            "type": "forgejo",
                            "active": True,
                            "events": sorted(TALOS_HOOK_SEND_EVENTS),
                            "config": {
                                "url": TALOS_HOOK_URL,
                                "content_type": "json",
                                "secret": secret,
                            },
                        },
                    ).raise_for_status()
                elif verb == "update":
                    client.patch(
                        f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}",
                        json={"events": sorted(TALOS_HOOK_SEND_EVENTS), "active": True},
                    ).raise_for_status()
                else:
                    client.delete(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}").raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} talos hook on {owner}/{repo} failed: {exc}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] talos hook on {owner}/{repo}")

        for repo, name, color, description in label_actions:
            try:
                (label_client or client).post(
                    f"/api/v1/repos/{owner}/{repo}/labels",
                    json={
                        "name": name,
                        "color": color,
                        "description": description,
                    },
                ).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(
                    f"[red]create `{name}` label on {owner}/{repo} failed: {exc}[/red]\n"
                    "Label management sits in Forgejo's issue scope — if this was a 403 "
                    "under the CI token (write:repository only), run this task locally "
                    "from gilbert."
                )
                raise typer.Exit(1) from exc
            console.print(f"[green]create[/green] `{name}` label on {owner}/{repo}")

        applied = len(actions) + len(hook_actions) + len(label_actions)
        console.print(f"\n[green]Applied {applied} change(s).[/green]")


if __name__ == "__main__":
    typer.run(main)
