def resolve_token(explicit: str | None, skip_if_missing: bool) -> str | None:
    """Resolve the API token, or None if --skip-if-no-token and none is set.

    Deliberately narrow: only $FORGE_REPO_WRITE_TOKEN, never $FORGEJO_TOKEN. The
    indri runner is host-mode (a LaunchAgent running as erichblume), so jobs
    INHERIT that session's environment — an earlier version of this script fell
    back to $FORGEJO_TOKEN and silently picked up a token the workflow never
    passed it. The wrong token then produced a wrong repo list, which surfaced as
    a confusing "these repos do not exist" error rather than "wrong credential".
    Accept exactly the one variable the workflow sets.
    """
    if explicit:
        return explicit
    if token := os.environ.get("FORGE_REPO_WRITE_TOKEN"):
        console.print("[dim]Using token from $FORGE_REPO_WRITE_TOKEN[/dim]")
        return token
    if skip_if_missing:
        return None
    console.print("[dim]Reading token from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(f"[red]Could not read the token from 1Password: {escape(str(exc))}[/red]")
        console.print("Pass --token, or set FORGE_REPO_WRITE_TOKEN.")
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def load_policy() -> tuple[str, str, dict[str, str], dict[str, str], set[str], set[str], dict[str, dict[str, str]]]:
    """Return (owner, collaborator, {repo: access}, {repo: pool}, release-hook
    repos, horkos-forge repos, {principal: {repo: access}}) from repos.json. The
    last element names the extra read-only fork-model principals: the declared
    set is the top-level `principals` list, and per-repo `principals` entries
    grant access on named repos — a listed principal with no per-repo entry
    reconciles to `none` on every repo, so removing its last entry revokes."""
    policy = json.loads(POLICY_PATH.read_text())
    declared = policy.get("principals", [])
    if not isinstance(declared, list) or not all(isinstance(p, str) for p in declared):
        console.print(
            f"[red]{POLICY_PATH.name}: top-level `principals` must be a list of "
            f"principal names (got {escape(repr(declared))})[/red]"
        )
        raise typer.Exit(1)
    # Case-insensitive on purpose: Forgejo resolves usernames case-insensitively
    # (current_access matches via .lower()); an exact match would let a
    # case-variant slip past this fence.
    seen: set[str] = set()
    for principal in declared:
        if principal.lower() in seen:
            console.print(
                f"[red]{POLICY_PATH.name}: top-level `principals` lists "
                f"{escape(repr(principal))} more than once (case-insensitive). "
                "Refusing.[/red]"
            )
            raise typer.Exit(1)
        if principal.lower() in (policy["collaborator"].lower(), HORKOS_FORGE_USER.lower()):
            console.print(
                f"[red]{POLICY_PATH.name}: `principals` declares "
                f"{escape(repr(principal))}, which is already managed on another axis "
                f"(the primary collaborator or horkos-forge) — double-managing one user "
                f"would let two halves PUT conflicting permissions. Refusing.[/red]"
            )
            raise typer.Exit(1)
        seen.add(principal.lower())
    # Seed every declared principal with an empty mapping: one whose last
    # per-repo entry is removed still reconciles to `none` on every repo, so
    # "remove from repos.json" means "revoke", not "forget this user".
    extra_principals: dict[str, dict[str, str]] = {p: {} for p in declared}
    desired: dict[str, str] = {}
    pools: dict[str, str] = {}
    release_hook_repos: set[str] = set()
    horkos_forge_repos: set[str] = set()
    for entry in policy["repos"]:
        name, access = entry["name"], entry["access"]
        if access not in VALID_ACCESS:
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid access {escape(repr(access))} "
                f"(expected one of {sorted(VALID_ACCESS)})[/red]"
            )
            raise typer.Exit(1)
        if name in PINNED_READ_ONLY and access == "write":
            # Refuse rather than silently downgrade: someone asked for a fence
            # to be flipped and should get told no, loudly.
            console.print(
                f"[red]{POLICY_PATH.name} asks for write on {escape(repr(name))}, which is "
                f"pinned read-only.[/red] That grant is a security boundary — see "
                f"PINNED_READ_ONLY in {Path(__file__).name}. Refusing."
            )
            raise typer.Exit(1)
        release_hook = entry.get("release_hook", False)
        if not isinstance(release_hook, bool):
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid release_hook "
                f"{escape(repr(release_hook))} (expected a boolean)[/red]"
            )
            raise typer.Exit(1)
        if release_hook:
            release_hook_repos.add(name)
        horkos_forge = entry.get("horkos_forge", False)
        if not isinstance(horkos_forge, bool):
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid horkos_forge "
                f"{escape(repr(horkos_forge))} (expected a boolean)[/red]"
            )
            raise typer.Exit(1)
        if horkos_forge:
            horkos_forge_repos.add(name)
        # Values can only be read/none, so the (write-only) PINNED_READ_ONLY
        # and actions-secrets fences hold trivially here.
        principals = entry.get("principals", {})
        if not isinstance(principals, dict):
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid principals "
                f"{escape(repr(principals))} (expected a JSON object)[/red]"
            )
            raise typer.Exit(1)
        for principal, access_level in principals.items():
            if principal not in extra_principals:
                console.print(
                    f"[red]{POLICY_PATH.name}: {escape(name)} declares principal "
                    f"{escape(repr(principal))}, which is not in the top-level "
                    f"`principals` list. A per-repo-only principal would drop out "
                    f"of the reconciler when its last entry is deleted, leaving its "
                    f"live grants unmanaged. Add it to the top-level `principals` "
                    "list. Refusing.[/red]"
                )
                raise typer.Exit(1)
            if access_level not in ("read", "none"):
                console.print(
                    f"[red]{POLICY_PATH.name}: {escape(name)} declares principal "
                    f"{escape(repr(principal))} with {escape(repr(access_level))}; additional "
                    f"principals are read-only, enforced in code — `write` would grant "
                    f"Actions-write on a user-owned repo, the exact thing this arrangement "
                    "must never do. Refusing.[/red]"
                )
                raise typer.Exit(1)
            extra_principals[principal][name] = access_level
        desired[name] = access
        pools[name] = entry.get("pool", "none")
    return policy["owner"], policy["collaborator"], desired, pools, release_hook_repos, horkos_forge_repos, extra_principals


def resolve_webhook_secret() -> str:
    """The shared talos webhook signing secret, needed only to CREATE a hook.

    $TALOS_FORGE_WEBHOOK_SECRET first (nothing provisions it today — it is an
    escape hatch), then 1Password. CI carries neither, so an apply that needs
    to create a hook fails here with instructions rather than creating a hook
    that talos will reject every delivery from.
    """
    if secret := os.environ.get("TALOS_FORGE_WEBHOOK_SECRET"):
        return secret
    console.print("[dim]Reading the talos webhook secret from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_WEBHOOK_SECRET_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(
            f"[red]Could not read the webhook secret from 1Password: {escape(str(exc))}[/red]\n"
            "Creating a hook needs the shared signing secret. Run this from "
            "gilbert (biometric `op`), or set TALOS_FORGE_WEBHOOK_SECRET."
        )
        raise typer.Exit(1) from exc
    return result.stdout.strip()


