def has_engage_label(client: httpx.Client, owner: str, repo: str, name: str) -> bool | None:
    """Whether the engagement label exists on this repo, or None if the label
    list is unreadable (unlike hooks, reading labels only needs read access,
    so None here means the token cannot see the repo at all)."""
    try:
        labels = paged(client, f"/api/v1/repos/{owner}/{repo}/labels")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return any(label.get("name", "").lower() == name.lower() for label in labels)


def paged(client: httpx.Client, path: str, **params) -> list[dict]:
    out: list[dict] = []
    page = 1
    while True:
        resp = client.get(path, params={"page": page, "limit": 50, **params})
        resp.raise_for_status()
        payload = resp.json()
        # /repos/search wraps its results in {"ok":…, "data":[…]}; the plain list
        # endpoints return a bare array.
        batch = payload.get("data", []) if isinstance(payload, dict) else payload
        if not batch:
            return out
        out.extend(batch)
        page += 1


def owner_repos(client: httpx.Client, owner: str) -> list[str]:
    """Every repo owned by `owner` that this token can see, private included.

    /repos/search, NOT /users/{owner}/repos (public repos only — that bug made
    every private repo in repos.json look nonexistent) and NOT /user/repos
    (needs the `read:user` scope, which a repo-scoped PAT may not carry).
    """
    found = paged(client, "/api/v1/repos/search")
    return [r["name"] for r in found if r["owner"]["login"] == owner]


def actions_secrets(client: httpx.Client, owner: str, repo: str) -> list[str] | None:
    """Names of `repo`'s Actions secrets, or None if unreadable.

    403/404 → None follows current_access' convention; other HTTP errors
    re-raise. No pagination: the list is small, and truncation can only
    hide names, never flip a non-empty verdict. Write on a repo is read of
    its secrets — workflows execute at the pushed ref and every run receives
    them — so a non-empty list under a write grant is a violation, not drift."""
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/actions/secrets")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code == 404 and actions_disabled(client, owner, repo):
            # Forgejo 404s the secrets endpoint when the repo's Actions unit
            # is off (myeve, research, timberborn-parsimony blocked every
            # apply that way). No unit, no runs, so a write grant hands the
            # bot no secrets; the next reconcile re-checks if it is turned on.
            return []
        if exc.response.status_code in (403, 404):
            return None
        raise
    # Forgejo serves a bare JSON array here, not GitHub's wrapped shape; a
    # non-list body would read as empty and silently disarm the invariant.
    try:
        body = resp.json()
    except json.JSONDecodeError:
        raise TypeError(
            f"unexpected /actions/secrets body for {owner}/{repo}: invalid JSON"
        ) from None
    if not isinstance(body, list):
        raise TypeError(
            f"unexpected /actions/secrets body for {owner}/{repo}: {type(body).__name__}"
        )
    return [s["name"] for s in body if isinstance(s, dict) and "name" in s]


def actions_disabled(client: httpx.Client, owner: str, repo: str) -> bool:
    """True only when the repo is readable and reports has_actions: false —
    an unreadable repo stays on the fatal `blocked` path."""
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}")
        resp.raise_for_status()
    except httpx.HTTPStatusError:
        return False
    return resp.json().get("has_actions") is False


def current_access(client: httpx.Client, owner: str, repo: str, who: str) -> str:
    """The collaborator grant on `repo`, or "none".

    Membership comes from the *collaborator list* rather than the
    effective-permission endpoint: on a public repo the latter reports "read"
    for everyone, which would make a non-collaborator indistinguishable from a
    granted one and cause this script to think a grant exists where none does.

    The level then comes from `/collaborators/{who}/permission`, because list
    entries are plain users — the API returns a `UserList` there, and `User`
    carries no permissions field to read a level out of.
    """
    try:
        collaborators = paged(client, f"/api/v1/repos/{owner}/{repo}/collaborators")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    if not any(user["login"].lower() == who.lower() for user in collaborators):
        return "none"
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/collaborators/{who}/permission")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    # Role names, not the boolean flags of a repo `permissions` object:
    # none | read | write | admin | owner.
    match resp.json().get("permission"):
        case "owner" | "admin":
            return "admin"
        case "write" | "read" as level:
            return level
        case _:
            return "unreadable"


def violation_line(owner: str, repo: str, secret_names: list[str]) -> str:
    """One violation's message; shared by the --check pending block and the
    apply-mode refusal so both report the same words."""
    return (
        f"actions-secrets: {owner}/{repo} declares write but carries "
        f"{len(secret_names)} Actions secret(s) ({', '.join(secret_names)}) — "
        "write on a repo means read of its Actions secrets; remove the "
        "secret(s) or the write grant"
    )


def load_protections(bots: tuple[str, ...]) -> list[dict]:
    """The declared branch protection rules from PROTECTIONS_PATH.

    Refuses (exit 1) a rule that omits or adds a field, repeats a
    (repo, rule_name), or whitelists a bot — see BOT_WHITELIST_FENCE.
    """
    rules = json.loads(PROTECTIONS_PATH.read_text())["rules"]
    seen: set[tuple[str, str]] = set()
    for rule in rules:
        where = f"{PROTECTIONS_PATH.name}: {rule.get('repo')}:{rule.get('rule_name')}"
        fields = set(rule) - {"repo", "rule_name"}
        if missing := sorted(PROTECTION_FIELDS - fields):
            console.print(f"[red]{escape(where)} does not declare {escape(', '.join(missing))}[/red]")
            raise typer.Exit(1)
        if unknown := sorted(fields - PROTECTION_FIELDS):
            console.print(f"[red]{escape(where)} has unknown field(s) {escape(', '.join(unknown))}[/red]")
            raise typer.Exit(1)
        key = (rule["repo"], rule["rule_name"])
        if key in seen:
            console.print(f"[red]{escape(where)} is declared twice[/red]")
            raise typer.Exit(1)
        seen.add(key)
        for field in BOT_WHITELIST_FENCE:
            if fenced := sorted({u.lower() for u in rule[field]} & {b.lower() for b in bots}):
                console.print(
                    f"[red]{escape(where)} puts {escape(', '.join(fenced))} on {field}.[/red] "
                    f"A bot may never be whitelisted past a branch protection — see "
                    f"BOT_WHITELIST_FENCE in {Path(__file__).name}. Refusing."
                )
                raise typer.Exit(1)
    return rules


def load_tag_protections(bots: tuple[str, ...]) -> list[dict]:
    """The declared tag protection rules from TAG_PROTECTIONS_PATH.

    Refuses (exit 1) a rule that omits or adds a field (name_pattern included
    — the API rejects an empty one), repeats a (repo, name_pattern), leaves
    both whitelists empty (the API rejects that too), or whitelists a bot —
    see TAG_BOT_WHITELIST_FENCE.
    """
    rules = json.loads(TAG_PROTECTIONS_PATH.read_text())["rules"]
    seen: set[tuple[str, str]] = set()
    for rule in rules:
        where = f"{TAG_PROTECTIONS_PATH.name}: {rule.get('repo')}:{rule.get('name_pattern')}"
        fields = set(rule) - {"repo"}
        if missing := sorted(TAG_PROTECTION_FIELDS - fields):
            console.print(f"[red]{escape(where)} does not declare {escape(', '.join(missing))}[/red]")
            raise typer.Exit(1)
        if unknown := sorted(fields - TAG_PROTECTION_FIELDS):
            console.print(f"[red]{escape(where)} has unknown field(s) {escape(', '.join(unknown))}[/red]")
            raise typer.Exit(1)
        key = (rule["repo"], rule["name_pattern"])
        if key in seen:
            console.print(f"[red]{escape(where)} is declared twice[/red]")
            raise typer.Exit(1)
        seen.add(key)
        if not rule["name_pattern"]:
            console.print(f"[red]{escape(where)} has an empty name_pattern — the Forgejo API rejects it[/red]")
            raise typer.Exit(1)
        if not rule["whitelist_usernames"] and not rule["whitelist_teams"]:
            console.print(
                f"[red]{escape(where)} leaves both whitelists empty — the Forgejo API rejects it.[/red] "
                "A tag protection must name who may push the matching tags."
            )
            raise typer.Exit(1)
        for field in TAG_BOT_WHITELIST_FENCE:
            if fenced := sorted({u.lower() for u in rule[field]} & {b.lower() for b in bots}):
                console.print(
                    f"[red]{escape(where)} puts {escape(', '.join(fenced))} on {field}.[/red] "
                    f"A bot may never be whitelisted past a tag protection — see "
                    f"TAG_BOT_WHITELIST_FENCE in {Path(__file__).name}. Refusing."
                )
                raise typer.Exit(1)
    return rules


def protection_diff(live: dict, rule: dict) -> dict[str, tuple[object, object]]:
    """{field: (live value, declared value)} for every PROTECTION_FIELDS
    field that differs. Lists compare as sets — the API does not promise to
    read back whitelists or contexts in the order they were sent."""

    def norm(value: object) -> object:
        return sorted(value) if isinstance(value, list) else value

    return {
        field: (live.get(field), rule[field])
        for field in sorted(PROTECTION_FIELDS)
        if norm(live.get(field)) != norm(rule[field])
    }


