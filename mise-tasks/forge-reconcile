def resolve_token(explicit: str | None, skip_if_missing: bool) -> str | None:
    """Resolve the API token, or None if --skip-if-no-token and none is set.

    Deliberately narrow: only $FORGE_REPO_WRITE_TOKEN, never $FORGEJO_TOKEN. The
    indri runner is host-mode (a LaunchAgent running as erichblume), so jobs
    INHERIT that session's environment — an earlier version of this script fell
    back to $FORGEJO_TOKEN and silently picked up a token the workflow never
    passed it. The wrong token then produced a wrong repo list, which surfaced as
    a confusing "these repos do not exist" error rather than "wrong credential".
    Accept exactly the one variable the workflow sets.
    """
    if explicit:
        return explicit
    if token := os.environ.get("FORGE_REPO_WRITE_TOKEN"):
        console.print("[dim]Using token from $FORGE_REPO_WRITE_TOKEN[/dim]")
        return token
    if skip_if_missing:
        return None
    console.print("[dim]Reading token from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(f"[red]Could not read the token from 1Password: {escape(str(exc))}[/red]")
        console.print("Pass --token, or set FORGE_REPO_WRITE_TOKEN.")
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def load_policy() -> tuple[str, str, dict[str, str], dict[str, str], set[str], set[str]]:
    """Return (owner, collaborator, {repo: access}, {repo: pool}, release-hook
    repos, horkos-forge repos) from repos.json."""
    policy = json.loads(POLICY_PATH.read_text())
    desired: dict[str, str] = {}
    pools: dict[str, str] = {}
    release_hook_repos: set[str] = set()
    horkos_forge_repos: set[str] = set()
    for entry in policy["repos"]:
        name, access = entry["name"], entry["access"]
        if access not in VALID_ACCESS:
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid access {escape(repr(access))} "
                f"(expected one of {sorted(VALID_ACCESS)})[/red]"
            )
            raise typer.Exit(1)
        if name in PINNED_READ_ONLY and access == "write":
            # Refuse rather than silently downgrade: someone asked for a fence
            # to be flipped and should get told no, loudly.
            console.print(
                f"[red]{POLICY_PATH.name} asks for write on {escape(repr(name))}, which is "
                f"pinned read-only.[/red] That grant is a security boundary — see "
                f"PINNED_READ_ONLY in {Path(__file__).name}. Refusing."
            )
            raise typer.Exit(1)
        release_hook = entry.get("release_hook", False)
        if not isinstance(release_hook, bool):
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid release_hook "
                f"{escape(repr(release_hook))} (expected a boolean)[/red]"
            )
            raise typer.Exit(1)
        if release_hook:
            release_hook_repos.add(name)
        horkos_forge = entry.get("horkos_forge", False)
        if not isinstance(horkos_forge, bool):
            console.print(
                f"[red]{POLICY_PATH.name}: {escape(name)} has invalid horkos_forge "
                f"{escape(repr(horkos_forge))} (expected a boolean)[/red]"
            )
            raise typer.Exit(1)
        if horkos_forge:
            horkos_forge_repos.add(name)
        desired[name] = access
        pools[name] = entry.get("pool", "none")
    return policy["owner"], policy["collaborator"], desired, pools, release_hook_repos, horkos_forge_repos


def resolve_webhook_secret() -> str:
    """The shared talos webhook signing secret, needed only to CREATE a hook.

    $TALOS_FORGE_WEBHOOK_SECRET first (nothing provisions it today — it is an
    escape hatch), then 1Password. CI carries neither, so an apply that needs
    to create a hook fails here with instructions rather than creating a hook
    that talos will reject every delivery from.
    """
    if secret := os.environ.get("TALOS_FORGE_WEBHOOK_SECRET"):
        return secret
    console.print("[dim]Reading the talos webhook secret from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_WEBHOOK_SECRET_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(
            f"[red]Could not read the webhook secret from 1Password: {escape(str(exc))}[/red]\n"
            "Creating a hook needs the shared signing secret. Run this from "
            "gilbert (biometric `op`), or set TALOS_FORGE_WEBHOOK_SECRET."
        )
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def resolve_horkos_hook_secret() -> str:
    """The shared forge→horkos release hook signing secret, needed only to
    CREATE a hook. One secret across all release repos — horkos verifies a
    single HORKOS_FORGE_HOOK_SECRET, unlike the per-repo talos secret.

    $HORKOS_FORGE_HOOK_SECRET first (an escape hatch, like the talos one),
    then 1Password (the 'horkos forge webhook' item in the blumeops vault,
    created as the named human step of eblume/horkos#17). CI carries neither,
    so an apply that needs to create a hook fails here with instructions
    rather than creating a hook horkos will reject every delivery from.
    """
    if secret := os.environ.get("HORKOS_FORGE_HOOK_SECRET"):
        return secret
    console.print("[dim]Reading the horkos webhook secret from 1Password…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_HORKOS_WEBHOOK_SECRET_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ) as exc:
        console.print(
            f"[red]Could not read the webhook secret from 1Password: {escape(str(exc))}[/red]\n"
            "Creating a hook needs the shared signing secret. Run this from "
            "gilbert (biometric `op`), or set HORKOS_FORGE_HOOK_SECRET."
        )
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def list_hooks(client: httpx.Client, owner: str, repo: str) -> list[dict] | None:
    """ALL of this repo's hooks, or None if the hook list is unreadable
    (hook management is repo-admin, like collaborators — same 403/404-→-None
    and fatal-if-listed logic). Each webhook kind then filters this list by
    its own delivery URL, so both kinds share one fetch per repo."""
    try:
        hooks = paged(client, f"/api/v1/repos/{owner}/{repo}/hooks")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return hooks


def hook_in_sync(hook: dict, read_events: frozenset[str]) -> bool:
    """One hook, as the API serves it, carries exactly this kind's event set
    (compared as a set — GET read-back order can differ) and is active. Used
    for planning and again as the apply-time read-back, because a Forgejo
    hook edit can answer 200 without applying (see the apply loop)."""
    return set(hook.get("events") or []) == set(read_events) and bool(hook.get("active"))


def hook_kind_state(
    kind_hooks: list[dict],
    read_events: frozenset[str],
    want: bool,
    repo: str,
    kind: str,
    actions: list[tuple[str, str, int | None, str]],
) -> tuple[str, str, str]:
    """One webhook kind's (have, verb, style) from its URL-filtered hook list.

    Shared by the talos and horkos halves: in_sync = exactly one hook whose
    event set matches READ (as a set — GET read-back order can differ),
    active, and no extras; no hooks → create if wanted; drifted → update the
    keeper and remove the extras; hooks present but not wanted → remove them
    all. `want` is the only per-kind input that differs here — everything else
    is data."""
    if not kind_hooks:
        have = "none"
        if want:
            verb = "create"
            actions.append((repo, "create", None, kind))
        else:
            verb = "ok"
    else:
        keeper, extras = kind_hooks[0], kind_hooks[1:]
        in_sync = hook_in_sync(keeper, read_events) and not extras
        have = "hook" if in_sync else "drifted"
        if not want:
            verb = "remove"
            actions.extend((repo, "remove", h["id"], kind) for h in kind_hooks)
        elif in_sync:
            verb = "ok"
        else:
            verb = "update"
            actions.append((repo, "update", keeper["id"], kind))
            actions.extend((repo, "remove", h["id"], kind) for h in extras)
    style = {"create": "green", "remove": "red", "update": "yellow", "ok": "dim"}[verb]
    return have, verb, style


def resolve_issue_token() -> str | None:
    """An issue-scoped token for the label half, or None (CI: skip labels).

    $FORGE_ISSUE_TOKEN first (an escape hatch, like TALOS_FORGE_WEBHOOK_SECRET),
    then 1Password. Non-fatal on failure by design — see the module docstring.
    """
    if token := os.environ.get("FORGE_ISSUE_TOKEN"):
        return token
    console.print("[dim]Reading an issue-scoped token from 1Password for the label half…[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_ISSUE_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,  # op misparses non-TTY stdin
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        FileNotFoundError,
    ):
        return None
    return result.stdout.strip()


def has_engage_label(client: httpx.Client, owner: str, repo: str, name: str) -> bool | None:
    """Whether the engagement label exists on this repo, or None if the label
    list is unreadable (unlike hooks, reading labels only needs read access,
    so None here means the token cannot see the repo at all)."""
    try:
        labels = paged(client, f"/api/v1/repos/{owner}/{repo}/labels")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return any(label.get("name", "").lower() == name.lower() for label in labels)


def paged(client: httpx.Client, path: str, **params) -> list[dict]:
    out: list[dict] = []
    page = 1
    while True:
        resp = client.get(path, params={"page": page, "limit": 50, **params})
        resp.raise_for_status()
        payload = resp.json()
        # /repos/search wraps its results in {"ok":…, "data":[…]}; the plain list
        # endpoints return a bare array.
        batch = payload.get("data", []) if isinstance(payload, dict) else payload
        if not batch:
            return out
        out.extend(batch)
        page += 1


def owner_repos(client: httpx.Client, owner: str) -> list[str]:
    """Every repo owned by `owner` that this token can see, private included.

    /repos/search, NOT /users/{owner}/repos (public repos only — that bug made
    every private repo in repos.json look nonexistent) and NOT /user/repos
    (needs the `read:user` scope, which a repo-scoped PAT may not carry).
    """
    found = paged(client, "/api/v1/repos/search")
    return [r["name"] for r in found if r["owner"]["login"] == owner]


def actions_secrets(client: httpx.Client, owner: str, repo: str) -> list[str] | None:
    """Names of `repo`'s Actions secrets, or None if unreadable.

    403/404 → None follows current_access' convention; other HTTP errors
    re-raise. No pagination: the list is small, and truncation can only
    hide names, never flip a non-empty verdict. Write on a repo is read of
    its secrets — workflows execute at the pushed ref and every run receives
    them — so a non-empty list under a write grant is a violation, not drift."""
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/actions/secrets")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code == 404 and actions_disabled(client, owner, repo):
            # Forgejo 404s the secrets endpoint when the repo's Actions unit
            # is off (myeve, research, timberborn-parsimony blocked every
            # apply that way). No unit, no runs, so a write grant hands the
            # bot no secrets; the next reconcile re-checks if it is turned on.
            return []
        if exc.response.status_code in (403, 404):
            return None
        raise
    # Forgejo serves a bare JSON array here, not GitHub's wrapped shape; a
    # non-list body would read as empty and silently disarm the invariant.
    try:
        body = resp.json()
    except json.JSONDecodeError:
        raise TypeError(
            f"unexpected /actions/secrets body for {owner}/{repo}: invalid JSON"
        ) from None
    if not isinstance(body, list):
        raise TypeError(
            f"unexpected /actions/secrets body for {owner}/{repo}: {type(body).__name__}"
        )
    return [s["name"] for s in body if isinstance(s, dict) and "name" in s]


def actions_disabled(client: httpx.Client, owner: str, repo: str) -> bool:
    """True only when the repo is readable and reports has_actions: false —
    an unreadable repo stays on the fatal `blocked` path."""
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}")
        resp.raise_for_status()
    except httpx.HTTPStatusError:
        return False
    return resp.json().get("has_actions") is False


def current_access(client: httpx.Client, owner: str, repo: str, who: str) -> str:
    """The collaborator grant on `repo`, or "none".

    Membership comes from the *collaborator list* rather than the
    effective-permission endpoint: on a public repo the latter reports "read"
    for everyone, which would make a non-collaborator indistinguishable from a
    granted one and cause this script to think a grant exists where none does.

    The level then comes from `/collaborators/{who}/permission`, because list
    entries are plain users — the API returns a `UserList` there, and `User`
    carries no permissions field to read a level out of.
    """
    try:
        collaborators = paged(client, f"/api/v1/repos/{owner}/{repo}/collaborators")
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    if not any(user["login"].lower() == who.lower() for user in collaborators):
        return "none"
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/collaborators/{who}/permission")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return "unreadable"
        raise
    # Role names, not the boolean flags of a repo `permissions` object:
    # none | read | write | admin | owner.
    match resp.json().get("permission"):
        case "owner" | "admin":
            return "admin"
        case "write" | "read" as level:
            return level
        case _:
            return "unreadable"


def violation_line(owner: str, repo: str, secret_names: list[str]) -> str:
    """One violation's message; shared by the --check pending block and the
    apply-mode refusal so both report the same words."""
    return (
        f"actions-secrets: {owner}/{repo} declares write but carries "
        f"{len(secret_names)} Actions secret(s) ({', '.join(secret_names)}) — "
        "write on a repo means read of its Actions secrets; remove the "
        "secret(s) or the write grant"
    )


def load_protections(bots: tuple[str, ...]) -> list[dict]:
    """The declared branch protection rules from PROTECTIONS_PATH.

    Refuses (exit 1) a rule that omits or adds a field, repeats a
    (repo, rule_name), or whitelists a bot — see BOT_WHITELIST_FENCE.
    """
    rules = json.loads(PROTECTIONS_PATH.read_text())["rules"]
    seen: set[tuple[str, str]] = set()
    for rule in rules:
        where = f"{PROTECTIONS_PATH.name}: {rule.get('repo')}:{rule.get('rule_name')}"
        fields = set(rule) - {"repo", "rule_name"}
        if missing := sorted(PROTECTION_FIELDS - fields):
            console.print(f"[red]{escape(where)} does not declare {escape(', '.join(missing))}[/red]")
            raise typer.Exit(1)
        if unknown := sorted(fields - PROTECTION_FIELDS):
            console.print(f"[red]{escape(where)} has unknown field(s) {escape(', '.join(unknown))}[/red]")
            raise typer.Exit(1)
        key = (rule["repo"], rule["rule_name"])
        if key in seen:
            console.print(f"[red]{escape(where)} is declared twice[/red]")
            raise typer.Exit(1)
        seen.add(key)
        for field in BOT_WHITELIST_FENCE:
            if fenced := sorted({u.lower() for u in rule[field]} & {b.lower() for b in bots}):
                console.print(
                    f"[red]{escape(where)} puts {escape(', '.join(fenced))} on {field}.[/red] "
                    f"A bot may never be whitelisted past a branch protection — see "
                    f"BOT_WHITELIST_FENCE in {Path(__file__).name}. Refusing."
                )
                raise typer.Exit(1)
    return rules


def protection_diff(live: dict, rule: dict) -> dict[str, tuple[object, object]]:
    """{field: (live value, declared value)} for every PROTECTION_FIELDS
    field that differs. Lists compare as sets — the API does not promise to
    read back whitelists or contexts in the order they were sent."""

    def norm(value: object) -> object:
        return sorted(value) if isinstance(value, list) else value

    return {
        field: (live.get(field), rule[field])
        for field in sorted(PROTECTION_FIELDS)
        if norm(live.get(field)) != norm(rule[field])
    }


def list_protections(client: httpx.Client, owner: str, repo: str) -> list[dict] | None:
    """The repo's branch protection rules, or None if unreadable (repo-admin,
    like hooks and collaborators — the same 403/404 → None convention). The
    endpoint is unpaginated in Forgejo v16."""
    try:
        resp = client.get(f"/api/v1/repos/{owner}/{repo}/branch_protections")
        resp.raise_for_status()
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            return None
        raise
    return resp.json()


def show(value: object) -> str:
    """A protection field value for a table cell or a pending line."""
    return ", ".join(value) if isinstance(value, list) else json.dumps(value)



# Invariants folded in from the retired `horkos-forge-drift` tool. `--check` is
# now the single forge drift check (weekly schedule + same-repo PRs), so the
# blast-radius facts horkos-forge-drift asserted live here, checked against the
# live forge on every check. Split two ways: the environment invariants
# (site-admin, blumeops:main whitelist) hold regardless of repos.json, and the
# horkos-forge *grant-set* invariant is keyed by the policy it is checked
# against (head vs base on a PR) — so it is reported as drift, not as a hard
# violation, when a PR is the thing moving the set.
EXPECTED_MAIN_WHITELIST = frozenset({"eblume"})
HORKOS_BLAST_REPO = "blumeops"
HORKOS_BLAST_BRANCH = "main"


class Findings:
    """Accumulates ok/fail/unknown lines; a check that cannot see is a failure."""
    def __init__(self):
        self.failures: list[str] = []
    def ok(self, what):
        console.print(f"[green]ok[/green]       {escape(what)}")
    def fail(self, what, detail):
        console.print(f"[red]invariant[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: {detail}")
    def unknown(self, what, detail):
        console.print(f"[red]UNKNOWN[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: could not verify ({detail})")


def check_site_admin(client, report):
    """`horkos-forge` is not a site admin and is active. A check that cannot see
    is a failure, not a pass — a partial picture of a permissions boundary
    invites a second surprise."""
    try:
        resp = client.get(f"/api/v1/users/{HORKOS_FORGE_USER}")
        resp.raise_for_status()
        user = resp.json()
    except httpx.HTTPStatusError as exc:
        report.unknown("horkos-forge is not a site admin", f"user lookup failed: {exc}")
        return
    if user.get("is_admin"):
        report.fail("horkos-forge is not a site admin", "IS a site admin — every other grant check here is moot")
    elif not user.get("is_active", True):
        report.fail("horkos-forge is not a site admin", "account is deactivated — dispatch cannot work")
    else:
        report.ok("horkos-forge is not a site admin")


def check_main_whitelist(client, owner, report):
    """blumeops:main stays whitelisted to eblume alone — the one repo where a
    shipped commit is production, so "can push branches" must not become "can
    ship to production". This is the live complement of BOT_WHITELIST_FENCE,
    which guards the *declared* rule; here we verify the live rule held."""
    what = f"blumeops:{HORKOS_BLAST_BRANCH} stays whitelisted to eblume alone"
    try:
        rules = list_protections(client, owner, HORKOS_BLAST_REPO)
    except httpx.HTTPStatusError as exc:
        report.unknown(what, f"branch protections not readable: {exc}")
        return
    if rules is None:
        report.unknown(what, "branch protections not readable — is the token admin-scoped?")
        return
    rule = next((r for r in rules if r.get("rule_name") == HORKOS_BLAST_BRANCH), None)
    if rule is None:
        report.fail(what, f"no branch protection on {HORKOS_BLAST_BRANCH} at all")
        return
    problems = []
    if not rule.get("enable_push_whitelist"):
        problems.append("push whitelist disabled")
    if not rule.get("enable_merge_whitelist"):
        problems.append("merge whitelist disabled")
    for field in ("push_whitelist_usernames", "merge_whitelist_usernames"):
        extra = sorted({u for u in (rule.get(field) or [])} - EXPECTED_MAIN_WHITELIST)
        if extra:
            problems.append(f"{field} also allows {', '.join(extra)}")
    if rule.get("push_whitelist_deploy_keys"):
        problems.append("deploy keys may push")
    if problems:
        report.fail(what, "; ".join(problems))
    else:
        report.ok(what)


def git_read_file(ref, relpath):
    """Read a file at a git ref, or None when git is absent or the file is not
    at that ref. Used by --pr-base-ref to read the PR base's declared state."""
    if shutil.which("git") is None:
        return None
    r = subprocess.run(["git", "show", f"{ref}:{relpath}"], capture_output=True, check=False)
    if r.returncode != 0:
        return None
    return r.stdout


def _policies_dict(policy):
    desired, pools = {}, {}
    release_hook_repos, horkos_forge_repos = set(), set()
    for entry in policy["repos"]:
        desired[entry["name"]] = entry["access"]
        pools[entry["name"]] = entry.get("pool", "none")
        if entry.get("release_hook", False):
            release_hook_repos.add(entry["name"])
        if entry.get("horkos_forge", False):
            horkos_forge_repos.add(entry["name"])
    return {"desired": desired, "pools": pools,
            "release_hook_repos": release_hook_repos,
            "horkos_forge_repos": horkos_forge_repos}


def read_policies_at(ref):
    """The repos.json declared state at a git ref (None when unreadable)."""
    raw = git_read_file(ref, "argocd/manifests/talos/repos.json")
    if raw is None:
        return None
    try:
        return _policies_dict(json.loads(raw))
    except json.JSONDecodeError:
        return None


def read_protections_at(ref):
    raw = git_read_file(ref, "forge/branch-protections.json")
    if raw is None:
        return []
    try:
        return json.loads(raw)["rules"]
    except (json.JSONDecodeError, KeyError):
        return []


def plan_at(client, owner, who, policies, protections):
    """Plan the drift of a (policy, protections) pair against the live forge —
    the read-only core of main's planning, factored out so --pr-base-ref can
    plan the PR base's state too. Returns {actions, horkos_actions,
    hook_actions, protection_actions, violations, blocked}."""
    desired = policies["desired"]
    pools = policies["pools"]
    release_hook_repos = policies["release_hook_repos"]
    horkos_forge_repos = policies["horkos_forge_repos"]
    all_repos = owner_repos(client, owner)
    blocked, violations = [], []
    actions, horkos_actions, hook_actions = [], [], []
    for repo in sorted(all_repos):
        want = desired.get(repo, "none")
        have = current_access(client, owner, repo, who)
        horkos_want = "write" if repo in horkos_forge_repos else "none"
        horkos_have = current_access(client, owner, repo, HORKOS_FORGE_USER)
        if have == "unreadable" or horkos_have == "unreadable":
            if repo in desired:
                blocked.append(repo)
            continue
        if have != want:
            verb = "revoke" if want == "none" else ("grant" if have == "none" else "update")
            actions.append((repo, verb, want))
        if horkos_have != horkos_want:
            horkos_actions.append(
                (repo, "revoke" if horkos_want == "none" else ("grant" if horkos_have == "none" else "update"), horkos_want))
        if want == "write":
            secrets = actions_secrets(client, owner, repo)
            if secrets is None and repo not in blocked:
                blocked.append(repo)
            elif secrets:
                violations.append((repo, secrets))
        want_hook = pools.get(repo, "none") != "none"
        want_release_hook = repo in release_hook_repos
        hooks = list_hooks(client, owner, repo)
        if hooks is None:
            if repo in desired and repo not in blocked:
                blocked.append(repo)
            continue
        _, _, _ = hook_kind_state(
            [h for h in hooks if h.get("config", {}).get("url") == TALOS_HOOK_URL],
            TALOS_HOOK_READ_EVENTS, want_hook, repo, "talos", hook_actions)
        _, _, _ = hook_kind_state(
            [h for h in hooks if h.get("config", {}).get("url") == HORKOS_HOOK_URL],
            HORKOS_HOOK_READ_EVENTS, want_release_hook, repo, "horkos", hook_actions)
    protection_actions = []
    for rule in protections:
        repo = rule["repo"]
        live_rules = list_protections(client, owner, repo)
        if live_rules is None:
            blocked.append(repo)
            continue
        live_by_name = {r["rule_name"]: r for r in live_rules}
        live = live_by_name.get(rule["rule_name"])
        if live is None:
            protection_actions.append((repo, rule["rule_name"], "create",
                                       {f: (None, rule[f]) for f in sorted(PROTECTION_FIELDS)}))
        else:
            diff = protection_diff(live, rule)
            if diff:
                protection_actions.append((repo, rule["rule_name"], "update", diff))
    return {"actions": actions, "horkos_actions": horkos_actions, "hook_actions": hook_actions,
            "protection_actions": protection_actions, "violations": violations, "blocked": blocked}


def _changed_facts(base_state, head_state):
    """The set of facts the PR's declared delta changes, keyed so a live-drift
    action can be classified intended vs unexpected by (repo, fact):
      - (repo, "access"), (repo, "horkos"), (repo, "talos-hook"),
        (repo, "release-hook")
      - (repo, "protect", rule_name)
    A base-plan action is INTENDED iff its fact is in this set (the PR is
    landing it), UNEXPECTED otherwise (the PR does not touch it).
    """
    b, h = base_state, head_state
    changed: set[tuple] = set()
    for repo in sorted(set(b["desired"]) | set(h["desired"])):
        if b["desired"].get(repo, "none") != h["desired"].get(repo, "none"):
            changed.add((repo, "access"))
        if (repo in b["horkos_forge_repos"]) != (repo in h["horkos_forge_repos"]):
            changed.add((repo, "horkos"))
        if b["pools"].get(repo, "none") != h["pools"].get(repo, "none"):
            changed.add((repo, "talos-hook"))
        if (repo in b["release_hook_repos"]) != (repo in h["release_hook_repos"]):
            changed.add((repo, "release-hook"))
    for repo, rn in sorted({(r["repo"], r["rule_name"]) for r in b["protections"]}
                           | {(r["repo"], r["rule_name"]) for r in h["protections"]}):
        base_rule = next((r for r in b["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        head_rule = next((r for r in h["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        if base_rule != head_rule:
            changed.add((repo, "protect", rn))
    return changed


def _intended_lines(owner, base_state, head_state):
    """One line per fact the PR's declared delta changes (base -> head), for the
    intended report, split into the auto-applies / hook / protection halves."""
    b, h = base_state, head_state
    auto, hook, prot = [], [], []
    for repo in sorted(set(b["desired"]) | set(h["desired"])):
        if b["desired"].get(repo, "none") != h["desired"].get(repo, "none"):
            auto.append(f"`{owner}/{repo}` agents access: {b['desired'].get(repo,'none')} -> {h['desired'].get(repo,'none')}")
        if (repo in b["horkos_forge_repos"]) != (repo in h["horkos_forge_repos"]):
            auto.append(f"`{owner}/{repo}` horkos-forge write: {'on' if repo in b['horkos_forge_repos'] else 'off'} -> {'on' if repo in h['horkos_forge_repos'] else 'off'}")
        if b["pools"].get(repo, "none") != h["pools"].get(repo, "none"):
            (hook if b["pools"].get(repo, "none") == "none" else auto).append(
                f"`{owner}/{repo}` talos hook pool: {b['pools'].get(repo,'none')} -> {h['pools'].get(repo,'none')}")
        if (repo in b["release_hook_repos"]) != (repo in h["release_hook_repos"]):
            (hook if repo not in b["release_hook_repos"] else auto).append(
                f"`{owner}/{repo}` horkos release hook: {'on' if repo in b['release_hook_repos'] else 'off'} -> {'on' if repo in h['release_hook_repos'] else 'off'}")
    for repo, rn in sorted({(r["repo"], r["rule_name"]) for r in b["protections"]}
                           | {(r["repo"], r["rule_name"]) for r in h["protections"]}):
        base_rule = next((r for r in b["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        head_rule = next((r for r in h["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        if base_rule != head_rule:
            prot.append(f"`{owner}/{repo}` branch protection `{rn}` changed")
    return sorted(set(auto)), sorted(set(hook)), sorted(set(prot))


def report_pr_check(client, owner, who, head_state, base_state, base_plan, pr_base_ref, report_file):
    """PR-check categorization (same-repo PRs only; fork/agent PRs skip to
    --skip-if-no-token before reaching here).

    INTENDED = the PR's declared delta (base -> head): warn only, split into
    auto-applies-on-merge vs the hook/protection halves that need a human run
    after merge. It never fails on its own.

    UNEXPECTED = the live forge's drift vs the PR *base*'s declared state on a
    fact the PR does NOT change (a merged change awaiting a human apply, or
    genuine drift) -> fail. An Actions-secrets violation or an unreadable repo
    also fails.

    Writes the markdown report to report_file (the workflow posts it as a PR
    comment) and fails iff unexpected drift is present.
    """
    changed = _changed_facts(base_state, head_state)
    auto, hook, prot = _intended_lines(owner, base_state, head_state)

    def changed_for(repo, fact, rn=None):
        return ((repo, "protect", rn) if fact == "protect" else (repo, fact)) in changed

    unexpected = []
    for repo, verb, want in base_plan["actions"]:
        if not changed_for(repo, "access"):
            unexpected.append(f"{verb} {owner}/{repo} -> {want}" if want != "none" else f"{verb} {owner}/{repo}")
    for repo, verb, want in base_plan["horkos_actions"]:
        if not changed_for(repo, "horkos"):
            unexpected.append(f"horkos-forge {verb} on {owner}/{repo} -> {want}" if want != "none" else f"horkos-forge {verb} on {owner}/{repo}")
    for repo, verb, _id, kind in base_plan["hook_actions"]:
        if not changed_for(repo, "talos-hook" if kind == "talos" else "release-hook"):
            unexpected.append(f"{verb} {'talos hook' if kind == 'talos' else 'horkos release hook'} on {owner}/{repo}")
    for repo, rn, verb, diff in base_plan["protection_actions"]:
        if not changed_for(repo, "protect", rn):
            unexpected.append(f"{verb} branch protection {owner}/{repo}:{rn} ({'all fields' if verb == 'create' else ', '.join(diff)})")
    for repo, names in base_plan["violations"]:
        unexpected.append(violation_line(owner, repo, names))
    if base_plan["blocked"]:
        unexpected.append(f"unreadable listed repo(s): {', '.join(base_plan['blocked'])}")

    lines = ["**`forge-reconcile` PR check** - forge desired state vs the live forge.", ""]
    if unexpected:
        lines.append(f"### [X] Unexpected drift (live vs `{pr_base_ref}`-declared) - this PR does not intend it")
        lines += [f"- {l}" for l in unexpected] + [""]
        lines.append("_This red is not this PR breaking something: a merged change is awaiting a human apply, or the forge drifted._")
        lines.append("")
    else:
        lines.append("[OK] **No unexpected drift** - the live forge matches main's declared state.")
        lines.append("")
    if auto:
        lines.append("### Intended - auto-applies on merge via the push trigger")
        lines += [f"- {l}" for l in auto] + [""]
    if hook:
        lines.append("### Intended - hook (a human runs `mise run forge-reconcile` from gilbert after merge; the CI token cannot create hooks)")
        lines += [f"- {l}" for l in hook] + [""]
    if prot:
        lines.append("### Intended - branch protection (a human MUST run `mise run forge-reconcile` from gilbert after merge; the CI token cannot apply these)")
        lines += [f"- {l}" for l in prot] + [""]

    # Surface intended drift even when it does not fail the check: a warn-only
    # result (notably a revocation) must still be read, so the workflow posts
    # this file as a PR comment whenever it is written.
    if report_file and (unexpected or auto or hook or prot):
        Path(report_file).write_text("\n".join(lines) + "\n", encoding="utf-8")

    if unexpected:
        console.print("\n[red]PR check: UNEXPECTED drift (this PR does not intend it) - failing.[/red]")
        for l in unexpected:
            console.print(f"  [red]{escape(l)}[/red]")
        raise typer.Exit(1)
    if auto or hook or prot:
        console.print("\n[yellow]PR check: intended drift only - green; it applies on merge (hook/protection halves need the human run).[/yellow]")
    else:
        console.print("\n[green]PR check: in sync, nothing intended.[/green]")


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run")] = False,
    check: Annotated[bool, typer.Option("--check")] = False,
    token: Annotated[str | None, typer.Option("--token")] = None,
    skip_if_no_token: Annotated[bool, typer.Option("--skip-if-no-token")] = False,
    pr_base_ref: Annotated[str | None, typer.Option("--pr-base-ref")] = None,
    report_file: Annotated[str | None, typer.Option("--report-file")] = None,
) -> None:
    owner, who, desired, pools, release_hook_repos, horkos_forge_repos = load_policy()
    protections = load_protections((who, HORKOS_FORGE_USER))
    preview = dry_run or check
    # The CI path: resolve_token takes $FORGE_REPO_WRITE_TOKEN only when no
    # --token is given. Gates the protection half's apply (module docstring).
    ci_token = token is None and bool(os.environ.get("FORGE_REPO_WRITE_TOKEN"))

    resolved = resolve_token(token, skip_if_no_token)
    if resolved is None:
        console.print(
            "[yellow]SKIPPED: $FORGE_REPO_WRITE_TOKEN is not set.[/yellow] Provision it with "
            "`mise run provision-indri -- --tags forgejo_actions_secrets`."
        )
        return

    client = httpx.Client(
        base_url=FORGE_URL,
        headers={"Authorization": f"token {resolved}"},
        timeout=30.0,
    )

    with client:
        # The blast-radius invariants folded in from horkos-forge-drift. They
        # gate only the PR-check path (--pr-base-ref), where a full view of the
        # forge is expected; the plain --check/--dry-run/apply paths keep their
        # existing behavior and reporting.
        env_findings: Findings | None = None
        if pr_base_ref:
            env_findings = Findings()
            check_site_admin(client, env_findings)
            check_main_whitelist(client, owner, env_findings)
            if env_findings.failures:
                raise typer.Exit(1)

        # Every repo the owner has, not just the listed ones — that is what makes
        # removal possible. A repo carrying a stale `agents` grant only shows up
        # here if we go looking for it.
        try:
            all_repos = owner_repos(client, owner)
        except httpx.HTTPStatusError as exc:
            console.print(f"[red]Could not list {escape(owner)}'s repos: {escape(str(exc))}[/red]")
            raise typer.Exit(1) from exc

        unknown = sorted(set(desired) - set(all_repos))
        if unknown:
            console.print(
                f"[red]repos.json lists repos that do not exist under {escape(repr(owner))} "
                f"(or the token cannot see them): {escape(', '.join(unknown))}[/red]"
            )
            raise typer.Exit(1)

        table = Table(title=f"`{escape(who)}` collaborations on {escape(owner)}/*")
        table.add_column("Repo")
        table.add_column("Current")
        table.add_column("Desired")
        table.add_column("Action")

        hook_table = Table(title=f"talos + horkos webhooks and `{escape(who)}` label on {escape(owner)}/*")
        hook_table.add_column("Kind")
        hook_table.add_column("Repo")
        hook_table.add_column("Current")
        hook_table.add_column("Desired")
        hook_table.add_column("Action")

        horkos_table = Table(title=f"`{escape(HORKOS_FORGE_USER)}` collaborations on {escape(owner)}/*")
        horkos_table.add_column("Repo")
        horkos_table.add_column("Current")
        horkos_table.add_column("Desired")
        horkos_table.add_column("Action")

        actions: list[tuple[str, str, str]] = []  # (repo, verb, permission)
        # Same shape as `actions`, but for HORKOS_FORGE_USER and driven by
        # repos.json's horkos_forge flag alone — a different collaborator and
        # a different policy axis (exempt from PINNED_READ_ONLY), so its own
        # list keeps the two reconciles disjoint.
        horkos_actions: list[tuple[str, str, str]] = []  # (repo, verb, permission)
        # (repo, verb, hook_id, kind) — verb in create|update|remove (kind is
        # "talos" or "horkos"); remove also covers extra duplicates on a repo
        # that keeps its first hook.
        hook_actions: list[tuple[str, str, int | None, str]] = []
        label_actions: list[tuple[str, str, str, str]] = []  # (repo, name, color, description)
        label_client: httpx.Client | None = None  # issue-scoped fallback, resolved lazily
        label_skipped = False  # no issue-capable token: warn once, check nothing
        blocked: list[str] = []
        violations: list[tuple[str, list[str]]] = []  # (repo, secret names)
        for repo in sorted(all_repos):
            want = desired.get(repo, "none")
            have = current_access(client, owner, repo, who)
            # horkos-forge half: want follows repos.json's horkos_forge flag and
            # is read against HORKOS_FORGE_USER, not `agents` — the two policies
            # are independent, write on blumeops for horkos-forge is the point
            # (see HORKOS_FORGE_USER), and PINNED_READ_ONLY is an `agents`-desired
            # fence that deliberately does not apply here.
            horkos_want = "write" if repo in horkos_forge_repos else "none"
            horkos_have = current_access(client, owner, repo, HORKOS_FORGE_USER)
            if have == "unreadable" or horkos_have == "unreadable":
                # Reading collaborators needs repo-admin permission. On a repo we were TOLD to
                # manage this is fatal: skipping would silently not apply policy
                # while still reporting success. On an unlisted repo it only means
                # we cannot audit it for a stale grant — warn and move on.
                if repo in desired:
                    blocked.append(repo)
                else:
                    console.print(f"[dim]{escape(owner)}/{escape(repo)}: not readable, not listed — ignoring[/dim]")
                continue

            if have == want:
                verb, style = "ok", "dim"
            elif want == "none":
                verb, style = "revoke", "red"
                actions.append((repo, "revoke", want))
            elif have == "none":
                verb, style = "grant", "green"
                actions.append((repo, "grant", want))
            else:
                verb, style = "update", "yellow"
                actions.append((repo, "update", want))

            if verb != "ok" or want != "none":
                table.add_row(escape(repo), escape(have), escape(want), f"[{style}]{verb}[/{style}]")

            # Same reconcile shape as the `agents` half, against HORKOS_FORGE_USER:
            # want = "write" on horkos_forge-flagged repos, "none" everywhere else
            # (including repos absent from repos.json — stale grants on a repo
            # that left the set are revoked, not left for the drift check).
            if horkos_have == horkos_want:
                horkos_verb, horkos_style = "ok", "dim"
            elif horkos_want == "none":
                horkos_verb, horkos_style = "revoke", "red"
                horkos_actions.append((repo, "revoke", horkos_want))
            elif horkos_have == "none":
                horkos_verb, horkos_style = "grant", "green"
                horkos_actions.append((repo, "grant", horkos_want))
            else:
                horkos_verb, horkos_style = "update", "yellow"
                horkos_actions.append((repo, "update", horkos_want))

            if horkos_verb != "ok" or horkos_want != "none":
                horkos_table.add_row(
                    escape(repo), escape(horkos_have), escape(horkos_want), f"[{horkos_style}]{horkos_verb}[/{horkos_style}]"
                )

            # Actions-secrets invariant: write on a repo is read of its secrets
            # (every run executes at the pushed ref), so a write grant on a
            # secrets-carrying repo is refused — even where have == want.
            if want == "write":
                secrets = actions_secrets(client, owner, repo)
                if secrets is None and repo not in blocked:
                    blocked.append(repo)
                elif secrets:
                    violations.append((repo, secrets))
            # Webhook half. Two kinds, both identified by their own delivery
            # URL — never by id, so a hand-created hook with the right URL is
            # adopted, not duplicated: one talos hook (exact event set,
            # active) on every pool repo, and one horkos release hook (push +
            # create + pull_request) on every repo with release_hook: true;
            # none anywhere
            # else. Same admin-visibility rules as collaborators, and the
            # same fatal-if-listed logic — collaborator readability was
            # already checked above, so reaching here means the hook list is
            # readable too (both are repo-admin). Both kinds derive from ONE
            # hook list fetched per repo.
            want_hook = pools.get(repo, "none") != "none"
            want_release_hook = repo in release_hook_repos
            hooks = list_hooks(client, owner, repo)
            if hooks is None:
                if repo in desired and repo not in blocked:
                    blocked.append(repo)
                continue

            hook_have, hook_verb, hook_style = hook_kind_state(
                [h for h in hooks if h.get("config", {}).get("url") == TALOS_HOOK_URL],
                TALOS_HOOK_READ_EVENTS,
                want_hook,
                repo,
                "talos",
                hook_actions,
            )
            release_have, release_verb, release_style = hook_kind_state(
                [h for h in hooks if h.get("config", {}).get("url") == HORKOS_HOOK_URL],
                HORKOS_HOOK_READ_EVENTS,
                want_release_hook,
                repo,
                "horkos",
                hook_actions,
            )

            if hook_verb != "ok" or want_hook:
                hook_table.add_row(
                    "talos",
                    escape(repo),
                    escape(hook_have),
                    "hook" if want_hook else "none",
                    f"[{hook_style}]{hook_verb}[/{hook_style}]",
                )
            if release_verb != "ok" or want_release_hook:
                hook_table.add_row(
                    "horkos",
                    escape(repo),
                    escape(release_have),
                    "hook" if want_release_hook else "none",
                    f"[{release_style}]{release_verb}[/{release_style}]",
                )

            # Label half: pool repos get all three issue-scope labels (the
            # `agents` engagement edge, the `no-agents` suppression edge, and
            # the `needs-proper-review` review edge); elsewhere an existing
            # one is left alone (see the module docstring for why this is
            # create-only, and why there is a fallback token).
            if want_hook and not label_skipped:
                label_specs = (
                    (who, f"#{ENGAGE_LABEL_COLOR}", ENGAGE_LABEL_DESCRIPTION),
                    (NO_AGENTS_LABEL_NAME, f"#{NO_AGENTS_LABEL_COLOR}", NO_AGENTS_LABEL_DESCRIPTION),
                    (NEEDS_REVIEW_LABEL_NAME, f"#{NEEDS_REVIEW_LABEL_COLOR}", NEEDS_REVIEW_LABEL_DESCRIPTION),
                )
                missing = []
                for name, color, description in label_specs:
                    labeled = has_engage_label(client, owner, repo, name)
                    if labeled is None and label_client is None:
                        issue_token = resolve_issue_token()
                        if issue_token is None:
                            label_skipped = True
                            console.print(
                                "[yellow]SKIPPED the label half: this token lacks the issue "
                                "scope and no fallback is available (set FORGE_ISSUE_TOKEN, "
                                "or run locally from gilbert for `op`). Label drift is NOT "
                                "being checked.[/yellow]"
                            )
                            break
                        label_client = httpx.Client(
                            base_url=FORGE_URL,
                            headers={"Authorization": f"token {issue_token}"},
                            timeout=30.0,
                        )
                    if labeled is None and label_client is not None:
                        labeled = has_engage_label(label_client, owner, repo, name)
                    if labeled is None:
                        if repo not in blocked:
                            blocked.append(repo)
                        break
                    if not labeled:
                        missing.append((name, color, description))
                for name, color, description in missing:
                    label_actions.append((repo, name, color, description))
                    hook_table.add_row("label", escape(repo), "no label", "label", "[green]create label[/green]")

        # Branch-protection half: one rule list per declared repo, matched by
        # rule_name. (repo, rule_name, verb, {field: (have, want)}) — verb is
        # create (diff is every field, have None) or update.
        protection_table = Table(title=f"branch protections on {escape(owner)}/*")
        protection_table.add_column("Rule")
        protection_table.add_column("Field")
        protection_table.add_column("Current")
        protection_table.add_column("Desired")
        protection_table.add_column("Action")
        protection_actions: list[tuple[str, str, str, dict[str, tuple[object, object]]]] = []
        if missing_repos := sorted({r["repo"] for r in protections} - set(all_repos)):
            console.print(
                f"[red]{PROTECTIONS_PATH.name} names repos that do not exist under {escape(repr(owner))} "
                f"(or the token cannot see them): {escape(', '.join(missing_repos))}[/red]"
            )
            raise typer.Exit(1)
        for repo in sorted({r["repo"] for r in protections}):
            live_rules = list_protections(client, owner, repo)
            if live_rules is None:
                if repo not in blocked:
                    blocked.append(repo)
                continue
            live_by_name = {r["rule_name"]: r for r in live_rules}
            declared = [r for r in protections if r["repo"] == repo]
            for rule in declared:
                name = f"{repo}:{rule['rule_name']}"
                live = live_by_name.get(rule["rule_name"])
                if live is None:
                    diff = {f: (None, rule[f]) for f in sorted(PROTECTION_FIELDS)}
                    protection_actions.append((repo, rule["rule_name"], "create", diff))
                    protection_table.add_row(escape(name), "(rule)", "none", "rule", "[green]create[/green]")
                    continue
                diff = protection_diff(live, rule)
                if not diff:
                    protection_table.add_row(escape(name), "", "", "", "[dim]ok[/dim]")
                    continue
                protection_actions.append((repo, rule["rule_name"], "update", diff))
                for field, (have, want) in diff.items():
                    protection_table.add_row(
                        escape(name), field, escape(show(have)), escape(show(want)), "[yellow]update[/yellow]"
                    )
            for extra in sorted(set(live_by_name) - {r["rule_name"] for r in declared}):
                console.print(
                    f"[yellow]{escape(owner)}/{escape(repo)} has branch protection {escape(repr(extra))} "
                    f"not in {PROTECTIONS_PATH.name} — left alone (declare it to manage it)[/yellow]"
                )

        console.print(table)
        console.print(hook_table)
        console.print(horkos_table)
        console.print(protection_table)

        if blocked:
            console.print(
                f"\n[red]Cannot read collaborators or Actions secrets on {len(blocked)} listed repo(s): "
                f"{escape(', '.join(blocked))}[/red]\n"
                f"Both need repo-admin permission — this token's user "
                f"is not an admin on them (Forgejo 404s rather than 403s when it cannot see a private "
                f"repo at all, so 'wrong token' and 'no such repo' look identical). "
                f"Refusing to apply a partial policy."
            )
            raise typer.Exit(1)

        if violations and not preview:
            # Refuse the whole apply, not just one repo: granting write would
            # hand the bot that repo's CI keys — there is no partial policy here.
            console.print(
                f"\n[red]Refusing to apply: {len(violations)} repo(s) declare write but carry "
                f"Actions secret(s).[/red]"
            )
            for repo, secret_names in violations:
                console.print(
                    f"[red]  {violation_line(escape(owner), escape(repo), [escape(n) for n in secret_names])}[/red]"
                )
            raise typer.Exit(1)

        if (
            not actions
            and not horkos_actions
            and not hook_actions
            and not label_actions
            and not protection_actions
            and not violations
        ):
            console.print("[green]In sync.[/green]")
            return

        if preview:
            pending = (
                len(actions)
                + len(horkos_actions)
                + len(hook_actions)
                + len(label_actions)
                + len(protection_actions)
                + len(violations)
            )
            console.print(f"\n[bold]{pending} change(s) pending.[/bold]")
            for repo, verb, perm in actions:
                console.print(f"  {verb} {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))
            for repo, verb, perm in horkos_actions:
                console.print(f"  {verb} {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))
            for repo, verb, _hook_id, kind in hook_actions:
                name = "talos hook" if kind == "talos" else "horkos release hook"
                console.print(f"  {verb} {name} on {escape(owner)}/{escape(repo)}")
            for repo, name, _color, _description in label_actions:
                console.print(f"  create `{escape(name)}` label on {escape(owner)}/{escape(repo)}")
            for repo, rule_name, verb, diff in protection_actions:
                fields = "all fields" if verb == "create" else ", ".join(diff)
                console.print(f"  {verb} branch protection {escape(owner)}/{escape(repo)}:{escape(rule_name)} ({escape(fields)})")
            for repo, secret_names in violations:
                console.print(f"  {violation_line(escape(owner), escape(repo), [escape(n) for n in secret_names])}")
            if check:
                if pr_base_ref:
                    base_state = read_policies_at(pr_base_ref)
                    if base_state is None:
                        console.print(
                            f"\n[red]Cannot read {POLICY_PATH.name} at base {escape(pr_base_ref)} — "
                            "refusing to categorize PR drift without the base's declared state.[/red]"
                        )
                        raise typer.Exit(1)
                    base_state["protections"] = read_protections_at(pr_base_ref)
                    base_plan = plan_at(client, owner, who, base_state, base_state["protections"])
                    head_state = {"desired": desired, "pools": pools,
                                  "release_hook_repos": release_hook_repos,
                                  "horkos_forge_repos": horkos_forge_repos,
                                  "protections": protections}
                    report_pr_check(client, owner, who, head_state, base_state, base_plan,
                                    pr_base_ref, report_file)
                    return

                console.print("\n[red]Out of sync (--check).[/red]")
                raise typer.Exit(1)
            return

        for repo, verb, perm in actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{who}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))

        # The horkos-forge half applies exactly like the agents half: PUT a
        # write grant / DELETE it, through the same mutation loop shape.
        for repo, verb, perm in horkos_actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{HORKOS_FORGE_USER}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))

        # Each kind's signing secret is fetched independently, and up front
        # only if a create of that kind is pending — so a missing secret fails
        # before any hook is touched. An update normally needs no secret (the
        # routine CI applies: events drift, repo leaves the pool / release
        # set), with one exception handled below: when the read-back shows
        # Forgejo's edit path dropped events, the hook is recreated, and that
        # resolves the secret lazily — in CI it fails loudly and asks for a
        # local run, exactly like a create.
        secrets_by_kind: dict[str, str] = {}
        if any(v == "create" and k == "talos" for _, v, _h, k in hook_actions):
            secrets_by_kind["talos"] = resolve_webhook_secret()
        if any(v == "create" and k == "horkos" for _, v, _h, k in hook_actions):
            secrets_by_kind["horkos"] = resolve_horkos_hook_secret()

        def hook_secret(kind: str) -> str:
            if kind not in secrets_by_kind:
                secrets_by_kind[kind] = (
                    resolve_webhook_secret() if kind == "talos" else resolve_horkos_hook_secret()
                )
            return secrets_by_kind[kind]

        def create_hook(repo: str, kind: str) -> dict:
            hook_url = TALOS_HOOK_URL if kind == "talos" else HORKOS_HOOK_URL
            send_events = TALOS_HOOK_SEND_EVENTS if kind == "talos" else HORKOS_HOOK_SEND_EVENTS
            response = client.post(
                f"/api/v1/repos/{owner}/{repo}/hooks",
                json={
                    "type": "forgejo",
                    "active": True,
                    "events": sorted(send_events),
                    "config": {
                        "url": hook_url,
                        "content_type": "json",
                        "secret": hook_secret(kind),
                    },
                },
            )
            response.raise_for_status()
            return response.json()

        def read_hook(repo: str, hook_id: int) -> dict:
            response = client.get(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}")
            response.raise_for_status()
            return response.json()

        for repo, verb, hook_id, kind in hook_actions:
            name = "talos hook" if kind == "talos" else "horkos release hook"
            send_events = TALOS_HOOK_SEND_EVENTS if kind == "talos" else HORKOS_HOOK_SEND_EVENTS
            read_events = TALOS_HOOK_READ_EVENTS if kind == "talos" else HORKOS_HOOK_READ_EVENTS
            try:
                if verb == "create":
                    after = read_hook(repo, create_hook(repo, kind)["id"])
                elif verb == "update":
                    assert hook_id is not None  # the planner always names the keeper
                    client.patch(
                        f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}",
                        json={"events": sorted(send_events), "active": True},
                    ).raise_for_status()
                    # Never trust the 200: Forgejo's API edit path (v16.0.2
                    # routers/api/v1/utils/hook.go editHook) maps every event
                    # EXCEPT the action_run_* trio, so a PATCH carrying them
                    # succeeds and changes nothing — the four horkos hooks
                    # sat "drifted → update" on every run for three days that
                    # way (2026-09-21..24, eblume/horkos#40). The create path
                    # does map them, so when the read-back disagrees, replace
                    # the hook: create the new one first (no delivery gap),
                    # then delete the old.
                    after = read_hook(repo, hook_id)
                    if not hook_in_sync(after, read_events):
                        still_missing = sorted(set(read_events) - set(after.get("events") or []))
                        console.print(
                            f"[yellow]edit did not stick[/yellow] on {name} on {escape(owner)}/{escape(repo)} "
                            f"(still missing {escape(', '.join(still_missing)) or 'nothing — inactive'}); "
                            "recreating it through the create API"
                        )
                        created = create_hook(repo, kind)
                        client.delete(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}").raise_for_status()
                        after = read_hook(repo, created["id"])
                        verb = "recreate"
                else:
                    assert hook_id is not None  # likewise for a removal
                    client.delete(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}").raise_for_status()
                    after = None
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {name} on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            if after is not None and not hook_in_sync(after, read_events):
                console.print(
                    f"[red]{verb} {name} on {escape(owner)}/{escape(repo)} did not converge:[/red] "
                    f"read-back events {escape(str(sorted(after.get('events') or [])))}, "
                    f"active={after.get('active')}"
                )
                raise typer.Exit(1)
            console.print(f"[green]{verb}[/green] {name} on {escape(owner)}/{escape(repo)}")

        for repo, name, color, description in label_actions:
            try:
                (label_client or client).post(
                    f"/api/v1/repos/{owner}/{repo}/labels",
                    json={
                        "name": name,
                        "color": color,
                        "description": description,
                    },
                ).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(
                    f"[red]create `{escape(name)}` label on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]\n"
                    "Label management sits in Forgejo's issue scope — if this was a 403 "
                    "under the CI token (write:repository only), run this task locally "
                    "from gilbert."
                )
                raise typer.Exit(1) from exc
            console.print(f"[green]create[/green] `{escape(name)}` label on {escape(owner)}/{escape(repo)}")

        # Last, so a CI apply still lands the other halves before refusing
        # this one (module docstring: protections apply from a human run).
        if protection_actions and ci_token:
            console.print(
                f"\n[red]Refusing {len(protection_actions)} branch protection change(s) under the CI token.[/red] "
                "Branch protection is applied only from a human run: `mise run forge-reconcile` "
                "(1Password, biometric) after reviewing `--dry-run`."
            )
            raise typer.Exit(1)
        for repo, rule_name, verb, diff in protection_actions:
            label = f"branch protection {escape(owner)}/{escape(repo)}:{escape(rule_name)}"
            rule = next(r for r in protections if r["repo"] == repo and r["rule_name"] == rule_name)
            base = f"/api/v1/repos/{owner}/{repo}/branch_protections"
            try:
                if verb == "create":
                    client.post(
                        base, json={"rule_name": rule_name, **{f: rule[f] for f in PROTECTION_FIELDS}}
                    ).raise_for_status()
                else:
                    client.patch(
                        f"{base}/{quote(rule_name, safe='')}", json={f: rule[f] for f in diff}
                    ).raise_for_status()
                resp = client.get(f"{base}/{quote(rule_name, safe='')}")
                resp.raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {label} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            # Read back the whole rule, not just the fields sent: the hook
            # half learned that a Forgejo edit can answer 200 and change nothing.
            if left := protection_diff(resp.json(), rule):
                console.print(
                    f"[red]{verb} {label} did not converge:[/red] still differs on {escape(', '.join(left))}"
                )
                raise typer.Exit(1)
            console.print(f"[green]{verb}[/green] {label}")

        applied = (
            len(actions) + len(horkos_actions) + len(hook_actions) + len(label_actions) + len(protection_actions)
        )
        console.print(f"\n[green]Applied {applied} change(s).[/green]")


if __name__ == "__main__":
    typer.run(main)
