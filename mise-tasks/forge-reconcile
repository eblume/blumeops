# Invariants folded in from the retired `horkos-forge-drift` tool. `--check` is
# now the single forge drift check (weekly schedule + same-repo PRs), so the
# blast-radius facts horkos-forge-drift asserted live here, checked against the
# live forge on every check. Split two ways: the environment invariants
# (site-admin, blumeops:main whitelist) hold regardless of repos.json, and the
# horkos-forge *grant-set* invariant is keyed by the policy it is checked
# against (head vs base on a PR) — so it is reported as drift, not as a hard
# violation, when a PR is the thing moving the set.
EXPECTED_MAIN_WHITELIST = frozenset({"eblume"})
HORKOS_BLAST_REPO = "blumeops"
HORKOS_BLAST_BRANCH = "main"
RELEASE_KIT_REPO = "release-kit"
EXPECTED_RELEASE_KIT_WRITERS = frozenset({"eblume"})


class Findings:
    """Accumulates ok/fail/unknown lines; a check that cannot see is a failure."""
    def __init__(self):
        self.failures: list[str] = []
    def ok(self, what, detail=""):
        if detail:
            console.print(f"[green]ok[/green]       {escape(what)} — {escape(detail)}")
        else:
            console.print(f"[green]ok[/green]       {escape(what)}")
    def fail(self, what, detail):
        console.print(f"[red]invariant[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: {detail}")
    def unknown(self, what, detail):
        console.print(f"[red]UNKNOWN[/red]  {escape(what)} — {escape(detail)}")
        self.failures.append(f"{what}: could not verify ({detail})")


def check_site_admin(client, report, extra=()):
    """`horkos-forge` is not a site admin and is active; each additional
    declared read-only principal is not a site admin either. A check that cannot
    see is a failure, not a pass — a partial picture of a permissions boundary
    invites a second surprise."""
    try:
        resp = client.get(f"/api/v1/users/{HORKOS_FORGE_USER}")
        resp.raise_for_status()
        user = resp.json()
    except httpx.HTTPStatusError as exc:
        report.unknown("horkos-forge is not a site admin", f"user lookup failed: {exc}")
        return
    if user.get("is_admin"):
        report.fail("horkos-forge is not a site admin", "IS a site admin — every other grant check here is moot")
    elif not user.get("is_active", True):
        report.fail("horkos-forge is not a site admin", "account is deactivated — dispatch cannot work")
    else:
        report.ok("horkos-forge is not a site admin")
    for name in extra:
        what = f"{name} is not a site admin"
        try:
            resp = client.get(f"/api/v1/users/{name}")
            resp.raise_for_status()
            user = resp.json()
        except httpx.HTTPStatusError as exc:
            report.unknown(what, f"user lookup failed: {exc}")
            continue
        if user.get("is_admin"):
            # is_admin only: a deactivated read-only principal is an
            # operational problem a human fixes, not a boundary failure.
            report.fail(what, "IS a site admin — a site-admin fork principal would void the whole arrangement")
        else:
            report.ok(what)


def check_main_whitelist(client, owner, report):
    """blumeops:main stays whitelisted to eblume alone — the one repo where a
    shipped commit is production, so "can push branches" must not become "can
    ship to production". This is the live complement of BOT_WHITELIST_FENCE,
    which guards the *declared* rule; here we verify the live rule held."""
    what = f"blumeops:{HORKOS_BLAST_BRANCH} stays whitelisted to eblume alone"
    try:
        rules = list_protections(client, owner, HORKOS_BLAST_REPO)
    except httpx.HTTPStatusError as exc:
        report.unknown(what, f"branch protections not readable: {exc}")
        return
    if rules is None:
        report.unknown(what, "branch protections not readable — is the token admin-scoped?")
        return
    rule = next((r for r in rules if r.get("rule_name") == HORKOS_BLAST_BRANCH), None)
    if rule is None:
        report.fail(what, f"no branch protection on {HORKOS_BLAST_BRANCH} at all")
        return
    problems = []
    if not rule.get("enable_push_whitelist"):
        problems.append("push whitelist disabled")
    if not rule.get("enable_merge_whitelist"):
        problems.append("merge whitelist disabled")
    for field in ("push_whitelist_usernames", "merge_whitelist_usernames"):
        extra = sorted({u for u in (rule.get(field) or [])} - EXPECTED_MAIN_WHITELIST)
        if extra:
            problems.append(f"{field} also allows {', '.join(extra)}")
    if rule.get("push_whitelist_deploy_keys"):
        problems.append("deploy keys may push")
    if problems:
        report.fail(what, "; ".join(problems))
    else:
        report.ok(what)


def check_release_kit_writers(client, owner, report):
    """release-kit tags stay pushable by eblume alone: no write-or-above
    collaborator other than eblume, no write deploy key. Live writers, not a
    tag-protection rule — why, see the release-kit note in
    docs/reference/operations/declared-state-files.md. The `main`
    branch-protection half is declared in branch-protections.json and
    drift-checked separately."""
    what = f"{RELEASE_KIT_REPO}: tags stay pushable by eblume alone"
    try:
        collaborators = paged(
            client, f"/api/v1/repos/{owner}/{RELEASE_KIT_REPO}/collaborators"
        )
    except httpx.HTTPStatusError as exc:
        if exc.response.status_code in (403, 404):
            report.unknown(what, "collaborator list unreadable")
            return
        raise
    allowed = {u.lower() for u in EXPECTED_RELEASE_KIT_WRITERS}
    problems: list[str] = []
    for user in collaborators:
        who = user.get("login", "")
        if who.lower() in allowed:
            continue
        try:
            resp = client.get(
                f"/api/v1/repos/{owner}/{RELEASE_KIT_REPO}/collaborators/{who}/permission"
            )
            resp.raise_for_status()
        except httpx.HTTPStatusError as exc:
            if exc.response.status_code in (403, 404):
                report.unknown(what, f"permission for {who} unreadable")
                return
            raise
        permission = resp.json().get("permission")
        if permission in {"write", "admin", "owner"}:
            problems.append(f"collaborator {who} has {permission} access")
    keys = list_deploy_keys(client, owner, RELEASE_KIT_REPO)
    if keys is None:
        report.unknown(what, "deploy keys unreadable")
        return
    for key in keys:
        if key.get("read_only") is not True:
            problems.append(f"deploy key {key.get('title', '<untitled>')!r} can write")
    if problems:
        report.fail(what, "; ".join(problems))
    else:
        report.ok(what)


def _parse_actions_secrets(data) -> dict[str, list[str]]:
    """Validate one parsed Actions-secrets document (from the file or a git
    ref) into {repo: [names]}, with the shared loud-failure rule: malformed
    input is Exit(1), never an empty dict — an empty read would look like
    "nothing declared" and pass against a live forge that carries secrets.
    A declared name with no value source fails the same way."""
    if not isinstance(data, dict):
        console.print(f"[red]{ACTIONS_SECRETS_PATH.name}: expected a mapping, got {type(data).__name__}[/red]")
        raise typer.Exit(1)
    repos = data.get("repos")
    if not isinstance(repos, list):
        console.print(f"[red]{ACTIONS_SECRETS_PATH.name}: missing or non-list `repos`[/red]")
        raise typer.Exit(1)
    out: dict[str, list[str]] = {}
    for entry in repos:
        if not isinstance(entry, dict) or not isinstance(entry.get("repo"), str):
            console.print(f"[red]{ACTIONS_SECRETS_PATH.name}: a repo entry is not a mapping with a `repo` name: {escape(str(entry))}[/red]")
            raise typer.Exit(1)
        secrets = entry.get("secrets", [])
        if not isinstance(secrets, list) or not all(isinstance(s, str) for s in secrets):
            console.print(f"[red]{ACTIONS_SECRETS_PATH.name}: {entry['repo']} `secrets` is not a list of strings[/red]")
            raise typer.Exit(1)
        for name in secrets:
            if (entry["repo"], name) not in ACTIONS_SECRET_SOURCES:
                console.print(
                    f"[red]{ACTIONS_SECRETS_PATH.name}: {entry['repo']} declares a secret with no value "
                    f"source in ACTIONS_SECRET_SOURCES — add the source or drop the declaration: {escape(name)}[/red]"
                )
                raise typer.Exit(1)
        out[entry["repo"]] = list(secrets)
    return out


def declared_actions_secret_names() -> dict[str, list[str]]:
    """Per-repo Actions-secret names declared in forge/actions-secrets.json.

    Read straight from ACTIONS_SECRETS_PATH; the file declares names only —
    the 1Password value sources live in the in-code ACTIONS_SECRET_SOURCES
    allowlist (a one-line data edit must not be able to pick a vault item). A
    malformed read or a declared name with no source is a loud failure, not an
    empty dict: an empty read would look like "nothing declared" and pass
    against a live forge that carries secrets."""
    try:
        data = json.loads(ACTIONS_SECRETS_PATH.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        console.print(f"[red]Cannot read declared Actions secrets from {ACTIONS_SECRETS_PATH.name}: {escape(str(exc))}[/red]")
        raise typer.Exit(1) from exc
    return _parse_actions_secrets(data)


def check_actions_secret_names(client, owner, report, pr_mode: bool = False):
    """Live Actions-secret names on the file's declared repos match the
    file's declarations — the name-level drift the apply half fixes and the
    weekly --check catches. A missing name (declared, not live) or an extra
    one (live, not declared) is drift; a check that cannot read a repo's
    secrets is a failure, like every check that cannot see. Repos the file
    does not declare are out of scope: the file is authoritative for its own
    list, and we do not assert secret-freedom on repos it never manages. In
    pr_mode the missing/extra split belongs to report_pr_check (live vs the
    PR base's declared set), so only readability is asserted here.
    """
    declared = declared_actions_secret_names()
    for repo in sorted(declared):
        what = f"Actions secret names on {owner}/{repo} match the file"
        live = actions_secrets(client, owner, repo)
        if live is None:
            report.unknown(what, "could not read the repo's Actions secrets")
            continue
        if pr_mode:
            report.ok(what)
            continue
        want = set(declared[repo])
        have = set(live)
        missing, extra = sorted(want - have), sorted(have - want)
        if missing or extra:
            parts = []
            if missing:
                parts.append(f"missing: {', '.join(missing)}")
            if extra:
                parts.append(f"undeclared live: {', '.join(extra)}")
            report.fail(what, "; ".join(parts))
        else:
            report.ok(what)


# The --1358 privileged-runner-label policy is DERIVED from forge/runners.json
# (#1526): a label whose every advertising runner is repo-scoped is gated to
# the repos those runners may take jobs for; an instance-scoped runner serves
# every repo and ungates its labels. The `privileged` boolean is deliberately
# NOT the gate — the ringtail nix-container-builder runners are privileged:
# false yet their label must stay gated (host-mode, credential-bearing).
def derive_privileged_label_policy(runners: list[dict]) -> dict[str, frozenset[str]]:
    """The gated-label map reproduced from forge/runners.json.

    A label base (part before the first `:`) is gated iff every runner
    advertising it is repo-scoped — a scope containing `/` (an owner name
    or `instance`, carrying no `/`, serves every repo and therefore
    UNGATES its labels, exactly as the live leg's `_serves_repo` treats
    them); its allowed repos are the union of the advertising runners'
    scope repo parts (`owner/` prefix stripped, so the repo name).
    """
    per_label: dict[str, list[str]] = {}
    for runner in runners:
        for label in runner["labels"]:
            per_label.setdefault(label.partition(":")[0], []).append(runner["scope"])
    return {
        base: frozenset(scope.partition("/")[2] for scope in scopes)
        for base, scopes in per_label.items()
        if all("/" in scope for scope in scopes)
    }


def load_privileged_label_policy() -> dict[str, frozenset[str]]:
    """The privileged-label policy, read from forge/runners.json (the single
    declared source for the runner topology, #1526)."""
    return derive_privileged_label_policy(json.loads(RUNNERS_PATH.read_text())["runners"])


def _runners_config() -> tuple[set[str], set[str], set[tuple[str, str]]]:
    """Declared label knowledge from forge/runners.json (#1526): the label
    bases, the `:x` suffixes, and the (repo, label-base) exception pairs whose
    workflows are known to target nothing (delete the entry once fixed)."""
    data = json.loads(RUNNERS_PATH.read_text())
    bases, suffixes = set(), set()
    for runner in data["runners"]:
        for label in runner["labels"]:
            base, _, suffix = label.partition(":")
            bases.add(base)
            if suffix:
                suffixes.add(suffix)
    exceptions = {(e["repo"], e["label"]) for e in data.get("label_exceptions", [])}
    return bases, suffixes, exceptions

# A `runs-on` value is a scalar, a flow list, or a `${{ expr }}`. The labels it
# names are its whole tokens: a bare word (splitting on `${{`/`}}` would leave
# expression glue like `github.event_name`), or the quoted strings the
# expression resolves to. We compare whole tokens, never substrings, so
# `indri-build` is not `indri` and `nix-container-builder` is not `priv`.
_RUNS_ON_KEY_RE = re.compile(r"^(\s*)runs-on:\s*(.*)$")
_RUNS_ON_ITEM_RE = re.compile(r"^(\s*)-\s+(\S.*)$")
_RUNS_ON_TOKEN_RE = re.compile(r"['\"](\w[\w-]*)['\"]|(?<![\w-])([\w-]+)(?![\w-])")


def runs_on_labels(value):
    """The runner labels a `runs-on` value names, as a set of whole tokens.
    findall yields (quoted, unquoted) captures per match; keep whichever is
    non-empty."""
    return {q or u for q, u in _RUNS_ON_TOKEN_RE.findall(value) if q or u}


def _strip_inline_comment(value):
    """Cut an unquoted ` #` comment so free text (a label *named* in prose)
    is not tokenized into the label set."""
    quote = None
    for i, ch in enumerate(value):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == "#" and (i == 0 or value[i - 1] in " 	"):
            return value[:i]
    return value


def _workflow_runs_on_labels(content):
    """(token, value) pairs for every label token named on a `runs-on`,
    covering the inline form, the `${{ }}` ternary, and the block form
    (`runs-on:` followed by a deeper-indented `- item` list). `value` is the
    raw text that named the token, for the report line."""
    out = []
    seen = set()
    in_block = False
    block_indent = -1
    for line in content.splitlines():
        m = _RUNS_ON_KEY_RE.match(line)
        if m:
            value = m.group(2).strip()
            in_block = not value
            block_indent = len(m.group(1))
            if value:
                for tok in runs_on_labels(_strip_inline_comment(value)):
                    if tok not in seen:
                        seen.add(tok)
                        out.append((tok, value))
            continue
        if in_block:
            item = _RUNS_ON_ITEM_RE.match(line)
            if item and len(item.group(1)) > block_indent:
                value = item.group(2).strip()
                for tok in runs_on_labels(_strip_inline_comment(value)):
                    if tok not in seen:
                        seen.add(tok)
                        out.append((tok, value))
                continue
            if line.strip():
                in_block = False
    return out


def _get(client, path, params=None):
    """GET with a retry on transient transport errors (proxy or network)."""
    last = None
    for _ in range(3):
        try:
            return client.get(path, params=params)
        except httpx.TransportError as exc:
            last = exc
    raise last


def _list_workflows(client, owner, repo, ref, directory):
    """Workflow file paths under `directory` at `ref`; an absent dir is [].
    A single GET, not paged(): the /contents endpoint returns the whole
    listing at once and ignores the page param, so the shared pager would
    spin forever on a non-empty directory. 403/404 both read as "no
    workflows" (Forgejo 404s a missing dir and a repo the caller cannot see
    alike)."""
    try:
        body = _get(client, f"/api/v1/repos/{owner}/{repo}/contents/{directory}", params={"ref": ref})
        body.raise_for_status()
        entries = body.json()
    except (httpx.HTTPStatusError, ValueError) as exc:
        if isinstance(exc, httpx.HTTPStatusError) and exc.response.status_code in (403, 404):
            return []
        raise
    if not isinstance(entries, list):
        return []
    return [f"{directory}/{e['name']}" for e in entries if e.get("name", "").endswith((".yaml", ".yml"))]


def scan_repo_workflow_labels(client: httpx.Client, owner: str):
    """Every repo's default-branch `.forgejo/workflows` runs-on tokens.

    Returns (labels_by_repo, repo_ids, unreadable, skipped_archived):
    repo → {label token: raw runs-on value that named it}, repo → API id,
    (what, detail) pairs to report as unknown — a failure to list the owner's
    repos (labels is then None) or a repo/file the caller cannot read — and
    the repos skipped because they're archived (an archived repo cannot run
    workflows, so its `runs-on` labels target nothing by construction, #1526).
    Only `.forgejo/workflows` is scanned — the one directory Forgejo executes,
    so an inert `.github/workflows` file can never reach the runner and is out
    of scope. A `runs-on` may be a `${{ ... }}` ternary, so a label counts as
    targeted if it appears in the expression's source — the set of runners the
    line can ever resolve to.
    """
    try:
        repos = owner_repos(client, owner)
    except (httpx.HTTPStatusError, httpx.TransportError, ValueError) as exc:
        return None, {}, [("every workflow targets a declared, live runner label",
                           f"could not list {owner}'s repos: {exc}")], set()
    labels, ids, unreadable, skipped_archived = {}, {}, [], set()
    for repo in sorted(repos):
        full = f"{owner}/{repo}"
        try:
            resp = _get(client, f"/api/v1/repos/{owner}/{repo}")
            resp.raise_for_status()
            info = resp.json()
            if info.get("archived"):
                skipped_archived.add(repo)
                continue
            ref = info.get("default_branch")
            entries = _list_workflows(client, owner, repo, ref, ".forgejo/workflows") if ref else []
        except (httpx.HTTPStatusError, httpx.TransportError, ValueError) as exc:
            unreadable.append(("every workflow targets a declared, live runner label",
                               f"cannot read {full}: {exc}"))
            continue
        ids[repo] = info.get("id")
        repo_labels: dict[str, str] = {}
        for path in entries:
            try:
                resp = _get(client, f"/{owner}/{repo}/raw/branch/{ref}/{path}")
                resp.raise_for_status()
                content = resp.text
            except (httpx.HTTPStatusError, httpx.TransportError) as exc:
                unreadable.append(("every workflow targets a declared, live runner label",
                                   f"cannot read {full}:{path}: {exc}"))
                continue
            for token, value in _workflow_runs_on_labels(content):
                repo_labels.setdefault(token, value)
        if repo_labels:
            labels[repo] = repo_labels
    return labels, ids, unreadable, skipped_archived


def check_privileged_labels(client, owner, report, labels):
    """No repo targets a privileged runner label it is not declared to (#1358).

    The gate is the policy derived from forge/runners.json (see
    derive_privileged_label_policy): a label whose every advertising runner is
    repo-scoped is gated to the repos those registrations serve, and a
    `runs-on` handing a repo's (possibly PR-head) code a slot on a gated
    runner it is not declared to fails the check. Works on the scan from
    scan_repo_workflow_labels; the clean case prints one summary line.
    """
    try:
        policy = load_privileged_label_policy()
    except (OSError, ValueError, KeyError) as exc:
        report.unknown("privileged-runner labels stay within their declared repos",
                       f"could not read {RUNNERS_PATH.name}: {exc}")
        return
    violations: dict[str, list[str]] = {}
    scanned = 0
    for repo in sorted(labels):
        scanned += 1
        for label, value in sorted(labels[repo].items()):
            allowed = policy.get(label)
            if allowed is None or repo in allowed:
                continue
            violations.setdefault(label, []).append(f"{owner}/{repo} → `{value}`")
    for label, places in sorted(violations.items()):
        report.fail(f"`{label}` is targeted only by its declared repos", "; ".join(places))
    if not violations:
        report.ok(f"no privileged-runner label outside its declared repos ({scanned} repos scanned)")


# Words the tokenizer can emit from a `${{ ... }}` runs-on expression that are
# never runner labels (context fields, event names, the ternary's boolean
# glue). The old policy-map lookup skipped them silently; exclude them here so
# an expression form does not fail the declaration check.
RUNS_ON_GLUE = frozenset({
    "github", "event_name", "pull_request", "push", "schedule", "workflow_dispatch",
    "workflow_run", "issue_comment", "issues", "true", "false", "null",
    "success", "failure", "cancelled", "always", "matrix", "strategy", "needs",
    "jobs", "inputs", "env", "vars", "secrets", "contains", "startsWith",
    "endsWith", "fromJSON", "toJSON",
})


def check_unknown_labels(owner, report, labels):
    """No workflow targets a `runs-on` no runner declares (#1526).

    A token is known when it is a declared label base, the `:x` suffix of
    one (`priv:host`'s bare `host`), or expression glue from the `${{ }}`
    ternary (RUNS_ON_GLUE, never labels). The glue and suffix excuses are
    context-bound: a token is glue only when the raw runs-on value that
    named it contains `${{` (a plain `runs-on: push` names the glue word
    `push` as a bare label and must fail), and a suffix only when that
    value contains `:` (a plain `runs-on: host` is not `priv:host`). A
    (repo, label-base) pair in runners.json's label_exceptions is known to
    target nothing and is exempt until the workflow is fixed — delete the
    entry then.
    """
    try:
        bases, suffixes, exceptions = _runners_config()
    except (OSError, ValueError, KeyError) as exc:
        report.unknown("no workflow targets an undeclared runner label",
                       f"could not read {RUNNERS_PATH.name}: {exc}")
        return
    unknown: dict[str, list[str]] = {}
    for repo in sorted(labels):
        for token in sorted(labels[repo]):
            raw = labels[repo][token]
            if token in RUNS_ON_GLUE and "${{" in raw:
                continue
            if token in suffixes and ":" in raw:
                continue
            if token in bases:
                continue
            if (repo, token) in exceptions:
                continue
            unknown.setdefault(token, []).append(f"{owner}/{repo} → `{raw}`")
    for token, places in sorted(unknown.items()):
        report.fail(f"`{token}` is not a runner label any runner declares", "; ".join(places))
    if not unknown:
        report.ok(f"no workflow targets an undeclared runner label ({len(labels)} repos scanned)")


def live_runner_series() -> list[dict]:
    """The live registered runners, one dict per forgejo_ci_runner_info series
    (runner, comma-joined registered labels, scope) — the same metric the CI
    runbook and charts read (#1515). Raises on a non-2xx or unparseable
    response; the caller turns that into an UNKNOWN finding."""
    with httpx.Client(timeout=15.0) as client:
        resp = client.get(f"{PROMETHEUS_URL}/api/v1/query", params={"query": "forgejo_ci_runner_info"})
        resp.raise_for_status()
        return [
            {
                "runner": m["metric"]["runner"],
                "labels": m["metric"].get("labels", ""),
                "scope": m["metric"].get("scope", "instance"),
            }
            for m in resp.json()["data"]["result"]
        ]


def _has_label_base(labels_field: str, base: str) -> bool:
    """Whether a runner's comma-joined registered labels include `base`
    (before any `:x` suffix)."""
    return any(l.split(":")[0] == base for l in labels_field.split(",") if l.strip())


def _serves_repo(scope: str, owner: str, repo: str, repo_id, owner_id) -> bool:
    """Whether a runner whose live registration scopes to `scope` can take
    `owner/repo` jobs: `instance` serves all, an owner name that owner's
    repos, `owner/repo` only itself, and the collector's numeric join
    fallbacks match the repo or owner API id (when the id is known)."""
    return (
        scope == "instance"
        or scope == owner
        or scope == f"{owner}/{repo}"
        or (repo_id is not None and scope == f"repo:{repo_id}")
        or (owner_id is not None and scope == f"owner:{owner_id}")
    )


def check_runner_series(client, owner, report, labels, repo_ids):
    """Every workflow runs-on label is served by a live runner (#1515).

    A warranted/CI job handed a label no runner registers queues forever, so
    this is a hard, scope-aware registration check: a label base is served iff
    some live series registers it and its scope covers the repo (instance, the
    owner, the repo, or the collector's repo:/owner: id fallbacks). Unknown
    labels and glue already failed the declaration leg, so only declared label
    bases are verified here — a `:x` suffix token (`host` from `priv:host`)
    never names a runnable label alone. Prometheus is reachable
    unauthenticated from CI runners and this pod.
    """
    if not labels:
        report.ok("every workflow runs-on label is served by a live runner",
                  "no workflow targets a runner label — live registration not exercised")
        return
    try:
        bases, _suffixes, exceptions = _runners_config()
    except (OSError, ValueError, KeyError) as exc:
        report.unknown("every workflow runs-on label is served by a live runner",
                       f"could not read {RUNNERS_PATH.name}: {exc}")
        return
    try:
        series = live_runner_series()
    except (httpx.HTTPStatusError, httpx.TransportError, ValueError, KeyError) as exc:
        report.unknown("every workflow runs-on label is served by a live runner",
                       f"prometheus unreachable: {exc}")
        return
    owner_id = None
    try:
        owner_id = _get(client, f"/api/v1/users/{owner}").json().get("id")
    except (httpx.HTTPStatusError, httpx.TransportError, ValueError):
        pass
    unserved: dict[tuple[str, str], list[str]] = {}
    checked = 0
    for repo in sorted(labels):
        repo_id = repo_ids.get(repo)
        for token in sorted(labels[repo]):
            if token not in bases or (repo, token) in exceptions:
                continue
            checked += 1
            advertising = [m for m in series if _has_label_base(m["labels"], token)]
            if any(_serves_repo(m["scope"], owner, repo, repo_id, owner_id) for m in advertising):
                continue
            if advertising:
                elsewhere = ", ".join(sorted({f"{m['runner']} ({m['scope']})" for m in advertising}))
                unserved[(repo, token)] = [
                    f"{owner}/{repo} → `{labels[repo][token]}`; registers: {elsewhere}"
                ]
            else:
                unserved[(repo, token)] = [f"{owner}/{repo} → `{labels[repo][token]}`; no live runner registers it"]
    for (repo, token), places in sorted(unserved.items()):
        report.fail(f"`{token}` has no live runner scoped to {owner}/{repo}", "; ".join(places))
    if not unserved:
        report.ok("every workflow runs-on label is served by a live runner",
                  f"{checked} label(s) verified against {len(series)} live runner(s)")


_RUNBOOK_NAME_RE = re.compile(r"^`([^`]+)`$")


def check_runbook_runner_table(report):
    """The runbook's ForgejoRunnerOffline table mirrors forge/runners.json.

    Every declared runner appears exactly once as a backticked first cell, and
    its last cell carries the runner's unit in backticks — the table is how an
    operator finds the daemon to restart, so name or unit drift sends them to
    the wrong host. The prose notes the columns mirror runners.json (#1526).
    """
    try:
        runners = json.loads(RUNNERS_PATH.read_text())["runners"]
        lines = RUNBOOK_PATH.read_text().splitlines()
    except (OSError, ValueError, KeyError, UnicodeError) as exc:
        report.unknown("runbook runner table mirrors forge/runners.json",
                       f"could not read the declared runner files: {exc}")
        return
    declared = {r["name"]: r["unit"] for r in runners}
    table: dict[str, str] = {}  # backticked name -> last-cell text
    malformed: list[str] = []
    after_heading = False
    in_table = False
    for line in lines:
        if line.startswith("## ForgejoRunnerOffline"):
            after_heading = True
            continue
        if not after_heading:
            continue
        # The section ends at the next heading: no later table belongs to
        # ForgejoRunnerOffline, so stop collecting there.
        if line.startswith("## "):
            break
        if not line.startswith("|"):
            # ... and at the first non-empty, non-`|` line after the table
            # has started; blank lines inside the table are tolerated.
            if in_table and line.strip():
                break
            continue
        in_table = True
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if cells == ["Runner", "Host", "Service"] or all(
            not c or set(c) <= {"-", ":"} for c in cells
        ):
            continue
        name_m = _RUNBOOK_NAME_RE.match(cells[0])
        if not name_m:
            malformed.append(f"unparsed table row: {line.strip()}")
            continue
        name = name_m.group(1)
        if name in table:
            malformed.append(f"duplicate table row for `{name}`")
            continue
        table[name] = cells[-1]
    problems = []
    for name, unit in sorted(declared.items()):
        if name not in table:
            problems.append(f"runner `{name}` missing from the table")
            continue
        if unit not in re.findall(r"`([^`]+)`", table[name]):
            problems.append(f"runner `{name}`'s Service cell should carry `{unit}`")
    for name in sorted(set(table) - set(declared)):
        problems.append(f"table lists `{name}`, not a declared runner")
    problems.extend(malformed)
    for problem in problems:
        report.fail("runbook runner table mirrors forge/runners.json", problem)
    if not problems:
        report.ok("runbook runner table mirrors forge/runners.json",
                  f"{len(declared)} runners, all match")



# --pr-base-ref reads the PR base's declared state from git. The CI checkout
# is shallow (PR merge ref only), so the base ref is not a local branch — fetch
# it shallow to origin/<ref> first, then read that. The ref is validated against
# this (it is interpolated into a git command) and the fetch is memoized so the
# two read_*_at calls fetch once.
BASE_REF_RE = re.compile(r"^[A-Za-z0-9._/-]+$")
_FETCHED_BASES: set[str] = set()


def git_read_file(ref, relpath):
    """Read a file at a git ref, or None when git is absent, the ref is invalid
    or unfetchable, or the file is not at that ref. Used by --pr-base-ref."""
    if shutil.which("git") is None or not BASE_REF_RE.fullmatch(ref or ""):
        return None
    if ref not in _FETCHED_BASES:
        f = subprocess.run(
            ["git", "fetch", "--depth=1", "origin", f"{ref}:refs/remotes/origin/{ref}"],
            capture_output=True, check=False,
        )
        if f.returncode != 0:
            return None
        _FETCHED_BASES.add(ref)
    r = subprocess.run(["git", "show", f"origin/{ref}:{relpath}"], capture_output=True, check=False)
    if r.returncode != 0:
        return None
    return r.stdout


def _policies_dict(policy):
    """The lenient reader's twin of load_policy's policy parsing (no refusals —
    it reads a git ref for the PR check, and a base can predate the top-level
    `principals` list): the declared set is seeded from the top-level list, and
    per-repo entries are collected even when their principal is not listed, so
    an old base's per-repo state still compares correctly."""
    desired, pools = {}, {}
    release_hook_repos, horkos_forge_repos = set(), set()
    declared = policy.get("principals") or []
    if not isinstance(declared, list) or not all(isinstance(p, str) for p in declared):
        declared = []
    extra_principals: dict[str, dict[str, str]] = {p: {} for p in declared}
    for entry in policy["repos"]:
        desired[entry["name"]] = entry["access"]
        pools[entry["name"]] = entry.get("pool", "none")
        if entry.get("release_hook", False):
            release_hook_repos.add(entry["name"])
        if entry.get("horkos_forge", False):
            horkos_forge_repos.add(entry["name"])
        principals = entry.get("principals") or {}
        if isinstance(principals, dict):
            for principal, access in principals.items():
                extra_principals.setdefault(principal, {})[entry["name"]] = access
    return {"desired": desired, "pools": pools,
            "release_hook_repos": release_hook_repos,
            "horkos_forge_repos": horkos_forge_repos,
            "extra_principals": extra_principals}


def read_policies_at(ref):
    """The repos.json declared state at a git ref (None when unreadable)."""
    raw = git_read_file(ref, "argocd/manifests/talos/repos.json")
    if raw is None:
        return None
    try:
        return _policies_dict(json.loads(raw))
    except json.JSONDecodeError:
        return None


def read_protections_at(ref):
    """The branch-protections rules at a git ref (None when unreadable, so a
    partial base read — repos.json OK, protections not — fails loudly rather
    than planning against an empty protection set)."""
    raw = git_read_file(ref, "forge/branch-protections.json")
    if raw is None:
        return None
    try:
        return json.loads(raw)["rules"]
    except (json.JSONDecodeError, KeyError):
        return None


def read_tag_protections_at(ref):
    """The tag-protection rules at a git ref: [] when the file does not exist
    at the ref — main carries no forge/tag-protections.json until the
    introducing PR merges, so "absent at the base" means "base declares no tag
    protections", which must NOT fail loudly the way branch-protections.json
    absence does — and None when it exists but is malformed."""
    raw = git_read_file(ref, "forge/tag-protections.json")
    if raw is None:
        return []
    try:
        return json.loads(raw)["rules"]
    except (json.JSONDecodeError, KeyError):
        return None


def actions_secret_names_at(ref):
    """Actions-secret names at a git ref: {} when the file does not exist at
    the ref (the creating PR reads an empty base), Exit(1) when it exists but
    is malformed."""
    raw = git_read_file(ref, "forge/actions-secrets.json")
    if raw is None:
        return {}
    try:
        data = json.loads(raw)
    except ValueError as exc:
        console.print(f"[red]forge/actions-secrets.json at {ref} is not valid JSON: {exc}[/red]")
        raise typer.Exit(1) from exc
    return _parse_actions_secrets(data)


def plan_protection_actions(client, owner, all_repos, protections, blocked):
    """Plan the branch-protection actions for the file against the live forge,
    shared by plan_at and main's table build: declared rules become
    create/update diffs, and any live rule the file does not declare is a
    pending delete. A repo whose live rule list is unreadable goes into
    blocked. Returns (protection_actions, live_by_repo); the live list is
    fetched at most once per repo.
    """
    protection_actions: list[tuple[str, str, str, dict[str, tuple[object, object]]]] = []
    live_by_repo: dict[str, list[dict] | None] = {}

    def fetch_live(repo):
        if repo not in live_by_repo:
            live_by_repo[repo] = list_protections(client, owner, repo)
        return live_by_repo[repo]

    for rule in protections:
        repo = rule["repo"]
        live_rules = fetch_live(repo)
        if live_rules is None:
            if repo not in blocked:
                blocked.append(repo)
            continue
        live_by_name = {r["rule_name"]: r for r in live_rules}
        live = live_by_name.get(rule["rule_name"])
        if live is None:
            protection_actions.append((repo, rule["rule_name"], "create",
                                       {f: (None, rule[f]) for f in sorted(PROTECTION_FIELDS)}))
        else:
            diff = protection_diff(live, rule)
            if diff:
                protection_actions.append((repo, rule["rule_name"], "update", diff))
    for repo in sorted(all_repos):
        live_rules = fetch_live(repo)
        if live_rules is None:
            if repo not in blocked:
                blocked.append(repo)
            continue
        declared_names = {r["rule_name"] for r in protections if r["repo"] == repo}
        for rn in sorted({r["rule_name"] for r in live_rules} - declared_names):
            protection_actions.append((repo, rn, "delete", {}))
    return protection_actions, live_by_repo


def plan_tag_protection_actions(client, owner, all_repos, tag_protections, blocked):
    """Plan the tag-protection actions for the file against the live forge,
    shared by plan_at and main's table build: declared rules become
    create/update diffs (matched to live rules by (repo, name_pattern) —
    unique per repo live and at load), and any live rule the file does not
    declare is a pending delete. A repo whose live rule list is unreadable
    goes into blocked. Returns (tag_protection_actions, tag_live_by_repo);
    the live list is fetched at most once per repo.
    """
    tag_protection_actions: list[tuple[str, str, str, dict[str, tuple[object, object]]]] = []
    tag_live_by_repo: dict[str, list[dict] | None] = {}

    def fetch_live(repo):
        if repo not in tag_live_by_repo:
            tag_live_by_repo[repo] = list_tag_protections(client, owner, repo)
        return tag_live_by_repo[repo]

    for rule in tag_protections:
        repo = rule["repo"]
        live_rules = fetch_live(repo)
        if live_rules is None:
            if repo not in blocked:
                blocked.append(repo)
            continue
        live_by_pattern = {r["name_pattern"]: r for r in live_rules}
        live = live_by_pattern.get(rule["name_pattern"])
        if live is None:
            tag_protection_actions.append((repo, rule["name_pattern"], "create",
                                           {f: (None, rule[f]) for f in sorted(TAG_PROTECTION_FIELDS)}))
        else:
            diff = tag_protection_diff(live, rule)
            if diff:
                tag_protection_actions.append((repo, rule["name_pattern"], "update", diff))
    for repo in sorted(all_repos):
        live_rules = fetch_live(repo)
        if live_rules is None:
            if repo not in blocked:
                blocked.append(repo)
            continue
        declared_patterns = {r["name_pattern"] for r in tag_protections if r["repo"] == repo}
        for pattern in sorted({r["name_pattern"] for r in live_rules} - declared_patterns):
            tag_protection_actions.append((repo, pattern, "delete", {}))
    return tag_protection_actions, tag_live_by_repo


def plan_at(client, owner, who, policies, protections, tag_protections):
    """Plan the drift of a (policy, protections, tag_protections) pair against
    the live forge — the read-only core of main's planning, factored out so
    --pr-base-ref can plan the PR base's state too. Returns {actions,
    horkos_actions, extra_actions, hook_actions, protection_actions,
    tag_protection_actions, violations, blocked}."""
    desired = policies["desired"]
    pools = policies["pools"]
    release_hook_repos = policies["release_hook_repos"]
    horkos_forge_repos = policies["horkos_forge_repos"]
    extra_principals = policies.get("extra_principals", {})
    all_repos = owner_repos(client, owner)
    blocked, violations = [], []
    actions, horkos_actions, extra_actions, hook_actions = [], [], [], []
    for repo in sorted(all_repos):
        want = desired.get(repo, "none")
        have = current_access(client, owner, repo, who)
        horkos_want = "write" if repo in horkos_forge_repos else "none"
        horkos_have = current_access(client, owner, repo, HORKOS_FORGE_USER)
        if have == "unreadable" or horkos_have == "unreadable":
            if repo in desired:
                blocked.append(repo)
            continue
        if have != want:
            verb = "revoke" if want == "none" else ("grant" if have == "none" else "update")
            actions.append((repo, verb, want))
        if horkos_have != horkos_want:
            horkos_actions.append(
                (repo, "revoke" if horkos_want == "none" else ("grant" if horkos_have == "none" else "update"), horkos_want))
        for principal in sorted(extra_principals):
            p_want = extra_principals[principal].get(repo, "none")
            p_have = current_access(client, owner, repo, principal)
            if p_have != p_want:
                extra_actions.append((
                    principal, repo,
                    "revoke" if p_want == "none" else ("grant" if p_have == "none" else "update"),
                    p_want))
        if want == "write":
            secrets = actions_secrets(client, owner, repo)
            if secrets is None and repo not in blocked:
                blocked.append(repo)
            elif secrets:
                violations.append((repo, secrets))
        want_hook = pools.get(repo, "none") != "none"
        want_release_hook = repo in release_hook_repos
        hooks = list_hooks(client, owner, repo)
        if hooks is None:
            if repo in desired and repo not in blocked:
                blocked.append(repo)
            continue
        _, _, _ = hook_kind_state(
            [h for h in hooks if h.get("config", {}).get("url") == TALOS_HOOK_URL],
            TALOS_HOOK_READ_EVENTS, want_hook, repo, "talos", hook_actions)
        _, _, _ = hook_kind_state(
            [h for h in hooks if h.get("config", {}).get("url") == HORKOS_HOOK_URL],
            HORKOS_HOOK_READ_EVENTS, want_release_hook, repo, "horkos", hook_actions)
    protection_actions, _ = plan_protection_actions(client, owner, all_repos, protections, blocked)
    tag_protection_actions, _ = plan_tag_protection_actions(client, owner, all_repos, tag_protections, blocked)
    return {"actions": actions, "horkos_actions": horkos_actions, "extra_actions": extra_actions,
            "hook_actions": hook_actions, "protection_actions": protection_actions,
            "tag_protection_actions": tag_protection_actions,
            "violations": violations, "blocked": blocked}


def _changed_facts(base_state, head_state):
    """The set of facts the PR's declared delta changes, keyed so a live-drift
    action can be classified intended vs unexpected by (repo, fact):
      - (repo, "access"), (repo, "horkos"), (repo, "talos-hook"),
        (repo, "release-hook")
      - (repo, "principal", name)
      - (repo, "secrets")
      - (repo, "protect", rule_name)
      - (repo, "tag_protect", name_pattern)
    A base-plan action is INTENDED iff its fact is in this set (the PR is
    landing it), UNEXPECTED otherwise (the PR does not touch it).
    """
    b, h = base_state, head_state
    changed: set[tuple] = set()
    for repo in sorted(set(b["desired"]) | set(h["desired"])):
        if b["desired"].get(repo, "none") != h["desired"].get(repo, "none"):
            changed.add((repo, "access"))
        if (repo in b["horkos_forge_repos"]) != (repo in h["horkos_forge_repos"]):
            changed.add((repo, "horkos"))
        if b["pools"].get(repo, "none") != h["pools"].get(repo, "none"):
            changed.add((repo, "talos-hook"))
        if (repo in b["release_hook_repos"]) != (repo in h["release_hook_repos"]):
            changed.add((repo, "release-hook"))
        # A principal absent from head's management set (dropped from the
        # top-level list) is not a changed fact: no intended line for it, and
        # report_pr_check fails a one-step demotion of a granted principal.
        for principal in sorted(h.get("extra_principals", {})):
            base_access = b.get("extra_principals", {}).get(principal, {}).get(repo, "none")
            head_access = h["extra_principals"][principal].get(repo, "none")
            if base_access != head_access:
                changed.add((repo, "principal", principal))
    for repo in sorted(set(b.get("secrets", {})) | set(h.get("secrets", {}))):
        if sorted(b["secrets"].get(repo, [])) != sorted(h["secrets"].get(repo, [])):
            changed.add((repo, "secrets"))
    for repo, rn in sorted({(r["repo"], r["rule_name"]) for r in b["protections"]}
                           | {(r["repo"], r["rule_name"]) for r in h["protections"]}):
        base_rule = next((r for r in b["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        head_rule = next((r for r in h["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        if base_rule != head_rule:
            changed.add((repo, "protect", rn))
    for repo, pattern in sorted({(r["repo"], r["name_pattern"]) for r in b["tag_protections"]}
                                | {(r["repo"], r["name_pattern"]) for r in h["tag_protections"]}):
        base_rule = next((r for r in b["tag_protections"] if (r["repo"], r["name_pattern"]) == (repo, pattern)), None)
        head_rule = next((r for r in h["tag_protections"] if (r["repo"], r["name_pattern"]) == (repo, pattern)), None)
        if base_rule != head_rule:
            changed.add((repo, "tag_protect", pattern))
    return changed


def _intended_lines(owner, base_state, head_state):
    """One line per fact the PR's declared delta changes (base -> head), for the
    intended report, split into the auto-applies / hook / branch-protection /
    tag-protection / secret-values halves."""
    b, h = base_state, head_state
    auto, hook, prot, tag_prot, values = [], [], [], [], []
    for repo in sorted(set(b["desired"]) | set(h["desired"])):
        if b["desired"].get(repo, "none") != h["desired"].get(repo, "none"):
            auto.append(f"`{owner}/{repo}` talos access: {b['desired'].get(repo,'none')} -> {h['desired'].get(repo,'none')}")
        if (repo in b["horkos_forge_repos"]) != (repo in h["horkos_forge_repos"]):
            auto.append(f"`{owner}/{repo}` horkos-forge write: {'on' if repo in b['horkos_forge_repos'] else 'off'} -> {'on' if repo in h['horkos_forge_repos'] else 'off'}")
        if b["pools"].get(repo, "none") != h["pools"].get(repo, "none"):
            (hook if b["pools"].get(repo, "none") == "none" else auto).append(
                f"`{owner}/{repo}` talos hook pool: {b['pools'].get(repo,'none')} -> {h['pools'].get(repo,'none')}")
        if (repo in b["release_hook_repos"]) != (repo in h["release_hook_repos"]):
            (hook if repo not in b["release_hook_repos"] else auto).append(
                f"`{owner}/{repo}` horkos release hook: {'on' if repo in b['release_hook_repos'] else 'off'} -> {'on' if repo in h['release_hook_repos'] else 'off'}")
        for principal in sorted(h.get("extra_principals", {})):
            base_access = b.get("extra_principals", {}).get(principal, {}).get(repo, "none")
            head_access = h["extra_principals"][principal].get(repo, "none")
            if base_access != head_access:
                auto.append(f"`{owner}/{repo}` {principal} access: {base_access} -> {head_access}")
    def _names(ns):
        return ", ".join(f"`{n}`" for n in ns) or "(none)"

    for repo in sorted(set(b.get("secrets", {})) | set(h.get("secrets", {}))):
        base_names = sorted(b["secrets"].get(repo, []))
        head_names = sorted(h["secrets"].get(repo, []))
        if base_names != head_names:
            values.append(
                f"`{owner}/{repo}` Actions secrets: {_names(base_names)} -> {_names(head_names)}"
            )
    for repo, rn in sorted({(r["repo"], r["rule_name"]) for r in b["protections"]}
                           | {(r["repo"], r["rule_name"]) for r in h["protections"]}):
        base_rule = next((r for r in b["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        head_rule = next((r for r in h["protections"] if (r["repo"], r["rule_name"]) == (repo, rn)), None)
        if base_rule != head_rule:
            prot.append(f"`{owner}/{repo}` branch protection `{rn}` changed")
    for repo, pattern in sorted({(r["repo"], r["name_pattern"]) for r in b["tag_protections"]}
                                | {(r["repo"], r["name_pattern"]) for r in h["tag_protections"]}):
        base_rule = next((r for r in b["tag_protections"] if (r["repo"], r["name_pattern"]) == (repo, pattern)), None)
        head_rule = next((r for r in h["tag_protections"] if (r["repo"], r["name_pattern"]) == (repo, pattern)), None)
        if base_rule != head_rule:
            tag_prot.append(f"`{owner}/{repo}` tag protection `{pattern}` changed")
    return sorted(set(auto)), sorted(set(hook)), sorted(set(prot)), sorted(set(tag_prot)), sorted(set(values))


def report_pr_check(client, owner, who, head_state, base_state, base_plan, head_plan, pr_base_ref, report_file):
    """PR-check categorization (same-repo PRs only; fork/agent PRs skip to
    --skip-if-no-token before reaching here).

    INTENDED = the PR's declared delta (base -> head): warn only, split into
    auto-applies-on-merge vs the hook/protection halves that need a human run
    after merge. It never fails on its own.

    UNEXPECTED = the live forge's drift vs the PR *base*'s declared state on a
    fact the PR does NOT change (a merged change awaiting a human apply, or
    genuine drift) -> fail. An Actions-secrets violation or an unreadable repo
    also fails.

    Writes the markdown report to report_file (the workflow posts it as a PR
    comment) and fails iff unexpected drift is present.
    """
    changed = _changed_facts(base_state, head_state)
    auto, hook, prot, tag_prot, values = _intended_lines(owner, base_state, head_state)

    def changed_for(repo, fact, rn=None):
        if fact in ("protect", "tag_protect"):
            key = (repo, fact, rn)
        elif fact == "principal":
            key = (repo, "principal", rn)
        else:
            key = (repo, fact)
        return key in changed

    # A PR whose *target* state violates the Actions-secrets fence (it grants
    # write on a repo carrying CI keys) must fail — the merge push refuses the
    # apply, but the check is where the human reads that before merging. Keyed
    # to the head plan (live vs head-declared), so a PR that REMOVES a
    # violation is not penalized for the pre-existing state.
    forbidden = [violation_line(owner, repo, names) for repo, names in head_plan["violations"]]

    unexpected = []
    for repo, verb, want in base_plan["actions"]:
        if not changed_for(repo, "access"):
            unexpected.append(f"{verb} {owner}/{repo} -> {want}" if want != "none" else f"{verb} {owner}/{repo}")
    for repo, verb, want in base_plan["horkos_actions"]:
        if not changed_for(repo, "horkos"):
            unexpected.append(f"horkos-forge {verb} on {owner}/{repo} -> {want}" if want != "none" else f"horkos-forge {verb} on {owner}/{repo}")
    for principal, repo, verb, want in base_plan["extra_actions"]:
        if not changed_for(repo, "principal", principal):
            unexpected.append(f"{principal} {verb} on {owner}/{repo} -> {want}" if want != "none" else f"{principal} {verb} on {owner}/{repo}")
    # A principal the PR removes from the declared set (the top-level
    # `principals` list) leaves the reconciler's management: the apply on
    # main revokes nothing for it, so a base that still grants it cannot be
    # demoted in this PR — the grants would persist under a green check.
    # Demote in two steps: remove the per-repo entries (merge, apply
    # revokes), then drop the list entry.
    demoted = {
        p.lower(): p for p in base_state.get("extra_principals", {})
        if p.lower() not in {q.lower() for q in head_state.get("extra_principals", {})}
    }
    for principal in sorted(demoted.values(), key=str.lower):
        granted = sorted(
            repo for repo, access in base_state["extra_principals"][principal].items()
            if access != "none"
        )
        if granted:
            unexpected.append(
                f"{principal} is removed from the declared `principals` set while the "
                f"base grants it on {', '.join(f'{owner}/{r}' for r in granted)} — the apply "
                f"on main would revoke nothing; remove its per-repo entries first, then "
                f"drop it from the list"
            )
    for repo, verb, _id, kind in base_plan["hook_actions"]:
        if not changed_for(repo, "talos-hook" if kind == "talos" else "release-hook"):
            unexpected.append(f"{verb} {'talos hook' if kind == 'talos' else 'horkos release hook'} on {owner}/{repo}")
    for repo, rn, verb, diff in base_plan["protection_actions"]:
        if not changed_for(repo, "protect", rn):
            detail = (
                "undeclared in branch-protections.json"
                if verb == "delete"
                else ("all fields" if verb == "create" else ", ".join(diff))
            )
            unexpected.append(f"{verb} branch protection {owner}/{repo}:{rn} ({detail})")
    for repo, pattern, verb, diff in base_plan["tag_protection_actions"]:
        if not changed_for(repo, "tag_protect", pattern):
            detail = (
                "undeclared in tag-protections.json"
                if verb == "delete"
                else ("all fields" if verb == "create" else ", ".join(diff))
            )
            unexpected.append(f"{verb} tag protection {owner}/{repo}:{pattern} ({detail})")
    for repo, names in base_plan["violations"]:
        if not changed_for(repo, "access"):
            unexpected.append(violation_line(owner, repo, names))
    # Live-drift Actions secrets on a repo whose declared names the PR leaves
    # unchanged are unexpected like any other live drift: the PR does not
    # intend them, so the check must fail until a human apply lands or they
    # are declared. A repo whose names the PR DOES change is skipped, like the
    # other facts: unrelated live drift on that repo is masked here and caught
    # by the post-merge weekly --check.
    for repo in sorted(base_state.get("secrets", {})):
        if changed_for(repo, "secrets"):
            continue
        live = actions_secrets(client, owner, repo)
        if live is None:
            unexpected.append(f"unreadable Actions secrets on {owner}/{repo}")
            continue
        missing, extra = (
            sorted(set(base_state["secrets"][repo]) - set(live)),
            sorted(set(live) - set(base_state["secrets"][repo])),
        )
        if missing:
            unexpected.append(f"Actions secret missing on {owner}/{repo}: {', '.join(missing)}")
        if extra:
            unexpected.append(f"undeclared live Actions secret on {owner}/{repo}: {', '.join(extra)}")
    if base_plan["blocked"]:
        unexpected.append(f"unreadable repo(s) under {owner}: {', '.join(base_plan['blocked'])}")

    lines = ["**`forge-reconcile` PR check** - forge desired state vs the live forge.", ""]
    if unexpected:
        lines.append(f"### [X] Unexpected drift (live vs `{pr_base_ref}`-declared) - this PR does not intend it")
        lines += [f"- {l}" for l in unexpected] + [""]
        lines.append("_This red is not this PR breaking something: a merged change is awaiting a human apply, or the forge drifted._")
        lines.append("")
    else:
        lines.append("[OK] **No unexpected drift** - the live forge matches main's declared state.")
        lines.append("")
    if forbidden:
        lines.append("### [X] Forbidden - this PR's target state breaks the Actions-secrets fence")
        lines += [f"- {l}" for l in forbidden] + [""]
        lines.append("_A repo granted `write` carries its CI keys to the bot; the merge push refuses this, so it cannot land as declared._")
        lines.append("")
    if auto:
        lines.append("### Intended - auto-applies on merge via the push trigger")
        lines += [f"- {l}" for l in auto] + [""]
    if hook:
        lines.append("### Intended - hook (a human runs `mise run forge-reconcile` from gilbert after merge; the CI token cannot create hooks)")
        lines += [f"- {l}" for l in hook] + [""]
    if prot:
        lines.append("### Intended - branch protection (a human MUST run `mise run forge-reconcile` from gilbert after merge; the CI token cannot apply these)")
        lines += [f"- {l}" for l in prot] + [""]
    if tag_prot:
        lines.append("### Intended - tag protection (a human MUST run `mise run forge-reconcile` from gilbert after merge; the CI token cannot apply these)")
        lines += [f"- {l}" for l in tag_prot] + [""]
    if values:
        lines.append("### Intended - Actions secret names (a human runs `mise run forge-reconcile` after merge; the CI token never writes values)")
        lines += [f"- {l}" for l in values] + [""]

    # Surface intended drift even when it does not fail the check: a warn-only
    # result (notably a revocation) must still be read, so the workflow posts
    # this file as a PR comment whenever it is written.
    if report_file and (forbidden or unexpected or auto or hook or prot or tag_prot or values):
        Path(report_file).write_text("\n".join(lines) + "\n", encoding="utf-8")

    if forbidden:
        console.print("\n[red]PR check: FORBIDDEN - this PR's target state breaks the Actions-secrets fence - failing.[/red]")
        for l in forbidden:
            console.print(f"  [red]{escape(l)}[/red]")
        raise typer.Exit(1)
    if unexpected:
        console.print("\n[red]PR check: UNEXPECTED drift (this PR does not intend it) - failing.[/red]")
        for l in unexpected:
            console.print(f"  [red]{escape(l)}[/red]")
        raise typer.Exit(1)
    if auto or hook or prot or tag_prot or values:
        console.print("\n[yellow]PR check: intended drift only - green; it applies on merge (hook/protection halves need the human run).[/yellow]")
    else:
        console.print("\n[green]PR check: in sync, nothing intended.[/green]")


def plan_action_secrets(client, owner, declared):
    """The values half's plan: (puts, deletes, unreadable_repos). Puts is
    every declared secret — values are write-only, so "in sync" is
    unobservable and the always-PUT is the idempotency the role had
    (201 create / 204 update) — and deletes the live names a repo no longer
    declares. An unreadable repo aborts the apply; preview just reports it."""
    puts, deletes, unreadable = [], [], []
    for repo in sorted(declared):
        live = actions_secrets(client, owner, repo)
        if live is None:
            unreadable.append(repo)
            continue
        puts += [(repo, name) for name in declared[repo]]
        deletes += [(repo, name) for name in sorted(set(live) - set(declared[repo]))]
    return puts, deletes, unreadable


def read_op_secret_value(ref: str) -> str:
    """The 1Password value behind one ACTIONS_SECRET_SOURCES entry.

    The value never reaches output: op's stdout goes straight into the PUT
    body, and every failure path prints only a fixed phrase plus the exit
    status - never op's stderr, where a value could appear (the console is
    teed into a log the failure-report step posts to the PR).
    """
    try:
        result = subprocess.run(
            ["op", "read", ref],
            capture_output=True, text=True, check=True,
            stdin=subprocess.DEVNULL, timeout=30,
        )
    except subprocess.CalledProcessError as exc:
        _abort_secret_value_read(f"op read exited {exc.returncode}")
    except subprocess.TimeoutExpired:
        _abort_secret_value_read("op read timed out")
    except FileNotFoundError:
        _abort_secret_value_read("`op` is not installed")
    return result.stdout.strip()


def _abort_secret_value_read(reason: str) -> None:
    """The red refusal shared by read_op_secret_value's failure paths;
    `reason` is fixed text plus an exit status, so no secret value can ride
    out in it."""
    console.print(f"[red]Could not read the Actions secret value: {reason} - aborting before any PUT or DELETE[/red]")
    raise typer.Exit(1)


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run")] = False,
    check: Annotated[bool, typer.Option("--check")] = False,
    token: Annotated[str | None, typer.Option("--token")] = None,
    skip_if_no_token: Annotated[bool, typer.Option("--skip-if-no-token")] = False,
    pr_base_ref: Annotated[str | None, typer.Option("--pr-base-ref")] = None,
    report_file: Annotated[str | None, typer.Option("--report-file")] = None,
    no_secrets: Annotated[bool, typer.Option("--no-secrets")] = False,
) -> None:
    owner, who, desired, pools, release_hook_repos, horkos_forge_repos, extra_principals = load_policy()
    protections = load_protections((who, HORKOS_FORGE_USER, *sorted(extra_principals)))
    tag_protections = load_tag_protections((who, HORKOS_FORGE_USER, *sorted(extra_principals)))
    preview = dry_run or check
    # The CI path: resolve_token takes $FORGE_REPO_WRITE_TOKEN only when no
    # --token is given. Gates the branch-protection AND the Actions-secret
    # values halves (module docstring).
    ci_token = token is None and bool(os.environ.get("FORGE_REPO_WRITE_TOKEN"))

    resolved = resolve_token(token, skip_if_no_token)
    if resolved is None:
        console.print(
            "[yellow]SKIPPED: $FORGE_REPO_WRITE_TOKEN is not set.[/yellow] Provision it with "
            "`mise run forge-reconcile` (a human run — it reads the value from 1Password)."
        )
        return

    client = httpx.Client(
        base_url=FORGE_URL,
        headers={"Authorization": f"token {resolved}"},
        timeout=30.0,
    )

    with client:
        # The blast-radius invariants folded in from horkos-forge-drift: the
        # horkos-forge bot is not a site admin, blumeops:main stays
        # whitelisted to eblume alone, and release-kit stays writable by
        # eblume alone. They are facts a forge-UI change leaves no diff for,
        # so they run on every --check — the weekly schedule and the PR
        # check alike — not just when a PR is in flight. They need only the
        # check client (the repo-write token can look up the bot user and
        # read blumeops' and release-kit's state), so no extra secret is
        # required. They are a hard stop before the drift plan: a
        # security-boundary failure is more urgent than the grant-set delta
        # it would otherwise precede.
        if check:
            env_findings = Findings()
            check_site_admin(client, env_findings, extra=sorted(extra_principals))
            check_main_whitelist(client, owner, env_findings)
            check_release_kit_writers(client, owner, env_findings)
            check_actions_secret_names(client, owner, env_findings, pr_mode=bool(pr_base_ref))
            # The runner-label drift checks (#1358, #1515, #1526): scan each
            # repo's default-branch workflows once, then check the scan
            # against the declared topology (gated privileged labels,
            # undeclared labels) and the live runners — the live leg hard-
            # fails because a warranted/CI job handed an unserved label queues
            # forever.
            labels, repo_ids, unreadable, skipped_archived = scan_repo_workflow_labels(client, owner)
            for what, detail in unreadable:
                env_findings.unknown(what, detail)
            if labels is not None:
                env_findings.ok(
                    "archived repos cannot target runner labels",
                    f"{len(skipped_archived)} archived repos skipped",
                )
                check_privileged_labels(client, owner, env_findings, labels)
                check_unknown_labels(owner, env_findings, labels)
                check_runner_series(client, owner, env_findings, labels, repo_ids)
            check_runbook_runner_table(env_findings)
            if env_findings.failures:
                raise typer.Exit(1)

        # Every repo the owner has, not just the listed ones — that is what makes
        # removal possible. A repo carrying a stale `talos` grant only shows up
        # here if we go looking for it.
        try:
            all_repos = owner_repos(client, owner)
        except httpx.HTTPStatusError as exc:
            console.print(f"[red]Could not list {escape(owner)}'s repos: {escape(str(exc))}[/red]")
            raise typer.Exit(1) from exc

        unknown = sorted(set(desired) - set(all_repos))
        if unknown:
            console.print(
                f"[red]repos.json lists repos that do not exist under {escape(repr(owner))} "
                f"(or the token cannot see them): {escape(', '.join(unknown))}[/red]"
            )
            raise typer.Exit(1)

        table = Table(title=f"`{escape(who)}` collaborations on {escape(owner)}/*")
        table.add_column("Repo")
        table.add_column("Current")
        table.add_column("Desired")
        table.add_column("Action")

        hook_table = Table(title=f"talos + horkos webhooks and `{escape(who)}` label on {escape(owner)}/*")
        hook_table.add_column("Kind")
        hook_table.add_column("Repo")
        hook_table.add_column("Current")
        hook_table.add_column("Desired")
        hook_table.add_column("Action")

        horkos_table = Table(title=f"`{escape(HORKOS_FORGE_USER)}` collaborations on {escape(owner)}/*")
        horkos_table.add_column("Repo")
        horkos_table.add_column("Current")
        horkos_table.add_column("Desired")
        horkos_table.add_column("Action")

        extra_tables: dict[str, Table] = {}
        for principal in sorted(extra_principals):
            t = Table(title=f"`{escape(principal)}` collaborations on {escape(owner)}/*")
            t.add_column("Repo")
            t.add_column("Current")
            t.add_column("Desired")
            t.add_column("Action")
            extra_tables[principal] = t

        actions: list[tuple[str, str, str]] = []  # (repo, verb, permission)
        # Same shape as `actions`, but for HORKOS_FORGE_USER and driven by
        # repos.json's horkos_forge flag alone — a different collaborator and
        # a different policy axis (exempt from PINNED_READ_ONLY), so its own
        # list keeps the two reconciles disjoint.
        horkos_actions: list[tuple[str, str, str]] = []  # (repo, verb, permission)
        # (principal, repo, verb, permission) — the extra read-only fork-model
        # principals declared via repos.json's `principals`, each granted at
        # most `read` (fenced at load_policy).
        extra_actions: list[tuple[str, str, str, str]] = []
        # (repo, verb, hook_id, kind) — verb in create|update|remove (kind is
        # "talos" or "horkos"); remove also covers extra duplicates on a repo
        # that keeps its first hook.
        hook_actions: list[tuple[str, str, int | None, str]] = []
        label_actions: list[tuple[str, str, str, str]] = []  # (repo, name, color, description)
        label_client: httpx.Client | None = None  # issue-scoped fallback, resolved lazily
        label_skipped = False  # no issue-capable token: warn once, check nothing
        blocked: list[str] = []
        violations: list[tuple[str, list[str]]] = []  # (repo, secret names)
        plan_access: dict[str, tuple[str, str]] = {}  # (have, want) per repo — the secrets fence's plan-time view
        for repo in sorted(all_repos):
            want = desired.get(repo, "none")
            have = current_access(client, owner, repo, who)
            plan_access[repo] = (have, want)
            # horkos-forge half: want follows repos.json's horkos_forge flag and
            # is read against HORKOS_FORGE_USER, not `talos` — the two policies
            # are independent, write on blumeops for horkos-forge is the point
            # (see HORKOS_FORGE_USER), and PINNED_READ_ONLY is a `talos`-desired
            # fence that deliberately does not apply here.
            horkos_want = "write" if repo in horkos_forge_repos else "none"
            horkos_have = current_access(client, owner, repo, HORKOS_FORGE_USER)
            if have == "unreadable" or horkos_have == "unreadable":
                # Reading collaborators needs repo-admin permission. On a repo we were TOLD to
                # manage this is fatal: skipping would silently not apply policy
                # while still reporting success. On an unlisted repo it only means
                # we cannot audit it for a stale grant — warn and move on.
                if repo in desired:
                    blocked.append(repo)
                else:
                    console.print(f"[dim]{escape(owner)}/{escape(repo)}: not readable, not listed — ignoring[/dim]")
                continue

            if have == want:
                verb, style = "ok", "dim"
            elif want == "none":
                verb, style = "revoke", "red"
                actions.append((repo, "revoke", want))
            elif have == "none":
                verb, style = "grant", "green"
                actions.append((repo, "grant", want))
            else:
                verb, style = "update", "yellow"
                actions.append((repo, "update", want))

            if verb != "ok" or want != "none":
                table.add_row(escape(repo), escape(have), escape(want), f"[{style}]{verb}[/{style}]")

            # Same reconcile shape as the `talos` half, against HORKOS_FORGE_USER:
            # want = "write" on horkos_forge-flagged repos, "none" everywhere else
            # (including repos absent from repos.json — stale grants on a repo
            # that left the set are revoked, not left for the drift check).
            if horkos_have == horkos_want:
                horkos_verb, horkos_style = "ok", "dim"
            elif horkos_want == "none":
                horkos_verb, horkos_style = "revoke", "red"
                horkos_actions.append((repo, "revoke", horkos_want))
            elif horkos_have == "none":
                horkos_verb, horkos_style = "grant", "green"
                horkos_actions.append((repo, "grant", horkos_want))
            else:
                horkos_verb, horkos_style = "update", "yellow"
                horkos_actions.append((repo, "update", horkos_want))

            if horkos_verb != "ok" or horkos_want != "none":
                horkos_table.add_row(
                    escape(repo), escape(horkos_have), escape(horkos_want), f"[{horkos_style}]{horkos_verb}[/{horkos_style}]"
                )

            # Extra principals half: same reconcile shape as the other two, but
            # read-only (fenced at load_policy) and driven by `principals`.
            for principal in sorted(extra_principals):
                p_want = extra_principals[principal].get(repo, "none")
                p_have = current_access(client, owner, repo, principal)
                if p_have == p_want:
                    p_verb, p_style = "ok", "dim"
                elif p_want == "none":
                    p_verb, p_style = "revoke", "red"
                    extra_actions.append((principal, repo, "revoke", p_want))
                elif p_have == "none":
                    p_verb, p_style = "grant", "green"
                    extra_actions.append((principal, repo, "grant", p_want))
                else:
                    p_verb, p_style = "update", "yellow"
                    extra_actions.append((principal, repo, "update", p_want))
                if p_verb != "ok" or p_want != "none":
                    extra_tables[principal].add_row(
                        escape(repo), escape(p_have), escape(p_want), f"[{p_style}]{p_verb}[/{p_style}]"
                    )

            # Actions-secrets invariant: write on a repo is read of its secrets
            # (every run executes at the pushed ref), so a write grant on a
            # secrets-carrying repo is refused — even where have == want.
            if want == "write":
                secrets = actions_secrets(client, owner, repo)
                if secrets is None and repo not in blocked:
                    blocked.append(repo)
                elif secrets:
                    violations.append((repo, secrets))
            # Webhook half. Two kinds, both identified by their own delivery
            # URL — never by id, so a hand-created hook with the right URL is
            # adopted, not duplicated: one talos hook (exact event set,
            # active) on every pool repo, and one horkos release hook (push +
            # create + pull_request) on every repo with release_hook: true;
            # none anywhere
            # else. Same admin-visibility rules as collaborators, and the
            # same fatal-if-listed logic — collaborator readability was
            # already checked above, so reaching here means the hook list is
            # readable too (both are repo-admin). Both kinds derive from ONE
            # hook list fetched per repo.
            want_hook = pools.get(repo, "none") != "none"
            want_release_hook = repo in release_hook_repos
            hooks = list_hooks(client, owner, repo)
            if hooks is None:
                if repo in desired and repo not in blocked:
                    blocked.append(repo)
                continue

            hook_have, hook_verb, hook_style = hook_kind_state(
                [h for h in hooks if h.get("config", {}).get("url") == TALOS_HOOK_URL],
                TALOS_HOOK_READ_EVENTS,
                want_hook,
                repo,
                "talos",
                hook_actions,
            )
            release_have, release_verb, release_style = hook_kind_state(
                [h for h in hooks if h.get("config", {}).get("url") == HORKOS_HOOK_URL],
                HORKOS_HOOK_READ_EVENTS,
                want_release_hook,
                repo,
                "horkos",
                hook_actions,
            )

            if hook_verb != "ok" or want_hook:
                hook_table.add_row(
                    "talos",
                    escape(repo),
                    escape(hook_have),
                    "hook" if want_hook else "none",
                    f"[{hook_style}]{hook_verb}[/{hook_style}]",
                )
            if release_verb != "ok" or want_release_hook:
                hook_table.add_row(
                    "horkos",
                    escape(repo),
                    escape(release_have),
                    "hook" if want_release_hook else "none",
                    f"[{release_style}]{release_verb}[/{release_style}]",
                )

            # Label half: pool repos get all three issue-scope labels (the
            # `talos` engagement edge, the `no-agents` suppression edge, and
            # the `needs-proper-review` review edge); elsewhere an existing
            # one is left alone (see the module docstring for why this is
            # create-only, and why there is a fallback token).
            if want_hook and not label_skipped:
                label_specs = (
                    (who, f"#{ENGAGE_LABEL_COLOR}", ENGAGE_LABEL_DESCRIPTION),
                    (NO_AGENTS_LABEL_NAME, f"#{NO_AGENTS_LABEL_COLOR}", NO_AGENTS_LABEL_DESCRIPTION),
                    (NEEDS_REVIEW_LABEL_NAME, f"#{NEEDS_REVIEW_LABEL_COLOR}", NEEDS_REVIEW_LABEL_DESCRIPTION),
                )
                missing = []
                for name, color, description in label_specs:
                    labeled = has_engage_label(client, owner, repo, name)
                    if labeled is None and label_client is None:
                        issue_token = resolve_issue_token()
                        if issue_token is None:
                            label_skipped = True
                            console.print(
                                "[yellow]SKIPPED the label half: this token lacks the issue "
                                "scope and no fallback is available (set FORGE_ISSUE_TOKEN, "
                                "or run locally from gilbert for `op`). Label drift is NOT "
                                "being checked.[/yellow]"
                            )
                            break
                        label_client = httpx.Client(
                            base_url=FORGE_URL,
                            headers={"Authorization": f"token {issue_token}"},
                            timeout=30.0,
                        )
                    if labeled is None and label_client is not None:
                        labeled = has_engage_label(label_client, owner, repo, name)
                    if labeled is None:
                        if repo not in blocked:
                            blocked.append(repo)
                        break
                    if not labeled:
                        missing.append((name, color, description))
                for name, color, description in missing:
                    label_actions.append((repo, name, color, description))
                    hook_table.add_row("label", escape(repo), "no label", "label", "[green]create label[/green]")

        # Branch-protection half: forge/branch-protections.json is the single
        # source of every eblume branch protection.
        protection_table = Table(title=f"branch protections on {escape(owner)}/*")
        protection_table.add_column("Rule")
        protection_table.add_column("Field")
        protection_table.add_column("Current")
        protection_table.add_column("Desired")
        protection_table.add_column("Action")
        if missing_repos := sorted({r["repo"] for r in protections} - set(all_repos)):
            console.print(
                f"[red]{PROTECTIONS_PATH.name} names repos that do not exist under {escape(repr(owner))} "
                f"(or the token cannot see them): {escape(', '.join(missing_repos))}[/red]"
            )
            raise typer.Exit(1)
        protection_actions, live_by_repo = plan_protection_actions(client, owner, all_repos, protections, blocked)
        for repo, rule_name, verb, diff in protection_actions:
            name = f"{repo}:{rule_name}"
            if verb == "delete":
                protection_table.add_row(escape(name), "(rule)", "rule", "none", "[red]delete[/red]")
            elif verb == "create":
                protection_table.add_row(escape(name), "(rule)", "none", "rule", "[green]create[/green]")
            else:
                for field, (have, want) in diff.items():
                    protection_table.add_row(
                        escape(name), field, escape(show(have)), escape(show(want)), "[yellow]update[/yellow]"
                    )
        # The actions list only names drift, so in-sync declared rules get an
        # explicit ok row.
        for repo in sorted({r["repo"] for r in protections}):
            live_rules = live_by_repo.get(repo)
            if live_rules is None:
                continue
            live_by_name = {r["rule_name"]: r for r in live_rules}
            for rule in [r for r in protections if r["repo"] == repo]:
                name = f"{repo}:{rule['rule_name']}"
                live = live_by_name.get(rule["rule_name"])
                if live is not None and not protection_diff(live, rule):
                    protection_table.add_row(escape(name), "", "", "", "[dim]ok[/dim]")

        # Tag-protection half: forge/tag-protections.json is the single source
        # of every eblume tag protection.
        tag_protection_table = Table(title=f"tag protections on {escape(owner)}/*")
        tag_protection_table.add_column("Pattern")
        tag_protection_table.add_column("Field")
        tag_protection_table.add_column("Current")
        tag_protection_table.add_column("Desired")
        tag_protection_table.add_column("Action")
        if missing_tag_repos := sorted({r["repo"] for r in tag_protections} - set(all_repos)):
            console.print(
                f"[red]{TAG_PROTECTIONS_PATH.name} names repos that do not exist under {escape(repr(owner))} "
                f"(or the token cannot see them): {escape(', '.join(missing_tag_repos))}[/red]"
            )
            raise typer.Exit(1)
        tag_protection_actions, tag_live_by_repo = plan_tag_protection_actions(
            client, owner, all_repos, tag_protections, blocked
        )
        for repo, name_pattern, verb, diff in tag_protection_actions:
            name = f"{repo}:{name_pattern}"
            if verb == "delete":
                tag_protection_table.add_row(escape(name), "(rule)", "rule", "none", "[red]delete[/red]")
            elif verb == "create":
                tag_protection_table.add_row(escape(name), "(rule)", "none", "rule", "[green]create[/green]")
            else:
                for field, (have, want) in diff.items():
                    tag_protection_table.add_row(
                        escape(name), field, escape(show(have)), escape(show(want)), "[yellow]update[/yellow]"
                    )
        # In-sync declared rules get an explicit ok row, like branch protections.
        for repo in sorted({r["repo"] for r in tag_protections}):
            live_rules = tag_live_by_repo.get(repo)
            if live_rules is None:
                continue
            live_by_pattern = {r["name_pattern"]: r for r in live_rules}
            for rule in [r for r in tag_protections if r["repo"] == repo]:
                name = f"{repo}:{rule['name_pattern']}"
                live = live_by_pattern.get(rule["name_pattern"])
                if live is not None and not tag_protection_diff(live, rule):
                    tag_protection_table.add_row(escape(name), "", "", "", "[dim]ok[/dim]")

        console.print(table)
        console.print(hook_table)
        console.print(horkos_table)
        for principal in sorted(extra_principals):
            console.print(extra_tables[principal])
        console.print(protection_table)
        console.print(tag_protection_table)

        if blocked:
            console.print(
                f"\n[red]Cannot read collaborators, Actions secrets, branch protections, or tag protections on {len(blocked)} repo(s): "
                f"{escape(', '.join(blocked))}[/red]\n"
                f"Each needs repo-admin permission — this token's user "
                f"is not an admin on them (Forgejo 404s rather than 403s when it cannot see a private "
                f"repo at all, so 'wrong token' and 'no such repo' look identical). "
                f"Refusing to apply a partial policy."
            )
            raise typer.Exit(1)

        if violations and not preview:
            # Refuse the whole apply, not just one repo: granting write would
            # hand the bot that repo's CI keys — there is no partial policy here.
            console.print(
                f"\n[red]Refusing to apply: {len(violations)} repo(s) declare write but carry "
                f"Actions secret(s).[/red]"
            )
            for repo, secret_names in violations:
                console.print(
                    f"[red]  {violation_line(escape(owner), escape(repo), [escape(n) for n in secret_names])}[/red]"
                )
            raise typer.Exit(1)

        in_sync = not (
            actions
            or horkos_actions
            or extra_actions
            or hook_actions
            or label_actions
            or protection_actions
            or tag_protection_actions
            or violations
        )
        # The values half is what a human apply is for: a values-only drift
        # (a newly declared name, a revoked grant's stale value) must keep an
        # apply-mode run from the "In sync." early return. Preview/--check
        # stays green on values-only drift (values are write-only), so the
        # gate is apply-mode only.
        values_pending = False
        if not preview and not no_secrets:
            _v_puts, _v_deletes, _v_unreadable = plan_action_secrets(
                client, owner, declared_actions_secret_names()
            )
            values_pending = bool(_v_puts or _v_deletes or _v_unreadable)
        if in_sync and not values_pending and not (check and pr_base_ref):
            console.print("[green]In sync.[/green]")
            return
        # A PR whose head plan is empty (e.g. one that only removes a branch
        # protection) must still run the intended/unexpected categorization, so
        # in PR-check mode we fall through to the preview/check branch below.

        if preview:
            pending = (
                len(actions)
                + len(horkos_actions)
                + len(extra_actions)
                + len(hook_actions)
                + len(label_actions)
                + len(protection_actions)
                + len(tag_protection_actions)
                + len(violations)
            )
            console.print(f"\n[bold]{pending} change(s) pending.[/bold]")
            for repo, verb, perm in actions:
                console.print(f"  {verb} {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))
            for repo, verb, perm in horkos_actions:
                console.print(f"  {verb} {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))
            for principal, repo, verb, perm in extra_actions:
                console.print(f"  {verb} {escape(principal)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))
            for repo, verb, _hook_id, kind in hook_actions:
                name = "talos hook" if kind == "talos" else "horkos release hook"
                console.print(f"  {verb} {name} on {escape(owner)}/{escape(repo)}")
            for repo, name, _color, _description in label_actions:
                console.print(f"  create `{escape(name)}` label on {escape(owner)}/{escape(repo)}")
            for repo, rule_name, verb, diff in protection_actions:
                detail = (
                    "undeclared in branch-protections.json"
                    if verb == "delete"
                    else ("all fields" if verb == "create" else ", ".join(diff))
                )
                console.print(f"  {verb} branch protection {escape(owner)}/{escape(repo)}:{escape(rule_name)} ({escape(detail)})")
            for repo, name_pattern, verb, diff in tag_protection_actions:
                detail = (
                    "undeclared in tag-protections.json"
                    if verb == "delete"
                    else ("all fields" if verb == "create" else ", ".join(diff))
                )
                console.print(f"  {verb} tag protection {escape(owner)}/{escape(repo)}:{escape(name_pattern)} ({escape(detail)})")
            for repo, secret_names in violations:
                console.print(f"  {violation_line(escape(owner), escape(repo), [escape(n) for n in secret_names])}")
            if not no_secrets:
                s_puts, s_deletes, s_unreadable = plan_action_secrets(
                    client, owner, declared_actions_secret_names()
                )
                for repo, name in s_puts:
                    console.print(f"  [dim]PUT {escape(owner)}/{escape(repo)}:{escape(name)} (value from 1Password — not shown)[/dim]")
                for repo, name in s_deletes:
                    console.print(f"  [dim]DELETE {escape(owner)}/{escape(repo)}:{escape(name)}[/dim]")
                for repo in s_unreadable:
                    console.print(f"  [dim]cannot read Actions secrets on {escape(owner)}/{escape(repo)}[/dim]")
            if check:
                if pr_base_ref:
                    base_state = read_policies_at(pr_base_ref)
                    if base_state is None:
                        console.print(
                            f"\n[red]Cannot read {POLICY_PATH.name} at base {escape(pr_base_ref)} — "
                            "refusing to categorize PR drift without the base's declared state.[/red]"
                        )
                        raise typer.Exit(1)
                    base_state["protections"] = read_protections_at(pr_base_ref)
                    if base_state["protections"] is None:
                        console.print(
                            f"\n[red]Cannot read {PROTECTIONS_PATH.name} at base {escape(pr_base_ref)} - "
                            "refusing to categorize PR drift against an empty protection set.[/red]"
                        )
                        raise typer.Exit(1)
                    base_state["tag_protections"] = read_tag_protections_at(pr_base_ref)
                    if base_state["tag_protections"] is None:
                        console.print(
                            f"\n[red]Cannot read {TAG_PROTECTIONS_PATH.name} at base {escape(pr_base_ref)} - "
                            "refusing to categorize PR drift against an empty tag-protection set.[/red]"
                        )
                        raise typer.Exit(1)
                    base_state["secrets"] = actions_secret_names_at(pr_base_ref)
                    base_plan = plan_at(client, owner, who, base_state, base_state["protections"], base_state["tag_protections"])
                    head_state = {"desired": desired, "pools": pools,
                                  "release_hook_repos": release_hook_repos,
                                  "horkos_forge_repos": horkos_forge_repos,
                                  "extra_principals": extra_principals,
                                  "protections": protections,
                                  "tag_protections": tag_protections,
                                  "secrets": declared_actions_secret_names()}
                    head_plan = {"violations": violations, "blocked": blocked}
                    report_pr_check(client, owner, who, head_state, base_state, base_plan,
                                    head_plan, pr_base_ref, report_file)
                    return

                console.print("\n[red]Out of sync (--check).[/red]")
                raise typer.Exit(1)
            return

        for repo, verb, perm in actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{who}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))

        # The horkos-forge half applies exactly like the talos half: PUT a
        # write grant / DELETE it, through the same mutation loop shape.
        for repo, verb, perm in horkos_actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{HORKOS_FORGE_USER}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {escape(HORKOS_FORGE_USER)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))

        # The extra principals half applies exactly like the other two: PUT a
        # read grant / DELETE it, through the same mutation loop shape.
        for principal, repo, verb, perm in extra_actions:
            path = f"/api/v1/repos/{owner}/{repo}/collaborators/{principal}"
            try:
                if verb == "revoke":
                    client.delete(path).raise_for_status()
                else:
                    client.put(path, json={"permission": perm}).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {escape(principal)} on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            console.print(f"[green]{verb}[/green] {escape(principal)} on {escape(owner)}/{escape(repo)}" + (f" → {escape(perm)}" if perm != "none" else ""))

        # Each kind's signing secret is fetched independently, and up front
        # only if a create of that kind is pending — so a missing secret fails
        # before any hook is touched. An update normally needs no secret (the
        # routine CI applies: events drift, repo leaves the pool / release
        # set), with one exception handled below: when the read-back shows
        # Forgejo's edit path dropped events, the hook is recreated, and that
        # resolves the secret lazily — in CI it fails loudly and asks for a
        # local run, exactly like a create.
        secrets_by_kind: dict[str, str] = {}
        if any(v == "create" and k == "talos" for _, v, _h, k in hook_actions):
            secrets_by_kind["talos"] = resolve_webhook_secret()
        if any(v == "create" and k == "horkos" for _, v, _h, k in hook_actions):
            secrets_by_kind["horkos"] = resolve_horkos_hook_secret()

        def hook_secret(kind: str) -> str:
            if kind not in secrets_by_kind:
                secrets_by_kind[kind] = (
                    resolve_webhook_secret() if kind == "talos" else resolve_horkos_hook_secret()
                )
            return secrets_by_kind[kind]

        def create_hook(repo: str, kind: str) -> dict:
            hook_url = TALOS_HOOK_URL if kind == "talos" else HORKOS_HOOK_URL
            send_events = TALOS_HOOK_SEND_EVENTS if kind == "talos" else HORKOS_HOOK_SEND_EVENTS
            response = client.post(
                f"/api/v1/repos/{owner}/{repo}/hooks",
                json={
                    "type": "forgejo",
                    "active": True,
                    "events": sorted(send_events),
                    "config": {
                        "url": hook_url,
                        "content_type": "json",
                        "secret": hook_secret(kind),
                    },
                },
            )
            response.raise_for_status()
            return response.json()

        def read_hook(repo: str, hook_id: int) -> dict:
            response = client.get(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}")
            response.raise_for_status()
            return response.json()

        for repo, verb, hook_id, kind in hook_actions:
            name = "talos hook" if kind == "talos" else "horkos release hook"
            send_events = TALOS_HOOK_SEND_EVENTS if kind == "talos" else HORKOS_HOOK_SEND_EVENTS
            read_events = TALOS_HOOK_READ_EVENTS if kind == "talos" else HORKOS_HOOK_READ_EVENTS
            try:
                if verb == "create":
                    after = read_hook(repo, create_hook(repo, kind)["id"])
                elif verb == "update":
                    assert hook_id is not None  # the planner always names the keeper
                    client.patch(
                        f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}",
                        json={"events": sorted(send_events), "active": True},
                    ).raise_for_status()
                    # Never trust the 200: Forgejo's API edit path (v16.0.2
                    # routers/api/v1/utils/hook.go editHook) maps every event
                    # EXCEPT the action_run_* trio, so a PATCH carrying them
                    # succeeds and changes nothing — the four horkos hooks
                    # sat "drifted → update" on every run for three days that
                    # way (2026-09-21..24, eblume/horkos#40). The create path
                    # does map them, so when the read-back disagrees, replace
                    # the hook: create the new one first (no delivery gap),
                    # then delete the old.
                    after = read_hook(repo, hook_id)
                    if not hook_in_sync(after, read_events):
                        still_missing = sorted(set(read_events) - set(after.get("events") or []))
                        console.print(
                            f"[yellow]edit did not stick[/yellow] on {name} on {escape(owner)}/{escape(repo)} "
                            f"(still missing {escape(', '.join(still_missing)) or 'nothing — inactive'}); "
                            "recreating it through the create API"
                        )
                        created = create_hook(repo, kind)
                        client.delete(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}").raise_for_status()
                        after = read_hook(repo, created["id"])
                        verb = "recreate"
                else:
                    assert hook_id is not None  # likewise for a removal
                    client.delete(f"/api/v1/repos/{owner}/{repo}/hooks/{hook_id}").raise_for_status()
                    after = None
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {name} on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            if after is not None and not hook_in_sync(after, read_events):
                console.print(
                    f"[red]{verb} {name} on {escape(owner)}/{escape(repo)} did not converge:[/red] "
                    f"read-back events {escape(str(sorted(after.get('events') or [])))}, "
                    f"active={after.get('active')}"
                )
                raise typer.Exit(1)
            console.print(f"[green]{verb}[/green] {name} on {escape(owner)}/{escape(repo)}")

        for repo, name, color, description in label_actions:
            try:
                (label_client or client).post(
                    f"/api/v1/repos/{owner}/{repo}/labels",
                    json={
                        "name": name,
                        "color": color,
                        "description": description,
                    },
                ).raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(
                    f"[red]create `{escape(name)}` label on {escape(owner)}/{escape(repo)} failed: {escape(str(exc))}[/red]\n"
                    "Label management sits in Forgejo's issue scope — if this was a 403 "
                    "under the CI token (write:repository only), run this task locally "
                    "from gilbert."
                )
                raise typer.Exit(1) from exc
            console.print(f"[green]create[/green] `{escape(name)}` label on {escape(owner)}/{escape(repo)}")

        # Last, so a CI apply still lands the other halves before refusing
        # this one (module docstring: protections apply from a human run).
        if protection_actions and ci_token:
            console.print(
                f"\n[red]Refusing {len(protection_actions)} branch protection change(s) under the CI token.[/red] "
                "Branch protection is applied only from a human run: `mise run forge-reconcile` "
                "(1Password, biometric) after reviewing `--dry-run`."
            )
            raise typer.Exit(1)
        for repo, rule_name, verb, diff in protection_actions:
            label = f"branch protection {escape(owner)}/{escape(repo)}:{escape(rule_name)}"
            base = f"/api/v1/repos/{owner}/{repo}/branch_protections"
            if verb == "delete":
                # Undeclared live rule: there is no declared `rule` to diff
                # against — delete it, then re-list to prove it is gone.
                try:
                    client.delete(f"{base}/{quote(rule_name, safe='')}").raise_for_status()
                    after = list_protections(client, owner, repo)
                except httpx.HTTPStatusError as exc:
                    console.print(f"[red]{verb} {label} failed: {escape(str(exc))}[/red]")
                    raise typer.Exit(1) from exc
                if after is None:
                    console.print(
                        f"[red]{verb} {label} did not converge: cannot read back "
                        f"{escape(owner)}/{escape(repo)}'s protections.[/red]"
                    )
                    raise typer.Exit(1)
                if rule_name in {r["rule_name"] for r in after}:
                    console.print(f"[red]{verb} {label} did not converge: still present[/red]")
                    raise typer.Exit(1)
                console.print(f"[green]{verb}[/green] {label}")
                continue
            rule = next(r for r in protections if r["repo"] == repo and r["rule_name"] == rule_name)
            try:
                if verb == "create":
                    client.post(
                        base, json={"rule_name": rule_name, **{f: rule[f] for f in PROTECTION_FIELDS}}
                    ).raise_for_status()
                else:
                    client.patch(
                        f"{base}/{quote(rule_name, safe='')}", json={f: rule[f] for f in diff}
                    ).raise_for_status()
                resp = client.get(f"{base}/{quote(rule_name, safe='')}")
                resp.raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {label} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            # Read back the whole rule, not just the fields sent: the hook
            # half learned that a Forgejo edit can answer 200 and change nothing.
            if left := protection_diff(resp.json(), rule):
                console.print(
                    f"[red]{verb} {label} did not converge:[/red] still differs on {escape(', '.join(left))}"
                )
                raise typer.Exit(1)
            console.print(f"[green]{verb}[/green] {label}")

        # Same gate as branch protections: a CI apply lands the other halves,
        # then refuses the tag half — a human run applies it.
        if tag_protection_actions and ci_token:
            console.print(
                f"\n[red]Refusing {len(tag_protection_actions)} tag protection change(s) under the CI token.[/red] "
                "Tag protection is applied only from a human run: `mise run forge-reconcile` "
                "(1Password, biometric) after reviewing `--dry-run`."
            )
            raise typer.Exit(1)
        for repo, name_pattern, verb, diff in tag_protection_actions:
            label = f"tag protection {escape(owner)}/{escape(repo)}:{escape(name_pattern)}"
            base = f"/api/v1/repos/{owner}/{repo}/tag_protections"
            if verb == "delete":
                # Undeclared live rule: there is no declared `rule` to diff
                # against — resolve its numeric id from the live list, delete
                # it, then re-list to prove it is gone.
                try:
                    live = list_tag_protections(client, owner, repo)
                    if live is None:
                        console.print(
                            f"[red]{verb} {label} did not converge: cannot read back "
                            f"{escape(owner)}/{escape(repo)}'s tag protections.[/red]"
                        )
                        raise typer.Exit(1)
                    the_id = next(
                        (r["id"] for r in live if r["name_pattern"] == name_pattern), None
                    )
                    if the_id is None:
                        console.print(
                            f"[red]{verb} {label} did not converge:[/red] "
                            f"the live rule {escape(name_pattern)} vanished between plan and apply"
                        )
                        raise typer.Exit(1)
                    client.delete(f"{base}/{the_id}").raise_for_status()
                    after = list_tag_protections(client, owner, repo)
                except httpx.HTTPStatusError as exc:
                    console.print(f"[red]{verb} {label} failed: {escape(str(exc))}[/red]")
                    raise typer.Exit(1) from exc
                if after is None:
                    console.print(
                        f"[red]{verb} {label} did not converge: cannot read back "
                        f"{escape(owner)}/{escape(repo)}'s tag protections.[/red]"
                    )
                    raise typer.Exit(1)
                if name_pattern in {r["name_pattern"] for r in after}:
                    console.print(f"[red]{verb} {label} did not converge: still present[/red]")
                    raise typer.Exit(1)
                console.print(f"[green]{verb}[/green] {label}")
                continue
            rule = next(r for r in tag_protections if r["repo"] == repo and r["name_pattern"] == name_pattern)
            try:
                if verb == "create":
                    resp = client.post(base, json={f: rule[f] for f in TAG_PROTECTION_FIELDS})
                    resp.raise_for_status()
                    # The id is server-assigned; read it back, then verify the
                    # whole object below rather than trusting the POST echo.
                    the_id = resp.json()["id"]
                else:
                    live = list_tag_protections(client, owner, repo)
                    if live is None:
                        console.print(
                            f"[red]{verb} {label} did not converge: cannot read back "
                            f"{escape(owner)}/{escape(repo)}'s tag protections.[/red]"
                        )
                        raise typer.Exit(1)
                    the_id = next(
                        (r["id"] for r in live if r["name_pattern"] == name_pattern), None
                    )
                    if the_id is None:
                        console.print(
                            f"[red]{verb} {label} did not converge:[/red] "
                            f"the live rule {escape(name_pattern)} vanished between plan and apply"
                        )
                        raise typer.Exit(1)
                    client.patch(f"{base}/{the_id}", json={f: rule[f] for f in diff}).raise_for_status()
                resp = client.get(f"{base}/{the_id}")
                resp.raise_for_status()
            except httpx.HTTPStatusError as exc:
                console.print(f"[red]{verb} {label} failed: {escape(str(exc))}[/red]")
                raise typer.Exit(1) from exc
            # Read back the whole rule, not just the fields sent: the hook
            # half learned that a Forgejo edit can answer 200 and change nothing.
            if left := tag_protection_diff(resp.json(), rule):
                console.print(
                    f"[red]{verb} {label} did not converge:[/red] still differs on {escape(', '.join(left))}"
                )
                raise typer.Exit(1)
            console.print(f"[green]{verb}[/green] {label}")

        # The Actions-secret values half — last, so the grant half has already
        # landed (the symmetric fence checks the plan-time grant state below).
        # Names
        # come from forge/actions-secrets.json; values from 1Password via the
        # in-code ACTIONS_SECRET_SOURCES allowlist. No secret value is ever
        # printed; the CI token (report-only) never reads one from 1Password.
        if not no_secrets:
            secret_puts, secret_deletes, secret_unreadable = plan_action_secrets(
                client, owner, declared_actions_secret_names()
            )
            if ci_token:
                # Report, never apply: values live in 1Password and only a
                # human (biometric) run may read them. Name drift is what the
                # weekly --check fails on; here one dim line covers it.
                console.print(
                    f"[dim]{len(secret_puts)} Actions-secret PUT(s) + {len(secret_deletes)} DELETE(s) "
                    "not applied under the CI token — values come from 1Password and a human run only: "
                    "`mise run forge-reconcile` on a machine with biometric access "
                    "(see forge/actions-secrets.json)[/dim]"
                )
            else:
                if secret_unreadable:
                    # A failed read aborts, never deletes.
                    console.print(
                        f"[red]Cannot read Actions secrets on {escape(', '.join(secret_unreadable))} — "
                        "refusing to touch its Actions secrets.[/red]"
                    )
                    raise typer.Exit(1)
                # The symmetric fence on the plan-time grant state (the grant
                # half runs first, so a live write grant was just revoked in
                # this run -> "re-run", not a violation; a write declared in
                # repos.json blocks either way). A repo the token can't read
                # is already in `blocked`.
                refusals: dict[str, tuple[str, str]] = {}
                for repo, _name in secret_puts:
                    have, want = plan_access.get(repo, ("unreadable", "none"))
                    if have == "unreadable":
                        # No plan-time entry: the repo is invisible to the
                        # token, so the fence cannot verify it.
                        refusals.setdefault(repo, (have, want))
                    elif want == "write" or have in ("write", "admin"):
                        refusals.setdefault(repo, (have, want))
                if refusals:
                    console.print("\n[red]Refusing to PUT Actions secrets:[/red]")
                    for repo, (have, want) in sorted(refusals.items()):
                        if want == "write":
                            console.print(
                                f"[red]  {escape(owner)}/{escape(repo)}: repos.json declares `write` for `talos` "
                                f"— write on a repo is read of its Actions secrets[/red]"
                            )
                        elif have in ("write", "admin"):
                            console.print(
                                f"[red]  {escape(owner)}/{escape(repo)}: the `talos` write grant was just "
                                "revoked in this run; re-run `mise run forge-reconcile`[/red]"
                            )
                        else:
                            console.print(
                                f"[red]  {escape(owner)}/{escape(repo)}: cannot read the `talos` grant "
                                f"— refusing[/red]"
                            )
                    raise typer.Exit(1)
                values: dict[tuple[str, str], str] = {}
                for repo, name in secret_puts:
                    values[(repo, name)] = read_op_secret_value(ACTIONS_SECRET_SOURCES[(repo, name)])
                for repo, name in secret_puts:
                    try:
                        client.put(
                            f"/api/v1/repos/{owner}/{repo}/actions/secrets/{quote(name, safe='')}",
                            json={"data": values[(repo, name)]},
                        ).raise_for_status()
                    except httpx.HTTPStatusError as exc:
                        console.print(
                            f"[red]PUT {escape(owner)}/{escape(repo)}:{escape(name)} failed: "
                            f"HTTP {exc.response.status_code}[/red]"
                        )
                        raise typer.Exit(1) from exc
                    console.print(f"[green]PUT[/green] {escape(owner)}/{escape(repo)}:{escape(name)}")
                for repo, name in secret_deletes:
                    try:
                        client.delete(
                            f"/api/v1/repos/{owner}/{repo}/actions/secrets/{quote(name, safe='')}"
                        ).raise_for_status()
                    except httpx.HTTPStatusError as exc:
                        console.print(
                            f"[red]DELETE {escape(owner)}/{escape(repo)}:{escape(name)} failed: "
                            f"HTTP {exc.response.status_code}[/red]"
                        )
                        raise typer.Exit(1) from exc
                    console.print(f"[red]DELETE[/red] {escape(owner)}/{escape(repo)}:{escape(name)}")

        applied = (
            len(actions) + len(horkos_actions) + len(extra_actions) + len(hook_actions) + len(label_actions) + len(protection_actions) + len(tag_protection_actions)
        )
        if not no_secrets and not ci_token:
            applied += len(secret_puts) + len(secret_deletes)
        console.print(f"\n[green]Applied {applied} change(s).[/green]")


if __name__ == "__main__":
    typer.run(main)
