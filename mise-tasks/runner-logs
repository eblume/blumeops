#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx==0.28.1", "rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="List recent Forgejo Actions runs or fetch logs for a specific job"
#USAGE arg "[run_number]" help="Run number to show jobs for (omit to list recent runs)"
#USAGE flag "--job -j <job>" help="Job index (0-based) to fetch logs for"
#USAGE flag "--runner -r <runner>" help="Filter listing by runner: indri, ringtail, or all"
#USAGE flag "--repo <repo>" help="Forge repo (owner/name), default: detected from git remote"
#USAGE flag "--limit -n <limit>" help="Max runs to display (0 for all)"
#USAGE flag "--attempt -a <attempt>" help="Job attempt to fetch (default: the latest)"
#USAGE flag "--token <token>" help="Forgejo API token (default: read from 1Password)"
"""List recent Forgejo Actions runs and fetch job logs.

Usage:
    mise run runner-logs                          # list recent runs (default 15)
    mise run runner-logs -n 0                     # list ALL runs
    mise run runner-logs -r ringtail              # list recent ringtail runs
    mise run runner-logs --repo eblume/hermes     # list runs for a different repo
    mise run runner-logs 474                      # show jobs in run 474
    mise run runner-logs 474 -j 1                 # fetch logs for job 1 of run 474
    mise run runner-logs 474 -j 1 -a 2            # ...second attempt of that job
"""

import os
import re
import subprocess
import sys
from typing import Annotated

import httpx
import typer
from rich.console import Console
from rich.table import Table

# FORGE_URL is for human-facing links only. API calls use the tailnet name:
# reachable from an agent pod since the stage-2 egress gateway (an HTTP proxy
# plain httpx speaks), while the public forge.eblu.me is HTTPS-poison
# in-cluster — DNS-rewritten to indri, whose Caddy holds no cert for it
# (docs/reference/services/argocd.md).
FORGE_URL = "https://forge.eblu.me"
FORGE_API = "https://forge.ops.eblu.me/api/v1"
OP_TOKEN_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/w3663ffnvkewbftncqxtcpeavy/api-token"

# Workflows using the ringtail nix-container-builder runner; everything else
# runs on the indri k8s runner.
RINGTAIL_WORKFLOWS = {"build-container-nix.yaml"}

app = typer.Typer(add_completion=False)


def resolve_token(explicit_token: str | None, console: Console) -> str:
    """Resolve Forgejo API token: explicit flag > FORGEJO_TOKEN env > 1Password.

    The `op` call is bounded on every axis. It misparses non-TTY stdin as an
    item template, so inheriting the parent's stdin makes it block forever on
    whatever happens to be there; a timeout keeps even an unforeseen stall
    finite; and a failed read reports what to do instead of a traceback.
    """
    if explicit_token:
        return explicit_token
    env_token = os.environ.get("FORGEJO_TOKEN", "").strip()
    if env_token:
        return env_token
    console.print("[dim]Reading Forgejo API token from 1Password...[/dim]")
    try:
        result = subprocess.run(
            ["op", "read", OP_TOKEN_REF],
            capture_output=True,
            text=True,
            check=True,
            stdin=subprocess.DEVNULL,
            timeout=30,
        )
    except subprocess.TimeoutExpired:
        console.print("[red]op read timed out after 30s.[/red]")
        console.print("Pass --token, or set FORGEJO_TOKEN.")
        raise typer.Exit(1) from None
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        detail = getattr(exc, "stderr", "") or str(exc)
        console.print(f"[red]Could not read the token from 1Password: {detail.strip()}[/red]")
        console.print("Pass --token, or set FORGEJO_TOKEN.")
        raise typer.Exit(1) from exc
    return result.stdout.strip()


def detect_repo_from_git() -> str | None:
    """Sniff owner/repo from a git remote, preferring `upstream` over `origin`.

    Under the fork model an agent clone's `origin` is the bot's fork, which has
    no Actions of its own — asking it for runs yields a bare 404. Canonical is
    `upstream`, and that is where the runs are. On a plain clone there is no
    `upstream` and `origin` already is canonical, so the preference is a no-op.
    """
    for remote in ("upstream", "origin"):
        try:
            result = subprocess.run(
                ["git", "remote", "get-url", remote],
                capture_output=True,
                text=True,
                check=True,
            )
        except (subprocess.CalledProcessError, FileNotFoundError):
            continue
        url = result.stdout.strip()
        # Only use it if the remote points at our forge
        if "forge.ops.eblu.me" not in url and "forge.eblu.me" not in url:
            continue
        # Match SSH (git@host:owner/repo.git) or HTTPS (https://host/owner/repo.git)
        if m := re.search(r"[/:]([^/]+/[^/]+?)(?:\.git)?$", url):
            return m.group(1)
    return None


def runner_for_workflow(workflow_id: str) -> str:
    return "ringtail" if workflow_id in RINGTAIL_WORKFLOWS else "indri"


def auth_headers(token: str) -> dict[str, str]:
    return {"Authorization": f"token {token}"}


def fetch_tasks(repo: str, token: str) -> list[dict]:
    """Fetch all tasks from the Forgejo API, paginating if needed."""
    tasks: list[dict] = []
    page = 1
    while True:
        resp = httpx.get(
            f"{FORGE_API}/repos/{repo}/actions/tasks",
            params={"page": page, "limit": 50},
            headers=auth_headers(token),
            timeout=15,
        )
        resp.raise_for_status()
        batch = resp.json().get("workflow_runs", [])
        if not batch:
            break
        tasks.extend(batch)
        page += 1
    return tasks


def resolve_run_id(repo: str, run_number: int, token: str) -> int | None:
    """Map a repo-visible run number to the global run id the API is keyed by.

    Every `/actions/runs*` route resolves its `{run_id}` with `GetRunByID`, so
    it wants the global id (1325), not the number in the URL you clicked (25).
    The listing carries both: `index_in_repo` is the per-repo number.
    """
    page = 1
    while True:
        resp = httpx.get(
            f"{FORGE_API}/repos/{repo}/actions/runs",
            params={"page": page, "limit": 50},
            headers=auth_headers(token),
            timeout=15,
        )
        resp.raise_for_status()
        batch = resp.json().get("workflow_runs", [])
        if not batch:
            return None
        for run in batch:
            if run.get("index_in_repo") == run_number:
                return run["id"]
        page += 1


def list_run_jobs(repo: str, run_id: int, token: str) -> list[dict] | None:
    """Jobs of a run, or None when the forge predates the endpoint.

    `/actions/runs/{run_id}/jobs` arrived in Forgejo v16.0.0; on v15 the route
    is simply absent and the router answers a bare 404. Callers pass a run_id
    that `resolve_run_id` just found in the listing, so the run is known to
    exist — a 404 here means the endpoint is missing, not the run.
    """
    resp = httpx.get(
        f"{FORGE_API}/repos/{repo}/actions/runs/{run_id}/jobs",
        headers=auth_headers(token),
        timeout=15,
    )
    if resp.status_code == 404:
        return None
    resp.raise_for_status()
    return resp.json()


def list_runs(runner: str, repo: str, limit: int, token: str, console: Console) -> None:
    """List recent workflow runs, grouped by run number."""
    tasks = fetch_tasks(repo, token)

    # Group tasks by run_number
    runs: dict[int, list[dict]] = {}
    for t in tasks:
        rn = t["run_number"]
        runs.setdefault(rn, []).append(t)

    table = Table(title=f"Recent runs — {repo} (filter: {runner})")
    table.add_column("Run #", style="cyan", no_wrap=True)
    table.add_column("Status")
    table.add_column("Runner")
    table.add_column("Jobs")
    table.add_column("Title")
    table.add_column("Event")

    shown = 0
    for rn in sorted(runs, reverse=True):
        if limit > 0 and shown >= limit:
            break

        jobs = sorted(runs[rn], key=lambda x: x["id"])
        workflow_id = jobs[0].get("workflow_id", "")
        host = runner_for_workflow(workflow_id)
        if runner != "all" and host != runner:
            continue

        # Aggregate status: worst status wins
        statuses = [j.get("status", "") for j in jobs]
        if "failure" in statuses:
            status, style = "failure", "red"
        elif "running" in statuses or "waiting" in statuses:
            status, style = "running", "yellow"
        elif all(s == "success" for s in statuses):
            status, style = "success", "green"
        else:
            status, style = statuses[0], "yellow"

        job_names = ", ".join(j.get("name", "?")[:30] for j in jobs)
        title = (jobs[0].get("display_title") or "")[:40]
        event = jobs[0].get("event", "")

        table.add_row(
            str(rn),
            f"[{style}]{status}[/{style}]",
            host,
            job_names,
            title,
            event,
        )
        shown += 1

    console.print(table)
    console.print("\n[dim]Use: mise run runner-logs <run#>        to see jobs in a run[/dim]")
    console.print("[dim]      mise run runner-logs <run#> -j N   to fetch logs for job N[/dim]")


def status_style(status: str) -> str:
    return "green" if status == "success" else "red" if status == "failure" else "yellow"


def show_jobs(run_number: int, repo: str, token: str, console: Console) -> None:
    """Show the jobs within a specific run.

    The `Job #` printed here is the index `-j N` takes, so this listing has to
    enumerate the same sequence `fetch_log` does — the jobs of the run. The
    pre-v16 fallback enumerates *tasks* instead, which is one entry per
    execution: a re-run job appears twice and the indices shift under you.
    """
    run_id = resolve_run_id(repo, run_number, token)
    if run_id is None:
        typer.echo(f"Error: no run #{run_number} in {repo}", err=True)
        raise typer.Exit(1)

    jobs = list_run_jobs(repo, run_id, token)
    table = Table(title=f"Jobs in run #{run_number} — {repo}")
    table.add_column("Job #", style="cyan", no_wrap=True)
    table.add_column("Status")
    table.add_column("Name")

    if jobs is not None:
        table.add_column("Attempt")
        table.add_column("Runs on")
        for i, job in enumerate(jobs):
            status = job.get("status", "")
            table.add_row(
                str(i),
                f"[{status_style(status)}]{status}[/{status_style(status)}]",
                job.get("name", ""),
                str(job.get("attempt", "")),
                ", ".join(job.get("runs_on") or []),
            )
    else:
        table.add_column("Created")
        tasks = sorted(
            [t for t in fetch_tasks(repo, token) if t["run_number"] == run_number],
            key=lambda x: x["id"],
        )
        if not tasks:
            typer.echo(f"Error: No jobs found for run #{run_number}", err=True)
            raise typer.Exit(1)
        for i, task in enumerate(tasks):
            status = task.get("status", "")
            table.add_row(
                str(i),
                f"[{status_style(status)}]{status}[/{status_style(status)}]",
                task.get("name", ""),
                task.get("created_at", ""),
            )

    console.print(table)
    if jobs is None:
        console.print(
            "\n[yellow]This forge predates the jobs REST API (Forgejo < 16.0.0); "
            "rows above are tasks, so a re-run job is listed once per attempt."
            "[/yellow]"
        )
    console.print(f"\n[dim]Use: mise run runner-logs {run_number} -j N   to fetch logs for job N[/dim]")


def fetch_log_via_api(
    repo: str, run_id: int, job_index: int, attempt: int | None, token: str
) -> str | None:
    """Job log from `/actions/jobs/{job_id}/logs`, or None on a pre-v16 forge.

    This is the only route that honours an API token, which makes it the only
    route that can read a **private** repo's log. Forgejo does not accept token
    auth on web routes at all, so the web fallback below is always an anonymous
    request — fine for a public repo, a 404 for every private one.
    """
    jobs = list_run_jobs(repo, run_id, token)
    if jobs is None:
        return None
    if job_index < 0 or job_index >= len(jobs):
        typer.echo(
            f"Error: job index {job_index} out of range (run has {len(jobs)} jobs)",
            err=True,
        )
        raise typer.Exit(1)

    job = jobs[job_index]
    params = {"attempt": attempt} if attempt is not None else {}
    resp = httpx.get(
        f"{FORGE_API}/repos/{repo}/actions/jobs/{job['id']}/logs",
        params=params,
        headers=auth_headers(token),
        timeout=60,
    )
    if resp.status_code == 404:
        # The job exists, so a 404 is about the log: never executed, or expired
        # out of log storage. Both are terminal — don't fall back to the web
        # route, which would only report the same absence less clearly.
        typer.echo(
            f"Error: no stored log for job {job_index} ({job.get('name', '?')}, "
            f"status {job.get('status', '?')}, attempt "
            f"{attempt if attempt is not None else job.get('attempt', '?')}) — "
            "the job never ran, or its log has expired.",
            err=True,
        )
        raise typer.Exit(1)
    resp.raise_for_status()
    return resp.text


def fetch_log_via_web(run_number: int, job_index: int, repo: str, token: str) -> str | None:
    """Pre-v16 fallback: the web log route, which is public-repo-only.

    /{repo}/actions/runs/{run}/jobs/{job}/attempt/{n}/logs serves the raw log,
    but as a *web* route it ignores API tokens entirely — every auth form
    (token, Bearer, basic, ?token=) leaves the request anonymous, so a private
    repo answers 404. Attempts are probed upward; the latest attempt's log wins.
    """
    web_url = f"{FORGE_URL}/{repo}/actions/runs/{run_number}/jobs/{job_index}"
    log_text: str | None = None
    attempt = 1
    while attempt <= 50:
        resp = httpx.get(
            f"{web_url}/attempt/{attempt}/logs",
            headers=auth_headers(token),
            timeout=30,
            follow_redirects=True,
        )
        if resp.status_code != 200:
            break
        log_text = resp.text
        attempt += 1
    return log_text


def fetch_log(
    run_number: int, job_index: int, repo: str, attempt: int | None, token: str
) -> None:
    """Print one job's log, preferring the REST API over the web route."""
    run_id = resolve_run_id(repo, run_number, token)
    if run_id is None:
        typer.echo(f"Error: no run #{run_number} in {repo}", err=True)
        raise typer.Exit(1)

    log_text = fetch_log_via_api(repo, run_id, job_index, attempt, token)
    if log_text is None:
        if attempt is not None:
            typer.echo(
                "Error: --attempt needs the job-log REST API, which this forge "
                "predates (Forgejo < 16.0.0).",
                err=True,
            )
            raise typer.Exit(1)
        log_text = fetch_log_via_web(run_number, job_index, repo, token)

    if log_text is None:
        typer.echo(
            f"Error: no log available for run #{run_number} job {job_index}.\n"
            "This forge predates the job-log REST API (Forgejo < 16.0.0), so the "
            "only route left is the web one — and that route ignores API tokens, "
            "so it can only read public repos. Upgrade the forge to >= 16.0.2 "
            "(see docs/how-to/operations/upgrade-forgejo.md), or read it in a "
            "browser:",
            err=True,
        )
        typer.echo(
            f"{FORGE_URL}/{repo}/actions/runs/{run_number}/jobs/{job_index}", err=True
        )
        raise typer.Exit(1)
    sys.stdout.write(log_text)


@app.command()
def main(
    run_number: Annotated[
        int | None,
        typer.Argument(help="Run number to show jobs for (omit to list recent runs)"),
    ] = None,
    job: Annotated[
        int | None,
        typer.Option("--job", "-j", help="Job index (0-based) to fetch logs for"),
    ] = None,
    runner: Annotated[
        str,
        typer.Option("--runner", "-r", help="Filter listing by runner: indri, ringtail, or all"),
    ] = "all",
    repo: Annotated[
        str | None,
        typer.Option("--repo", help="Forge repo (owner/name), default: detected from git remote"),
    ] = None,
    limit: Annotated[
        int,
        typer.Option("--limit", "-n", help="Max runs to display (0 for all)"),
    ] = 15,
    attempt: Annotated[
        int | None,
        typer.Option("--attempt", "-a", help="Job attempt to fetch (default: the latest)"),
    ] = None,
    token: Annotated[
        str | None,
        typer.Option("--token", help="Forgejo API token (default: read from 1Password)"),
    ] = None,
) -> None:
    """List recent Forgejo Actions runs or fetch logs for a specific job."""
    if runner not in ("indri", "ringtail", "all"):
        typer.echo(f"Error: runner must be 'indri', 'ringtail', or 'all', got '{runner}'")
        raise typer.Exit(1)

    console = Console()

    if repo is None:
        repo = detect_repo_from_git()
        if repo is None:
            typer.echo(
                "Error: could not detect repo from git remote; use --repo owner/name",
                err=True,
            )
            raise typer.Exit(1)
        console.print(f"[dim]Detected repo: {repo}[/dim]")

    resolved_token = resolve_token(token, console)

    if run_number is None:
        if job is not None:
            typer.echo("Error: --job requires a run number", err=True)
            raise typer.Exit(1)
        list_runs(runner, repo, limit, resolved_token, console)
    elif job is None:
        if attempt is not None:
            typer.echo("Error: --attempt requires --job", err=True)
            raise typer.Exit(1)
        show_jobs(run_number, repo, resolved_token, console)
    else:
        fetch_log(run_number, job, repo, attempt, resolved_token)


if __name__ == "__main__":
    app()
