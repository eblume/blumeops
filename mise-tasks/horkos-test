"""Unit tests for the blumeops side of the approval path: the
`mise-tasks/request-run` / `mise-tasks/verify-runs` clients that file against
[[horkos]]. (The service's own suite moved with it to the eblume/horkos repo —
`scripts/test` there.)

Pure-function coverage of the parts where being wrong is an audit-integrity
problem rather than an outage — run attribution and SHA binding above all.
Needs nothing privileged: no forge token, no cluster, no vault, so it works
from an agent pod as well as from gilbert.

Usage: mise run horkos-test [-- <pytest args>]
"""

import pathlib
import sys

import pytest

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.exit(pytest.main([str(ROOT / "tests"), "-q", *sys.argv[1:]]))
