#!/usr/bin/env bash
#MISE description="Run the CI lint gate (prek hookset) locally before pushing"
set -euo pipefail

# The same hook set the lint workflow's prek job runs on every PR — catch
# failures before pushing, not after a human CI-approval click. prettier is
# SKIPped: it is a node hook and the agent pod ships no node, so a JSON
# formatting miss is caught only in CI. prek and actionlint come from
# mise.toml; the hook set lives in prek.toml.
export SKIP="${SKIP:+$SKIP,}prettier"
exec prek run --all-files "$@"
