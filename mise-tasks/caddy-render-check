#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
#MISE description="Check the indri caddy service data: unique hosts/names/ports and the exact :8443 fly split (no render; no network)"
"""Check the fly-listener split in the indri caddy service data.

Reads darwin/indri/caddy-services.json (the generation-owned source the Nix
renderer turns into the Caddyfile) and asserts, at the data level:

  1. every service has a unique name and a unique host under .ops.eblu.me;
  2. the services flagged fly_proxied are exactly fly_proxied_services
     (both directions), so the :8443 fly-only listener serves what is listed;
  3. every fly_proxied service is kind-valid (proxy or static);
  4. tcp_services ports are unique.

This does not render a Caddyfile: the Nix renderer is validated at activation
by `caddy adapt`, and CI's Docs Checks has no nix eval. Runs in Docs Checks on
every PR and locally via `mise run caddy-render-check`.
"""

import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / "darwin/indri/caddy-services.json"
DOMAIN = "ops.eblu.me"
KINDS = {"proxy", "static"}


def check_services(data: dict[str, Any]) -> list[str]:
    """Return a list of failure messages (empty means the split holds)."""
    errors: list[str] = []
    services = data.get("services", [])
    fly_listed = list(data.get("fly_proxied_services", []))

    names = [s.get("name") for s in services]
    hosts = [s.get("host") for s in services]
    for label, values in (("name", names), ("host", hosts)):
        dupes = sorted({v for v in values if values.count(v) > 1})
        if dupes:
            errors.append(f"duplicate service {label}s: {', '.join(map(str, dupes))}")

    for s in services:
        host = s.get("host", "")
        if not (host == DOMAIN or host.endswith("." + DOMAIN)):
            errors.append(f"{s.get('name')}: host {host!r} is not under {DOMAIN}")

    fly_flagged = [s["name"] for s in services if s.get("fly_proxied") is True]
    for name in sorted(set(fly_flagged) - set(fly_listed)):
        errors.append(f"{name}: fly_proxied but not listed in fly_proxied_services")
    for name in sorted(set(fly_listed) - set(fly_flagged)):
        errors.append(f"{name}: listed in fly_proxied_services but not fly_proxied")
    for name in fly_listed:
        if name not in names:
            errors.append(f"{name}: in fly_proxied_services but no such service")

    for s in services:
        if s.get("fly_proxied") is True and s.get("kind", "proxy") not in KINDS:
            errors.append(f"{s.get('name')}: fly_proxied with unknown kind {s.get('kind')!r}")

    ports = [t.get("port") for t in data.get("tcp_services", [])]
    dupes = sorted({p for p in ports if ports.count(p) > 1}, key=str)
    if dupes:
        errors.append(f"duplicate tcp_services ports: {', '.join(map(str, dupes))}")
    return errors


def main() -> int:
    data = json.loads(DATA.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"{DATA.relative_to(ROOT)}: expected a JSON object")
    errors = check_services(data)
    fly = list(data.get("fly_proxied_services", []))
    services = data.get("services", [])
    if errors:
        for e in errors:
            print(f"FAIL — {e}")
        print(f"FAIL — {len(errors)} problem(s) in {DATA.relative_to(ROOT)}")
        return 1
    print(
        f"ok — {len(services)} services in {DATA.relative_to(ROOT)}; "
        f":443 serves all, :8443 serves {len(fly)} ({', '.join(fly)})"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
