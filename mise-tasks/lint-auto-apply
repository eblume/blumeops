# Tailnet name — the public forge.eblu.me static mirror has no API
# (docs/reference/services/argocd.md). This lint also needs the local
# worktree and its workflows, so the repo is pinned, not a flag.
FORGE_API_BASE = "https://forge.ops.eblu.me/api/v1"
REPO = "eblume/blumeops"
# Canonical git URL. Never fetched into a configured remote (some clones
# have the canonical repo at `origin`, not `upstream`) — see _main_repo.
CANONICAL_URL = "https://forge.ops.eblu.me/eblume/blumeops.git"
WORKTREE = Path(__file__).resolve().parent.parent  # mise-tasks/ → repo root

# `class: auto` workflows that do NOT apply a host: an explicit allowlist,
# not a detection. build-container builds `containers/**` into zot — no
# host is involved.
NON_HOST_AUTO_WORKFLOWS = frozenset({"build-container.yaml"})

# 'nixos/<host>/**' | 'darwin/<host>/**' — the host-apply glob shape.
HOST_GLOB_RE = re.compile(r"^(nixos|darwin)/([A-Za-z0-9-]+)/\*\*$")
# A plain shared host input in an auto workflow's paths: no glob
# characters, not absolute. Anything in paths that is neither a host glob
# nor one of these must be an error — silently ignoring it is how a
# trigger slips past the derivation.
PLAIN_PATH_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
# Forge PR-merge subjects: "Merge pull request '<title>' (#NNN) from <ref>
# into main"; only those embed the PR number, so a non-merge subject never
# mislabels an issue number as a PR.
PR_MERGE_RE = re.compile(r"^Merge pull request '(.*)' \(#([0-9]+)\) from \S+ into main$")
# The declaration line: exactly one host per line. `[ \t]*`, not `\s*` — a
# newline after the colon must not count.
MARKER_RE = re.compile(r"^Auto-apply:[ \t]*([A-Za-z0-9-]+)[ \t]*$")
# A fenced-code-block delimiter; markers and #NNNN mentions inside fences
# are data being shown, not declarations.
FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")

console = Console()
err = Console(stderr=True, style="bold red")


def forge_token() -> str:
    if token := os.environ.get("FORGEJO_TOKEN"):
        return token.strip()
    try:
        result = subprocess.run(
            ["op", "read", "op://agents/talos-forgejo-token/api-token"],
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        err.print(f"No FORGEJO_TOKEN and `op read` failed: {exc}")
        raise typer.Exit(1) from exc
    if result.returncode != 0:
        err.print(f"No FORGEJO_TOKEN and `op read` failed: {result.stderr.strip()}")
        raise typer.Exit(1)
    return result.stdout.strip()


def api_client() -> httpx.Client:
    return httpx.Client(
        base_url=FORGE_API_BASE,
        headers={
            "User-Agent": "blumeops-lint-auto-apply",
            "Authorization": f"token {forge_token()}",
        },
        timeout=30.0,
    )


def _main_repo() -> Path:
    d = Path(
        os.environ.get(
            "LINT_AUTO_APPLY_CACHE", str(Path.home() / ".cache" / "blumeops-lint-auto-apply")
        )
    )
    d.mkdir(parents=True, exist_ok=True)
    return d


def _lock_stale(lock_path: Path) -> bool:
    # An unparseable lock is stale only when old: between the O_EXCL create
    # and the pid write it is empty while its writer is still alive.
    try:
        age = time.monotonic() - lock_path.stat().st_mtime
    except FileNotFoundError:
        return True
    try:
        pid = int(lock_path.read_text().strip())
    except (ValueError, OSError):
        return age > 60
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    return False


def _acquire_lock(lock_path: Path, timeout: float = 60.0) -> None:
    deadline = time.monotonic() + timeout
    while True:
        try:
            fd = os.open(str(lock_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            with os.fdopen(fd, "w") as f:
                f.write(str(os.getpid()))
            return
        except FileExistsError:
            if _lock_stale(lock_path):
                with contextlib.suppress(FileNotFoundError):
                    lock_path.unlink()
                continue
            if time.monotonic() > deadline:
                raise SystemExit(
                    f"{lock_path} is locked by another process "
                    f"(pid {lock_path.read_text().strip()}) — timed out waiting"
                )
            time.sleep(0.5)


def fetch_main() -> tuple[Path, str | None]:
    """Refresh the tool-owned bare cache of canonical main; (dir, error).

    The session worktree is a shallow clone shared across sessions, so the
    pending list (first-parent history between the baseline and main) is
    computed in a full bare clone instead — deepening the shared worktree
    is not an option. The pid lock keeps concurrent sessions on one pod
    from racing the same fetch. Check mode fails closed on a non-None
    error; --pending prints it and goes on (a generator, not a gate).
    """
    d = _main_repo()
    try:
        _acquire_lock(d / "fetch.lock")
    except SystemExit as exc:
        return d, str(exc)
    try:
        if not (d / "HEAD").exists():
            proc = subprocess.run(
                ["git", "init", "--bare", str(d)],
                capture_output=True,
                text=True,
                timeout=60,
                check=False,
            )
            if proc.returncode != 0:
                return d, proc.stderr.strip()
        proc = subprocess.run(
            [
                "git",
                "-C",
                str(d),
                "fetch",
                "--no-tags",
                CANONICAL_URL,
                "+refs/heads/main:refs/heads/main",
            ],
            capture_output=True,
            text=True,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
            timeout=600,
            check=False,
        )
        return d, (
            None if proc.returncode == 0 else proc.stderr.strip() or "git fetch of main failed"
        )
    finally:
        with contextlib.suppress(OSError):
            (d / "fetch.lock").unlink()


def main_ref_exists(cache_dir: Path) -> bool:
    return (
        subprocess.run(
            ["git", "-C", str(cache_dir), "rev-parse", "--verify", "--quiet", "refs/heads/main"],
            capture_output=True,
            check=False,
        ).returncode
        == 0
    )


def fetch_file(client: httpx.Client, path: str, ref: str) -> str:
    """Raw file text at ref via the contents API (single-file fetches are
    base64). On a 404, falls back to the local object store — the CI
    checkout sits at the PR head, so its objects are local even when the
    head lives in a fork the API will not serve. Missing everywhere is an
    error: a silent skip here fails the derivation open.
    """
    resp = client.get(f"/repos/{REPO}/contents/{path}", params={"ref": ref})
    if resp.status_code == 404 and ref != "main":
        proc = subprocess.run(
            ["git", "show", f"{ref}:{path}"],
            capture_output=True,
            text=True,
            cwd=WORKTREE,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
            timeout=60,
            check=False,
        )
        if proc.returncode == 0:
            return proc.stdout
    if resp.status_code == 404:
        raise SystemExit(f"{path} not found at {ref}")
    resp.raise_for_status()
    data = resp.json()
    if data.get("encoding") == "base64":
        return base64.b64decode(data["content"]).decode()
    return data.get("content") or ""


@dataclass
class HostInfo:
    workflow: str  # e.g. "ringtail-rebuild.yaml"
    globs: list[str] = field(default_factory=list)  # the host's own globs
    inputs: list[str] = field(default_factory=list)  # shared inputs it imports
    fire_and_forget: bool = False

    @property
    def trigger_paths(self) -> list[str]:
        # The full trigger set: the host glob plus the shared input files
        # its config imports (forge/runners.nix → forge/runners.json).
        return self.globs + self.inputs


def derive_hosts(
    client: httpx.Client,
    pr_workflow_refs: dict[str, str] | None = None,
    policy_ref: str = "main",
) -> dict[str, HostInfo]:
    """Auto-apply hosts from the policy and the workflows' on.push.paths.

    Fail-closed: a `class: auto` workflow must either be in
    NON_HOST_AUTO_WORKFLOWS or list a host glob in its push paths; every
    other shape is an error. pr_workflow_refs maps a workflow filename the
    PR modifies to the PR head sha, so the PR's own version decides;
    policy_ref works the same way for the policy. Hosts keep
    warrant-policy order, so ringtail precedes indri.
    """
    policy = fetch_file(client, "warrant-policy.yaml", policy_ref)
    try:
        data = yaml.safe_load(policy) or {}
    except yaml.YAMLError as exc:
        raise SystemExit(f"warrant-policy.yaml ({policy_ref}) is not valid YAML: {exc}") from exc
    actions = data.get("actions") or {}
    if not isinstance(actions, dict):
        raise SystemExit("warrant-policy.yaml: `actions` must be a mapping")
    refs = pr_workflow_refs or {}
    hosts: dict[str, HostInfo] = {}
    for workflow, entry in actions.items():
        if not isinstance(entry, dict) or entry.get("class") != "auto":
            continue
        if workflow in NON_HOST_AUTO_WORKFLOWS:
            continue
        ref = refs.get(workflow, "main")
        try:
            raw = fetch_file(client, f".forgejo/workflows/{workflow}", ref)
        except SystemExit as exc:
            raise SystemExit(
                f"{workflow} (class: auto): {exc} — if the PR removed it, "
                "remove the policy entry or change its class in the same PR"
            ) from exc
        try:
            wdata = yaml.safe_load(raw) or {}
        except yaml.YAMLError as exc:
            raise SystemExit(f"{workflow} (class: auto, at {ref}): not valid YAML: {exc}") from exc
        # PyYAML folds the `on` key into boolean True.
        on = wdata.get("on", wdata.get(True))
        if not isinstance(on, dict):
            raise SystemExit(f"{workflow}: `on` must be a mapping (got {type(on).__name__})")
        push = on.get("push")
        if push is None or push is True:
            raise SystemExit(
                f"{workflow}: no `on.push.paths` (missing or bare `on: push`) — a host-apply "
                "workflow must list its host globs in paths"
            )
        if not isinstance(push, dict):
            raise SystemExit(f"{workflow}: `on.push` must be a mapping (got {type(push).__name__})")
        paths = push.get("paths")
        if not isinstance(paths, list) or not paths:
            raise SystemExit(f"{workflow}: `on.push.paths` must be a non-empty list (got {paths!r})")
        paths_ignore = push.get("paths-ignore")
        if paths_ignore is not None and not isinstance(paths_ignore, list):
            raise SystemExit(
                f"{workflow}: `on.push.paths-ignore` must be a list (got {paths_ignore!r})"
            )
        host_globs: dict[str, str] = {}
        inputs: list[str] = []
        for p in paths:
            if not isinstance(p, str):
                raise SystemExit(f"{workflow}: a paths entry must be a string (got {p!r})")
            if p in (paths_ignore or []):
                continue
            m = HOST_GLOB_RE.match(p)
            if m:
                host_globs.setdefault(m.group(2), p)
            elif PLAIN_PATH_RE.match(p):
                if p not in inputs:
                    inputs.append(p)
            else:
                raise SystemExit(
                    f"{workflow}: paths entry {p!r} is neither a host glob "
                    "'<nixos|darwin>/<host>/**' nor a plain input path"
                )
        if not host_globs:
            raise SystemExit(
                f"{workflow} is class: auto but derives no host from on.push.paths — if it no "
                "longer applies a host on push, add it to NON_HOST_AUTO_WORKFLOWS "
                "(mise-tasks/lint-auto-apply) or change its policy class"
            )
        for host, g in host_globs.items():
            info = hosts.setdefault(
                host, HostInfo(workflow=workflow, fire_and_forget="wait=false" in raw)
            )
            info.globs.append(g)
            info.fire_and_forget = info.fire_and_forget or "wait=false" in raw
        for p in inputs:
            for host in host_globs:
                if p not in hosts[host].inputs:
                    hosts[host].inputs.append(p)
    return hosts


def run_revision(run: dict) -> str | None:
    """The SHA a run applied. Dispatch runs carry it in the event payload's
    inputs — event_payload is a JSON-ENCODED STRING, not an object; push
    runs applied their own commit_sha."""
    if run.get("trigger_event") == "workflow_dispatch":
        try:
            rev = json.loads(run["event_payload"])["inputs"]["revision"]
        except (KeyError, TypeError, json.JSONDecodeError):
            return None
    else:
        rev = run.get("commit_sha")
    return rev if isinstance(rev, str) and SHA_RE.match(rev) else None


def baseline(client: httpx.Client, info: HostInfo) -> tuple[str, str] | None:
    """(revision, date) of the newest successful run of the host's workflow.

    The runs endpoint returns the workflow's full history, newest first
    (limit/per_page are ignored — verified 2026-10-13), so no paging; there
    is no `conclusion` field — status is the outcome."""
    resp = client.get(f"/repos/{REPO}/actions/runs", params={"workflow_id": info.workflow})
    resp.raise_for_status()
    for run in resp.json().get("workflow_runs") or []:
        if run.get("status") != "success":
            continue
        rev = run_revision(run)
        if rev is None:
            continue  # unreadable payload — not a usable baseline
        return rev, str(run.get("created") or "")[:10]
    return None


def pr_subject_number(subject: str) -> int | None:
    m = PR_MERGE_RE.match(subject)
    return int(m.group(2)) if m else None


def display_subject(first_line: str) -> str:
    # Merge subjects wrap the PR title; fall back to the raw first line.
    m = PR_MERGE_RE.match(first_line)
    return m.group(1) if m else first_line


def pr_from_api(client: httpx.Client, sha: str) -> int | None:
    """PR number for a non-merge first-parent commit: /commits/{sha}/pull is
    200 (with `number`) only for a merged PR's merge commit."""
    try:
        resp = client.get(f"/repos/{REPO}/commits/{sha}/pull")
        if resp.status_code == 200:
            return resp.json().get("number")
    except httpx.HTTPError:
        pass
    return None


def _git_cache(cache_dir: Path, *args: str) -> str:
    proc = subprocess.run(
        ["git", "-C", str(cache_dir), *args],
        capture_output=True,
        text=True,
        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
        timeout=180,
        check=False,
    )
    if proc.returncode != 0:
        raise SystemExit(f"git {' '.join(args)} failed in {cache_dir}: {proc.stderr.strip()}")
    return proc.stdout


def pending_changes(
    client: httpx.Client,
    last_applied: str,
    globs: list[str],
    cache_dir: Path,
    exclude_prs: frozenset[int] = frozenset(),
) -> list[dict[str, Any]]:
    """First-parent merges on main since last_applied whose diff touched the
    host's trigger set (host globs plus shared inputs) — exactly the PRs
    the merge would also apply. A first-parent commit M is a pending host
    change when `git diff --name-only M^1 M -- <globs>` is non-empty.
    Merges of the PRs in exclude_prs are skipped: the PR under check is the
    merge commit it would name, and a re-check after its own merge must
    pass. Computed in the tool-owned bare cache (full first-parent history).
    """
    if not main_ref_exists(cache_dir):
        raise SystemExit(
            "the canonical main ref is missing in the cache — the fetch failed; the "
            "pending list cannot be computed against an unknown main"
        )
    if (
        subprocess.run(
            ["git", "-C", str(cache_dir), "merge-base", "--is-ancestor", last_applied, "refs/heads/main"],
            capture_output=True,
            check=False,
        ).returncode
        != 0
    ):
        raise SystemExit(
            f"baseline {last_applied[:8]} is not an ancestor of main — refusing to compute "
            "a pending list against unrelated history"
        )
    revs = _git_cache(cache_dir, "rev-list", "--first-parent", f"{last_applied}..refs/heads/main").split()
    items: list[dict[str, Any]] = []
    for m in revs:
        if not _git_cache(cache_dir, "diff", "--name-only", f"{m}^1", m, "--", *globs).strip():
            continue
        subject = _git_cache(cache_dir, "log", "-1", "--format=%s", m).strip()
        pr = pr_subject_number(subject)
        if pr is not None and pr in exclude_prs:
            continue
        if pr is None:
            pr = pr_from_api(client, m)
        items.append(
            {
                "pr": pr,
                "sha": m,
                "sha8": m[:8],
                "subject": display_subject(subject),
                "date": _git_cache(cache_dir, "log", "-1", "--format=%cs", m).strip(),
            }
        )
    return items


def pending_block(
    host: str, info: HostInfo, base: tuple[str, str], pend: list[dict[str, Any]]
) -> str:
    workflow_disp = info.workflow.removesuffix(".yaml")
    lines = [
        f"Auto-apply: {host}",
        "",
        f"> **Auto-apply:** merging this applies **all of main** to `{host}` — including",
        "> host changes merged to main since the last apply.",
        ">",
    ]
    if info.fire_and_forget:
        lines.append(
            f"> Baseline: `{base[0][:8]}` (last launched revision, {base[1]} — "
            "fire-and-forget: a green run means launched, not switched; "
            "the pending list may over-count)."
        )
    else:
        lines.append(f"> Baseline: `{base[0][:8]}` (last successful `{workflow_disp}` run, {base[1]}).")
    if pend:
        lines.append("> Pending host changes on main that this merge would also apply:")
        for item in pend:
            num = f"#{item['pr']} — " if item["pr"] is not None else ""
            lines.append(f"> - {num}{item['sha8']} {item['subject']}")
    else:
        lines.append("> No other unapplied host changes on main as of this check.")
    return "\n".join(lines)


def report_pending(
    client: httpx.Client,
    hosts: dict[str, HostInfo],
    cache_dir: Path,
    as_json: bool,
    fetch_note: str | None,
) -> None:
    ref_ok = not fetch_note or main_ref_exists(cache_dir)
    out: dict[str, Any] = {}
    for host, info in hosts.items():
        base = baseline(client, info)
        entry: dict[str, Any] = {
            "workflow": info.workflow,
            "fire_and_forget": info.fire_and_forget,
        }
        if base is None:
            entry["no_successful_run"] = (
                f"no successful run of {info.workflow} found — cannot compute the "
                f"pending list; confirm manually that main is applied to {host}"
            )
            if not as_json:
                err.print(f"[yellow]note:[/yellow] {entry['no_successful_run']}")
        elif not ref_ok:
            entry["pending_unavailable"] = (
                f"cannot compute the pending list: the canonical main fetch failed "
                f"({fetch_note})"
            )
            if not as_json:
                err.print(f"[yellow]note:[/yellow] {entry['pending_unavailable']}")
        else:
            pend = pending_changes(client, base[0], info.trigger_paths, cache_dir)
            entry.update(
                {
                    "baseline_sha": base[0],
                    "baseline_short": base[0][:8],
                    "baseline_date": base[1],
                    "pending": pend,
                    "block": pending_block(host, info, base, pend),
                }
            )
        out[host] = entry
    if as_json:
        json.dump({"mode": "pending", "git_fetch": fetch_note or "ok", "hosts": out}, sys.stdout, indent=2)
        print()
        return
    for entry in out.values():
        if block := entry.get("block"):
            print(block)
            print()


def glob_matches(glob: str, filename: str) -> bool:
    # '<dir>/**' → prefix '<dir>/': the dir and its contents. A plain path
    # (a shared input file) matches exactly, not by prefix.
    if glob.endswith("**"):
        return filename.startswith(glob.removesuffix("**"))
    return filename == glob


def _marker_entries(body: str) -> list[tuple[int, str]]:
    """(line index, host) of every plain `Auto-apply: <host>` line,
    skipping fenced code blocks: a marker pasted inside a code block is
    shown, not declared."""
    entries: list[tuple[int, str]] = []
    fence: str | None = None
    for i, line in enumerate(body.splitlines()):
        if fence:
            stripped = line.strip()
            if stripped.startswith(fence) and set(stripped) <= {fence[0], " "}:
                fence = None
            continue
        m = FENCE_RE.match(line)
        if m:
            fence = m.group(1)
            continue
        m = MARKER_RE.match(line)
        if m:
            entries.append((i, m.group(1)))
    return entries


def body_markers(body: str) -> dict[str, int]:
    """host → line index of the first marker for it (see _marker_entries)."""
    markers: dict[str, int] = {}
    for i, host in _marker_entries(body):
        markers.setdefault(host, i)
    return markers


def pending_segment(body: str, host: str) -> list[str] | None:
    """The blockquote lines of all of host's Auto-apply blocks — each runs
    from its marker line to the next marker line (any host, outside fences)
    or end of body. None if the body has no marker for host. A refreshed
    block below a stale one both count.

    Pending items must be named *here*, not anywhere in the body: a #NNNN
    in some unrelated sentence is not a declaration that the merge would
    ship that change.
    """
    lines = body.splitlines()
    entries = _marker_entries(body)
    starts = [i for i, h in entries if h == host]
    if not starts:
        return None
    next_marker = {i for i, _ in entries}
    seg: list[str] = []
    for start in starts:
        end = next((i for i in sorted(next_marker) if i > start), len(lines))
        seg.extend(l for l in lines[start + 1 : end] if l.lstrip().startswith(">"))
    return seg


def check_pr(client: httpx.Client, number: int, cache_dir: Path) -> dict[str, Any]:
    pr_resp = client.get(f"/repos/{REPO}/pulls/{number}")
    if pr_resp.status_code == 404:
        return {"number": number, "error": f"PR #{number} not found", "pass": False}
    pr_resp.raise_for_status()
    pr = pr_resp.json()
    files_resp = client.get(f"/repos/{REPO}/pulls/{number}/files")
    if files_resp.status_code == 404:
        return {"number": number, "error": f"PR #{number} files unreadable", "pass": False}
    files_resp.raise_for_status()
    files = files_resp.json()
    # previous_filename on a rename: a file moving out of a host path is a
    # host change (the deletion ships on merge).
    names = [f.get("filename", "") for f in files] + [
        f["previous_filename"] for f in files if f.get("previous_filename")
    ]

    head = pr["head"]["sha"]
    # The PR's own version decides for the policy and workflows it
    # modifies (the head may live in a fork — fetch_file falls back to the
    # local object store).
    policy_ref = head if "warrant-policy.yaml" in names else "main"
    modified_wfs = {
        name.removeprefix(".forgejo/workflows/")
        for name in names
        if name.startswith(".forgejo/workflows/") and name.endswith(".yaml")
    }
    hosts = derive_hosts(client, {wf: head for wf in modified_wfs}, policy_ref)
    affected = sorted(
        host
        for host, info in hosts.items()
        if any(glob_matches(g, name) for g in info.trigger_paths for name in names)
    )
    if not affected:
        return {
            "number": number,
            "title": pr.get("title"),
            "html_url": pr.get("html_url"),
            "pass": True,
            "affected_hosts": [],
            "note": "no auto-apply host paths touched",
        }

    body = pr.get("body") or ""  # body may be None
    missing: dict[str, list[str]] = {}
    blocks: dict[str, str] = {}
    for host in affected:
        info = hosts[host]
        base = baseline(client, info)
        if base is None:
            missing[host] = [
                (
                    f"no successful run of {info.workflow} found — cannot compute the "
                    f"pending list; confirm manually that main is applied to {host}"
                )
            ]
            continue
        pend = pending_changes(client, base[0], info.trigger_paths, cache_dir, exclude_prs=frozenset((number,)))
        blocks[host] = pending_block(host, info, base, pend)
        problems: list[str] = []
        # The !! pragma namespace is talos's; the declaration is plain text,
        # one host per line, outside any code block.
        if host not in body_markers(body):
            problems.append(
                f"missing marker line 'Auto-apply: {host}' (exactly one host per line)"
            )
        seg_text = "\n".join(pending_segment(body, host) or [])
        for item in pend:
            named = (
                item["pr"] is not None
                and re.search(rf"(?<!\w)#{item['pr']}\b", seg_text) is not None
            )
            named = named or re.search(rf"\b{item['sha8']}\b", seg_text) is not None
            if not named:
                ref = f"#{item['pr']}" if item["pr"] is not None else item["sha8"]
                problems.append(f"pending {ref} ({item['subject']}) not named in the Auto-apply block")
        missing[host] = problems
    return {
        "number": number,
        "title": pr.get("title"),
        "html_url": pr.get("html_url"),
        "pass": not any(missing.values()),
        "affected_hosts": affected,
        "missing": missing,
        "blocks": blocks,
    }


def report_check(r: dict[str, Any]) -> None:
    title = escape(r.get("title") or "")
    if r.get("error"):
        console.print(f"[red]FAIL[/red] #{r['number']} — {r['error']}")
        return
    if r["pass"]:
        console.print(f"[green]PASS[/green] #{r['number']} — {title}")
        if note := r.get("note"):
            console.print(f"      {note}")
        return
    console.print(f"[red]FAIL[/red] #{r['number']} — {title}")
    for host, problems in r["missing"].items():
        console.print(f"  [yellow]{host}[/yellow]:")
        for p in problems:
            console.print(f"    - {escape(p)}")
        if block := r["blocks"].get(host):
            console.print("    paste this block into the PR body:")
            print()
            for line in block.splitlines():
                print(f"      {line}")
            print()


def main(
    args: Annotated[
        list[str] | None, typer.Argument(help="PR numbers to lint, or host names after --pending")
    ] = None,
    pending: Annotated[
        bool, typer.Option("--pending", help="Generate paste-ready blocks instead of linting PRs")
    ] = False,
    as_json: Annotated[
        bool, typer.Option("--json", help="Machine-readable JSON output")
    ] = False,
) -> None:
    cache_dir, fetch_note = fetch_main()
    args = args or []
    try:
        with api_client() as client:
            if pending:
                hosts = derive_hosts(client)
                if args:
                    unknown = [h for h in args if h not in hosts]
                    if unknown:
                        err.print(
                            f"[red]error:[/red] no auto-apply host named "
                            f"{', '.join(unknown)} — known: {', '.join(sorted(hosts))}"
                        )
                        raise typer.Exit(1)
                    selected = {h: hosts[h] for h in args}
                else:
                    selected = hosts
                if fetch_note and not as_json:
                    err.print(f"[yellow]note:[/yellow] {fetch_note} — the pending list may be stale")
                report_pending(client, selected, cache_dir, as_json, fetch_note)
                raise typer.Exit(0)  # a generator, not a gate

            try:
                prs = [int(a) for a in args]
            except ValueError:
                err.print("PR numbers must be integers.")
                raise typer.Exit(2) from None
            if not prs:
                console.print("[yellow]no PRs given[/yellow] — pass PR numbers, or --pending [host ...]")
                raise typer.Exit(2)
            if fetch_note:
                # A stale or missing main under-counts pending items →
                # false PASS, so a failed fetch is a verdict of its own.
                err.print(f"[red]error:[/red] {fetch_note}")
                err.print("cannot verify the PR against main; fix the fetch and re-run")
                raise typer.Exit(1)

            results = [check_pr(client, n, cache_dir) for n in prs]
            failed = any(not r["pass"] for r in results)
            if as_json:
                json.dump(
                    {"mode": "check", "git_fetch": fetch_note or "ok", "prs": results, "exit": 1 if failed else 0},
                    sys.stdout,
                    indent=2,
                )
                print()
            else:
                for r in results:
                    report_check(r)
            raise typer.Exit(1 if failed else 0)
    except httpx.HTTPError as exc:
        detail = str(exc)
        if isinstance(exc, httpx.HTTPStatusError):
            detail = f"{detail} (HTTP {exc.response.status_code})"
        err.print(f"forge API request failed: {detail}")
        err.print(
            "is forge.ops.eblu.me reachable from here, and does the FORGEJO_TOKEN "
            "have read access to eblume/blumeops (Actions runs, PR files)?"
        )
        raise typer.Exit(1) from exc


if __name__ == "__main__":
    typer.run(main)
