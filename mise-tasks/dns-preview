#!/usr/bin/env bash
#MISE description="[human] Preview DNS changes to eblu.me with Pulumi"

set -euo pipefail

# Pulumi Cloud holds the stack state; the token comes from 1Password so no
# host needs a stored `pulumi login`. An already-set token (e.g. CI) wins.
PULUMI_ACCESS_TOKEN=${PULUMI_ACCESS_TOKEN:-$(op read "op://blumeops/Pulumi/access-token")}
export PULUMI_ACCESS_TOKEN

GANDI_PERSONAL_ACCESS_TOKEN=$(op read "op://blumeops/gandi - blumeops/pat")
export GANDI_PERSONAL_ACCESS_TOKEN

cd "$(dirname "$0")/../pulumi/gandi"
uv sync --quiet || { echo "uv sync failed — if devpi is down, run 'devpi off' and retry"; exit 1; }
pulumi stack select eblu-me
pulumi preview "$@"
