#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx[socks]==0.28.1", "rich==15.0.0", "typer==0.27.1", "pyyaml==6.0.3"]
# ///
#MISE description="Request a privileged workflow run (approval-gated; see warrant-approval-gated-runs)"
#USAGE arg "<workflow>" help="Workflow file under .forgejo/workflows/, e.g. build-container.yaml"
#USAGE arg "<sha>" help="FULL 40-char commit SHA the request is bound to"
#USAGE flag "--pr <pr>" help="PR to attach the request to (default: auto-detect from an open PR's head SHA)"
#USAGE flag "--repo <repo>" help="Repo holding that PR, owner/name (default eblume/blumeops)"
#USAGE flag "-i --input <input>" var=#true help="Dispatch input as key=value (repeatable)"
#USAGE flag "--why <why>" help="One-line justification"
#USAGE flag "--supersedes <supersedes>" help="Warrant request id this replaces; retires it so it stops looking live"
#USAGE flag "--notify" help="Also push to ntfy (heph is the system of record either way)"
#USAGE flag "--script <script>" help="One-off script body: a file path, or '-' for stdin (run-script.yaml only)"
"""Request an approval-gated privileged run.

Implements Phase 1 of [[warrant-approval-gated-runs]]: an agent (or a human)
formally requests that a privileged workflow be dispatched at an immutable
SHA. The request is mirrored into the Warrant queue and recorded as a PR
comment and a heph task (the system of record — heph is the information
plane); an ntfy push is optional and off by default. Approval remains a human
act: deciding the request in Warrant, or dispatching from the forge UI, both
behind an Authentik SSO login. This tool holds no privileged credentials and
cannot trigger anything — by design (invariant 4).

The bound SHA is enforced, not merely recorded: warrant-policy's `binds_sha`
names the dispatch input that must carry it, and a request that would let CI
build something else is refused before it is filed.

A PR that takes review feedback moves its head SHA, which obsoletes the
request bound to the old commit. `--supersedes <id>` retires that one as the
new request is filed: Warrant marks it superseded (it can no longer be
approved), the old PR comment gets a note, and its tracking task closes.

Usage:
  mise run request-run <workflow> <full-sha> [--pr N] [--repo owner/name] \
      [--input k=v]... [--why TEXT] [--supersedes ID] [--notify] [--script <script>]

Every flag typer accepts must also be declared in the #USAGE block above: mise
validates argv against that spec before this script runs and rejects anything
undeclared ("unexpected word: --pr"), which `--` does not bypass. Two traps
when editing it, both found the hard way:

  * The block must be CONTIGUOUS. An ordinary comment line between two #USAGE
    lines truncates the spec silently — no warning, the later flags simply do
    not exist. Explanatory prose goes here, not in there.
  * Booleans are KDL v2, so repeatable flags need `var=#true`, not `var=true`.
    `var=true` fails to parse, and mise's fallback for an unparseable spec is
    to forward argv unvalidated — so it looks like it works until the day the
    spec parses again.
"""

import hashlib
import json
import os
import re
import subprocess
import sys
from typing import Annotated

import httpx
import typer
from rich.console import Console

# FORGE_BASE is for human-facing links only. API calls use the tailnet name:
# in-cluster DNS rewrites forge.eblu.me to indri, whose Caddy holds no cert
# for that name, so HTTPS to the public name dies in the TLS handshake
# (docs/reference/services/argocd.md: "safe for SSH and poison for HTTPS").
FORGE_BASE = "https://forge.eblu.me"
FORGE_API_BASE = "https://forge.ops.eblu.me/api/v1"
REPO_OWNER = "eblume"
REPO_NAME = "blumeops"
REPO_API = f"{FORGE_API_BASE}/repos/{REPO_OWNER}/{REPO_NAME}"
REPO_WEB = f"{FORGE_BASE}/{REPO_OWNER}/{REPO_NAME}"
# blumeops is where the workflow definitions, warrant-policy.yaml and the
# dispatch live — always. The PR a request is *attached* to may live elsewhere
# (--repo); the functions taking `repo_api` are the PR side.
DEFAULT_PR_REPO = f"{REPO_OWNER}/{REPO_NAME}"
NTFY_URL = "https://ntfy.ops.eblu.me/ops-approvals"

console = Console()
err = Console(stderr=True, style="bold red")


def forge_token() -> str:
    """FORGEJO_TOKEN from the env, else the bot PAT from the agents vault."""
    if token := os.environ.get("FORGEJO_TOKEN"):
        return token.strip()
    # op parses non-TTY stdin as JSON — always feed it /dev/null.
    try:
        result = subprocess.run(
            ["op", "read", "op://agents/agents-forgejo-token/api-token"],
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
            timeout=30,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        err.print(f"No FORGEJO_TOKEN and `op read` failed: {exc}")
        raise typer.Exit(1) from exc
    if result.returncode != 0:
        err.print("No FORGEJO_TOKEN and `op read` failed:")
        err.print(result.stderr.strip())
        raise typer.Exit(1)
    return result.stdout.strip()


def workflow_on_main(client: httpx.Client, workflow: str) -> bool:
    """Privileged definitions execute from main (invariant 3) — so the
    request is only coherent if the workflow exists there."""
    resp = client.get(f"{REPO_API}/raw/main/.forgejo/workflows/{workflow}")
    return resp.status_code == 200


def main_file_exists(client: httpx.Client, path: str) -> bool:
    return client.get(f"{REPO_API}/raw/main/{path}").status_code == 200


def enforce_policy(
    client: httpx.Client, workflow: str, inputs: dict[str, str], sha: str
) -> None:
    """Validate the request against warrant-policy.yaml ON MAIN (Phase 4 of
    [[warrant-approval-gated-runs]]) — the reviewed autonomy boundary.
    Unknown actions are deny-by-default; input schemas catch typos at
    request time instead of run time (pilot friction d).

    Also enforces the SHA binding: the policy's `binds_sha` names the input
    that carries the approved commit, and a request whose bound SHA does not
    reach that input is refused here rather than dispatched."""
    import yaml

    resp = client.get(f"{REPO_API}/raw/main/warrant-policy.yaml")
    if resp.status_code != 200:
        err.print("warrant-policy.yaml not found on main — cannot validate the request.")
        raise typer.Exit(1)
    policy = yaml.safe_load(resp.text)
    entry = (policy.get("actions") or {}).get(workflow)
    if entry is None:
        err.print(
            f"'{workflow}' has no warrant-policy.yaml entry — unknown actions are "
            "deny-by-default. Add a policy entry (reviewed PR) to make it requestable."
        )
        raise typer.Exit(1)
    if entry.get("class") == "deny":
        err.print(f"'{workflow}' is class DENY: {entry.get('note', 'not requestable')}")
        raise typer.Exit(1)

    spec = entry.get("inputs") or {}
    for name, rules in spec.items():
        if rules.get("required") and name not in inputs:
            err.print(f"policy: input '{name}' is required for {workflow}")
            raise typer.Exit(1)
    for name, value in inputs.items():
        rules = spec.get(name)
        if rules is None:
            err.print(f"policy: '{name}' is not a declared input of {workflow}")
            raise typer.Exit(1)
        if (pattern := rules.get("pattern")) and not re.fullmatch(pattern, value):
            err.print(f"policy: input '{name}'='{value}' does not match {pattern}")
            raise typer.Exit(1)
        match rules.get("validate"):
            case "argocd-app":
                if not main_file_exists(client, f"argocd/apps/{value}.yaml"):
                    err.print(
                        f"policy: '{value}' is not a declared ArgoCD Application "
                        "(most carry a -ringtail suffix)"
                    )
                    raise typer.Exit(1)
            case "container-dir":
                if not main_file_exists(client, f"containers/{value}/default.nix"):
                    err.print(f"policy: containers/{value}/default.nix does not exist on main")
                    raise typer.Exit(1)
            case None:
                pass

    enforce_sha_binding(workflow, entry, inputs, sha)


def enforce_sha_binding(
    workflow: str, entry: dict, inputs: dict[str, str], sha: str
) -> None:
    """The approved SHA must actually reach the run.

    A privileged workflow takes its target as a dispatch input; the SHA a
    request is *bound* to is a separate field in the warrant payload. Nothing
    joined the two, so `-i container=agent-ws` with no `ref` filed a request
    that read "build bcb2b55" and dispatched a build of main — which then
    reported success (warrant #22, run 742). Every downstream signal was
    green for a build of the wrong commit.

    So: refuse. Injecting the bound SHA silently would guess at intent, and
    the whole point of the binding is that the approver's reading of it is
    authoritative."""
    binding = entry.get("binds_sha")
    if binding is None:
        if entry.get("class") == "warrant":
            err.print(
                f"policy: '{workflow}' is class warrant but declares no binds_sha — "
                "a requestable workflow must name the input carrying the approved SHA."
            )
            raise typer.Exit(1)
        return

    value = inputs.get(binding)
    if value is None:
        err.print(
            f"policy: '{workflow}' binds its approved SHA through the '{binding}' input, "
            f"which you did not pass — the run would build main, not {sha[:7]}.\n"
            f"  Re-run with: -i {binding}={sha}"
        )
        raise typer.Exit(1)
    if value == sha:
        return
    if not re.fullmatch(r"[0-9a-f]{40}", value):
        # `main` is a legitimate dispatch value — the workflows accept it, and
        # the policy pattern still admits it — but it resolves at dispatch
        # time, which is the moving target an approval exists to pin down.
        err.print(
            f"policy: '{binding}={value}' is not an immutable commit, so this request "
            f"would bind {sha[:7]} and dispatch whatever '{value}' points at when it "
            "runs.\n"
            f"  Pass -i {binding}={sha}, or if you really mean that ref's current tip, "
            "resolve it to a SHA and bind the request to that."
        )
        raise typer.Exit(1)
    err.print(
        f"policy: '{binding}={value}' does not match the SHA this request binds "
        f"({sha}). An approval that names one commit and dispatches another is "
        "the failure this check exists to stop.\n"
        f"  Bind the request to {value[:7]}… instead, or pass -i {binding}={sha}."
    )
    raise typer.Exit(1)


def neutralize_refs(text: str) -> str:
    """Wrap bare `#123` in a code span so Forgejo does not autolink it.

    `--why` is where a human writes "supersedes request #21", and Forgejo
    reads a bare #N as an issue/PR reference of *this repo* — on PR #525 that
    rendered a confident link to an unrelated PR. Code spans are exempt from
    reference expansion, and they survive copy-paste; a backslash escape does
    not, because the reference transformer runs over text nodes regardless."""
    return re.sub(r"(?<![\w`])#(\d+)\b", r"`#\1`", text)


def find_pr_for_sha(client: httpx.Client, sha: str, repo_api: str = REPO_API) -> dict | None:
    """The open PR whose head is the requested SHA, if any."""
    resp = client.get(f"{repo_api}/pulls", params={"state": "open", "limit": 50})
    resp.raise_for_status()
    for pr in resp.json():
        if pr.get("head", {}).get("sha") == sha:
            return pr
    return None


def get_pr(client: httpx.Client, number: int, repo_api: str = REPO_API) -> dict:
    resp = client.get(f"{repo_api}/pulls/{number}")
    if resp.status_code != 200:
        err.print(f"PR #{number} not found in that repo ({resp.status_code})")
        raise typer.Exit(1)
    return resp.json()


def pr_touches_workflows(client: httpx.Client, number: int, repo_api: str = REPO_API) -> list[str]:
    """Workflow files changed by the PR — flagged loudly in the request,
    because those changes only take effect after merge (invariant 3)."""
    resp = client.get(f"{repo_api}/pulls/{number}/files", params={"limit": 300})
    if resp.status_code != 200:
        return []  # non-fatal; the reviewer still sees the full diff
    return [
        f["filename"]
        for f in resp.json()
        if f.get("filename", "").startswith(".forgejo/workflows/")
    ]


HORKOS_URL = "https://horkos.ops.eblu.me"
AUTHENTIK_TOKEN_URL = "https://authentik.ops.eblu.me/application/o/token/"
SOCKS_FALLBACK = "socks5://localhost:1055"  # agent pod's tailscale sidecar


def _ops_client() -> httpx.Client:
    """Client for *.ops.eblu.me: direct on gilbert, SOCKS fallback in-pod.

    The probe uses a throwaway client: any request on the returned client
    would implicitly open it, and the caller's `with` would then raise
    "Cannot open a client instance more than once" on __enter__."""
    proxy = os.environ.get("ALL_PROXY")
    try:
        with httpx.Client(timeout=5.0, proxy=proxy) as probe:
            probe.get(f"{HORKOS_URL}/healthz")
    except httpx.TransportError:
        proxy = SOCKS_FALLBACK
    return httpx.Client(timeout=15.0, proxy=proxy)


WARRANT_ERRORS = (
    subprocess.CalledProcessError,
    subprocess.TimeoutExpired,
    httpx.HTTPError,
    KeyError,
    OSError,
)


def _warrant_bearer(c: httpx.Client) -> str:
    """A client_credentials token for the agents-m2m identity. Nothing
    privileged: it can file and retire requests, and decide none of them."""
    app_pw = subprocess.run(
        ["op", "read", "op://agents/agents-authentik-sa/app-password"],
        capture_output=True, text=True, stdin=subprocess.DEVNULL, check=True,
        timeout=30,
    ).stdout.strip()
    tok = c.post(
        AUTHENTIK_TOKEN_URL,
        data={
            "grant_type": "client_credentials",
            "client_id": "agents-m2m",
            "username": "agent-ringtail",
            "password": app_pw,
            "scope": "openid profile",
        },
    )
    tok.raise_for_status()
    return str(tok.json()["access_token"])


def mirror_to_warrant(
    workflow: str, sha: str, inputs: dict[str, str], why: str, pr: int, pr_repo: str
) -> int | None:
    """Mirror the request into the Warrant queue ([[warrant]]) with the
    agents-m2m identity. Best-effort by design: Warrant v0.1 is an
    informational mirror — the PR comment + heph task remain the system of
    record, so any failure here warns and moves on."""
    try:
        with _ops_client() as c:
            resp = c.post(
                f"{HORKOS_URL}/api/requests",
                headers={"Authorization": f"Bearer {_warrant_bearer(c)}"},
                json={
                    "action": workflow,
                    "sha": sha,
                    "inputs": inputs,
                    "why": why,
                    "pr": pr,
                    "pr_repo": pr_repo,
                },
            )
            resp.raise_for_status()
            return resp.json().get("id")
    except WARRANT_ERRORS as exc:
        err.print(f"warrant mirror failed (request still filed via PR+heph): {exc}")
        return None


def supersede_in_warrant(old_id: int, new_id: int) -> dict | None:
    """Retire the request `new_id` replaces, returning its coordinates.

    Warrant scopes this to our own still-pending requests and only ever
    reduces — a superseded request cannot be approved, so this grants nothing
    (invariant 4). A failure leaves the old request pending, which is the safe
    direction: a stale entry in the queue, not a retired one that should have
    stood."""
    try:
        with _ops_client() as c:
            resp = c.post(
                f"{HORKOS_URL}/api/requests/{old_id}/supersede",
                headers={"Authorization": f"Bearer {_warrant_bearer(c)}"},
                json={"by": new_id},
            )
            resp.raise_for_status()
            return resp.json()
    except WARRANT_ERRORS as exc:
        detail = getattr(getattr(exc, "response", None), "text", "")
        err.print(f"could not supersede request #{old_id} — it is still pending: {exc} {detail[:200]}")
        return None


def tracking_task_title(workflow: str, sha: str, pr: int, pr_repo: str | None = None) -> str:
    """The title of the heph task a request files — and the key superseding
    uses to find that task again, so both come from here. #N is ambiguous across
    repos, so a non-blumeops PR names its repo."""
    repo = f" ({pr_repo})" if pr_repo and pr_repo != DEFAULT_PR_REPO else ""
    return f"Approve: {workflow} @ {sha[:7]} (PR #{pr}{repo})"


def heph_context(node_id: str) -> str:
    result = subprocess.run(
        ["heph", "context", node_id], capture_output=True, text=True
    )
    return result.stdout if result.returncode == 0 else ""


def close_tracking_task(old: dict, old_id: int, new_id: int) -> str | None:
    """Close the heph task the superseded request filed.

    Matched on title *and* on the `Warrant request: #<id>` line request-run
    stamps into the task's context — a title alone is not enough evidence to
    close someone's task on. Anything other than exactly one match prints what
    to close by hand rather than guessing."""
    title = tracking_task_title(old["action"], old["sha"], old["pr"], old.get("pr_repo"))
    try:
        rows = json.loads(
            subprocess.run(
                ["heph", "list", "--project", "Blumeops", "--json"],
                capture_output=True, text=True, check=True,
            ).stdout
        )
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        err.print(f"heph list failed ({exc}); close the task for request #{old_id} by hand.")
        return None

    stamp = f"Warrant request: #{old_id}"
    matches = [
        row["node_id"]
        for row in rows
        if row.get("title") == title and stamp in heph_context(row["node_id"])
    ]
    if len(matches) != 1:
        err.print(
            f"{len(matches)} open tasks match '{title}' carrying '{stamp}' — "
            "close the superseded one by hand (`heph done <id>`)."
        )
        return None

    node_id = matches[0]
    subprocess.run(
        ["heph", "log", node_id,
         f"Superseded by warrant request #{new_id}; retired in Warrant and "
         "closed by request-run --supersedes. No decision was made on this one."],
        capture_output=True, text=True,
    )
    result = subprocess.run(["heph", "done", node_id], capture_output=True, text=True)
    if result.returncode != 0:
        err.print(f"heph done {node_id} failed: {result.stderr.strip()}")
        return None
    return node_id


def annotate_superseded_comment(
    client: httpx.Client, old: dict, old_id: int, new_id: int, new_sha: str
) -> None:
    """Say on the PR that the old request is dead.

    The approver reads the PR, so a request retired only in Warrant still
    looks live where the decision actually gets made. Warrant ids are rendered
    as links, never bare: `#N` in a comment body autolinks to PR N of this
    repo."""
    if not old.get("pr"):
        return
    old_repo = old.get("pr_repo") or DEFAULT_PR_REPO
    body = (
        "## 🚫 Request superseded\n\n"
        f"[Request #{old_id}]({HORKOS_URL}/) — `{old['action']}` at `{old['sha'][:7]}` — "
        f"is replaced by [request #{new_id}]({HORKOS_URL}/) at `{new_sha[:7]}`, and has "
        "been retired in Warrant: it can no longer be approved. Decide the new request "
        "instead.\n"
    )
    resp = client.post(
        f"{FORGE_API_BASE}/repos/{old_repo}/issues/{old['pr']}/comments",
        json={"body": body},
    )
    if resp.status_code != 201:
        err.print(
            f"could not post the supersession note on PR #{old['pr']} "
            f"({resp.status_code}) — request #{old_id} is retired in Warrant regardless."
        )


def file_heph_task(title: str, body: str) -> str | None:
    """The heph task is the durable pending-approval record. Non-fatal if
    heph is unavailable — the PR comment still exists — but warn loudly."""
    try:
        result = subprocess.run(
            ["heph", "task", title, "--project", "Blumeops", "--attention", "orange"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        err.print(f"heph task creation FAILED (request is PR-comment-only!): {exc}")
        return None
    match = re.search(r"01[A-Z0-9]{24}", result.stdout)
    if match is None:
        err.print(f"could not parse task id from heph output: {result.stdout!r}")
        return None
    node_id = match.group(0)
    subprocess.run(
        ["heph", "context", node_id, "--append", body],
        capture_output=True,
        text=True,
    )
    return node_id


def load_script(script: str, workflow: str, inputs: list[str]) -> list[str]:
    """One-off script mode: the body travels in the request inputs as the
    (script, script_sha256) pair - horkos binds the pair at filing time (the
    hash must match the body) and the warrant freezes both, so what the
    approver reads is exactly what the executor runs.

    The body comes from a file path, or stdin with '-'. Returns the two input
    strings for the request. Refuses what would make the pair ambiguous:
    another workflow (where the pair means nothing), an empty or non-UTF-8
    body, or a body already supplied via -i (two sources of truth)."""
    if workflow != "run-script.yaml":
        err.print(
            f"--script is only supported with the run-script.yaml workflow (got {workflow})"
        )
        raise typer.Exit(1)
    if any(
        pair.startswith("script=") or pair.startswith("script_sha256=") for pair in inputs
    ):
        err.print(
            "--script cannot be combined with -i script=.../script_sha256=... - one source of truth"
        )
        raise typer.Exit(1)
    try:
        if script == "-":
            body = sys.stdin.read()
        else:
            with open(script, encoding="utf-8") as f:
                body = f.read()
    except (OSError, UnicodeDecodeError) as exc:
        err.print(f"could not read the script body from {script!r}: {exc}")
        raise typer.Exit(1) from exc
    if not body:
        err.print("the script body is empty - nothing to approve")
        raise typer.Exit(1)
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
    return [f"script={body}", f"script_sha256={digest}"]


def main(
    workflow: Annotated[str, typer.Argument(help="Workflow file, e.g. build-container.yaml")],
    sha: Annotated[str, typer.Argument(help="FULL 40-char commit SHA")],
    pr_number: Annotated[
        int | None,
        typer.Option("--pr", help="PR to attach the request to (auto-detected from an open PR's head SHA if omitted)"),
    ] = None,
    pr_repo: Annotated[
        str | None,
        typer.Option("--repo", help="Repo holding that PR, owner/name (default eblume/blumeops) — the workflow and SHA are always blumeops"),
    ] = None,
    inputs: Annotated[
        list[str] | None,
        typer.Option("--input", "-i", help="Dispatch input as key=value (repeatable)"),
    ] = None,
    why: Annotated[str, typer.Option(help="One-line justification")] = "",
    supersedes: Annotated[
        int | None,
        typer.Option("--supersedes", help="Warrant request id this replaces (it is retired)"),
    ] = None,
    notify: Annotated[
        bool,
        typer.Option("--notify", help="Also push to ntfy (optional; heph is the system of record)"),
    ] = False,
    script: Annotated[
        str | None,
        typer.Option("--script", help="One-off script body: a file path, or '-' for stdin (run-script.yaml only)"),
    ] = None,
) -> None:
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        err.print(f"'{sha}' is not a full 40-char lowercase SHA (short SHAs break dispatch checkouts).")
        raise typer.Exit(1)
    if "/" in workflow or not workflow.endswith((".yaml", ".yml")):
        err.print(f"'{workflow}' should be a bare workflow filename, e.g. build-container.yaml")
        raise typer.Exit(1)

    inputs = inputs or []
    for pair in inputs:
        if "=" not in pair:
            err.print(f"--input '{pair}' is not key=value")
            raise typer.Exit(1)
    if pr_repo is not None and not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", pr_repo):
        err.print(f"'{pr_repo}' should be owner/name, e.g. eblume/talos")
        raise typer.Exit(1)
    pr_repo = pr_repo or DEFAULT_PR_REPO
    pr_api = f"{FORGE_API_BASE}/repos/{pr_repo}"
    pr_web = f"{FORGE_BASE}/{pr_repo}"

    token = forge_token()
    with httpx.Client(
        headers={"Authorization": f"token {token}"}, timeout=30.0
    ) as client:
        if not workflow_on_main(client, workflow):
            err.print(
                f".forgejo/workflows/{workflow} does not exist on main — privileged "
                "definitions run from main only; merge the workflow first."
            )
            raise typer.Exit(1)

        if script is not None:
            inputs += load_script(script, workflow, inputs)
        input_map = dict(p.split("=", 1) for p in inputs)
        enforce_policy(client, workflow, input_map, sha)

        if pr_number is None:
            pr = find_pr_for_sha(client, sha, pr_api)
            if pr is None:
                err.print(
                    f"No open PR in {pr_repo} has this SHA as its head. Pass --pr <N> "
                    "explicitly (e.g. the merged PR a post-merge build belongs to), "
                    "or --repo if the PR lives in another repo."
                )
                raise typer.Exit(1)
        else:
            pr = get_pr(client, pr_number, pr_api)
        number = pr["number"]

        touched = pr_touches_workflows(client, number, pr_api)

        sha7 = sha[:7]
        dispatch_url = f"{REPO_WEB}/actions?workflow={workflow}"
        # The script body gets its own section below - a multi-line body in a
        # table cell would split the row and mangle the comment.
        input_pairs = [p.split("=", 1) for p in inputs]
        input_lines = "\n".join(
            f"| `{key}` | `{value}` |" for key, value in input_pairs if key != "script"
        )
        input_table = (
            "| input | value |\n|---|---|\n" + input_lines
            if input_pairs
            else "_(no inputs)_"
        )
        script_body = input_map.get("script")
        # A triple-backtick sequence in the body would break the fence; the
        # horkos confirm page is the canonical rendering, this is the copy-out aid.
        script_section = (
            f"\n**Script** - `{input_map['script_sha256']}`, {len(script_body)} bytes "
            "(body bound in the Horkos request, rendered in full on the confirm page):\n\n"
            f"```\n{script_body}```\n"
            if script_body is not None
            else ""
        )
        workflow_warning = (
            "\n> ⚠️ **This PR changes workflow definitions** ("
            + ", ".join(f"`{f}`" for f in touched)
            + ") — per invariant 3 those changes only take effect after merge; "
            "this run executes *main's* definition.\n"
            if touched
            else ""
        )
        why_line = f"\n**Why:** {neutralize_refs(why)}\n" if why else ""

        # Mirror BEFORE commenting so the comment can name the queue entry the
        # approver is meant to act on. Mirroring is best-effort and returns
        # None on failure, so the comment degrades to what it rendered before.
        warrant_id = mirror_to_warrant(workflow, sha, input_map, why, number, pr_repo)

        # Retire the request this one replaces before commenting, so the
        # comment can state the outcome rather than the intent.
        superseded = None
        if supersedes is not None:
            if warrant_id is None:
                err.print(
                    f"not superseding request #{supersedes}: this request never reached "
                    "Warrant, and retiring the old one would leave nothing live."
                )
            else:
                superseded = supersede_in_warrant(supersedes, warrant_id)
        supersedes_row = (
            f"| **Supersedes** | [request #{supersedes}]({HORKOS_URL}/) at "
            f"`{superseded['sha'][:7]}` — retired, no longer approvable |\n"
            if superseded
            else f"| **Supersedes** | ⚠️ `#{supersedes}` — retiring it FAILED; it is still "
            "pending, ignore it |\n"
            if supersedes is not None
            else ""
        )

        warrant_row = (
            f"| **Warrant** | [request #{warrant_id}]({HORKOS_URL}/) — approve or deny here |\n"
            if warrant_id
            else f"| **Warrant** | ⚠️ mirror failed — this request is PR+heph only, "
            f"approve from the [dispatch page]({dispatch_url}) |\n"
        )
        approve_line = (
            f"**To approve:** open [Horkos]({HORKOS_URL}/) and decide request "
            f"#{warrant_id} — approving dispatches the run itself, with the SHA and "
            "inputs above already bound. To deny, deny it there (or say so here) and "
            "`heph done` the tracking task with a note."
            if warrant_id
            else f"**To approve:** open the [dispatch page]({dispatch_url}) → *Run "
            f"workflow* → paste the SHA and inputs above → run. To deny, say so here "
            "and `heph done` the tracking task with a note."
        )

        comment_body = f"""## 🔏 Privileged run requested

| | |
|---|---|
| **Workflow** | [`{workflow}`]({REPO_WEB}/src/branch/main/.forgejo/workflows/{workflow}) |
| **SHA** | `{sha}` |
| **Diff** | {pr_web}/pulls/{number}/files |
{warrant_row}{supersedes_row}
{input_table}{script_section}
{why_line}{workflow_warning}
{approve_line}

Requested via `mise run request-run` — see [[warrant-approval-gated-runs]].
This request grants nothing: dispatch remains write-gated to humans.
"""


        resp = client.post(
            f"{pr_api}/issues/{number}/comments", json={"body": comment_body}
        )
        if resp.status_code != 201:
            err.print(f"Failed to post PR comment ({resp.status_code}): {resp.text[:300]}")
            raise typer.Exit(1)
        comment_url = resp.json().get("html_url", f"{pr_web}/pulls/{number}")

        if superseded and supersedes is not None and warrant_id is not None:
            annotate_superseded_comment(client, superseded, supersedes, warrant_id, sha)

    pr_ref = f"PR #{number}" + (f" ({pr_repo})" if pr_repo != DEFAULT_PR_REPO else "")
    # A script body in the task context is noise - the PR comment carries it.
    input_display = [
        p if not p.startswith("script=")
        else f"script=<{input_map['script_sha256']}, {len(input_map['script'])} bytes>"
        for p in inputs
    ]
    heph_body = (
        f"Privileged run request: {workflow} @ {sha} ({pr_ref}).\n"
        f"Request comment: {comment_url}\n"
        + (f"Warrant: {HORKOS_URL}/ (request #{warrant_id})\n" if warrant_id else "")
        + f"Dispatch page: {dispatch_url}\n"
        f"Inputs: {' '.join(input_display) if input_display else '(none)'}\n"
        f"Why: {why or '(not given)'}\n"
        "Close this task when the run is dispatched+verified (approve) or denied."
    )

    task_id = file_heph_task(tracking_task_title(workflow, sha, number, pr_repo), heph_body)

    if superseded and supersedes is not None and warrant_id is not None:
        close_tracking_task(superseded, supersedes, warrant_id)

    if warrant_id and task_id:
        # verify-runs parses this line for exact request→run attribution —
        # keep the format in sync with its WARRANT_ID_RE.
        subprocess.run(
            ["heph", "context", task_id, "--append", f"Warrant request: #{warrant_id}"],
            capture_output=True,
            text=True,
        )

    if notify:
        try:
            with _ops_client() as client:
                client.post(
                    NTFY_URL,
                    content=f"{workflow} @ {sha7} (PR #{number}) awaits approval",
                    headers={
                        "Title": "Privileged run requested",
                        "Click": comment_url,
                        "Tags": "lock",
                        "Actions": f"view, Review request, {comment_url}; view, Dispatch page, {dispatch_url}",
                    },
                    timeout=10.0,
                ).raise_for_status()
        except httpx.HTTPError as exc:
            err.print(f"ntfy push failed (request still filed): {exc}")

    console.print(f"[green]Request filed.[/green] PR comment: {comment_url}")
    if warrant_id:
        console.print(f"warrant: {HORKOS_URL}/ (request #{warrant_id})")
    if task_id:
        console.print(f"heph task: {task_id}")
    if superseded:
        console.print(f"superseded: request #{supersedes} is retired and no longer approvable")


if __name__ == "__main__":
    typer.run(main)
