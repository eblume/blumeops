#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "pytest==9.1.1",
#   "prometheus-client==0.26.0",
# ]
# ///
#MISE description="Run the exporter unit tests (API-fixture replays, no network)"
"""Fixture-based unit tests for the homegrown exporters.

Replays fixtures for the homegrown exporters
(containers/authentik-blueprint-exporter/ and containers/openrouter-exporter/,
whose fixtures live under containers/openrouter-exporter/fixtures/ and are
synthetic) and runs their test_exporter.py files. For authentik, the replays
through the exporter's own snapshot logic assert the metric semantics — the
delete/re-create error-survival case, the empty-list = failed-poll case,
and pagination URL-building. No network, no secrets, works from an agent
pod (eblume/blumeops#1444).

Usage: mise run exporter-self-test [-- <pytest args>]
"""

import pathlib
import sys

import pytest

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.exit(pytest.main([
    str(ROOT / "containers" / "authentik-blueprint-exporter" / "test_exporter.py"),
    str(ROOT / "containers" / "openrouter-exporter" / "test_exporter.py"),
    "--import-mode=importlib",
    "-q",
    *sys.argv[1:],
]))
