#!/usr/bin/env bash
#MISE description="[human] Check that all services are online and responding"

set -euo pipefail

"$(dirname "$0")/_require" kubectl

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

FAILED=0

check_service() {
    local name="$1"
    local check_cmd="$2"

    printf "%-24s " "$name..."
    if eval "$check_cmd" > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        FAILED=1
    fi
}

# Indri legs only. Tailscale SSH on indri exits 0 no matter what the remote
# did (upstream tailscale/tailscale#18256; the fix #20626 is still pending),
# so a check must verify in-band: the remote command prints a sentinel only
# after it has run, and the local side greps for it. SSH's own rc is kept as
# transport triage only.
check_indri() {
    local name="$1"
    local label="$2"
    # Remote command template; the label arrives as $1 of the remote sh -c
    # (the _ after the template is sh -c's argv[0] placeholder). Only the
    # final rc never reaches the local side, so the sentinel is gated on the
    # PID column holding a number: launchctl exits 0 whether or not the job
    # runs, a not-loaded label's error goes to stderr (discarded), and a
    # stopped job's PID column is a dash — matching only a number (and not,
    # say, `grep -v "^-"`, which the column header would defeat) leaves
    # running as the sole pass condition.
    local remote_cmd
    if [[ -z "${3:-}" ]]; then
        remote_cmd='sh -c '\''set -eu; launchctl list "$1" 2>/dev/null | grep -qE "^[[:space:]]*[0-9]+" && echo "INDRI-OK $1"'\'''
    else
        remote_cmd="$3"
    fi

    printf "%-24s " "$name..."
    local out
    if ! out=$(ssh erichblume@indri "$remote_cmd" _ "$label" 2>&1); then
        echo -e "${RED}FAILED${NC} (ssh transport failure)"
        FAILED=1
        return 0
    fi
    if grep -qxF "INDRI-OK $label" <<<"$out"; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC} (no success sentinel from indri)"
        FAILED=1
    fi
}

check_http() {
    local name="$1"
    local url="$2"

    printf "%-24s " "$name..."
    if curl -sf --max-time 5 "$url" > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        FAILED=1
    fi
}

# ============== Grafana Alerting API ==============

GRAFANA_URL="https://grafana.ops.eblu.me"
GRAFANA_CREDS=""

fetch_alerts() {
    if [ -z "$GRAFANA_CREDS" ]; then
        local pass
        pass=$(op read 'op://vg6xf6vvfmoh5hqjjhlhbeoaie/oxkcr3xtxnewy7noep2izvyr6y/password' 2>/dev/null) || true
        if [ -n "$pass" ]; then
            GRAFANA_CREDS=$(echo -n "admin:$pass" | base64)
        fi
    fi

    if [ -z "$GRAFANA_CREDS" ]; then
        echo ""
        return
    fi

    curl -sf --max-time 10 \
        -H "Authorization: Basic $GRAFANA_CREDS" \
        "$GRAFANA_URL/api/prometheus/grafana/api/v1/alerts" 2>/dev/null || echo ""
}

# Fetch all alerts once
ALERTS_JSON=$(fetch_alerts)

check_alert() {
    local name="$1"
    local alertname="$2"
    # Optional: filter by a label key=value
    local filter_key="${3:-}"
    local filter_value="${4:-}"

    printf "%-24s " "$name..."

    if [ -z "$ALERTS_JSON" ]; then
        echo -e "${YELLOW}NO DATA${NC} (can't reach Grafana alerting API)"
        return
    fi

    local firing
    firing=$(echo "$ALERTS_JSON" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except:
    sys.exit(1)
alerts = data.get('data', {}).get('alerts', [])
for a in alerts:
    if a['labels'].get('alertname') != '$alertname':
        continue
    if '$filter_key' and a['labels'].get('$filter_key') != '$filter_value':
        continue
    if a['state'] in ('Alerting', 'Pending') or a['state'].startswith('Alerting'):
        url = a.get('annotations', {}).get('runbook_url', '')
        summary = a.get('annotations', {}).get('summary', '')
        print(f'{summary}|{url}')
" 2>/dev/null)

    if [ -z "$firing" ]; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FIRING${NC}"
        local runbook_printed=false
        while IFS='|' read -r summary runbook; do
            if [ -n "$summary" ]; then
                echo -e "                           $summary"
            fi
            if [ -n "$runbook" ] && [ "$runbook_printed" = false ]; then
                echo -e "                           Runbook: $runbook"
                runbook_printed=true
            fi
        done <<< "$firing"
        FAILED=1
    fi
}

echo "Checking services..."
echo "===================="
echo ""

# Local services on indri (not yet covered by alerting)
# ssh explicitly as erichblume: bare `ssh indri` relies on a local
# username mapping that only exists on gilbert. Run from another host
# (e.g. ringtail), tailscale SSH fails with "failed to look up local
# user" since indri's account is erichblume, not the caller's username.
echo "Local services on indri:"
check_indri "forgejo" "mcquack.eblume.forgejo"
check_indri "alloy" "mcquack.eblume.alloy"
check_indri "borgmatic" "mcquack.eblume.borgmatic"
check_indri "borgmatic-metrics" "mcquack.eblume.borgmatic-metrics"
check_indri "zot" "mcquack.eblume.zot"
check_indri "zot-metrics" "mcquack.eblume.zot-metrics"
check_indri "jellyfin-metrics" "mcquack.eblume.jellyfin-metrics"
check_indri "forgejo-runner (indri)" "mcquack.eblume.forgejo-runner"

# indri-build runner: system-domain launchd daemons under the unprivileged
# indri-build user (eblume/blumeops#1357). The user and both daemons are
# created by the first deployment of that PR, so skip (pass) until the user
# exists. "Not fatal-errored": a loaded job passes even while the runner
# idles before the human registers it, and even while colima provisions.
if out=$(ssh erichblume@indri "/usr/bin/id indri-build >/dev/null 2>&1 && echo 'INDRI-OK indri-build'" 2>&1) && grep -qxF "INDRI-OK indri-build" <<<"$out"; then
    check_indri "forgejo-runner-build" "system/mcquack.eblume.forgejo-runner-build" "sh -c 'set -eu; sudo -n launchctl print system/mcquack.eblume.forgejo-runner-build >/dev/null && echo \"INDRI-OK \$1\"'"
    check_indri "colima-build" "system/mcquack.eblume.colima-build" "sh -c 'set -eu; sudo -n launchctl print system/mcquack.eblume.colima-build >/dev/null && echo \"INDRI-OK \$1\"'"
else
    printf "%-24s " "forgejo-runner-build..."
    echo -e "${YELLOW}SKIP${NC} (indri-build user not deployed yet)"
fi

echo ""
echo "Metrics textfiles (via alerting):"
check_alert "textfile-freshness" "TextfileStale"

echo ""
echo "Ringtail HTTP endpoints (via alerting / blackbox exporter):"
# Probed by the Alloy blackbox exporter on ringtail
# (argocd/manifests/alloy-ringtail/config.alloy). Each target's `name` becomes
# the `service` label on ServiceProbeFailure, so this list must mirror the
# blackbox target list. ollama is intentionally omitted (scaled to 0 unless needed).
check_alert "ArgoCD" "ServiceProbeFailure" "service" "argocd"
check_alert "Authentik" "ServiceProbeFailure" "service" "authentik"
check_alert "Frigate" "ServiceProbeFailure" "service" "frigate"
check_alert "Grafana" "ServiceProbeFailure" "service" "grafana"
check_alert "Homepage" "ServiceProbeFailure" "service" "homepage"
check_alert "Immich" "ServiceProbeFailure" "service" "immich"
check_alert "Kiwix" "ServiceProbeFailure" "service" "kiwix"
check_alert "Loki" "ServiceProbeFailure" "service" "loki"
check_alert "Mealie" "ServiceProbeFailure" "service" "mealie"
check_alert "Miniflux" "ServiceProbeFailure" "service" "miniflux"
check_alert "Navidrome" "ServiceProbeFailure" "service" "navidrome"
check_alert "Ntfy" "ServiceProbeFailure" "service" "ntfy"
check_alert "Paperless" "ServiceProbeFailure" "service" "paperless"
check_alert "Prometheus" "ServiceProbeFailure" "service" "prometheus"
check_alert "TeslaMate" "ServiceProbeFailure" "service" "teslamate"
check_alert "Tempo" "ServiceProbeFailure" "service" "tempo"
check_alert "Transmission" "ServiceProbeFailure" "service" "transmission"

echo ""
echo "Indri & public HTTP endpoints (direct probe — not in the ringtail cluster):"
check_http "Forge (ops)" "https://forge.ops.eblu.me/"
check_http "Zot Registry" "https://registry.ops.eblu.me/v2/_catalog"
check_http "Devpi" "https://pypi.ops.eblu.me/"
check_http "CV" "https://cv.ops.eblu.me/"

echo ""
echo "Frigate (via alerting):"
check_alert "camera-fps" "FrigateCameraDown"
echo "Frigate (not yet covered by alerting):"
check_service "frigate-storage" "curl -sf --max-time 5 https://nvr.ops.eblu.me/api/stats | jq -e '.service.storage | to_entries | map(select(.key | startswith(\"/media\"))) | length > 0 and all(.[]; .value.free > 0)'"

echo ""
echo "Ringtail (not yet covered by alerting):"
check_service "ssh" "ssh -o ConnectTimeout=5 ringtail true"
check_service "tailscale" "ssh ringtail 'tailscale status --self --json' | jq -e '.Self.Online' > /dev/null"
# /etc/rancher/k3s/k3s.yaml is 0600 root:root since ringtail became a multi-user
# host, so read it via `sudo k3s kubectl` (eblume has passwordless sudo; kubeconfig
# stays locked). `grep -qw` so a NotReady node can't false-pass on the substring.
check_service "k3s" "ssh ringtail 'sudo k3s kubectl get nodes --no-headers | grep -qw Ready'"
check_service "k3s-apiserver (remote)" "kubectl --context=k3s-ringtail get --raw /healthz"
check_service "forgejo-runner" "ssh ringtail 'systemctl is-active gitea-runner-nix_container_builder.service'"

echo ""
echo "Pod health (via alerting):"
check_alert "pod-readiness" "PodNotReady"

echo ""
echo "Database (via alerting):"
check_alert "PostgreSQL" "PostgresClusterUnhealthy"

echo ""
echo "Public services (not yet covered by alerting):"
check_http "Docs (public)" "https://docs.eblu.me/"
check_http "CV (public)" "https://cv.eblu.me/"
check_http "Forge (public)" "https://forge.eblu.me/"
check_http "Fly.io healthz" "https://blumeops-proxy.fly.dev/healthz"

echo ""
echo "ArgoCD app sync status (via alerting):"
check_alert "argocd-sync" "ArgoCDAppOutOfSync"
# Keep the detailed table as a summary view
printf "%-20s %-12s %-12s %s\n" "NAME" "SYNC" "HEALTH" "TARGET"
while read -r name sync health target; do
    if [[ "$sync" == "Synced" ]]; then
        printf "%-20s ${GREEN}%-12s${NC} %-12s %s\n" "$name" "$sync" "$health" "$target"
    elif [[ "$sync" == "OutOfSync" ]]; then
        printf "%-20s ${RED}%-12s${NC} %-12s %s\n" "$name" "$sync" "$health" "$target"
    else
        printf "%-20s %-12s %-12s %s\n" "$name" "$sync" "$health" "$target"
    fi
done < <(kubectl --context=k3s-ringtail get applications -n argocd --no-headers -o custom-columns='NAME:.metadata.name,SYNC:.status.sync.status,HEALTH:.status.health.status,TARGET:.spec.source.targetRevision' 2>/dev/null)

echo ""
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}All services healthy!${NC}"
    exit 0
else
    echo -e "${RED}Some services failed health check${NC}"
    exit 1
fi
