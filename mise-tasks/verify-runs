#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx[socks]==0.28.1", "rich==15.0.0", "typer==0.27.1", "pyyaml==6.0.3"]
# ///
#MISE description="Sweep open Approve tasks: match to workflow runs, close settled ones (warrant Phase 2 audit)"
"""Close the request→approve→run loop: the audit sweep.

Phase 2 of [[warrant-approval-gated-runs]]. `request-run` files an
attention-orange heph task per privileged-run request; this task sweeps the
open ones, matches each to its workflow run on the forge, and:

- run succeeded  → `heph log` the outcome, `heph done` the task
- run failed     → `heph log` the failure + run URL, LEAVE the task open
                   (a failed approval needs human/agent follow-up)
- run built the wrong commit → `heph log` an AUDIT FAILURE, LEAVE it open.
                   A green run that did not carry the approved SHA is the
                   worst of the four outcomes, because nothing else reports it.
- no run yet / still running → leave untouched

Attribution prefers the RECORD over inference: warrant stores the run number
the forge named in its dispatch response (`return_run_info`), and request-run
stamps the warrant request id into the heph task, so a task closes against
the exact run its approval caused. A warrant record with no run number is
reported, never guessed: request status "dispatched" means the dispatch ran
but the forge never named the run (pre-`return_run_info` forge / 204 answer)
— "dispatched-norun", left for a human to link or re-dispatch; status
"dispatch_failed" means the dispatch attempt failed (the reason is on the
warrant note); any other run-less status (approved, denied, superseded, …)
was never dispatched — "never dispatched", with the warrant note's
"not dispatched: {reason}" surfaced when horkos recorded one
(eblume/horkos#13). Inference is refused for all three: eblume/horkos#12
audited run 1754 being guessed for an approved-but-undispatched request. The
forge-side heuristic (newest dispatch of that workflow after the request was
filed) is reserved for approvals with no warrant record at all — pre-stamp
tasks or a warrant outage — and closures it produces are marked as inferred
in the audit log.

Run it from any agent session (`mise run verify-runs`) — it needs heph and
the bot's forge token, nothing privileged. Idempotent; safe to run anytime.

Usage: mise run verify-runs [--dry-run]
"""

import json
import os
import re
import subprocess
from typing import Annotated

import httpx
import typer
from rich.console import Console
from rich.markup import escape

# Tailnet name — the public forge.eblu.me is HTTPS-poison in-cluster
# (docs/reference/services/argocd.md).
FORGE_API_BASE = "https://forge.ops.eblu.me/api/v1"
REPO = "eblume/blumeops"
TITLE_RE = re.compile(r"^Approve: (?P<workflow>\S+) @ (?P<sha7>[0-9a-f]{7}) \(PR #(?P<pr>\d+)\)$")

HORKOS_URL = "https://horkos.ops.eblu.me"
AUTHENTIK_TOKEN_URL = "https://authentik.ops.eblu.me/application/o/token/"
SOCKS_FALLBACK = "socks5://localhost:1055"  # agent pod's tailscale sidecar
# request-run appends this line to each Approve task's context doc.
WARRANT_ID_RE = re.compile(r"Warrant request: #(\d+)")

console = Console()
err = Console(stderr=True, style="bold red")


def forge_token() -> str:
    if token := os.environ.get("FORGEJO_TOKEN"):
        return token.strip()
    try:
        result = subprocess.run(
            ["op", "read", "op://agents/agents-forgejo-token/api-token"],
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
            timeout=30,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        err.print(f"No FORGEJO_TOKEN and `op read` failed: {exc}")
        raise typer.Exit(1) from exc
    if result.returncode != 0:
        err.print(f"No FORGEJO_TOKEN and `op read` failed: {result.stderr.strip()}")
        raise typer.Exit(1)
    return result.stdout.strip()


def heph(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["heph", *args], capture_output=True, text=True)


def open_approve_tasks() -> list[dict]:
    result = heph("list", "--project", "Blumeops", "--json")
    if result.returncode != 0:
        err.print(f"heph list failed: {result.stderr.strip()}")
        raise typer.Exit(1)
    tasks = []
    for row in json.loads(result.stdout):
        if row.get("state") != "outstanding" or row.get("tombstoned"):
            continue
        if match := TITLE_RE.match(row.get("title", "")):
            tasks.append({**row, **match.groupdict()})
    return tasks


def recent_runs(client: httpx.Client) -> list[dict]:
    resp = client.get(f"{FORGE_API_BASE}/repos/{REPO}/actions/tasks", params={"limit": 50})
    resp.raise_for_status()
    data = resp.json()
    return data.get("workflow_runs") or data


def _ops_client() -> httpx.Client:
    """Client for *.ops.eblu.me: direct on gilbert, SOCKS fallback in-pod.

    The probe uses a throwaway client: any request on the returned client
    would implicitly open it, and the caller's `with` would then raise
    "Cannot open a client instance more than once" on __enter__."""
    proxy = os.environ.get("ALL_PROXY")
    try:
        with httpx.Client(timeout=5.0, proxy=proxy) as probe:
            probe.get(f"{HORKOS_URL}/healthz")
    except httpx.TransportError:
        proxy = SOCKS_FALLBACK
    return httpx.Client(timeout=15.0, proxy=proxy)


def warrant_requests() -> dict[int, dict]:
    """The recorded request→run links. Warrant stores the run number the
    forge itself named in the dispatch response (`return_run_info`) — the one
    attribution that is recorded rather than inferred. Best-effort: any
    failure here warns and returns {}, degrading the sweep to the forge-side
    heuristic rather than blocking it."""
    try:
        app_pw = subprocess.run(
            ["op", "read", "op://agents/agents-authentik-sa/app-password"],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, check=True,
            timeout=30,
        ).stdout.strip()
        with _ops_client() as c:
            tok = c.post(
                AUTHENTIK_TOKEN_URL,
                data={
                    "grant_type": "client_credentials",
                    "client_id": "agents-m2m",
                    "username": "agent-ringtail",
                    "password": app_pw,
                    "scope": "openid profile",
                },
            )
            tok.raise_for_status()
            resp = c.get(
                f"{HORKOS_URL}/api/requests",
                params={"limit": 500},
                headers={"Authorization": f"Bearer {tok.json()['access_token']}"},
            )
            resp.raise_for_status()
            return {r["id"]: r for r in resp.json()}
    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired,
        httpx.HTTPError,
        KeyError,
        OSError,
    ) as exc:
        err.print(f"warrant lookup failed (falling back to forge-side matching): {exc}")
        return {}


def warrant_id_for(task: dict) -> int | None:
    """The warrant request id request-run stamped into the task's context
    doc; None for pre-stamp tasks or if heph is unreadable."""
    result = heph("context", task["node_id"])
    if result.returncode != 0:
        return None
    m = WARRANT_ID_RE.search(result.stdout)
    return int(m.group(1)) if m else None


def sha_policy(client: httpx.Client) -> dict[str, str]:
    """action → the input name that must carry the approved SHA, per
    warrant-policy.yaml ON MAIN. Best-effort: an unreadable policy disables
    the binding audit rather than blocking the sweep."""
    import yaml

    try:
        resp = client.get(f"{FORGE_API_BASE}/repos/{REPO}/raw/main/warrant-policy.yaml")
        resp.raise_for_status()
        actions = (yaml.safe_load(resp.text) or {}).get("actions") or {}
    except (httpx.HTTPError, yaml.YAMLError) as exc:
        err.print(f"warrant-policy read failed (skipping SHA-binding audit): {exc}")
        return {}
    return {
        name: entry["binds_sha"]
        for name, entry in actions.items()
        if entry.get("binds_sha")
    }


def binding_mismatch(wrec: dict, bindings: dict[str, str]) -> str | None:
    """Did the dispatch actually carry the SHA the approval was bound to?

    Compare the RECORD against itself — warrant stores both the bound `sha`
    and the `inputs` it dispatched — never the run's `head_sha`. A dispatched
    run's head_sha is main's tip at dispatch time, not the payload (that is
    what `match_run` documents and what PR #523 fixed), so a head_sha
    comparison would fail every honest approval filed before main moved on.

    Catches warrant #22 retroactively: bound to bcb2b55, dispatched with no
    `ref` at all, built main, reported success.

    Returns None only when the binding is affirmatively verified. A record it
    cannot read is reported, not waved through — an audit that closes a task
    it failed to check is worse than one that asks a human to look."""
    binding = bindings.get(wrec.get("action", ""))
    if binding is None:
        return None  # action declares no binding; nothing to verify
    raw = wrec.get("inputs")
    if raw is None:
        return "request record carries no dispatch inputs, so the SHA binding cannot be verified"
    try:
        inputs = json.loads(raw)
    except json.JSONDecodeError:
        return "request record has unreadable dispatch inputs, so the SHA binding cannot be verified"
    bound, sent = wrec.get("sha"), inputs.get(binding)
    if sent == bound:
        return None
    if sent is None:
        return f"dispatched with no '{binding}' input, so it ran against main, not {str(bound)[:7]}"
    return f"dispatched '{binding}={sent}' but the approval bound {str(bound)[:7]}"


def match_run(task: dict, runs: list[dict]) -> dict | None:
    """Forge-side FALLBACK when no recorded warrant link exists. A dispatched
    run's head_sha is the main tip at dispatch time, not the payload SHA the
    request bound — the two coincide only while the payload is the tip. So:
    prefer a head_sha match when one exists, else the newest workflow_dispatch
    run of that workflow started after the request was filed (epoch ms → s).
    This is inference; the caller marks its closures as such."""
    filed_at = (task.get("created_at") or 0) / 1000

    def started(r: dict) -> float:
        return _epoch(r.get("run_started_at") or r.get("created_at") or "")

    candidates = [
        r
        for r in runs
        if r.get("workflow_id") == task["workflow"] and started(r) >= filed_at - 60
    ]
    exact = [r for r in candidates if (r.get("head_sha") or "").startswith(task["sha7"])]
    pool = exact or [r for r in candidates if r.get("event") == "workflow_dispatch"]
    return max(pool, key=lambda r: r["run_number"]) if pool else None


def _note_detail(note: str | None, prefix: str) -> str | None:
    """The most recent `prefix: …` segment horkos appended to a warrant note.

    horkos appends one segment per pre-dispatch no-op (" | not dispatched:
    …") or failed dispatch (" | dispatch FAILED: …"), so a note can carry
    several; the appended-most is the operative one. Limitation: a detail
    containing a literal `|` is truncated at the first internal pipe — the
    separator is horkos's format, so the extraction degrades gracefully."""
    if not note:
        return None
    for segment in reversed(re.split(r"\s*\|\s*", note)):
        m = re.match(re.escape(prefix) + r":\s*(.+)", segment, re.IGNORECASE)
        if m:
            return m.group(1).strip()
    return None


def not_dispatched_reason(note: str | None) -> str | None:
    """Why a dispatch never ran: the reason in the warrant note's trailing
    " | not dispatched: {reason}" segment (eblume/horkos#13), or None when
    the note records none (pre-#13 records, or a note the API did not fold)."""
    return _note_detail(note, "not dispatched")


def dispatch_failed_detail(note: str | None) -> str | None:
    """Why a dispatch attempt failed: the detail in the warrant note's
    trailing " | dispatch FAILED: {detail}" segment, or None."""
    return _note_detail(note, "dispatch FAILED")


def attribution(
    task: dict, wid: int | None, wrec: dict | None, runs: list[dict]
) -> tuple[dict | None, str | None, str]:
    """Decide run attribution for one open Approve task.

    The warrant record — when one exists — is authoritative: a request may
    close only against the run number the forge named in its own dispatch
    response (persisted as the warrant's `run_number`). Forge-side inference
    (`match_run`) is reserved for approvals with NO warrant record at all —
    pre-stamp tasks or a warrant outage.

    A run-less warrant record is never guessed at. Three shapes exist, and
    the sweep distinguishes them: request status "dispatched" means the
    dispatch DID run but the forge answered without naming one (pre-
    `return_run_info` forge / 204) — "dispatched-norun", a human links or
    re-dispatches; "dispatch_failed" means the dispatch attempt failed (the
    reason is on the warrant note); anything else (approved / denied /
    superseded / …) was never dispatched. Inferring a run for any of them is
    exactly the misattribution audit eblume/horkos#12 caught (run 1754
    guessed for an approved-but-undispatched request), so all three refuse
    the heuristic outright.

    Returns (run, via, state):
      - "recorded": warrant names `run_number`; `run` is that run, or None
        when it sits outside the recent-run window.
      - "pending":  warrant exists and awaits a decision.
      - "dispatched-norun": status "dispatched", no `run_number` — the run
        ran but was never recorded; a human links or re-dispatches.
      - "dispatch_failed": status "dispatch_failed" — the dispatch attempt
        failed, terminally; the warrant note carries the reason.
      - "never":    any other run-less record — never dispatched.
      - "inferred": no warrant record; `run` from the forge-side heuristic
        (None when nothing matches).
    """
    if wrec and wrec.get("run_number"):
        via = f"recorded: warrant #{wid}"
        run = next(
            (r for r in runs if r.get("run_number") == wrec["run_number"]), None
        )
        return run, via, "recorded"
    if wrec and wrec.get("status") == "pending":
        return None, None, "pending"
    if wrec:
        # Recorded but run-less. Three shapes — two of them NOT "never
        # dispatched": status "dispatched" means the dispatch ran and the
        # forge just never named a run (pre-return_run_info forge / 204);
        # status "dispatch_failed" means the dispatch attempt failed (the
        # warrant note carries the reason). Everything else (approved /
        # denied / superseded / …) was never dispatched. Guessing a run for
        # any of them would reopen the eblume/horkos#12 misattribution, so
        # all three report and stay open; main() surfaces the note's
        # "not dispatched: {reason}" when horkos recorded one.
        if wrec.get("status") == "dispatched":
            return None, None, "dispatched-norun"
        if wrec.get("status") == "dispatch_failed":
            return None, None, "dispatch_failed"
        return None, None, "never"
    return match_run(task, runs), "inferred: newest dispatch after filing", "inferred"


def _epoch(iso: str) -> float:
    from datetime import datetime

    try:
        return datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return 0.0


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run", help="Report only; change nothing")] = False,
) -> None:
    tasks = open_approve_tasks()
    if not tasks:
        console.print("No open Approve tasks — the queue is clean.")
        return

    token = forge_token()
    with httpx.Client(headers={"Authorization": f"token {token}"}, timeout=30.0) as client:
        runs = recent_runs(client)
        bindings = sha_policy(client)
    warrants = warrant_requests()

    closed = failed = pending = mismatched = never_dispatched = 0
    for task in tasks:
        node_id = task["node_id"]
        label = f"{task['workflow']} @ {task['sha7']} (PR #{task['pr']})"

        wid = warrant_id_for(task)
        wrec = warrants.get(wid) if wid else None
        run, via, state = attribution(task, wid, wrec, runs)
        if state == "inferred" and wid is not None:
            # Stamped but missing: the (successful) fetch of the horkos
            # requests returned no record for this warrant id — it sits
            # outside the limit window, or the request vanished. The sweep
            # still infers (behavior unchanged), but say so: a genuinely
            # approved task is being attributed by guesswork, which is
            # exactly the #12 misattribution, and it must not pass silently.
            console.print(
                f"[yellow]warn[/yellow]   {label} — warrant #{wid} not among the "
                "500 newest horkos requests; treating as unrecorded (inference "
                "may misattribute)"
            )
        if state == "recorded" and run is None:
            # attribution returns "recorded" only when the warrant names a run number
            assert wrec is not None
            console.print(
                f"[yellow]pending[/yellow]  {label} — warrant #{wid} names run "
                f"{wrec['run_number']}, which is outside the recent-run window"
            )
            pending += 1
            continue
        if state == "pending":
            console.print(f"[yellow]pending[/yellow]  {label} — warrant #{wid} awaits decision")
            pending += 1
            continue
        if state == "dispatched-norun":
            console.print(
                f"[yellow]dispatched-norun[/yellow]  {label} — warrant #{wid} WAS "
                "dispatched but the forge named no run (pre-return_run_info "
                "answer / deaf forge); a human must link or re-dispatch — "
                "inference refused (task left open)"
            )
            pending += 1  # open: awaits that human follow-up
            continue
        if state == "dispatch_failed":
            detail = dispatch_failed_detail(wrec.get("note") if wrec else None)
            suffix = f": {escape(detail)}" if detail else ""
            console.print(
                f"[red]dispatch FAILED[/red]  {label} — warrant #{wid} dispatch failed"
                f"{suffix} (see the warrant note for the reason; task left open)"
            )
            failed += 1
            continue
        if state == "never":
            reason = not_dispatched_reason(wrec.get("note") if wrec else None)
            reason_text = f" — not dispatched: {escape(reason)}" if reason else ""
            console.print(
                f"[yellow]never dispatched[/yellow]  {label} — warrant #{wid} records no "
                f"run number{reason_text}; inference refused, so no run is "
                "guessed (task left open)"
            )
            never_dispatched += 1
            continue

        if run is None:
            console.print(f"[yellow]pending[/yellow]  {label} — not dispatched yet")
            pending += 1
            continue
        url = f"https://forge.eblu.me/{REPO}/actions/runs/{run['run_number']}"
        status = run.get("status")

        # A run that built the wrong commit must never close its approval,
        # however green the forge reports it.
        if wrec and (why := binding_mismatch(wrec, bindings)):
            if not dry_run:
                heph(
                    "log", node_id,
                    f"AUDIT FAILURE: run {run['run_number']} {why} — {url} ({via}). "
                    "The approved change was not what ran; left open. "
                    "Re-request with the SHA bound to the workflow's payload input.",
                )
            console.print(
                f"[red]MISMATCH[/red] {label} — run {run['run_number']} {why} "
                "(task left open)"
            )
            mismatched += 1
            continue

        if status == "success":
            if not dry_run:
                heph("log", node_id, f"AUDIT: run {run['run_number']} succeeded — {url} ({via}). Auto-closed by verify-runs.")
                heph("done", node_id)
            console.print(f"[green]closed[/green]   {label} — run {run['run_number']} succeeded ({via})")
            closed += 1
        elif status in ("failure", "cancelled"):
            if not dry_run:
                heph("log", node_id, f"AUDIT: run {run['run_number']} {status} — {url} ({via}). Left open for follow-up.")
            console.print(f"[red]failed[/red]   {label} — run {run['run_number']} {status} ({via}; task left open)")
            failed += 1
        else:
            console.print(f"[yellow]running[/yellow]  {label} — run {run['run_number']} {status}")
            pending += 1

    summary = f"\n{closed} closed, {failed} failed (open), {pending} pending/running"
    if never_dispatched:
        summary += f", [yellow]{never_dispatched} never dispatched[/yellow] (open)"
    if mismatched:
        summary += f", [red]{mismatched} SHA-binding mismatch[/red] (open)"
    console.print(summary)


if __name__ == "__main__":
    typer.run(main)
