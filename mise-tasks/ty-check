#!/usr/bin/env bash
#MISE description="Type-check the repo with ty (project + mise-tasks uv scripts)"
#
# Type-checks the whole repo with ty: the .py project (tests/) plus the
# extensionless uv scripts in mise-tasks/, which ty's file walk does not
# discover on its own (they carry no .py suffix), so they are enumerated
# and passed explicitly.
#
# ty runs in the project's uv environment (`uv run --group dev`): the `dev`
# dependency group in pyproject.toml mirrors the versions the mise-tasks uv
# scripts pin inline (plus pytest for tests/), so every import type-checks
# against package versions that match what actually runs. The project env is
# buildable in any fresh checkout, so no dedicated .ty-env is needed; keep
# the `dev` group in lockstep when those inline pins move.
set -euo pipefail
cd "$(dirname "$0")/.."

# Extensionless uv scripts: identified by their uv shebang, not their name.
uv_scripts=()
while IFS= read -r f; do
  [ -n "$f" ] && uv_scripts+=("$f")
done < <(find mise-tasks -type f -exec grep -l '^#!/usr/bin/env -S uv run --script' {} + 2>/dev/null | sort)

exec uv run --group dev ty check . "${uv_scripts[@]}"
