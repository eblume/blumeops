#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx[socks]==0.28.1", "rich==15.0.0", "typer==0.26.7"]
# ///
#MISE description="List available containers and their recent tags"
#USAGE arg "[name]" help="Optional container name to filter output"
"""List container images and their recent registry tags.

Shows the registry path and recent tags from the zot registry for each
nix-built container (containers/*/default.nix). Tags are annotated with
[main] or [branch] to indicate whether the build commit is an ancestor of
origin/main.

Usage:
    mise run container-list                # all containers
    mise run container-list prometheus     # single container (more tags shown)
"""

import re
import subprocess
from pathlib import Path

import httpx
import typer
from rich.console import Console
from rich.table import Table

REGISTRY = "registry.ops.eblu.me"
CONTAINER_DIR = Path("containers")

console = Console()
app = typer.Typer(add_completion=False)


def git(*args: str) -> str:
    result = subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    )
    return result.stdout.strip()


def sha_hint(tag: str) -> str:
    """Check if the 7-char hex SHA in a tag is on origin/main."""
    match = re.search(r"[0-9a-f]{7}", tag)
    if not match:
        return ""
    sha = match.group()
    try:
        full_sha = git("rev-parse", "--verify", sha)
    except subprocess.CalledProcessError:
        return "[dim]\\[unknown][/dim]"
    try:
        git("merge-base", "--is-ancestor", full_sha, "origin/main")
        return "[green]\\[main][/green]"
    except subprocess.CalledProcessError:
        return "[yellow]\\[branch][/yellow]"


def get_tags(image: str) -> list[str] | None:
    """Version tags for `image`, or None if the registry could not be reached.

    The distinction is the whole point. Collapsing both onto `[]` reports "no
    tags", and "this container has never been built" is a confident answer to a
    question we never got to ask — from an agent pod that was every container,
    every time. A 404 does genuinely mean no such repository, so that stays [].
    """
    try:
        resp = httpx.get(f"https://{REGISTRY}/v2/{image}/tags/list", timeout=10)
        if resp.status_code == 404:
            return []
        resp.raise_for_status()
        tags = resp.json().get("tags", [])
    except (httpx.HTTPError, ValueError):
        return None
    return sorted(t for t in tags if re.match(r"^v[0-9]", t))


def discover_containers() -> list[dict]:
    """Find container directories with a nix build (containers/*/default.nix)."""
    containers = []
    for d in sorted(CONTAINER_DIR.iterdir()):
        if not d.is_dir():
            continue
        if not (d / "default.nix").exists():
            continue
        containers.append({
            "name": d.name,
            "path": str(d),
        })
    return containers


@app.command()
def main(
    name: str = typer.Argument("", help="Container name to filter (optional)"),
) -> None:
    """List available containers and their recent tags."""
    containers = discover_containers()

    if name:
        containers = [c for c in containers if c["name"] == name]
        if not containers:
            console.print(f"[red]No container found matching '{name}'.[/red]")
            console.print("Run without arguments to see all containers.")
            raise typer.Exit(1)

    tag_count = 10 if name else 4

    unreachable = 0
    for c in containers:
        image = f"blumeops/{c['name']}"
        tags = get_tags(image)

        console.print(f"[bold]{c['name']}[/bold]")
        console.print(f"   Image: {REGISTRY}/{image}")
        console.print(f"   Path:  {c['path']}")

        if tags is None:
            unreachable += 1
            console.print("   Recent tags: [red]registry unreachable[/red]")
        elif tags:
            console.print("   Recent tags:")
            for tag in tags[-tag_count:]:
                console.print(f"     - {tag} {sha_hint(tag)}")
        else:
            console.print("   Recent tags: [dim](none)[/dim]")
        console.print()

    if unreachable:
        console.print(
            f"[red]{unreachable} of {len(containers)} could not be queried — "
            f"tag lists above are missing, not empty.[/red]"
        )
        console.print(
            f"[dim]{REGISTRY} is tailnet-only. From an agent pod, route through "
            f"the sidecar:[/dim]\n"
            f"  ALL_PROXY=socks5://localhost:1055 mise run container-list"
        )
        raise typer.Exit(1)

    console.print("[dim]---[/dim]")
    console.print(
        "Tags marked [green]\\[main][/green] were built from a commit on main."
    )
    console.print(
        "Tags marked [yellow]\\[branch][/yellow] were built from a PR branch — "
        "use \\[main] tags in production manifests."
    )
    console.print()
    console.print("To trigger a build:")
    console.print("  mise run container-build-and-release <container>")


if __name__ == "__main__":
    app()
