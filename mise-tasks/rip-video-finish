#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="[human] File a rip-video staging dir into the Jellyfin library per its metadata.json (indri)"
#USAGE arg "<staging>" help="Staging dir written by rip-video"
#USAGE flag "--library <dir>" help="Video library root (default: /Volumes/allisonflix)"
#USAGE flag "--dry-run" help="Show where each file would go"
#USAGE flag "--clean" help="Remove the staging dir after filing"
"""Second half of the video pipeline ([[rip-a-disc]]): metadata.json → Jellyfin layout.

    movie:  Movies/<Title (Year)>/<Title (Year)>.mkv
            Movies/<Title (Year)>/extras/<Name>.mkv
    tv:     TV/<Show>/Season NN/<Show> - SNNENN - <Episode Title>.mkv

Jellyfin reads titles and episode numbers from these names and fetches the
rest itself. Refuses to overwrite anything already in the library.
"""

import json
import re
import shutil
import sys
from pathlib import Path
from typing import Annotated

import typer
from rich.console import Console
from rich.markup import escape
from rich.table import Table

console = Console()
app = typer.Typer(add_completion=False)

DEFAULT_LIBRARY = Path("/Volumes/allisonflix")
PATH_CHARS = str.maketrans({"/": "／", ":": "：", "\0": ""})


def safe_component(text: str) -> str:
    text = text.translate(PATH_CHARS).strip().lstrip(".")
    return re.sub(r"\s+", " ", text) or "_"


def plan_movie(meta: dict, library: Path) -> list[tuple[str, Path]]:
    if not meta.get("title") or not meta.get("year"):
        raise ValueError("movie needs title and year")
    name = safe_component(f"{meta['title']} ({meta['year']})")
    folder = library / "Movies" / name
    plan = []
    features = 0
    for f in meta["files"]:
        target = f.get("target")
        if not target:
            continue
        if target == "feature":
            features += 1
            plan.append((f["source"], folder / f"{name}.mkv"))
        elif target.startswith("extra:"):
            plan.append((f["source"], folder / "extras" / f"{safe_component(target[6:])}.mkv"))
        else:
            raise ValueError(f"{f['source']}: movie target must be 'feature', 'extra:<Name>' or null, not {target!r}")
    if features > 1:
        raise ValueError("more than one file is marked 'feature'")
    return plan


def plan_tv(meta: dict, library: Path) -> list[tuple[str, Path]]:
    if not meta.get("show") or meta.get("season") is None:
        raise ValueError("tv needs show and season")
    season = int(meta["season"])
    show = safe_component(meta["show"])
    folder = library / "TV" / show / (meta.get("season_dir") or f"Season {season:02d}")
    plan = []
    for f in meta["files"]:
        target = f.get("target")
        if not target:
            continue
        m = re.fullmatch(r"E(\d+)(?:-(\d+))?(?::(.*))?", target)
        if not m:
            raise ValueError(f"{f['source']}: tv target must look like 'E3', 'E3:Title' or 'E3-4', not {target!r}")
        first, last, title = m.groups()
        code = f"S{season:02d}E{int(first):02d}" + (f"-E{int(last):02d}" if last else "")
        name = f"{show} - {code}" + (f" - {safe_component(title.strip())}" if title and title.strip() else "")
        plan.append((f["source"], folder / f"{name}.mkv"))
    return plan


@app.command()
def main(
    staging: Annotated[Path, typer.Argument(help="Staging dir written by rip-video")],
    library: Annotated[Path, typer.Option("--library", help="Video library root")] = DEFAULT_LIBRARY,
    dry_run: Annotated[bool, typer.Option("--dry-run", help="Show the plan only")] = False,
    clean: Annotated[bool, typer.Option("--clean", help="Remove the staging dir after filing")] = False,
) -> None:
    """File a ripped disc into the Jellyfin library."""
    staging = staging.expanduser().resolve()
    meta_path = staging / "metadata.json"
    if not meta_path.exists():
        console.print(f"[red]{escape(str(meta_path))} not found — is this a rip-video staging dir?[/red]")
        raise typer.Exit(1)
    meta = json.loads(meta_path.read_text())
    if not library.is_dir():
        console.print(f"[red]{escape(str(library))} is not mounted (AutoMounter?).[/red]")
        raise typer.Exit(1)
    try:
        kind = meta.get("kind")
        if kind == "movie":
            plan = plan_movie(meta, library)
        elif kind == "tv":
            plan = plan_tv(meta, library)
        else:
            raise ValueError(f"kind must be 'movie' or 'tv', not {kind!r}")
    except ValueError as exc:
        console.print(f"[red]metadata.json is not ready: {escape(str(exc))}[/red]")
        raise typer.Exit(1) from None
    if not plan:
        console.print("[red]Every file has target null — nothing to file.[/red]")
        raise typer.Exit(1)

    table = Table(title=f"{kind}: {meta.get('title') or meta.get('show')}")
    table.add_column("Staged")
    table.add_column("Filed as")
    problems = []
    for src, dst in plan:
        table.add_row(escape(src), escape(str(dst.relative_to(library))))
        if not (staging / src).exists():
            problems.append(f"{src} is not in the staging dir")
        if dst.exists():
            problems.append(f"{dst} already exists")
    console.print(table)
    if len({dst for _, dst in plan}) != len(plan):
        problems.append("two files map to the same destination")
    if problems:
        console.print("[red]Refusing:[/red]")
        for p in problems:
            console.print(f"  - {escape(p)}")
        raise typer.Exit(1)
    if dry_run:
        return

    for src, dst in plan:
        dst.parent.mkdir(parents=True, exist_ok=True)
        console.print(f"moving {escape(src)} → {escape(str(dst))}")
        shutil.move(str(staging / src), str(dst))
    (staging / ".filed").write_text("\n".join(str(dst) for _, dst in plan) + "\n")
    console.print(f"[green]Filed {len(plan)} file(s). Jellyfin picks them up on its next library scan.[/green]")
    if clean:
        shutil.rmtree(staging)
        console.print(f"Removed {escape(str(staging))}")


if __name__ == "__main__":
    try:
        app()
    except OSError as exc:
        console.print(f"[red]{escape(str(exc))}[/red]")
        sys.exit(1)
