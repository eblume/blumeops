#!/usr/bin/env bash
#MISE description="[human] Run ansible playbook to provision ringtail (NixOS)"

set -euo pipefail

export MISE_TASK_OUTPUT=interleave

# Native nix, or the nixos/nix container on a nixless controller (gilbert).
echo "Updating nixos/ringtail/flake.lock..."
"$(dirname "$0")/_flake_lock" nixos/ringtail

if ! git diff --quiet nixos/ringtail/flake.lock; then
    git add nixos/ringtail/flake.lock
    echo "flake.lock changed and staged. Commit, push, and re-run."
    exit 1
fi

COMMIT=$(git rev-parse HEAD)
# `if !` keeps a failed ls-remote out of set -e's reach, so an unreachable
# forge fails here with git's own error instead of a silent exit.
if ! REMOTE_REF=$(git ls-remote origin "$(git rev-parse --abbrev-ref HEAD)" | awk 'NR==1{print $1}'); then
    echo "ERROR: cannot reach origin to verify $COMMIT is pushed."
    exit 1
fi

if [[ "$REMOTE_REF" != "$COMMIT" ]]; then
    echo "ERROR: Current commit $COMMIT is not pushed to forge."
    echo "Push your changes first: git push"
    exit 1
fi

echo "Deploying commit $COMMIT to ringtail..."

cd ansible
ansible-playbook playbooks/ringtail.yml -e "ringtail_commit=$COMMIT" "$@"
