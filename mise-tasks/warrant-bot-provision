#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx==0.28.1", "rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="[human] Provision the warrant-bot forge identity + dispatch PAT (gilbert, human-run)"
"""Provision `warrant-bot`: the identity Warrant uses to dispatch approved runs.

**Human-run on gilbert, by design.** This script is deliberately NOT a
workflow. Minting the dispatch credential from CI would (a) need a
vault-*write* credential in CI, (b) let a compromised run turn "can run a
workflow" into "holds a persistent dispatch identity" via an admin credential,
and (c) dissolve the human ceremony that is the boundary on new privileged
credentials. Scripting the tedium is fine; automating the birth of the
credential is not. Drift *verification* is the part that belongs in CI, and
is a separate read-only job.

Scope split, deliberate: only step 1 needs an admin-scoped token, and it is
meant to be an **ephemeral** one (`--token`, never stored). Steps 2-4 work
with the stored forge token and the bot's own credentials.

What it does (idempotent, --dry-run supported):
  1. creates the `warrant-bot` forge user if absent (admin API, write:admin)
  2. grants it **write** on eblume/blumeops — the permission
     `workflow_dispatch` requires — and nothing else
  3. mints a `write:repository` PAT **as warrant-bot itself** (basic auth —
     no admin scope needed for this step)
  4. stores the PAT (and the bot's login password) in ONE blumeops item

Residual capability, stated plainly: a write collaborator can also push
non-protected branches on blumeops. `main` is push+merge whitelisted to
eblume, so it cannot touch main or merge PRs; branch pushes are visible and
revert-able, and the credential is revocable in one click. That is the
accepted floor because Forgejo has no dispatch-only permission.

Usage: mise run warrant-bot-provision [--dry-run] [--rotate] [--token <t>]
"""

import secrets
import subprocess
import sys
import time
from typing import Annotated

import httpx
import typer
from rich.console import Console

# Tailnet name — the public forge.eblu.me is HTTPS-poison in-cluster
# (docs/reference/services/argocd.md).
FORGE_API = "https://forge.ops.eblu.me/api/v1"
BOT_USER = "warrant-bot"
BOT_EMAIL = "warrant-bot@eblu.me"
TARGET_REPO = ("eblume", "blumeops")
TOKEN_NAME = "warrant-dispatch"
TOKEN_SCOPES = ["write:repository"]
ADMIN_TOKEN_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/w3663ffnvkewbftncqxtcpeavy/api-token"
# The blumeops vault, not blumeops-ci: this credential is consumed by a k8s
# service through external-secrets, and 1Password Connect is provisioned
# --vaults blumeops. blumeops-ci is for CI job-time `op read`, a different
# consumer with a different reader.
VAULT = "blumeops"
VAULT_ITEM = "warrant-dispatch-token"

# ...and CI needs the same PAT, from the other side of that fence. Connect
# cannot see blumeops-ci and the CI service account cannot see blumeops, so
# one credential has to exist in both vaults. That mirror is written HERE, by
# the ceremony that mints the PAT, rather than by hand: a hand-copy survives
# exactly until the first `--rotate`, and its failure mode is a 401 in a
# release job that points nowhere near this task.
CI_VAULT = "blumeops-ci"
CI_ITEM = "horkos-dispatch"

console = Console()
err = Console(stderr=True, style="bold red")


def op(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    # op misparses non-TTY stdin as an item template — always /dev/null it.
    result = subprocess.run(
        ["op", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL
    )
    if check and result.returncode != 0:
        # Surface op's own message: a bare CalledProcessError hides the one
        # line that says what went wrong.
        err.print(f"op {' '.join(args[:2])} failed: {result.stderr.strip()}")
        raise typer.Exit(1)
    return result


SCOPE_HELP = """
User creation needs a token with the **write:admin** scope, which the stored
forge token deliberately lacks (it carries repo-admin scope for collaborator
work — see agent-repo-access). Do NOT widen the stored token: mint an
**ephemeral** one instead, use it here, then revoke it.

  forge → Settings → Applications → Generate New Token
      name:   warrant-bot-provision (temporary)
      scopes: write:admin
  mise run warrant-bot-provision -- --token <paste>
  # then delete that token in the same UI

Alternative, no token at all: create the user in
forge → Site Administration → Identity & Access → Users → Create User
(username warrant-bot), store its password at
op://blumeops/warrant-dispatch-token as field `login-password`, and
re-run this task — it will grant the collaboration and mint the PAT as
warrant-bot itself.
"""


def mirror_to_ci(pat: str) -> None:
    """Reconcile op://blumeops-ci/horkos-dispatch/token with the canonical PAT.

    Consumers: run-script.yaml's report step (proving a run to horkos), and
    the pin-bump PR step in the talos and horkos release workflows. Runs on
    every invocation, not just on --rotate, so this task doubles as the drift
    check for the mirror.
    """
    current = op("read", f"op://{CI_VAULT}/{CI_ITEM}/token", check=False)
    if current.returncode == 0 and current.stdout.strip() == pat:
        console.print(f"mirror op://{CI_VAULT}/{CI_ITEM}/token: [green]in step[/green]")
        return
    field = f"token[password]={pat}"
    if current.returncode == 0:
        op("item", "edit", CI_ITEM, "--vault", CI_VAULT, field)
        console.print(f"[yellow]mirror updated[/yellow] op://{CI_VAULT}/{CI_ITEM}/token")
    else:
        op("item", "create", "--vault", CI_VAULT, "--title", CI_ITEM,
           "--category", "API Credential", field)
        console.print(f"[green]mirror created[/green] op://{CI_VAULT}/{CI_ITEM}/token")


def admin_token(explicit: str | None) -> str:
    """An ephemeral --token if given, else the stored forge token via
    biometric op. No env fallback: an inherited token in a CI-like shell
    must not be able to drive this ceremony."""
    if explicit:
        return explicit.strip()
    result = op("read", ADMIN_TOKEN_REF, check=False)
    if result.returncode != 0:
        err.print("Could not read the forge admin token from 1Password.")
        err.print("This task is gilbert-only and requires biometric `op`.")
        err.print(result.stderr.strip())
        raise typer.Exit(1)
    return result.stdout.strip()


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run", help="Report only; change nothing")] = False,
    rotate: Annotated[bool, typer.Option("--rotate", help="Mint a fresh PAT even if one is stored")] = False,
    token_opt: Annotated[
        str | None,
        typer.Option("--token", help="Ephemeral write:admin token (never stored) for user creation"),
    ] = None,
) -> None:
    if not sys.stdin.isatty() and not dry_run:
        err.print("Refusing to run non-interactively: this ceremony is human-run.")
        raise typer.Exit(1)

    token = admin_token(token_opt)
    owner, repo = TARGET_REPO
    password: str | None = None
    with httpx.Client(headers={"Authorization": f"token {token}"}, timeout=30.0) as c:
        # 1. user
        exists = c.get(f"{FORGE_API}/users/{BOT_USER}").status_code == 200
        console.print(f"user {BOT_USER}: {'present' if exists else 'MISSING'}")
        if not exists and not dry_run:
            # Forgejo requires a password at creation; the bot then
            # authenticates by PAT. Generated here and held in memory for the
            # token mint below, then stored beside the PAT in one item — no
            # second vault round-trip to get out of sync with.
            password = secrets.token_urlsafe(32)
            resp = c.post(
                f"{FORGE_API}/admin/users",
                json={
                    "username": BOT_USER,
                    "email": BOT_EMAIL,
                    "password": password,
                    "must_change_password": False,
                },
            )
            if resp.status_code == 403:
                err.print(f"user creation refused (403): {resp.json().get('message', '')}")
                console.print(SCOPE_HELP)
                raise typer.Exit(1)
            if resp.status_code not in (201, 200):
                err.print(f"user creation failed ({resp.status_code}): {resp.text[:300]}")
                raise typer.Exit(1)
            console.print(f"[green]created[/green] {BOT_USER}")

        # 2. collaborator grant (write — what workflow_dispatch needs)
        perm = c.get(f"{FORGE_API}/repos/{owner}/{repo}/collaborators/{BOT_USER}/permission")
        current = perm.json().get("permission") if perm.status_code == 200 else "none"
        console.print(f"collaborator on {owner}/{repo}: {current}")
        if current != "write" and not dry_run:
            resp = c.put(
                f"{FORGE_API}/repos/{owner}/{repo}/collaborators/{BOT_USER}",
                json={"permission": "write"},
            )
            if resp.status_code not in (204, 201, 200):
                err.print(f"collaborator grant failed ({resp.status_code}): {resp.text[:300]}")
                raise typer.Exit(1)
            console.print("[green]granted[/green] write")

        # 3 + 4. PAT → vault. Minted AS warrant-bot over basic auth, not via
        # the admin API: a bot minting its own token needs no admin scope, and
        # the resulting PAT is unambiguously the bot's own credential.
        stored = op("read", f"op://{VAULT}/{VAULT_ITEM}/token", check=False).returncode == 0
        console.print(f"stored PAT in {VAULT}: {'present' if stored else 'absent'}")
        if stored and not rotate:
            console.print("nothing to mint (use --rotate to replace)")
            if not dry_run:
                mirror_to_ci(op("read", f"op://{VAULT}/{VAULT_ITEM}/token").stdout.strip())
        elif not dry_run:
            if password is None:
                op_result = op("read", f"op://{VAULT}/{VAULT_ITEM}/login-password", check=False)
                password = op_result.stdout.strip() if op_result.returncode == 0 else None
            if not password:
                err.print(
                    f"The bot exists but no login password is available. Store it at "
                    f"op://{VAULT}/{VAULT_ITEM} field 'login-password' (or run with "
                    "--rotate after resetting it in the forge UI) and re-run."
                )
                raise typer.Exit(1)
            resp = httpx.post(
                f"{FORGE_API}/users/{BOT_USER}/tokens",
                auth=(BOT_USER, password),
                json={"name": f"{TOKEN_NAME}-{int(time.time())}", "scopes": TOKEN_SCOPES},
                timeout=30.0,
            )
            if resp.status_code not in (201, 200):
                err.print(f"token mint failed ({resp.status_code}): {resp.text[:300]}")
                raise typer.Exit(1)
            pat = resp.json()["sha1"]
            fields = [f"token[password]={pat}", f"login-password[password]={password}"]
            if stored:
                op("item", "edit", VAULT_ITEM, "--vault", VAULT, *fields)
            else:
                op("item", "create", "--vault", VAULT, "--title", VAULT_ITEM,
                   "--category", "API Credential", *fields)
            console.print(f"[green]stored[/green] op://{VAULT}/{VAULT_ITEM}/token")
            mirror_to_ci(pat)

    console.print(
        "\nNext: the horkos deployment reads this via ExternalSecret. A rotation "
        "does NOT reach the running pod on its own — env is read at pod start, so "
        "restart horkos after --rotate."
    )


if __name__ == "__main__":
    typer.run(main)
