#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx==0.28.1", "rich==15.0.0", "typer==0.27.2"]
# ///
#MISE description="[human] Provision the horkos-forge forge identity + dispatch PAT (gilbert, human-run)"
"""Provision `horkos-forge`: the identity Horkos dispatches approved runs as.

**Human-run on gilbert, by design.** This script is deliberately NOT a
workflow. Minting the dispatch credential from CI would (a) need a
vault-*write* credential in CI, (b) let a compromised run turn "can run a
workflow" into "holds a persistent dispatch identity" via an admin credential,
and (c) dissolve the human ceremony that is the boundary on new privileged
credentials. Scripting the tedium is fine; automating the birth of the
credential is not. Drift *verification* is the part that belongs in CI, and
is a separate read-only job.

Scope split, deliberate: only step 1 needs an admin-scoped token, and it is
meant to be an **ephemeral** one (`--token`, never stored). Steps 2-4 work
with the stored forge token and the bot's own credentials.

What it does (idempotent, --dry-run supported):
  1. creates the `horkos-forge` forge user if absent (or renames the
     grandfathered `warrant-bot` — admin API, write:admin)
  2. grants it **write** on eblume/blumeops — the permission
     `workflow_dispatch` requires — and nothing else
  3. mints a `write:repository` PAT **as horkos-forge itself** (basic auth —
     no admin scope needed for this step)
  4. proves the new PAT **before any vault write or revoke**: `GET /user`
     answers `horkos-forge` and a repo probe reads eblume/blumeops
  5. stores the PAT (and the bot's login password) in ONE blumeops item,
     then mirrors it to the CI vault
  6. revokes the predecessors — every other token named `horkos-forge-*` or
     `warrant-dispatch-*` — and re-lists to assert exactly one dispatch
     token remains (`--keep-others` opts out)

Residual capability, stated plainly: a write collaborator can also push
non-protected branches on blumeops. `main` is push+merge whitelisted to
eblume, so it cannot touch main or merge PRs; branch pushes are visible and
revert-able, and the credential is revocable in one click. That is the
accepted floor because Forgejo has no dispatch-only permission.

Usage: mise run horkos-forge-provision [--dry-run] [--rotate] [--keep-others] [--token <t>]
"""

import json
import os
import secrets
import subprocess
import sys
import time
from typing import Annotated

import httpx
import typer
from rich.console import Console
from rich.markup import escape

# Tailnet name — the public forge.eblu.me is HTTPS-poison in-cluster
# (docs/reference/services/argocd.md). $FORGE_API overrides for tests/stubs.
FORGE_API = os.environ.get("FORGE_API", "https://forge.ops.eblu.me/api/v1")
BOT_USER = "horkos-forge"
BOT_EMAIL = "horkos-forge@eblu.me"
# Grandfathered name, retired by the rename leg below (blumeops#1039, step 1).
LEGACY_USER = "warrant-bot"
TARGET_REPO = ("eblume", "blumeops")
TOKEN_NAME = "horkos-forge"
TOKEN_SCOPES = ["write:repository"]
# The one-live-key invariant (mirrors zot-apikey-rotate): after a mint, every
# other token with a dispatch name is revoked. `warrant-dispatch-*` are the
# grandfathered names minted before blumeops#1039 renamed warrant-bot.
TOKEN_PREFIXES = ("horkos-forge-", "warrant-dispatch-")
ADMIN_TOKEN_REF = "op://vg6xf6vvfmoh5hqjjhlhbeoaie/w3663ffnvkewbftncqxtcpeavy/api-token"
# The blumeops vault, not blumeops-ci: this credential is consumed by a k8s
# service through external-secrets, and 1Password Connect is provisioned
# --vaults blumeops. blumeops-ci is for CI job-time `op read`, a different
# consumer with a different reader.
VAULT = "blumeops"
VAULT_ITEM = "horkos-forge-token"
# Grandfathered item title; the human renames the item in the 1Password UI.
# Refused (not recreated) if it is still present when the new title is absent.
LEGACY_VAULT_ITEM = "warrant-dispatch-token"

# ...and CI needs the same PAT, from the other side of that fence. Connect
# cannot see blumeops-ci and the CI service account cannot see blumeops, so
# one credential has to exist in both vaults. That mirror is written HERE, by
# the ceremony that mints the PAT, rather than by hand: a hand-copy survives
# exactly until the first `--rotate`, and its failure mode is a 401 in a
# release job that points nowhere near this task.
CI_VAULT = "blumeops-ci"
CI_ITEM = "horkos-dispatch"

console = Console()
err = Console(stderr=True, style="bold red")


def op(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    # op misparses non-TTY stdin as an item template — always /dev/null it.
    result = subprocess.run(
        ["op", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL, check=False
    )
    if check and result.returncode != 0:
        # Surface op's own message: a bare CalledProcessError hides the one
        # line that says what went wrong.
        err.print(f"op {' '.join(args[:2])} failed: {escape(result.stderr.strip())}")
        raise typer.Exit(1)
    return result


SCOPE_HELP = """
User creation needs a token with the **write:admin** scope, which the stored
forge token deliberately lacks (it carries repo-admin scope for collaborator
work — see agent-repo-access). Do NOT widen the stored token: mint an
**ephemeral** one instead, use it here, then revoke it.

  forge → Settings → Applications → Generate New Token
      name:   horkos-forge-provision (temporary)
      scopes: write:admin
  mise run horkos-forge-provision -- --token <paste>
  # then delete that token in the same UI

Alternative, no token at all: create the user in
forge → Site Administration → Identity & Access → Users → Create User
(username horkos-forge), store its password at
op://blumeops/horkos-forge-token as field `login-password`, and
re-run this task — it will grant the collaboration and mint the PAT as
horkos-forge itself.
"""


def item_state(vault: str, title: str) -> str:
    """'ok' | 'missing' — anything else exits non-zero.

    A bare `op read` return code cannot tell a transient auth/network failure
    from a missing item; creating on either is the duplicate cascade
    (eblume/blumeops#963). So the probe is `op item get` by title, and 'missing'
    is reported only when op says so AND the title has zero matches in the
    vault.
    """
    get = op("item", "get", title, "--vault", vault, "--format", "json", check=False)
    if get.returncode == 0:
        return "ok"
    if "isn't an item in the" in get.stderr:
        lst = op("item", "list", "--vault", vault, "--format", "json", check=False)
        if lst.returncode != 0:
            err.print(f"op item list in vault {vault!r} failed:")
            err.print(escape(lst.stderr.strip()))
            raise typer.Exit(1)
        n = sum(
            1 for i in json.loads(lst.stdout) if i.get("title") == title
        )
        if n == 0:
            return "missing"
        err.print(
            f"op item get {title!r} in vault {vault!r}: not found by title, but "
            f"{n} item(s) titled {title!r} still exist — refusing to write "
            "(eblume/blumeops#963)."
        )
        raise typer.Exit(1)
    err.print(f"op item get {title} in vault {vault!r} failed without a definite not-found:")
    err.print(escape(get.stderr.strip()))
    raise typer.Exit(1)


def mirror_to_ci(pat: str) -> None:
    """Reconcile op://blumeops-ci/horkos-dispatch/token with the canonical PAT.

    Consumers: run-script.yaml's report step (proving a run to horkos), and
    the pin-bump PR step in the talos and horkos release workflows. Runs on
    every invocation, not just on --rotate, so this task doubles as the drift
    check for the mirror.
    """
    if item_state(CI_VAULT, CI_ITEM) == "ok":
        current = op("read", f"op://{CI_VAULT}/{CI_ITEM}/token").stdout.strip()
        if current == pat:
            console.print(f"mirror op://{CI_VAULT}/{CI_ITEM}/token: [green]in step[/green]")
            return
        op("item", "edit", CI_ITEM, "--vault", CI_VAULT, f"token[password]={pat}")
        console.print(f"[yellow]mirror updated[/yellow] op://{CI_VAULT}/{CI_ITEM}/token")
    else:
        op("item", "create", "--vault", CI_VAULT, "--title", CI_ITEM,
           "--category", "API Credential", f"token[password]={pat}")
        console.print(f"[green]mirror created[/green] op://{CI_VAULT}/{CI_ITEM}/token")


def list_dispatch_tokens(client: httpx.Client, check: bool = True) -> list[dict] | None:
    """Every PAT held by BOT_USER, paginated at limit=50.

    Forgejo's default page is 30, so a naive one-page read could hide a
    predecessor from the re-list assertion behind a page boundary. Dies loud
    on anything but 200 — an unreadable inventory is indistinguishable from a
    misleading one — unless `check` is False (no-mint run), where a failure
    returns None: by then no mint happens and the mirror has already run (or
    been skipped by --dry-run), so the list feeds only the advisory drift
    warning and a hard failure would buy nothing.
    """
    tokens: list[dict] = []
    page = 1
    while True:
        resp = client.get(
            f"{FORGE_API}/users/{BOT_USER}/tokens",
            params={"page": page, "limit": 50},
            timeout=30.0,
        )
        if resp.status_code == 401:
            if not check:
                return None
            err.print(
                f"token list denied (401) — the stored login-password no longer "
                f"authenticates as {BOT_USER}; fix it before rotating"
            )
            raise typer.Exit(1)
        if resp.status_code != 200:
            if not check:
                return None
            err.print(f"token list failed ({resp.status_code}): {escape(resp.text[:300])}")
            raise typer.Exit(1)
        batch = resp.json()
        if not batch:
            return tokens
        tokens.extend(batch)
        page += 1


def admin_token(explicit: str | None) -> str:
    """An ephemeral --token if given, else the stored forge token via
    biometric op. No env fallback: an inherited token in a CI-like shell
    must not be able to drive this ceremony."""
    if explicit:
        return explicit.strip()
    result = op("read", ADMIN_TOKEN_REF, check=False)
    if result.returncode != 0:
        err.print("Could not read the forge admin token from 1Password.")
        err.print("This task is gilbert-only and requires biometric `op`.")
        err.print(result.stderr.strip())
        raise typer.Exit(1)
    return result.stdout.strip()


def main(
    dry_run: Annotated[bool, typer.Option("--dry-run", help="Report only; change nothing")] = False,
    rotate: Annotated[bool, typer.Option("--rotate", help="Mint a fresh PAT even if one is stored")] = False,
    keep_others: Annotated[bool, typer.Option("--keep-others", help="Do not revoke the other dispatch PATs")] = False,
    token_opt: Annotated[
        str | None,
        typer.Option("--token", help="Ephemeral write:admin token (never stored) for user creation"),
    ] = None,
) -> None:
    if not sys.stdin.isatty() and not dry_run:
        err.print("Refusing to run non-interactively: this ceremony is human-run.")
        raise typer.Exit(1)

    token = admin_token(token_opt)
    owner, repo = TARGET_REPO
    password: str | None = None
    with httpx.Client(headers={"Authorization": f"token {token}"}, timeout=30.0) as c:
        # 1. user — create, or rename the grandfathered warrant-bot (blumeops#1039)
        new_present = c.get(f"{FORGE_API}/users/{BOT_USER}").status_code == 200
        legacy_present = c.get(f"{FORGE_API}/users/{LEGACY_USER}").status_code == 200
        console.print(f"user {BOT_USER}: {'present' if new_present else 'absent'}")
        if legacy_present and new_present:
            console.print(
                f"[yellow]user {LEGACY_USER} also still exists — remove it in the "
                "forge UI if it is not supposed to be there[/yellow]"
            )
        if new_present:
            pass
        elif legacy_present:
            if dry_run:
                console.print(f"[dim]would rename {LEGACY_USER} → {BOT_USER} (admin API)[/dim]")
            else:
                resp = c.post(
                    f"{FORGE_API}/admin/users/{LEGACY_USER}/rename",
                    json={"new_username": BOT_USER},
                )
                if resp.status_code == 403:
                    err.print(f"user rename refused (403): {escape(str(resp.json().get('message', '')))}")
                    console.print(SCOPE_HELP)
                    raise typer.Exit(1)
                if resp.status_code not in (200, 201):
                    err.print(f"user rename failed ({resp.status_code}): {escape(resp.text[:300])}")
                    raise typer.Exit(1)
                console.print(f"[green]renamed[/green] {LEGACY_USER} → {BOT_USER}")
        elif not dry_run:
            # Forgejo requires a password at creation; the bot then
            # authenticates by PAT. Generated here and held in memory for the
            # token mint below, then stored beside the PAT in one item — no
            # second vault round-trip to get out of sync with.
            password = secrets.token_urlsafe(32)
            resp = c.post(
                f"{FORGE_API}/admin/users",
                json={
                    "username": BOT_USER,
                    "email": BOT_EMAIL,
                    "password": password,
                    "must_change_password": False,
                },
            )
            if resp.status_code == 403:
                err.print(f"user creation refused (403): {escape(str(resp.json().get('message', '')))}")
                console.print(SCOPE_HELP)
                raise typer.Exit(1)
            if resp.status_code not in (201, 200):
                err.print(f"user creation failed ({resp.status_code}): {escape(resp.text[:300])}")
                raise typer.Exit(1)
            console.print(f"[green]created[/green] {BOT_USER}")
        else:
            console.print(f"[dim]would create {BOT_USER} (admin API)[/dim]")

        # 2. collaborator grant (write — what workflow_dispatch needs)
        perm = c.get(f"{FORGE_API}/repos/{owner}/{repo}/collaborators/{BOT_USER}/permission")
        current = perm.json().get("permission") if perm.status_code == 200 else "none"
        console.print(f"collaborator on {owner}/{repo}: {escape(current)}")
        if current != "write" and not dry_run:
            resp = c.put(
                f"{FORGE_API}/repos/{owner}/{repo}/collaborators/{BOT_USER}",
                json={"permission": "write"},
            )
            if resp.status_code not in (204, 201, 200):
                err.print(f"collaborator grant failed ({resp.status_code}): {escape(resp.text[:300])}")
                raise typer.Exit(1)
            console.print("[green]granted[/green] write")

        # 3. The mint. Minted AS horkos-forge over basic auth, not via the
        # admin API: a bot minting its own token needs no admin scope, and the
        # resulting PAT is unambiguously the bot's own credential.
        stored = item_state(VAULT, VAULT_ITEM) == "ok"
        legacy_item_present = item_state(VAULT, LEGACY_VAULT_ITEM) == "ok"
        console.print(f"stored PAT in {VAULT}: {'present' if stored else 'absent'}")

        # The mint, the revoke leg and the drift warning all authenticate to the
        # forge as horkos-forge over basic auth. Loading the login-password once
        # hands the token inventory the same credential the mint proves.
        if password is None:
            op_result = op("read", f"op://{VAULT}/{VAULT_ITEM}/login-password", check=False)
            password = op_result.stdout.strip() if op_result.returncode == 0 else None

        mint_needed = rotate or not stored
        minted = False
        new_token_id: int | None = None
        if stored and not rotate:
            console.print("nothing to mint (use --rotate to replace)")
            if not dry_run:
                mirror_to_ci(op("read", f"op://{VAULT}/{VAULT_ITEM}/token").stdout.strip())
        elif dry_run:
            note = "nothing stored" if not stored else (
                f"would replace the stored PAT at op://{VAULT}/{VAULT_ITEM}/token"
            )
            console.print(
                f"[dim]would mint {TOKEN_NAME}-{int(time.time())} "
                f"({', '.join(TOKEN_SCOPES)}) as {BOT_USER} — {note}[/dim]"
            )
        else:
            if not stored and legacy_item_present:
                err.print(
                    f"op://{VAULT}/{VAULT_ITEM} is absent, but the grandfathered "
                    f"op://{VAULT}/{LEGACY_VAULT_ITEM} is still present — rename the "
                    "item in 1Password first; creating a second item would orphan "
                    "the PAT (eblume/blumeops#963)."
                )
                raise typer.Exit(1)
            if not password:
                err.print(
                    f"The bot exists but no login password is available. Store it at "
                    f"op://{VAULT}/{VAULT_ITEM} field 'login-password' (or run with "
                    "--rotate after resetting it in the forge UI) and re-run."
                )
                raise typer.Exit(1)
            resp = httpx.post(
                f"{FORGE_API}/users/{BOT_USER}/tokens",
                auth=(BOT_USER, password),
                json={"name": f"{TOKEN_NAME}-{int(time.time())}", "scopes": TOKEN_SCOPES},
                timeout=30.0,
            )
            if resp.status_code not in (201, 200):
                err.print(f"token mint failed ({resp.status_code}): {escape(resp.text[:300])}")
                raise typer.Exit(1)
            body = resp.json()
            pat = body["sha1"]
            new_token_id = body["id"]
            minted = True

            # 4. Prove the new PAT before any vault write or revoke: a 401 or a
            # wrong login here dies with the predecessor still live and untouched.
            me = c.get(f"{FORGE_API}/user", headers={"Authorization": f"token {pat}"})
            if me.status_code != 200:
                err.print(
                    f"new PAT rejected ({me.status_code}) — aborting before any "
                    "vault write or revoke; the previous token stays live"
                )
                raise typer.Exit(1)
            if me.json().get("login") != BOT_USER:
                err.print(
                    f"new PAT authenticated as {me.json().get('login')!r}, expected "
                    f"{BOT_USER!r} — aborting before any vault write or revoke"
                )
                raise typer.Exit(1)
            repo_check = c.get(
                f"{FORGE_API}/repos/{owner}/{repo}",
                headers={"Authorization": f"token {pat}"},
            )
            if repo_check.status_code != 200:
                err.print(
                    f"new PAT cannot read {owner}/{repo} ({repo_check.status_code}) — "
                    "the collaborator grant is not usable through it; aborting before "
                    "any vault write or revoke"
                )
                raise typer.Exit(1)
            console.print("[green]verified[/green] new PAT: /user is horkos-forge and reads eblume/blumeops")

            # 5. Vault write + CI mirror — exactly as before the revoke leg.
            fields = [f"token[password]={pat}", f"login-password[password]={password}"]
            if stored:
                op("item", "edit", VAULT_ITEM, "--vault", VAULT, *fields)
            else:
                op("item", "create", "--vault", VAULT, "--title", VAULT_ITEM,
                   "--category", "API Credential", *fields)
            console.print(f"[green]stored[/green] op://{VAULT}/{VAULT_ITEM}/token")
            mirror_to_ci(pat)

        # 6. Token inventory: the drift warning is printed on EVERY run; the
        # predecessor sweep and its re-list assertion run after a mint. One list
        # feeds both, so the re-list sees the same pagination the deletion
        # choices came from.
        if password is None:
            console.print(
                "[yellow]warning[/yellow] no login-password available — cannot list "
                f"{BOT_USER}'s tokens; drift and revocation skipped"
            )
        else:
            with httpx.Client(auth=(BOT_USER, password), timeout=30.0) as bc:
                tokens = list_dispatch_tokens(bc, check=mint_needed)
                if tokens is None:
                    console.print(
                        "[yellow]warning[/yellow] could not list "
                        f"{BOT_USER}'s tokens — drift check skipped"
                    )
                else:
                    drift = [t for t in tokens if not t["name"].startswith(TOKEN_PREFIXES)]
                    if drift:
                        console.print(
                            "[yellow]warning[/yellow] token(s) not matching the dispatch "
                            f"prefixes {escape(str(TOKEN_PREFIXES))}: "
                            + ", ".join(f"{escape(t['name'])} (id={t['id']})" for t in drift)
                        )
                    if mint_needed:
                        others = [
                            t for t in tokens
                            if t["name"].startswith(TOKEN_PREFIXES) and t["id"] != new_token_id
                        ]
                        if not others:
                            console.print("no predecessor dispatch token(s) to revoke")
                        elif dry_run and keep_others:
                            for t in others:
                                console.print(
                                    f"[dim]would keep[/dim] {t['name']} (id={t['id']}) — --keep-others"
                                )
                        elif dry_run:
                            for t in others:
                                console.print(f"[dim]would revoke[/dim] {t['name']} (id={t['id']})")
                        elif keep_others:
                            for t in others:
                                console.print(
                                    f"[yellow]kept[/yellow] {t['name']} (id={t['id']}) — --keep-others"
                                )
                        else:
                            for t in others:
                                resp = bc.delete(f"{FORGE_API}/users/{BOT_USER}/tokens/{t['id']}")
                                if resp.status_code not in (204, 200):
                                    err.print(
                                        f"revoke of {t['name']} (id={t['id']}) failed "
                                        f"({resp.status_code}): {escape(resp.text[:300])}"
                                    )
                                    raise typer.Exit(1)
                                console.print(f"[green]revoked[/green] {t['name']} (id={t['id']})")
                            remaining = list_dispatch_tokens(bc)
                            if remaining is None:
                                err.print(
                                    "post-revocation re-list failed — the one-live-key "
                                    "invariant is not proven; investigate"
                                )
                                raise typer.Exit(1)
                            live = [t for t in remaining if t["name"].startswith(TOKEN_PREFIXES)]
                            if len(live) != 1 or live[0]["id"] != new_token_id:
                                err.print(
                                    f"post-revocation re-list: expected exactly the new token "
                                    f"(id={new_token_id}); found "
                                    + (", ".join(f"{t['name']} (id={t['id']})" for t in live) or "none")
                                    + " — the one-live-key invariant is not proven; investigate"
                                )
                                raise typer.Exit(1)
                            console.print(
                                f"[green]verified[/green] exactly one dispatch token remains: "
                                f"{live[0]['name']} (id={live[0]['id']})"
                            )

    if minted:
        console.print(
            "\nNext: push the new PAT to the cluster. The k8s Secret "
            "horkos/horkos-dispatch still holds the predecessor until ESO's 1h "
            "refresh, so a rollout restart before the sync would re-read a dead "
            "token. Run these (this script prints, it does not execute):"
        )
        console.print(
            "kubectl --context=k3s-ringtail -n horkos annotate externalsecret "
            "horkos-dispatch force-sync=$(date +%s) --overwrite"
        )
        console.print("kubectl --context=k3s-ringtail -n horkos rollout restart deployment/horkos")
        console.print("curl -s https://horkos.ops.eblu.me/healthz   # expect armed, not armed-no-token")


if __name__ == "__main__":
    typer.run(main)
