#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx[socks]==0.28.1", "rich==15.0.0", "typer==0.27.1"]
# ///
#MISE description="Fleet health via Grafana alert rules, using the agents-m2m JWT (agent-usable)"
"""Agent-usable fleet health check ([[warrant-approval-gated-runs]] / heph
01KZ2XGW): query Grafana's alert-rule states as the `agent-ringtail`
machine identity and exit nonzero if anything is firing.

This is the Grafana-native replacement for the parts of `services-check`
an agent can't run (kubectl/ssh legs). Works from gilbert (direct) and
from the agent pod (SOCKS fallback via the tailscale sidecar). Credentials:
the `agents` vault only (`agents-authentik-sa` item) — no privileged access,
Grafana sees a Viewer.

Anything firing or pending is listed a second time with the labels that say
*which* instance — which textfile, which camera, which pod. Every runbook in
docs/how-to/runbooks/ opens by asking for exactly that, so a report without it
sends the reader back to Grafana before step 1.

Exit codes: 0 all inactive · 1 firing · 2 pending-only (warn).
"""

import os
import subprocess
from typing import Annotated, Any

import httpx
import typer
from rich.console import Console
from rich.table import Table

AUTHENTIK_TOKEN_URL = "https://authentik.ops.eblu.me/application/o/token/"
GRAFANA_RULES_URL = "https://grafana.ops.eblu.me/api/prometheus/grafana/api/v1/rules"
SOCKS_FALLBACK = "socks5://localhost:1055"  # agent pod's tailscale sidecar

console = Console()
err = Console(stderr=True, style="bold red")


def op_read(ref: str) -> str:
    try:
        result = subprocess.run(
            ["op", "read", ref],
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        err.print(f"op read {ref} failed: {exc}")
        raise typer.Exit(3) from exc
    if result.returncode != 0:
        err.print(f"op read {ref} failed: {result.stderr.strip()}")
        raise typer.Exit(3)
    return result.stdout.strip()


def client_for(url: str) -> httpx.Client:
    """Direct first; SOCKS fallback for the pod (its tailnet path is the
    sidecar proxy). Honors ALL_PROXY if the caller sets one.

    The probe is a throwaway module-level request: callers enter the returned
    client as a context manager, and httpx refuses to enter a client that has
    already sent a request, so the client returned here must be unused."""
    proxy = os.environ.get("ALL_PROXY")
    base = url.split("/api/")[0] + "/"
    try:
        httpx.get(base, timeout=5.0, proxy=proxy)
        return httpx.Client(timeout=30.0, proxy=proxy)
    except httpx.TransportError:
        return httpx.Client(timeout=30.0, proxy=SOCKS_FALLBACK)


def mint_token() -> str:
    app_pw = op_read("op://agents/agents-authentik-sa/app-password")
    with client_for(AUTHENTIK_TOKEN_URL) as c:
        resp = c.post(
            AUTHENTIK_TOKEN_URL,
            data={
                "grant_type": "client_credentials",
                "client_id": "agents-m2m",
                "username": "agent-ringtail",
                "password": app_pw,
                # groups claim (-> Grafana Viewer) requires the profile scope
                "scope": "openid profile",
            },
        )
    if resp.status_code != 200:
        err.print(f"authentik token grant failed ({resp.status_code}): {resp.text[:200]}")
        raise typer.Exit(3)
    return resp.json()["access_token"]


# Labels every instance carries, or that only restate the rule. Dropping them
# leaves the ones that actually distinguish one instance from another.
BOILERPLATE_LABELS = frozenset(
    {"alertname", "grafana_folder", "__name__", "severity", "service", "job"}
)


def live_instances(rule: dict) -> list[dict]:
    """The alert instances that are not Normal, with their identifying labels.

    Grafana returns every series the rule evaluates, healthy ones included, so
    filtering on the instance's own state is what makes this the short list of
    things actually wrong.
    """
    out = []
    for alert in rule.get("alerts") or []:
        if (alert.get("state") or "Normal") == "Normal":
            continue
        labels = alert.get("labels") or {}
        identity = ", ".join(
            f"{k}={v}" for k, v in sorted(labels.items()) if k not in BOILERPLATE_LABELS
        )
        out.append({
            "state": alert.get("state"),
            "activeAt": alert.get("activeAt"),
            "identity": identity or "(no distinguishing labels)",
            "labels": labels,
        })
    return out


def main(
    as_json: Annotated[bool, typer.Option("--json", help="Machine-readable output")] = False,
) -> None:
    token = mint_token()
    with client_for(GRAFANA_RULES_URL) as c:
        resp = c.get(GRAFANA_RULES_URL, headers={"X-JWT-Assertion": token})
    if resp.status_code != 200:
        err.print(f"grafana rules query failed ({resp.status_code}): {resp.text[:200]}")
        raise typer.Exit(3)

    rules: list[dict[str, Any]] = [
        {
            "group": g.get("name"),
            "name": r.get("name"),
            "state": r.get("state"),
            "instances": live_instances(r),
        }
        for g in resp.json().get("data", {}).get("groups", [])
        for r in g.get("rules", [])
    ]
    firing = [r for r in rules if r["state"] == "firing"]
    pending = [r for r in rules if r["state"] == "pending"]

    if as_json:
        import json

        print(json.dumps({"rules": rules, "firing": len(firing), "pending": len(pending)}))
    else:
        table = Table(title="Grafana alert rules (as agent-ringtail)")
        table.add_column("rule")
        table.add_column("group")
        table.add_column("state")
        for r in rules:
            style = {"firing": "bold red", "pending": "yellow"}.get(r["state"], "green")
            table.add_row(r["name"], r["group"], f"[{style}]{r['state']}[/{style}]")
        console.print(table)
        console.print(
            f"{len(rules)} rules: {len(firing)} firing, {len(pending)} pending, "
            f"{len(rules) - len(firing) - len(pending)} inactive"
        )
        # Which one. A rule name says a class of thing is wrong; the instance
        # labels say which disk, which camera, which textfile — and that is the
        # first line of every runbook we have.
        for r in firing + pending:
            for inst in r["instances"]:
                console.print(
                    f"  [bold]{r['name']}[/bold] [{inst['state']}] {inst['identity']}"
                    + (f" since {inst['activeAt']}" if inst["activeAt"] else "")
                )

    if firing:
        raise typer.Exit(1)
    if pending:
        raise typer.Exit(2)


if __name__ == "__main__":
    typer.run(main)
