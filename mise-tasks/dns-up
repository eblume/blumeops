#!/usr/bin/env bash
#MISE description="[human] Apply DNS changes to eblu.me with Pulumi"

set -euo pipefail

source "$(dirname "$0")/_pulumi_env"

cd "$(dirname "$0")/../pulumi/gandi"
uv sync --quiet || { echo "uv sync failed — if devpi is down, run 'devpi off' and retry"; exit 1; }
pulumi stack select eblu-me
pulumi up --yes "$@"
