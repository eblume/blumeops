#!/usr/bin/env bash
#MISE description="[human] One-time setup: configure Fly.io secrets and certs (idempotent)"

set -euo pipefail
export FLY_API_TOKEN
FLY_API_TOKEN="$(op read 'op://blumeops/fly.io admin/add more/deploy-token')"

APP="blumeops-proxy"

source "$(dirname "$0")/_pulumi_env"

# Fetch Tailscale auth key from Pulumi state
echo "Fetching Tailscale auth key from Pulumi..."
TS_AUTHKEY=$(cd "$(dirname "$0")/../pulumi/tailscale" && pulumi stack select tail8d86e && pulumi stack output flyio_authkey --show-secrets)
fly secrets set TS_AUTHKEY="$TS_AUTHKEY" --stage -a "$APP"
echo "Tailscale auth key staged (will take effect on next deploy)"

# Allocate IPs (idempotent — fly errors if already allocated)
# Shared IPv4 is free and sufficient for HTTP/HTTPS services.
# Use 'fly ips allocate-v4' (no --shared) for dedicated IPv4 ($2/mo)
# if the service needs non-HTTP protocols.
# allocate-v6 does not fail when one exists — it allocates another — so
# check first (every earlier run leaked a dedicated v6).
fly ips allocate-v4 --shared -a "$APP" 2>/dev/null || true
if ! fly ips list -a "$APP" --json | grep -q '"Type": *"v6"'; then
    fly ips allocate-v6 -a "$APP"
fi
echo "IPs allocated"

# Static forge mirror volume (fly/git-mirror/README.md). Must exist before
# the first deploy of an image with the [[mounts]] block; idempotent.
# Fly volume names allow only [a-z0-9_]; the region must match the
# machine's (fly.toml primary_region), since a volume attaches only there.
if ! fly volumes list -a "$APP" --json 2>/dev/null | grep -q '"name": *"git_mirror"' ; then
    fly volumes create git_mirror --size 5 --region sjc -a "$APP" --yes
fi
echo "Mirror volume ready"

# Add certs for all public domains (idempotent — fly ignores duplicates)
fly certs add eblu.me -a "$APP" 2>/dev/null || true
fly certs add www.eblu.me -a "$APP" 2>/dev/null || true
fly certs add docs.eblu.me -a "$APP" 2>/dev/null || true
fly certs add cv.eblu.me -a "$APP" 2>/dev/null || true
fly certs add forge.eblu.me -a "$APP" 2>/dev/null || true
fly certs add shower.eblu.me -a "$APP" 2>/dev/null || true
fly certs add photos.eblu.me -a "$APP" 2>/dev/null || true
echo "Certificates configured"

echo "Done. Run 'mise run fly-deploy' to deploy."
