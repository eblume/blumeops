# borgmatic's non-secret files on indri: the configs, the dump helpers, the photo
# verify script and the ops repo admin script. Each text is the rendered output of
# the borgmatic role's Jinja templates for the role defaults (inventory: no host
# overrides). Secrets (.pgpass, the BorgBase and ringtail keys, the borg passphrase
# file) are not here. The LaunchAgent plists are a separate generation concern.
{ lib, pkgs }:
let
  home = "/Users/erichblume";
  borgmaticVersion = "2.1.10";

  header = "# Generated by the indri nix-darwin generation (darwin/indri/borgmatic.nix) - do not edit by hand.";

  borgmaticBin = "${home}/.local/share/mise/installs/pipx-borgmatic/latest/bin/borgmatic";
  borgBin = "/opt/homebrew/bin/borg";
  pgDumpCommand = "/opt/homebrew/opt/postgresql@18/bin/pg_dump";
  borgbaseKey = "${home}/.ssh/borgbase_ed25519";
  ringtailKey = "${home}/.ssh/borgmatic_ringtail_ed25519";
  passcommand = "cat ${home}/.borg/config.yaml";
  sshCommand = "ssh -o IdentitiesOnly=yes -i ${borgbaseKey}";
  sshCommandPhotos = "ssh -o IdentitiesOnly=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=5 -i ${borgbaseKey}";
  retries = 3;
  retryWait = 300;
  binDir = "${home}/bin";
  configDir = "${home}/.config/borgmatic";
  mainConfigPath = "${configDir}/config.yaml";
  talosDataConfigPath = "${configDir}/talos-data.yaml";
  operationalConfigPath = "${configDir}/operational.yaml";
  photosConfigPath = "${configDir}/photos.yaml";
  dumpArchive = "${home}/.local/share/borgmatic/k8s-dumps-archive";
  dumpOp = "${home}/.local/share/borgmatic/k8s-dumps-op";
  dumpTalos = "${home}/.local/share/borgmatic/k8s-dumps-talos";
  sqliteSnapshotTimeout = 1200;
  sqliteBusyTimeout = 10;
  verifyMarkerDir = "/opt/homebrew/var/state/borgmatic-verification";
  photosRepo = "ssh://xcrtl5tg@xcrtl5tg.repo.borgbase.com/./repo";
  photosSourceDirs = [ "/Volumes/photos/library" "/Volumes/photos/upload" ];

  sifakaRepo = {
    path = "/Volumes/backups/borg/";
    label = "sifaka-borg-backups";
    encryption = "repokey";
    append_only = true;
  };
  borgbaseRepo = {
    path = "ssh://u3ugi1x1@u3ugi1x1.repo.borgbase.com/./repo";
    label = "borgbase-offsite";
    encryption = "repokey";
    append_only = true;
  };
  operationalRepo = {
    path = "/Volumes/backups/borg-operational/";
    label = "sifaka-operational";
    encryption = "repokey";
    append_only = false;
  };

  # Dump entries: target is the ringtail forced-command endpoint for every entry.
  ringtail = "ssh:borgmatic@ringtail";
  k8sSqliteDumps = [ { name = "mealie"; target = ringtail; } ];
  archiveK8sSqliteDumps = [ { name = "horkos"; target = ringtail; } ];
  k8sFileDumps = map (name: { inherit name; target = ringtail; }) [
    "navidrome"
    "audiobookshelf"
    "pulumi-tail8d86e-state"
    "pulumi-eblu-me-state"
  ];
  k8sTarDumps = map (name: { inherit name; target = ringtail; }) [ "talos-data" "mealie-data" ];
  archiveK8sTarDumps = [ { name = "paperless-media"; target = ringtail; } ];
  archiveSqliteDumps = [
    { name = "heph"; path = "${home}/.local/share/heph/heph.db"; }
    { name = "forgejo"; path = "${home}/forgejo/data/forgejo.db"; }
  ];

  pgDb = name: port: { inherit name port; hostname = "pg.ops.eblu.me"; username = "borgmatic"; };
  archivePostgres = [ (pgDb "paperless" 5434) ];
  operationalPostgres = [
    (pgDb "authentik" 5434)
    (pgDb "miniflux" 5434)
    (pgDb "teslamate" 5434)
    (pgDb "immich" 5433)
  ];

  boolText = b: if b then "true" else "false";

  repoEntry = repo:
    "    - path: ${repo.path}\n"
    + "      label: ${repo.label}\n"
    + lib.optionalString (repo ? encryption) "      encryption: ${repo.encryption}\n"
    + lib.optionalString (repo ? append_only) "      append_only: ${boolText repo.append_only}\n";

  pgEntry = db:
    "    - name: ${db.name}\n"
    + "      hostname: ${db.hostname}\n"
    + "      port: ${toString db.port}\n"
    + "      username: ${db.username}\n"
    + "      pg_dump_command: ${pgDumpCommand}\n";

  # The `when:` gates in the templates; every list here is non-empty, so each gate is true.
  sqliteHook = db: "          # VACUUM INTO (one read snapshot; writers cannot restart the copy,\n          # unlike .backup) under a hard timeout, see sqlite-dump.sh.j2.\n          - ${binDir}/borgmatic-sqlite-dump \"${db.path}\" \"${dumpArchive}/${db.name}.db\" ${toString sqliteSnapshotTimeout}\n";
  k8sSqliteHook = dir: db: "          - ${binDir}/borgmatic-k8s-sqlite-dump ${db.target} ${db.name} ${dir}/${db.name}.db\n";
  k8sFileHook = dir: db: "          - ${binDir}/borgmatic-k8s-file-dump ${db.target} ${db.name} ${dir}/${db.name}.db\n";
  k8sTarHook = dir: db: "          - ${binDir}/borgmatic-k8s-tar-dump ${db.target} ${db.name} ${dir}/${db.name}.tar\n";
  operationalTarHook = db: "          # talos-data is excluded: its own config (talos-data.yaml) owns its dump and archive.\n" + k8sTarHook dumpOp db;

  mainConfig = ''
    ${header}

    # Path to borg binary (LaunchAgent doesn't have homebrew in PATH)
    local_path: ${borgBin}

    source_directories:
        - ${home}/code/personal/zk
        - ${home}/Documents
        - ${home}/forgejo
        - ${dumpArchive}

    source_directories_must_exist: true

    exclude_patterns:
        - ${home}/forgejo/data/forgejo.db*
        - ${home}/forgejo/data/forgejo-repositories/mirrors
        - ${home}/forgejo/data/forgejo-repositories/talos
        - ${home}/forgejo/data/actions_artifacts
        - ${home}/forgejo/data/actions_log
        - ${home}/forgejo/data/indexers
        - ${home}/forgejo/data/queues
        - ${home}/forgejo/data/sessions
        - ${home}/forgejo/data/tmp
        - ${home}/forgejo/log

    repositories:
    ${lib.concatMapStrings repoEntry [ sifakaRepo borgbaseRepo ]}
    # zstd for new chunks (lz4 is borg's default); the repo-wide ratio improves
    # as archives churn in the never-pruned history.
    compression: auto,zstd

    encryption_passcommand: ${passcommand}

    # Pin the archive-name format explicitly (borg's default) and scope
    # any future prune to it: `talos-data-*` archives share these repos
    # and must stay out of reach.
    archive_name_format: 'indri-{now:%Y-%m-%dT%H:%M:%S.%f}'
    match_archives: 'indri-*'

    # Pre-backup: stage the never-lose database snapshots into the dump dir
    # (which is in source_directories, so the snapshots land in the archive).
    # A non-zero exit from any hook aborts the whole backup, so a failed
    # snapshot is never silent. Same `commands:` hook mechanics as
    # operational.yaml — including the per-config `before: configuration`
    # scope, so this coexists with talos-data.yaml's own hook in the one
    # `--config config.yaml --config talos-data.yaml create` run.
    commands:
        - before: configuration
          when: [create]
          run:
              - mkdir -p ${dumpArchive}
    ${lib.concatMapStrings sqliteHook archiveSqliteDumps}${lib.concatMapStrings (k8sSqliteHook dumpArchive) archiveK8sSqliteDumps}${lib.concatMapStrings (k8sTarHook dumpArchive) archiveK8sTarDumps}
    # Never-lose PostgreSQL dumps (streamed via pg_dump, ~/.pgpass as always).
    postgresql_databases:
    ${lib.concatMapStrings pgEntry archivePostgres}
    ssh_command: ${sshCommand}

    # Retry a failing repository action (e.g. a broken SSH pipe partway through a
    # large offsite upload to BorgBase) rather than failing the whole run. borg
    # checkpoints an interrupted `create`, so a retry resumes from where it dropped.
    # retry_wait backs off linearly across attempts to let a transient network issue
    # clear. Only the failing repository is retried; the before-backup dump hooks
    # (which run once at `before: configuration`) are not re-run.
    retries: ${toString retries}
    retry_wait: ${toString retryWait}

    # The main config is the never-pruned archive tier (zk, Documents, forgejo,
    # and the never-lose dumps heph/forgejo/horkos/paperless) — no retention
    # keys and no prune action. Tier B retention lives in operational.yaml.
  '';

  talosDataConfig = ''
    ${header}
    #
    # Borgmatic config for talos agent session state (k8s tar dump).
    # Never pruned by design (talos-data is confirmed never-pruned,
    # eblume/blumeops#1417): no keep_* keys here, and the main config's
    # match_archives: 'indri-*' keeps its prune off this prefix.

    local_path: ${borgBin}

    # The dump hook below stages tonight's tar here (not in the operational
    # config's k8s-dumps-op/ staging).
    source_directories:
        - ${dumpTalos}/talos-data.tar

    source_directories_must_exist: true

    # Same two repos as the main config. match_archives is pinned so a
    # future prune in EITHER config can only ever reach its own prefix.
    repositories:
    ${lib.concatMapStrings repoEntry [ sifakaRepo borgbaseRepo ]}
    archive_name_format: 'talos-data-{now:%Y-%m-%dT%H:%M:%S.%f}'
    match_archives: 'talos-data-*'

    # zstd for new chunks only; the repo-wide ratio improves as archives accumulate.
    compression: auto,zstd

    encryption_passcommand: ${passcommand}

    # Stage tonight's dump before the create runs. A non-zero exit aborts
    # the whole run, so a failed dump is never a silent, stale archive.
    commands:
        - before: configuration
          when: [create]
          run:
              - mkdir -p ${dumpTalos}
    ${lib.concatMapStrings (k8sTarHook dumpTalos) (builtins.filter (d: d.name == "talos-data") k8sTarDumps)}
    ssh_command: ${sshCommand}

    # Save checkpoints every 10 minutes so an interrupted offsite upload doesn't
    # lose all progress.
    checkpoint_interval: 600

    retries: ${toString retries}
    retry_wait: ${toString retryWait}
  '';

  operationalConfig = ''
    ${header}
    #
    # Tier B (operational) borgmatic config — rotating tier. See eblume/blumeops#1417.
    # zstd applies to new chunks only; the repo is local sifaka, no BorgBase
    # offsite yet (needs a dashboard-created key, a separate deliberate step).

    local_path: ${borgBin}

    source_directories:
        - ${configDir}
        - ${dumpOp}
        - /Volumes/shower

    source_directories_must_exist: true

    repositories:
    ${lib.concatMapStrings repoEntry [ operationalRepo ]}
    # zstd for new chunks; repo-wide ratio improves as archives rotate.
    compression: auto,zstd

    encryption_passcommand: ${passcommand}

    # Pin the archive-name format; any future prune is scoped here and
    # can't reach the `indri-*` or `talos-data-*` archives sharing these repos.
    archive_name_format: 'operational-{now:%Y-%m-%dT%H:%M:%S.%f}'
    match_archives: 'operational-*'

    # Pre-backup: stage database snapshots into the dump dir (which is in
    # source_directories, so the snapshots land in the archive). A non-zero exit
    # from any hook aborts the whole backup, so a failed snapshot is never silent.
    #
    # Uses the `commands:` hook syntax (the legacy `before_backup:` key is
    # deprecated as of borgmatic 2.x). `before: configuration` runs these once per
    # borgmatic run: snapshots are staged a single time and consumed by the
    # operational repo(s). `when: [create]` scopes the hooks to backup runs only.
    #
    # Quoting/escaping for the k8s hooks is delegated to the helper scripts
    # deployed by the borgmatic ansible role. Each k8s entry's `target` is
    # ssh:borgmatic@ringtail — the ringtail dump endpoint (forced command; only
    # the dump name is sent).
    commands:
        - before: configuration
          when: [create]
          run:
              - mkdir -p ${dumpOp}
    ${lib.concatMapStrings (k8sSqliteHook dumpOp) k8sSqliteDumps}${lib.concatMapStrings (k8sFileHook dumpOp) k8sFileDumps}${lib.concatMapStrings operationalTarHook (builtins.filter (d: d.name != "talos-data") k8sTarDumps)}
    ssh_command: ${sshCommand}

    # Retry a failing repository action instead of losing the whole night.
    retries: ${toString retries}
    retry_wait: ${toString retryWait}

    # Same rationale as photos.yaml — slow runs must not wedge neighboring agents.
    checkpoint_interval: 600
    lock_wait: 300

    # Enforced by the ops agent's `create prune compact` action; `keep_yearly: -1`
    # keeps each year's final archive forever, so the /Volumes/shower record survives.
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 12
    keep_yearly: -1

    # PostgreSQL database backups (streamed via pg_dump)
    postgresql_databases:
    ${lib.concatMapStrings pgEntry operationalPostgres}'';

  photosConfig = ''
    ${header}
    #
    # Borgmatic config for immich photo library backup.
    # Backs up library/ and upload/ from /Volumes/photos (sifaka SMB mount)
    # to BorgBase offsite ONLY. Excludes encoded-video/, thumbs/, backups/
    # since those are regenerable from originals.
    #
    # Separate from the main borgmatic config to keep concerns isolated:
    # - main config: indri data → sifaka + borgbase
    # - this config: sifaka photos → borgbase (different repo)

    local_path: ${borgBin}

    source_directories:
        - /Volumes/photos/library
        - /Volumes/photos/upload

    source_directories_must_exist: true

    repositories:
        - path: ${photosRepo}
          label: borgbase-immich-photos
          encryption: repokey
          append_only: true

    encryption_passcommand: ${passcommand}

    ssh_command: ${sshCommandPhotos}

    # Save checkpoints every 10 minutes so interrupted backups don't lose all progress
    checkpoint_interval: 600

    # Wait for the repo lock instead of failing fast: the 06:00 verification job
    # runs while the 04:00 create's checkpoints can still hold the lock.
    lock_wait: 300

    # Retention policy — photos are precious, keep more history
    keep_daily: 7
    keep_monthly: 12
    keep_yearly: 1000
  '';

  sqliteDumpScript = ''
    #!/bin/sh
    ${header}
    #
    # Snapshot a WAL-mode SQLite database into the borgmatic dump dir.
    # VACUUM INTO is one read transaction: consistent on a busy source, and
    # unlike the incremental .backup API its copy cannot be restarted by
    # concurrent writers (the 2026-10-22 forgejo.db .backup starvation —
    # heph/forgejo hooks sat there ~6h, eblume/blumeops#1773).
    #
    # The hard bound below is the second half of that fix: a snapshot that
    # cannot finish (lock contention beyond busy_timeout, a full dump dir,
    # anything else) fails this run loudly and bounded, instead of starving
    # the nightly and every later one. launchd never overlaps a one-shot job
    # with itself, so the bound also caps how late a healthy run can start.
    # macOS ships no coreutils `timeout` (see darwin/indri/mount-sifaka.sh),
    # so the bound is the same /usr/bin/perl fork/alarm pattern: TERM the
    # child on alarm, exit 124.
    #
    # test -f first: sqlite3 silently auto-creates a missing source as an
    # empty DB and exits 0, which would back up nothing. A missing source
    # must abort the run instead.
    set -eu

    [ "$#" -eq 3 ] || { echo "usage: $0 <src.db> <dest.db> <timeout_secs>" >&2; exit 2; }
    SRC="$1"
    DEST="$2"
    TIMEOUT_SECS="$3"

    test -f "$SRC" || { echo "sqlite-dump: source missing: $SRC" >&2; exit 1; }

    # rm -f the stale dest and any WAL sidecars first: VACUUM INTO refuses
    # to overwrite an existing file, and the old .backup dest was WAL-mode,
    # so a hung run leaves -wal/-shm in the dump dir (today: an 806 MB
    # forgejo.db-wal) that would ride into the never-pruned archives.
    rm -f "$DEST" "$DEST-wal" "$DEST-shm"

    # .timeout (ms) sets the busy handler without echoing, unlike
    # PRAGMA busy_timeout: acquiring the read snapshot can hit a running
    # checkpoint or the start-of-VACUUM exclusive phase on a busy source,
    # and SQLite's default is 0, so the first contended lock would abort
    # otherwise.
    #
    # VACUUM INTO goes in as the positional SQL argument with -bail: an
    # error inside a -cmd statement does not necessarily set the CLI's exit
    # code, and without -bail the CLI reads stdin after the error and exits
    # 0 (stdin is /dev/null under launchd), so a real failure would report
    # as success and borg would archive a missing or torn snapshot.
    # </dev/null keeps the same guarantee for a manual tty run.
    #
    # run_with_timeout is the darwin/indri/mount-sifaka.sh helper, verbatim:
    # the child argv goes straight through $@, TERM'd on alarm, exit 124.
    run_with_timeout() {
      secs="$1"
      shift
      TT_SECS="$secs" /usr/bin/perl -e '
      use POSIX ":sys_wait_h";
      my ($rc, $prev);
      $prev{CHLD} = $SIG{CHLD};
      $SIG{CHLD} = "DEFAULT";
      $pid = fork();
      exit 127 unless defined $pid;
      exec @ARGV if $pid == 0;
      exit 127 if $pid == 0;
      $SIG{CHLD} = $prev{CHLD};
      $SIG{ALRM} = sub { kill "TERM" => $pid; exit 124 };
      alarm $ENV{TT_SECS};
      waitpid($pid, 0);
      $rc = $? >> 8;
      exit 124 if $? & 0x7f;
      exit $rc;
    ' "$@"
    }

    rc=0
    run_with_timeout "$TIMEOUT_SECS" /usr/bin/sqlite3 -bail "$SRC" \
        -cmd ".timeout ${toString (sqliteBusyTimeout * 1000)}" \
        "VACUUM INTO '$DEST';" </dev/null || rc=$?

    if [ "$rc" -eq 0 ]; then
      exit 0
    fi

    # A failed snapshot leaves no torn dest behind: borg archives whatever is
    # in the dump dir, so a partial file or sidecars would ride into the next
    # archive.
    rm -f "$DEST" "$DEST-wal" "$DEST-shm"

    case "$rc" in
      124)
        echo "sqlite-dump: snapshot of $SRC timed out after ''${TIMEOUT_SECS}s; aborting the run" >&2
        ;;
      *)
        echo "sqlite-dump: snapshot of $SRC failed (exit $rc)" >&2
        ;;
    esac
    exit "$rc"
  '';

  k8sSqliteDumpScript = ''
    #!/usr/bin/env bash
    ${header}
    #
    # Helper script invoked by borgmatic's before_backup hook to capture a
    # k8s pod's SQLite database. Keeps the borgmatic config readable by
    # pulling all the quoting out of YAML.
    #
    # Usage:
    #   borgmatic-k8s-sqlite-dump <target> <name> <dump_target>
    #
    # <target> is one of:
    #   ssh:borgmatic@ringtail - ringtail dump endpoint (forced command; only
    #                       <name> travels over the wire)
    #
    # <name>        - the dump's name in the ringtail endpoint's table
    # <dump_target> - file on this host to receive the dump
    set -euo pipefail

    target=''${1:?missing target}
    name=''${2:?missing name}
    dump_target=''${3:?missing dump target}

    mode=''${target%%:*}
    ref=''${target#*:}

    case "$mode" in
        ssh)
            # The ringtail endpoint's key forces `sudo /etc/borgmatic/borgmatic-dump
            # <name>` (nixos/ringtail/configuration.nix), so the only dial over the
            # wire is the dump name — pod coordinates live in the ringtail table.
            # accept-new pins ringtail's host key on first contact; BatchMode
            # fails fast instead of prompting in the headless LaunchAgent run.
            ssh -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
                -i "${ringtailKey}" \
                "$ref" "$name" > "$dump_target"
            ;;
        *)
            echo "borgmatic-k8s-sqlite-dump: unknown target mode: $mode" >&2
            echo "  expected ssh:borgmatic@ringtail" >&2
            exit 1
            ;;
    esac
  '';

  k8sFileDumpScript = ''
    #!/usr/bin/env bash
    ${header}
    #
    # Helper invoked by borgmatic's before_backup hook to ferry a *pre-existing*
    # backup file out of a k8s pod's PVC. Unlike borgmatic-k8s-sqlite-dump (which
    # runs an online dump inside the pod), this assumes the service produces its
    # own consistent backup files on a schedule. The ringtail dump endpoint picks
    # the lexically-greatest file matching its <glob> (fixed-width timestamps, so
    # lexical order == chronological) and streams it to <dump_target>.
    #
    # Usage:
    #   borgmatic-k8s-file-dump <target> <name> <dump_target>
    #
    # <target> is one of:
    #   ssh:borgmatic@ringtail - ringtail dump endpoint (forced command; only
    #                       <name> travels over the wire). The endpoint is
    #                       self-contained: a missing or empty export is contained
    #                       (rc 0, empty stdout — the previous staged export is
    #                       kept), a genuine infra error aborts the nightly.
    #
    # <name>        - the dump's name in the ringtail endpoint's table
    # <dump_target> - file on this host to receive the newest backup
    set -euo pipefail

    target=''${1:?missing target}
    name=''${2:?missing name}
    dump_target=''${3:?missing dump target}

    mode=''${target%%:*}
    ref=''${target#*:}

    case "$mode" in
        ssh)
            # The ringtail endpoint's key forces `sudo /etc/borgmatic/borgmatic-dump
            # <name>` (nixos/ringtail/configuration.nix), so the only dial over the
            # wire is the dump name — pod coordinates live in the ringtail table.
            # rc 0 with empty stdout means "no export yet" — keep the previous
            # staged file rather than clobbering it.
            tmp="''${dump_target}.tmp.$$"
            rc=0
            # accept-new pins ringtail's host key on first contact; BatchMode
            # fails fast instead of prompting in the headless LaunchAgent run.
            ssh -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
                -i "${ringtailKey}" \
                "$ref" "$name" > "$tmp" || rc=$?
            if [[ $rc -ne 0 ]]; then
                rm -f "$tmp"
                echo "borgmatic-k8s-file-dump: $name ferry failed (rc=$rc)" >&2
                exit "$rc"
            fi
            if [[ -s "$tmp" ]]; then
                mv -f "$tmp" "$dump_target"
            else
                rm -f "$tmp"
            fi
            ;;
        *)
            echo "borgmatic-k8s-file-dump: unknown target mode: $mode" >&2
            echo "  expected ssh:borgmatic@ringtail" >&2
            exit 1
            ;;
    esac
  '';

  k8sTarDumpScript = ''
    #!/usr/bin/env bash
    ${header}
    #
    # Helper script invoked by borgmatic's before_backup hook to capture a
    # k8s pod's data directory via tar. Keeps the borgmatic config readable by
    # pulling all the quoting out of YAML.
    #
    # Usage:
    #   borgmatic-k8s-tar-dump <target> <name> <dump_target>
    #
    # <target> is one of:
    #   ssh:borgmatic@ringtail - ringtail dump endpoint (forced command; only
    #                       <name> travels over the wire)
    #
    # <name>        - the dump's name in the ringtail endpoint's table
    # <dump_target> - file on this host to receive the tar
    set -euo pipefail

    target=''${1:?missing target}
    name=''${2:?missing name}
    dump_target=''${3:?missing dump target}

    mode=''${target%%:*}
    ref=''${target#*:}

    case "$mode" in
        ssh)
            # The ringtail endpoint's key forces `sudo /etc/borgmatic/borgmatic-dump
            # <name>` (nixos/ringtail/configuration.nix), so the only dial over the
            # wire is the dump name — pod coordinates live in the ringtail table.
            # accept-new pins ringtail's host key on first contact; BatchMode
            # fails fast instead of prompting in the headless LaunchAgent run.
            ssh -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
                -i "${ringtailKey}" \
                "$ref" "$name" > "$dump_target"
            ;;
        *)
            echo "borgmatic-k8s-tar-dump: unknown target mode: $mode" >&2
            echo "  expected ssh:borgmatic@ringtail" >&2
            exit 1
            ;;
    esac
  '';

  verifyPhotosScript = ''
    #!/bin/bash
    ${header}
    #
    # Scheduled verification for the borgbase-immich-photos repo (photos borgmatic
    # config; sources: ${lib.concatStringsSep ", " photosSourceDirs}).
    # Cadence (StartCalendarInterval in the LaunchAgent): every Tuesday 06:00 and
    # the 2nd of each month at 06:00. Each run:
    #   - repo + archive-metadata check (borgmatic check --only repository
    #     --only archives) always; its success marker is written right after.
    #   - full-data check (--only data, borg's --verify-data) only when the
    #     previous data-check marker is missing or older than 40 days.
    #   - sampled test-restore (5 random >1MB files from the newest archive) only
    #     when /Volumes/photos (sifaka SMB mount) is mounted.

    set -euo pipefail

    # Full paths: launchd PATH is /opt/homebrew/bin:/usr/bin:/bin
    BORG="${borgBin}"
    BORGMATIC="${borgmaticBin}"
    JQ=/opt/homebrew/bin/jq
    REPO="${photosRepo}"
    MARKER_DIR="${verifyMarkerDir}"

    export BORG_PASSCOMMAND="${passcommand}"
    export BORG_RSH="${sshCommandPhotos}"
    # borg config/security/cache live in the default ~/.config/borg (same as the
    # daily creates)

    # Default mounted; the grep in this pipeline must not kill the script (pipefail)
    MOUNTED=1
    /sbin/mount | grep -q ' /Volumes/photos ' || MOUNTED=0

    # Newest archive in the repo (empty only for an empty repo: restore is then
    # skipped, the checks still run)
    LAST_ARCHIVE=$("$BORG" list --json "$REPO" | "$JQ" -r '.archives[-1].name // empty')

    # Weekly consistency check (repo + archive metadata). A failure exits here, so
    # the check marker is not written for a repo that fails its checks.
    "$BORGMATIC" --config "${photosConfigPath}" check \
        --repository "${photosRepo}" \
        --only repository --only archives --force
    echo "$(date +%s)" > "$MARKER_DIR/check"

    # Monthly full-data check (borg --verify-data, valid only alongside the archive
    # check); only when never run or stale (a corrupt marker just re-runs it).
    DATA_STATE=skipped
    if [ ! -f "$MARKER_DIR/check-data" ]; then DATA_STATE=ran
    else
        STAMP=$(cat "$MARKER_DIR/check-data" 2>/dev/null)
        case "$STAMP" in '''|*[!0-9]*) DATA_STATE=ran ;;
            *) [ $(( $(date +%s) - STAMP )) -gt $((40*24*3600)) ] && DATA_STATE=ran ;;
        esac
    fi
    if [ "$DATA_STATE" = ran ]; then
        "$BORGMATIC" --config "${photosConfigPath}" check \
            --repository "${photosRepo}" \
            --only archives --only data --force
        echo "$(date +%s)" > "$MARKER_DIR/check-data"
    fi

    # Sampled test-restore: extract random >1MB files from the newest archive and
    # sha256-compare against the live files under the SMB mount.
    RESTORE_STATE=skipped
    if [ "$MOUNTED" = 1 ] && [ -n "$LAST_ARCHIVE" ]; then
        RESTORE_STATE=ran
        WORK="$HOME/.config/borg-verify-photos-work"
        rm -rf "$WORK"
        mkdir -p "$WORK"
        trap 'rm -rf "$WORK"' EXIT
        COMPARED=0
        SKIPPED=0
        MISMATCHED=0
        FAILED=0   # 0 ok; 1 hash mismatch; 2 EPERM (TCC) on a live read

        # macOS ships no GNU coreutils shuf, so sample with an awk reservoir
        # (paths arrive TAB-separated; dirs end in / and are skipped).
        SAMPLES=$("$BORG" list "$REPO::''${LAST_ARCHIVE}" --format '{path}{TAB}{size}{NL}' | awk -F'\t' '
            BEGIN { srand(); n = 5 }
            $1 !~ /\/$/ && $2 > 1000000 {
                c++
                if (c <= n) { s[c] = $1 }
                else { j = int(rand() * c) + 1; if (j <= n) s[j] = $1 }
            }
            END { for (i = 1; i <= c && i <= n; i++) print s[i] }
        ')

        while read -r path; do
            [ -z "$path" ] && continue
            # archive paths are relative to the create cwd (/Users/erichblume);
            # live files sit under /Volumes/photos, so strip that known prefix
            archive_path="''${path#/}"
            rel="''${archive_path#Volumes/photos/}"
            live="/Volumes/photos/$rel"
            if [ ! -f "$live" ]; then
                # deleted on sifaka since the backup; transient, not an error
                SKIPPED=$((SKIPPED + 1))
                echo "test-restore skip: $path (absent on sifaka)" >&2
                continue
            fi
            # an extract failure (ssh blip, path churn) is transient: skip, don't abort
            if ! "$BORG" extract --stdout "$REPO::''${LAST_ARCHIVE}" "$archive_path" > "$WORK/probe" 2> "$WORK/extract.err"; then
                SKIPPED=$((SKIPPED + 1))
                echo "test-restore skip: $path (extract failed: $(cat "$WORK/extract.err"))" >&2
                continue
            fi
            # the probe is a local file we just wrote; hash it (safe)
            probe_hash=$(shasum -a 256 "$WORK/probe" | awk '{print $1}')
            # the live read is the TCC-sensitive one. A non-permission failure is
            # transient (skip); a permission error (EPERM or EACCES) is the TCC
            # regression this job exists to catch, so it fails the run and writes
            # no marker.
            if ! live_hash=$(shasum -a 256 "$live" 2> "$WORK/live.err" | awk '{print $1}'); then
                if grep -qi 'permission' "$WORK/live.err"; then
                    echo "test-restore PERMISSION ERROR (TCC): $path, live read denied: $(cat "$WORK/live.err")" >&2
                    FAILED=2
                    break
                fi
                SKIPPED=$((SKIPPED + 1))
                echo "test-restore skip: $path (live read failed: $(cat "$WORK/live.err"))" >&2
                continue
            fi
            COMPARED=$((COMPARED + 1))
            if [ "$probe_hash" != "$live_hash" ]; then
                echo "test-restore MISMATCH: $path (archive vs live under /Volumes/photos; benign if the file changed since the last 04:00 backup, else investigate)" >&2
                MISMATCHED=$((MISMATCHED + 1))
                FAILED=1
                break
            fi
            echo "test-restore ok: $path"
        done <<< "$SAMPLES"

        # always export the counts so a mostly-skipped or failed run is visible
        echo "$COMPARED" > "$MARKER_DIR/test-restore-compared"
        echo "$SKIPPED" > "$MARKER_DIR/test-restore-skipped"
        echo "$MISMATCHED" > "$MARKER_DIR/test-restore-mismatched"

        if [ "$FAILED" = 1 ]; then
            echo "test-restore FAILED: $MISMATCHED hash mismatch(es) among $COMPARED compared" >&2
            exit 1
        fi
        if [ "$FAILED" = 2 ]; then
            echo "test-restore FAILED: EPERM on a live read (TCC), no marker written" >&2
            exit 1
        fi
        # a test-restore marker means at least one file was actually compared
        if [ "$COMPARED" -ge 1 ]; then
            echo "$(date +%s)" > "$MARKER_DIR/test-restore"
        fi
    fi

    echo "verification ok: repo+archives check ran; data check $DATA_STATE; test-restore $RESTORE_STATE"
  '';

  opsRepoAdminScript = ''
    #!/bin/sh
    ${header}
    #
    # One-shot admin for the operational borg repos. The oneshot's plist execs
    # the TCC-granted borgmatic venv python, which spawns this script: the
    # launchd responsible process must hold the Network Volumes grant to read
    # the SMB share's content (the repo's exclusive lock), and neither sshd
    # nor /bin/sh holds it — so running the script directly, under launchd or
    # over ssh, dies with EPERM on the first lock.
    #
    # Idempotent no-op on a healthy repo: repo-create only when the repo's
    # README is absent, and append_only flipped to 0 only when it reads 1.
    # append_only must stay 0: on borg 1.4 an append-only repo makes `compact`
    # a silent no-op, so the rotating repo's pruned segments would never be
    # reclaimed.
    #
    # The mount guard mirrors the role's ssh-side assert: the archive-tier
    # repo's README (present on the NAS since 2026-01) proves /Volumes/backups
    # is the sifaka mount; `test -e` is metadata-only, so it holds for a by-hand
    # ssh run too.
    set -eu

    BORG="${borgBin}"
    BORG_CONFIG="${operationalConfigPath}"
    MOUNT_MARK=/Volumes/backups/borg/README

    test -e "$MOUNT_MARK" || {
      echo "ops-repo-admin: sifaka mount not up (no $MOUNT_MARK); aborting" >&2
      exit 1
    }

    REPO="${operationalRepo.path}"

    if ! test -e "$REPO/README"; then
      echo "ops-repo-admin: creating operational repo at $REPO"
      "${borgmaticBin}" --config "$BORG_CONFIG" repo-create --repository "$REPO"
    fi

    # The direct borg config calls don't inherit the borgmatic config's
    # lock_wait (300); pass it so an overlapping run waits instead of LockTimeout'ing at the 1 s default.
    if ! append_only="$("$BORG" --lock-wait 300 config "$REPO" append_only)"; then
      echo "ops-repo-admin: reading append_only of $REPO failed" >&2
      exit 1
    fi
    if [ "$append_only" = "1" ]; then
      "$BORG" --lock-wait 300 config "$REPO" append_only 0
      echo "ops-repo-admin: set append_only=0 on $REPO"
    fi
  '';
in
{
  inherit borgmaticVersion;

  files = [
    { path = "${binDir}/borgmatic-k8s-sqlite-dump"; text = k8sSqliteDumpScript; mode = "0755"; }
    { path = "${binDir}/borgmatic-k8s-file-dump"; text = k8sFileDumpScript; mode = "0755"; }
    { path = "${binDir}/borgmatic-k8s-tar-dump"; text = k8sTarDumpScript; mode = "0755"; }
    { path = "${binDir}/borgmatic-sqlite-dump"; text = sqliteDumpScript; mode = "0755"; }
    { path = "${binDir}/borgmatic-ops-repo-admin"; text = opsRepoAdminScript; mode = "0755"; }
    { path = "${home}/.local/bin/borgmatic-verify-photos"; text = verifyPhotosScript; mode = "0755"; }
    { path = mainConfigPath; text = mainConfig; mode = "0600"; }
    { path = talosDataConfigPath; text = talosDataConfig; mode = "0600"; }
    { path = operationalConfigPath; text = operationalConfig; mode = "0600"; }
    { path = photosConfigPath; text = photosConfig; mode = "0600"; }
  ];
}
