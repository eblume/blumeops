{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/Users/erichblume/zot",
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5050",
    "externalUrl": "https://registry.ops.eblu.me",
    "auth": {
      "openid": {
        "providers": {
          "oidc": {
            "credentialsFile": "/Users/erichblume/.config/zot/oidc-credentials.json",
            "issuer": "https://authentik.ops.eblu.me/application/o/zot/",
            "scopes": ["openid", "email", "profile"],
            "claimMapping": {
              "username": "preferred_username"
            }
          }
        }
      },
      "apikey": true
    },
    "accessControl": {
      "metrics": {
        "anonymousPolicy": ["read"]
      },
      "repositories": {
        "**": {
          "policies": [
            {
              "groups": ["ci-artifacts"],
              "actions": ["read", "create"]
            },
            {
              "groups": ["admins"],
              "actions": ["read", "create", "update", "delete"]
            }
          ],
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        },
                "blumeops/talos": {
          "policies": [
            {
              "groups": ["ci-talos-artifacts"],
              "actions": ["create", "update"]
            },
            {
              "groups": ["ci-artifacts"],
              "actions": ["read", "create"]
            },
            {
              "groups": ["admins"],
              "actions": ["read", "create", "update", "delete"]
            }
          ],
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        },
        "blumeops/horkos": {
          "policies": [
            {
              "groups": ["ci-horkos-artifacts"],
              "actions": ["create", "update"]
            },
            {
              "groups": ["ci-artifacts"],
              "actions": ["read", "create"]
            },
            {
              "groups": ["admins"],
              "actions": ["read", "create", "update", "delete"]
            }
          ],
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        },
        "blumeops/cv": {
          "policies": [
            {
              "groups": ["horkos-artifacts"],
              "actions": ["create", "update"]
            },
            {
              "groups": ["ci-artifacts"],
              "actions": ["read", "create"]
            },
            {
              "groups": ["admins"],
              "actions": ["read", "create", "update", "delete"]
            }
          ],
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        }
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "content": [{"prefix": "**", "destination": "/docker.io"}],
          "onDemand": true,
          "tlsVerify": true
        },
        {
          "urls": ["https://ghcr.io"],
          "content": [{"prefix": "**", "destination": "/ghcr.io"}],
          "onDemand": true,
          "tlsVerify": true
        },
        {
          "urls": ["https://quay.io"],
          "content": [{"prefix": "**", "destination": "/quay.io"}],
          "onDemand": true,
          "tlsVerify": true
        }
      ]
    },
    "search": {
      "enable": true,
      "cve": {
        "updateInterval": "24h"
      }    },
    "ui": {
      "enable": true
    }
  }
}
