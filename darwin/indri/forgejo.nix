# forgejo's app.ini (V5-83 PR 1), rendered by the indri generation. Values mirror
# ansible/roles/forgejo/templates/app.ini.j2 with the defaults in
# ansible/roles/forgejo/defaults/main.yml. The three secrets are *_URI file
# references read by forgejo at start, so no secret value reaches the store.
{ secretsDir }:
''
  # Generated by the indri nix-darwin generation (darwin/indri/forgejo.nix) - do not
  # edit by hand.
  APP_NAME = Forgejo
  APP_SLOGAN = Beyond coding. We Forge.
  RUN_USER = erichblume
  WORK_PATH = /Users/erichblume/forgejo
  RUN_MODE = prod

  [server]
  HTTP_ADDR = 0.0.0.0
  HTTP_PORT = 3001
  SSH_DOMAIN = forge.ops.eblu.me
  DOMAIN = forge.ops.eblu.me
  ROOT_URL = https://forge.ops.eblu.me/
  APP_DATA_PATH = /Users/erichblume/forgejo/data
  DISABLE_SSH = false
  START_SSH_SERVER = true
  BUILTIN_SSH_SERVER_USER = forgejo
  SSH_PORT = 2222
  SSH_LISTEN_PORT = 2200
  LFS_START_SERVER = true
  LFS_JWT_SECRET_URI = file:${secretsDir}/lfs-jwt-secret
  OFFLINE_MODE = true
  REVERSE_PROXY_LIMIT = 2
  REVERSE_PROXY_TRUSTED_PROXIES = *

  [database]
  DB_TYPE = sqlite3
  PATH = /Users/erichblume/forgejo/data/forgejo.db
  LOG_SQL = false

  [repository]
  ROOT = /Users/erichblume/forgejo/data/forgejo-repositories
  DEFAULT_REPO_UNITS = repo.code,repo.issues,repo.pulls,repo.releases,repo.wiki,repo.projects,repo.actions

  [lfs]
  PATH = /Users/erichblume/forgejo/data/lfs

  [packages]
  ENABLED = false

  [mailer]
  ENABLED = false

  [service]
  REGISTER_EMAIL_CONFIRM = false
  ENABLE_NOTIFY_MAIL = false
  DISABLE_REGISTRATION = true
  ALLOW_ONLY_EXTERNAL_REGISTRATION = true
  ENABLE_CAPTCHA = false
  REQUIRE_SIGNIN_VIEW = false
  DEFAULT_KEEP_EMAIL_PRIVATE = false
  DEFAULT_ALLOW_CREATE_ORGANIZATION = true
  DEFAULT_ENABLE_TIMETRACKING = true
  NO_REPLY_ADDRESS = noreply.indri

  [openid]
  ENABLE_OPENID_SIGNIN = false
  ENABLE_OPENID_SIGNUP = false

  [mirror]
  DEFAULT_INTERVAL = 8h
  MIN_INTERVAL = 10m

  [migrations]
  # Push-mirror syncs re-check their remote URL against the migration
  # allow/block lists on every sync. With no list, only *external*
  # addresses pass — and the fly mirror endpoint's tailnet IP is CGNAT
  # (100.64.0.0/10, classed private), so push mirrors to it fail without
  # this (eblume/blumeops#1208).
  ALLOW_LOCALNETWORKS = true

  [cron.update_checker]
  ENABLED = false

  [cron.archive_cleanup]
  ENABLED = true
  RUN_AT_START = true
  SCHEDULE = @midnight
  OLDER_THAN = 2h

  [cron.delete_old_system_notices]
  ENABLED = true
  RUN_AT_START = true
  SCHEDULE = @every 168h
  OLDER_THAN = 720h

  [cron.delete_old_actions]
  ENABLED = true
  RUN_AT_START = true
  SCHEDULE = @every 168h
  OLDER_THAN = 2160h

  [session]
  PROVIDER = file

  [log]
  MODE = console
  LEVEL = info
  ROOT_PATH = /Users/erichblume/forgejo/log

  [repository.pull-request]
  DEFAULT_MERGE_STYLE = merge
  # Instance-wide: closing an issue is a deliberate human act, not a PR-merge side effect (#1258).
  # `-` is deliberate: go-ini ignores an empty list (keeping the defaults), while a
  # non-letter keyword is rejected by references.parseKeywords, leaving a nil pattern.
  CLOSE_KEYWORDS = -
  REOPEN_KEYWORDS = -

  [repository.signing]
  DEFAULT_TRUST_MODEL = committer

  [security]
  INSTALL_LOCK = true
  INTERNAL_TOKEN_URI = file:${secretsDir}/internal-token
  PASSWORD_HASH_ALGO = pbkdf2_hi

  [oauth2]
  JWT_SECRET_URI = file:${secretsDir}/oauth2-jwt-secret

  [oauth2_client]
  ENABLE_AUTO_REGISTRATION = true
  ACCOUNT_LINKING = login
  USERNAME = nickname
  REGISTER_EMAIL_CONFIRM = false

  [metrics]
  ENABLED = true
  ENABLED_ISSUE_BY_LABEL = false
  ENABLED_ISSUE_BY_REPOSITORY = false

  [actions]
  ENABLED = true
  DEFAULT_ACTIONS_URL = https://code.forgejo.org

  [webhook]
  # Default is `external` only, which denies tailnet targets — the talos
  # PR-label webhook delivers to talos.ops.eblu.me (100.x behind Caddy).
  ALLOWED_HOST_LIST = external, *.ops.eblu.me
''
