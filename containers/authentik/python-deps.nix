# Python dependency venv for authentik.
#
# No FOD and no import-from-derivation: the venv closure is the checked-in,
# freshness-gated venv-lock.nix — pure data (wheel/sdist/git sources with
# hashes, per-package dep edges, the sdist build-system closure, the
# resolution order), generated by
# `mise run generate-authentik-venv-lock` from the pinned trio (the revs
# below; the file's provenance records the same) and the sources.nix
# authentik rev. The prek hook re-resolves the closure and fails Lint on
# drift, so a changed uv.lock without regeneration is a CI failure.
#
# Every venv package is a plain fetchurl/fetchGit + stdenv derivation (the
# port of uv2nix `remote` the old overlay ran, now driven by the recorded
# data), and the venv assembles them with containers/authentik/make-venv.py
# — byte-exact from the pinned pyproject-nix (the task keeps it gated) — so
# the output layout is unchanged for authentik-django.nix.
#
# The local workspace projects (and the root project) are excluded from the
# venv: authentik-django.nix copies them from the monorepo source and patches
# them, so the venv must contain exactly the third-party closure of the root
# project's dependencies.
{ pkgs ? import <nixpkgs> { }, sources ? import ./sources.nix { inherit pkgs; } }:

let
  lib = pkgs.lib;

  # The pinned trio that produced venv-lock.nix (data only — the
  # generate-authentik-venv-lock task reads these to regenerate the closure;
  # this file never fetches or imports the trio at eval). Keep the url+rev
  # shape the task's pin regex expects.
  trio = {
    "pyproject-nix" = { url = "https://forge.ops.eblu.me/mirrors/pyproject.nix.git"; rev = "ddc400a6883b042646d0940e65971bb7f7e96107"; };
    "uv2nix" = { url = "https://forge.ops.eblu.me/mirrors/uv2nix.git"; rev = "7aba73a3d85454f1118f8cf9de97979b4d26bcac"; };
    "build-system-pkgs" = { url = "https://forge.ops.eblu.me/mirrors/build-system-pkgs.git"; rev = "a17819c85163988e063806ffc4f6d2716bc8ead8"; };
  };

  venvLock = import ./venv-lock.nix;

  python = pkgs.python314;
  inherit (python) sitePackages;
  uv = pkgs.uv;

  # --- source construction (port of uv2nix `remote`'s src) -----------------

  # fetchurl does not un-escape the name; uv requires precise wheel
  # filenames, so percent-encoding in the URL is decoded for the name.
  unquoteURL =
    lib.replaceStrings
      [
        "%21"
        "%23"
        "%24"
        "%26"
        "%27"
        "%28"
        "%29"
        "%2A"
        "%2B"
        "%2C"
        "%2F"
        "%3A"
        "%3B"
        "%3D"
        "%3F"
        "%40"
        "%5B"
        "%5D"
      ]
      [
        "!"
        "#"
        "$"
        "&"
        "'"
        "("
        ")"
        "*"
        "+"
        ","
        "/"
        ":"
        ";"
        "="
        "?"
        "@"
        "["
        "]"
      ];

  srcFilename = url: unquoteURL (lib.baseNameOf url);

  fetchSource =
    s:
    if s.type == "git" then
      # Builtins.fetchGit (rev-pinned FOD), the same fetcher the old uv2nix
      # overlay used — pkgs.fetchGit does not exist under the current
      # nixpkgs pin.
      builtins.fetchGit {
        inherit (s) url rev;
        allRefs = true;
        submodules = true;
      }
    else if s.type == "sdist" then
      # No name override: the old build fetched sdists by raw URL basename.
      pkgs.fetchurl { inherit (s) url hash; }
    else
      pkgs.fetchurl {
        name = srcFilename s.url;
        inherit (s) url hash;
      };

  # manylinux platform tags -> the glibc packages the old build put on the
  # wheel's buildInputs (Linux only, as here).
  manylinuxInputs =
    tags:
    lib.unique (
      lib.concatMap (
        tag:
        if lib.hasPrefix "manylinux1" tag then pkgs.pythonManylinuxPackages.manylinux1
        else if lib.hasPrefix "manylinux2010" tag then pkgs.pythonManylinuxPackages.manylinux2010
        else if lib.hasPrefix "manylinux2014" tag then pkgs.pythonManylinuxPackages.manylinux2014
        else if lib.hasPrefix "manylinux_" tag then pkgs.pythonManylinuxPackages.manylinux2014
        else [ ]
      ) tags
    );

  # --- shared phases ---------------------------------------------------------
  # Ports of the pinned pyproject-nix setup hooks (revs in venv-lock.nix
  # provenance), non-cross Linux as here: the configure hook's env, the
  # wheel-dist / PEP 517 build phases, the uv-pip install, and the
  # output-setup hook (rendered as a post-install step instead of a custom
  # postPhase — same nix-support/setup-hook content).

  configurePhase = ''
    runHook preConfigure
    export PYTHONPATH="${python}/${sitePackages}"
    if [ -z "''${UV_COMPILE_BYTECODE-}" ]; then
      export UV_COMPILE_BYTECODE=1
    fi
    if [ -z "''${UV_COMPILE_BYTECODE_TIMEOUT-}" ]; then
      export UV_COMPILE_BYTECODE_TIMEOUT=0
    fi
    if [ -z "''${UV_NO_INSTALLER_METADATA-}" ]; then
      export UV_NO_INSTALLER_METADATA=1
    fi
    if [ -z "''${UV_NO_CONFIG-}" ]; then
      export UV_NO_CONFIG=1
    fi
    if [ -z "''${UV_SKIP_WHEEL_FILENAME_CHECK-}" ]; then
      export UV_SKIP_WHEEL_FILENAME_CHECK=1
    fi
    if [ -z "''${dontUseCmakeConfigure-}" ]; then
      export dontUseCmakeConfigure=true
    fi
    runHook postConfigure
  '';

  # Wheel sources are always files here (the old hook's directory branch
  # never applied to fetched wheels).
  wheelBuildPhase = ''
    runHook preBuild
    echo "Creating dist..."
    mkdir -p dist
    ln -s "$src" "dist/$(stripHash "$src")"
    runHook postBuild
  '';

  # PEP 517: `uv build --no-build-isolation`; the build-system backends are
  # importable via NIX_PYPROJECT_PYTHONPATH (the nativeBuildInputs'
  # nix-support/setup-hooks add them), exactly as the old hook ran it.
  sdistBuildPhase = ''
    runHook preBuild
    echo "Creating a distribution..."
    env PYTHONPATH="$NIX_PYPROJECT_PYTHONPATH:$PYTHONPATH" ${uv}/bin/uv build -v --no-cache --python=${python.interpreter} --offline --no-build-isolation --out-dir dist/ "--wheel"
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    pushd dist >/dev/null
    for wheel in *.whl; do
      ${uv}/bin/uv pip --offline --no-cache install --no-deps --link-mode=copy --python=${python.interpreter} --system --prefix "$out" "./$wheel"
      echo "Successfully installed $wheel"
    done
    popd
    rm -f "$out/.lock"

    runHook postInstall

    # pyproject-output-setup-hook content: advertise this package's
    # site-packages to dependent PEP 517 builds.
    mkdir -p $out/nix-support
    printf '%s\n' \
      "# Add Python dependency to search path for discovery by build" \
      "addToSearchPath NIX_PYPROJECT_PYTHONPATH \"$out/${sitePackages}\"" \
      >>$out/nix-support/setup-hook
  '';

  # --- package derivations (port of uv2nix `remote`) ------------------------

  mkPassthru =
    e:
    {
      # The old overlay carried "wheel"|"pyproject"; git sources built as
      # pyproject.
      format = if e.fmt == "wheel" then "wheel" else "pyproject";
      dependencies = e.dependencies;
      optional-dependencies = e.optionalDependencies;
      dependency-groups = e.dependencyGroups;
    };

  mkWheelPkg =
    name: e:
    pkgs.stdenv.mkDerivation (
      {
        pname = name;
        inherit (e) version;
        src = fetchSource e.source;

        dontStrip = true;
        dontUnpack = true;

        nativeBuildInputs = [ uv pkgs.autoPatchelfHook python ];
        buildInputs = manylinuxInputs e.source.platformTags;

        inherit configurePhase installPhase;
        buildPhase = wheelBuildPhase;

        passthru = mkPassthru e;
      }
      // lib.optionalAttrs (!venvLock.config."compile-bytecode") {
        UV_COMPILE_BYTECODE = "0";
      }
    );

  mkSdistPkg =
    name: e:
    pkgs.stdenv.mkDerivation (
      {
        pname = name;
        inherit (e) version;
        src = fetchSource e.source;

        nativeBuildInputs = [ uv python ];

        inherit configurePhase installPhase;
        buildPhase = sdistBuildPhase;

        passthru = mkPassthru e;
      }
      // lib.optionalAttrs (!venvLock.config."compile-bytecode") {
        UV_COMPILE_BYTECODE = "0";
      }
    );

  # Build-system packages (prebuilt wheels the sdist builds install first).
  # The two attr inheritances below are the build-system-pkgs overlay
  # overrides the old scope applied to the bspkgs-workspace versions of
  # cython/pkgconfig (the setuptools entry comes from the authentik lock and
  # carried no override).
  mkBuildSystemPkg =
    name: e:
    # Build-system entries record {version, format, source} — no dep edges
    # (they have none in either lock); give them the empty passthru the
    # resolvers expect.
    (mkWheelPkg name (e // {
      fmt = "wheel";
      dependencies = { };
      optionalDependencies = { };
      dependencyGroups = { };
    }))
    // lib.optionalAttrs (name == "cython" && pkgs.python3Packages.cython ? setupHook) {
      setupHook = pkgs.python3Packages.cython.setupHook;
    }
    // lib.optionalAttrs (name == "pkgconfig") {
      inherit (pkgs.pkg-config)
        setupHooks
        wrapperName
        suffixSalt
        targetPrefix
        baseBinName
        ;
    };

  # A build-system name that is also a venv member (setuptools, a runtime
  # dep here) had ONE definition in the old scope: the authentik-lock
  # version, which served as venv member and as the sdist build backend.
  # Reuse the venv derivation for those; the recorded sources must agree.
  collidingBuildSystem = lib.intersectLists
    (lib.attrNames venvLock.venv)
    (lib.attrNames venvLock.buildSystem);

  baseSet = lib.listToAttrs (
    lib.mapAttrsToList (name: e:
      lib.nameValuePair name
        (if e.fmt == "wheel" then mkWheelPkg name e else mkSdistPkg name e)
    ) venvLock.venv
  )
  // lib.listToAttrs (
    lib.map (name:
      lib.nameValuePair name
        (mkBuildSystemPkg name venvLock.buildSystem.${name})
    ) (lib.filter (n: !venvLock.venv ? ${n}) (lib.attrNames venvLock.buildSystem))
  );

  # The nixpkgs interpreter ships no setuptools, so every sdist/git venv
  # package gets its PEP 517 backend(s) here — the same fixups the old build
  # applied (system libraries for the C compiles included). Every
  # non-wheel venv package must appear: a package without backend inputs
  # cannot `uv build --no-build-isolation`.
  sdistBackendNames = [
    "lxml"
    "xmlsec"
    "psycopg-c"
    "gssapi"
    "py-ubjson"
    "opencontainers"
  ];

  # --- resolvers (port of pyproject-nix build/lib/resolvers.nix, same rev) --
  # Copied verbatim so build-system deps and the venv dep list resolve
  # exactly as the old overlay scope did (the venv merge is order-sensitive
  # on file collisions).
  resolveNonCyclic =
    # List of package names to memoize
    memoNames:
    # Package set to resolve packages from
    set:
    let
      recurse' =
        name: extras:
        let
          pkg = set.${name};
          dependencies = pkg.passthru.dependencies or { };
        in
        [ name ]
        ++ lib.concatMap (name: recurse name dependencies.${name}) (lib.attrNames dependencies)
        ++ lib.concatMap (
          name':
          let
            extra' = pkg.passthru.optional-dependencies.${name'} or null;
            group' = pkg.passthru.dependency-groups.${name'} or null;
          in
          lib.throwIf (extra' == null && group' == null)
            "Extra/group name '${name'}' does not match either extra or dependency group in package ${pkg.pname}"
            (lib.concatMap
              (name: recurse name extra'.${name})
              (if extra' != null then (lib.attrNames extra') else [ ])
              ++ lib.concatMap (name: recurse name group'.${name}) (
                if group' != null then (lib.attrNames group') else [ ]
              ))
        ) extras;

      # Memoise known build systems with no extras enabled for better performance
      memo = lib.genAttrs memoNames (name: recurse' name [ ]);

      recurse =
        name: extras: if extras == [ ] then (memo.${name} or (recurse' name [ ])) else recurse' name extras;
    in
    # Attribute set of dependencies -> extras { requests = [ "socks" ]; }
    spec: lib.concatMap (name: recurse name spec.${name}) (lib.attrNames spec);

  # Copied verbatim from the pinned pyproject-nix (build/lib/resolvers.nix,
  # revs in venv-lock.nix provenance) so build-system deps and the venv dep
  # list resolve exactly as the old overlay scope did.
  resolveCyclic =
    # Package set to resolve packages from
    set:
    # Attribute set of dependencies -> extras `{ requests = [ "socks" ]; }`
    spec:
    let
      mkKey = key: { inherit key; };

      # Resolve spec recursively
      closure' = lib.genericClosure {
        startSet = lib.concatMap (
          name: [ (mkKey name) ] ++ lib.map (extra: mkKey "${name}@${extra}") spec.${name}
        ) (lib.attrNames spec);
        operator =
          { key }:
          let
            m = lib.match "(.+)@(.*)" key;
          in
          # We're looking for a package with extra or dependency group
          if m != null then
            (
              let
                pkg = set.${lib.elemAt m 0};
                name' = lib.elemAt m 1;
                extras' = pkg.passthru.optional-dependencies.${name'} or null;
                groups' = pkg.passthru.dependency-groups.${name'} or null;
              in
              lib.throwIf (extras' == null && groups' == null)
                "Extra/group name '${name'}' does not match either extra or dependency group"
                (
                  (
                    if extras' != null then
                      lib.concatMap (name: [ (mkKey name) ] ++ lib.map (extra: mkKey "${name}@${extra}") extras'.${name}) (
                        lib.attrNames extras'
                      )
                    else
                      [ ]
                  )
                  ++ (
                    if groups' != null then
                      lib.concatMap (name: [ (mkKey name) ] ++ lib.map (extra: mkKey "${name}@${extra}") groups'.${name}) (
                        lib.attrNames groups'
                      )
                    else
                      [ ]
                  )
                )
            )

          # Root package with no extra
          else
            (
              let
                pkg = set.${key};
                dependencies = pkg.passthru.dependencies or { };
              in
              lib.concatMap (name: [ (mkKey name) ] ++ lib.map (extra: mkKey "${name}@${extra}") dependencies.${name}) (
                lib.attrNames dependencies
              )
            );
      };

      # closure' contains a list like [ { key = "dep@extra"; }]
      # where a dependency with an extra is a duplicate of its non-extra
      # enabled form.
      closure = lib.filter (dep: lib.match ".+@.*" dep.key == null) closure';

    in
    lib.map (dep: dep.key) closure;

  # sdistFixups — the per-sdist C-library and backend fixups the old build
  # applied, now over the data-driven base set. `set` is the fixpoint (the
  # old scope's `final`): the xmlsec entry references the already-fixed
  # lxml, whose site-packages its build imports for headers.
  sdistFixups = set:
    let
      # The old final.resolveBuildSystem mapped the resolved names to their
      # package derivations (nativeBuildInputs need paths, not names).
      sbs = spec: lib.map (name: set.${name}) (resolveNonCyclic [ ] set spec);
    in
    lib.optionalAttrs (baseSet ? lxml) {
      lxml = baseSet.lxml.overrideAttrs (old: {
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ pkgs.pkg-config ] ++ sbs { setuptools = [ ]; };
        buildInputs = (old.buildInputs or [ ]) ++ [ pkgs.libxml2 pkgs.libxslt pkgs.zlib ];
      });
    }
    // lib.optionalAttrs (baseSet ? xmlsec) {
      xmlsec = baseSet.xmlsec.overrideAttrs (old: {
        # build_ext.py has two undeclared build deps (uv's isolated builds used
        # to provide both): the Python pkgconfig module (pulled from the
        # build-systems set like setuptools) and lxml itself, imported for its
        # headers via lxml.get_include()
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ pkgs.pkg-config set.lxml ]
          ++ sbs { setuptools = [ ]; } ++ sbs { pkgconfig = [ ]; };
        # The Python pkgconfig module shells out to a nix pkg-config wrapper
        # that resolves the runtime PKG_CONFIG_PATH. xmlsec1.pc Requires
        # libxml-2.0 and libxslt, so all four .pc dirs must be visible.
        postConfigure = (old.postConfigure or "") + ''
          export PKG_CONFIG_PATH="${pkgs.xmlsec.dev}/lib/pkgconfig:${pkgs.libxml2.dev}/lib/pkgconfig:${pkgs.libxslt.dev}/lib/pkgconfig:${pkgs.openssl.dev}/lib/pkgconfig"
        '';
        # libtool provides libltdl, which xmlsec's dynamic crypto backend loads
        buildInputs = (old.buildInputs or [ ]) ++ [ pkgs.xmlsec pkgs.openssl pkgs.libtool pkgs.zlib pkgs.libffi ];
      });
    }
    // lib.optionalAttrs (baseSet ? "psycopg-c") {
      "psycopg-c" = baseSet."psycopg-c".overrideAttrs (old: {
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ [ pkgs.postgresql.pg_config ] ++ sbs { setuptools = [ ]; };
        buildInputs = (old.buildInputs or [ ]) ++ [ pkgs.libpq ];
      });
    }
    // lib.optionalAttrs (baseSet ? gssapi) {
      gssapi = baseSet.gssapi.overrideAttrs (old: {
        # setup.py imports cythonize unconditionally (pre-generated C code)
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ sbs { setuptools = [ ]; } ++ sbs { cython = [ ]; };
        buildInputs = (old.buildInputs or [ ]) ++ [ pkgs.krb5 ];
        # gssapi's pre-generated C code uses S4U prototypes without including
        # gssapi_ext.h; force-include it (same workaround as the old FOD)
        NIX_CFLAGS_COMPILE = "-include gssapi/gssapi_ext.h";
      });
    }
    // lib.optionalAttrs (baseSet ? "py-ubjson") {
      "py-ubjson" = baseSet."py-ubjson".overrideAttrs (old: {
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ sbs { setuptools = [ ]; };
      });
    }
    // lib.optionalAttrs (baseSet ? "aws-cdk-cloud-assembly-schema") {
      "aws-cdk-cloud-assembly-schema" = baseSet."aws-cdk-cloud-assembly-schema".overrideAttrs (old: {
        # aws-cdk-lib vendors its own aws_cdk.cloud_assembly_schema (a different
        # jsii build with a different _jsii import path). uv installs the
        # standalone first, then aws-cdk-lib overwrites the shared file
        # (last-wins). make-venv's merge can't express last-wins, so drop the
        # colliding file here; the merge then keeps aws-cdk-lib's copy.
        postInstall = (old.postInstall or "") + ''
          rm -f "$out/lib/python3.14/site-packages/aws_cdk/cloud_assembly_schema/__init__.py"
        '';
      });
    }
    // lib.optionalAttrs (baseSet ? opencontainers) {
      opencontainers = baseSet.opencontainers.overrideAttrs (old: {
        nativeBuildInputs = (old.nativeBuildInputs or [ ]) ++ sbs { setuptools = [ ]; };
      });
    };

  pythonSet = lib.fix (set: baseSet // (sdistFixups set));

  # --- the venv (port of pyproject-nix mkVirtualEnv) ------------------------

  # Vendored byte-exact from the pinned pyproject-nix (the task keeps it
  # gated); run as the venv's build phase, exactly as the old hook ran it.
  makeVenvScript = ./make-venv.py;

  # The spec's attrNames order is the recorded resolved attrset order — it
  # seeds resolveCyclic's closure walk, so NIX_PYPROJECT_DEPS comes out
  # exactly as the old build's (see venv-lock.nix venvOrder).
  venvSpec = lib.listToAttrs (
    lib.map (n: lib.nameValuePair n [ ]) venvLock.venvOrder
  );

in
assert lib.all (
  n: venvLock.venv.${n}.source == venvLock.buildSystem.${n}.source
  && venvLock.venv.${n}.version == venvLock.buildSystem.${n}.version
) collidingBuildSystem;
assert
  lib.all
    (n: lib.elem n sdistBackendNames)
    (lib.filter (n: venvLock.venv.${n}.fmt != "wheel") (lib.attrNames venvLock.venv));

# One file collision remains in the locked closure: a top-level docs/Makefile
# shipped by both django-tenants and pyrad (unrelated doc-build files, either
# copy is fine). Let make-venv link the first-encountered copy. (The
# aws_cdk.cloud_assembly_schema conflict is handled by the
# aws-cdk-cloud-assembly-schema override above.)
pkgs.stdenv.mkDerivation {
  name = "authentik-python-deps";

  dontConfigure = true;
  dontUnpack = true;
  dontBuild = true;
  dontPatch = true;

  nativeBuildInputs = [ python ];

  NIX_PYPROJECT_DEPS = lib.concatStringsSep ":"
    (lib.map (name: pythonSet.${name}) (resolveCyclic pythonSet venvSpec));
  dontMoveLib64 = true;
  noDumpEnvVars = true;

  installPhase = ''
    runHook preInstall
    ${python.interpreter} ${makeVenvScript} --python ${python} "$out" --env NIX_PYPROJECT_DEPS --ignore-collisions lib/python3.14/site-packages/docs/Makefile
    runHook postInstall
  '';
}
